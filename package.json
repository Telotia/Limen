{
  "name": "limen",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Telotia website (codename: Limen)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:dev": "cross-env LIMEN_ENV=dev astro build",
    "build:prod": "cross-env LIMEN_ENV=prod astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "bun test",
    "smoke:dev": "bun scripts/smoke-url.ts https://dev.telotia.com \"Request a pilot\"",
    "smoke:prod": "bun scripts/smoke-url.ts https://telotia.com \"September\"",
    "hooks:install": "git config core.hooksPath .githooks",
    "commitlint": "commitlint --edit",
    "cf:deploy:dev": "bun run build:dev && bunx wrangler deploy --env=",
    "cf:deploy:production": "bun run build:prod && bunx wrangler deploy --env production"
  },
  "dependencies": {
    "astro": "^6.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.7.0",
    "@types/three": "^0.184.1",
    "cross-env": "^7.0.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.90.1"
  }
}
