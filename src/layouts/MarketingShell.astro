---
// The dev site's pages. In production (telotia.com) they only exist to send old links home, as on main, whose
// homepage, Research tab and privacy page are telotia.com's (main merged into dev, 23 Oct 2026).
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import SiteLayout from './SiteLayout.astro';

interface Props {
  title: string;
  description: string;
  isProd: boolean;
}

const { title, description, isProd } = Astro.props;
---

{isProd ? (
  <html lang="en-CA">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Telotia</title>
      <meta http-equiv="refresh" content="0; url=/" />
      <meta name="robots" content="noindex" />
      <link rel="canonical" href="https://telotia.com/" />
      <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    </head>
    <body><p><a href="/">Telotia</a></p></body>
  </html>
) : (
  <SiteLayout title={title} description={description}>
    <div class="site-shell">
      <Nav />
      <main><slot /></main>
      <Footer />
    </div>
  </SiteLayout>
)}

{!isProd && <script is:inline src="/telotia-particles.js?v=11" defer></script>}
{!isProd && <script is:inline src="/home-init.js?v=30" defer></script>}
{!isProd && <script is:inline src="/ui-windows.js?v=16" defer></script>}

<style>
  .site-shell {
    width: 100%;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: var(--fsans);
    color: var(--t1);
    background-color: var(--cn-gang);
    background-image:
      linear-gradient(rgba(242,236,222,.46), rgba(242,236,222,.46)),
      radial-gradient(ellipse at 16% 7%, rgba(255,251,240,.28), transparent 44%),
      radial-gradient(ellipse at 82% 68%, rgba(167,142,68,.065), transparent 42%),
      linear-gradient(112deg, rgba(255,251,240,.13), transparent 38%, rgba(80,97,109,.045)),
      url('/assets/ink-wash/textures/xuan-paper-generated.jpg');
    background-repeat: repeat, no-repeat, no-repeat, no-repeat, repeat;
    background-size: auto, 100% 100%, 100% 100%, 100% 100%, 680px 680px;
    /* Keep the real fibre field visible. The tonal layers above it remove the
       appearance of a repeating photograph without bleaching it into a flat fill. */
    background-blend-mode: normal, soft-light, multiply, multiply, normal;
    position: relative;
    overflow-x: clip;
  }

  main {
    position: relative;
    z-index: 1;
    flex: 1 0 auto;
  }
</style>
