---
import { artResources, newsResources } from '../data/resource-menu';

interface Props {
  showSubnav?: boolean;
}
const { showSubnav = true } = Astro.props;
const currentPath = Astro.url.pathname;

const isCurrent = (href: string) => {
  const normalized = href.startsWith('/') ? href : `/${href}`;
  return currentPath === normalized || currentPath === normalized.replace('.html', '');
};

---

<!-- NAV -->
<div class="nav-flow-slot" aria-hidden="true"></div>
<nav class="navlight" aria-label="Primary navigation" style="position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:28px;padding:0 64px;min-height:72px;background:linear-gradient(90deg,rgba(230,226,216,.94),rgba(246,243,236,.9) 46%,rgba(230,226,216,.94));backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid rgba(23,32,29,.22);box-shadow:0 1px 0 rgba(255,255,255,.35)">
    <button class="nav-collapse" type="button" aria-label="Collapse navigation">
      <span aria-hidden="true">←</span>
    </button>
    <a class="nav-brand" href="/" style="text-decoration:none"><div style="display:flex;align-items:center;gap:14px">
      <img src="/telotia-mark-tricolor-transparent.webp" alt="Telotia" style="height:50px;width:50px;object-fit:contain;display:block;flex-shrink:0;transform:scale(1.22);transform-origin:center"/>
      <span style="font-family:var(--fmono);font-size:14px;font-weight:500;letter-spacing:.34em;padding-left:.34em;color:#10182F">TELOTIA</span>
    </div></a>
    <div class="nav-links" style={`display:${showSubnav ? 'flex' : 'none'};gap:26px;margin-left:6px`}>
      {showSubnav && (
        <>
          <a class="lk nav-link" aria-current={isCurrent('research.html') ? 'page' : undefined} href="research.html">Research</a>
          <a class="lk nav-link" aria-current={isCurrent('demo.html') ? 'page' : undefined} href="demo.html">Demo</a>
          <a class="lk nav-link" aria-current={isCurrent('process.html') ? 'page' : undefined} href="process.html">Process</a>
          <a class="lk nav-link" aria-current={isCurrent('workspace.html') ? 'page' : undefined} href="workspace.html">Workspace</a>
          <a class="lk nav-link" aria-current={isCurrent('consult.html') ? 'page' : undefined} href="consult.html">Consult</a>
        </>
      )}
      <div class="nav-res">
        <a class="lk nav-link" aria-current={currentPath.startsWith('/resource') ? 'page' : undefined} href="/resource.html">Resources</a>
        <div class="res-panel">
          <div class="res-col">
            <div class="res-col-title">Art</div>
            {artResources.map((item) => (
              <a class="res-item" href={item.href}>
                <span class="res-item-title">{item.title}</span>
                <span class="res-item-date">{item.date}</span>
              </a>
            ))}
            <a class="res-viewall" href="/resource.html#art">All art →</a>
          </div>
          <div class="res-col">
            <div class="res-col-title">News</div>
            {newsResources.map((item) => (
              <a class="res-item" href={item.href}>
                <span class="res-item-title">{item.title}</span>
                <span class="res-item-date">{item.date}</span>
              </a>
            ))}
            <a class="res-viewall" href="/resource.html#news">All news →</a>
          </div>
        </div>
      </div>
    </div>
    <div class="nav-spacer" style="flex:1"></div>
    <a class="btn-s nav-cta" href="consult.html" style="font-size:13px;color:var(--t2);text-decoration:none;border:1px solid var(--rule);border-radius:8px;padding:8px 16px">Request a pilot</a>
    <details class="nav-mobile">
      <summary aria-label="Open navigation">Menu</summary>
      <div class="nav-mobile-panel">
        <a href="research.html">Research</a>
        <a href="demo.html">Demo</a>
        <a href="process.html">Process</a>
        <a href="workspace.html">Workspace</a>
        <a href="consult.html">Consult</a>
        <a href="/resource.html">Resources</a>
        <a href="/resource.html#art">Art</a>
        <a href="/resource.html#news">News</a>
        <a class="nav-mobile-cta" href="consult.html">Request a pilot</a>
      </div>
    </details>
  </nav>

<style>
  .nav-flow-slot {
    display: none;
  }

  .nav-collapse {
    position: absolute;
    left: 17px;
    top: 50%;
    z-index: 2;
    display: grid;
    width: 31px;
    height: 31px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    box-shadow: none;
    color: rgba(29, 48, 41, 0.62);
    cursor: pointer;
    transform: translateY(-50%);
    transition: color .24s var(--ease), background .24s var(--ease), transform .24s var(--ease);
  }

  .nav-collapse::before {
    content: "";
    position: absolute;
    inset: 8px 2px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(29, 48, 41, .22), rgba(29, 48, 41, 0) 72%);
    filter: blur(3px);
    opacity: .48;
    transform: scaleX(.74);
    transition: opacity .24s var(--ease), transform .24s var(--ease);
  }

  .nav-collapse span {
    position: relative;
    font-family: var(--fbrush);
    font-size: 22px;
    line-height: 1;
    transform: translate(0, -1px) scaleX(1.14);
    text-shadow: -1px 0 1px rgba(29, 48, 41, .18);
  }

  .nav-collapse span::after {
    content: "←";
    position: absolute;
    inset: 0;
    color: currentColor;
    opacity: .16;
    filter: blur(.45px);
    transform: translate(1px, 1px) scaleX(.94);
  }

  .nav-collapse:hover {
    color: rgba(16, 24, 47, .9);
    background: rgba(255, 255, 255, .28);
    transform: translateY(-50%) translateX(-2px);
  }

  .nav-collapse:hover::before {
    opacity: .72;
    transform: scaleX(.94);
  }

  .nav-collapse:focus-visible {
    outline: 1px solid var(--teal);
    outline-offset: 3px;
  }

  .nav-mobile {
    display: none;
    position: relative;
    margin-left: auto;
    font-family: var(--fmono);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 72px;
    font-size: 13px;
    white-space: nowrap;
  }

  .nav-link[aria-current="page"] {
    color: var(--t1);
  }

  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 14px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--teal);
    transform: translateX(-50%);
    box-shadow: 0 0 0 3px rgba(42, 85, 165, 0.08);
  }

  .nav-res {
    display: flex;
    align-items: center;
    min-height: 72px;
  }

  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 8px 11px;
    color: var(--t2);
    font-size: 12px;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    width: min(260px, calc(100vw - 32px));
    display: grid;
    padding: 10px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: rgba(245, 243, 237, 0.97);
    box-shadow: 0 24px 50px -24px rgba(16, 24, 47, 0.45);
    max-height: calc(100dvh - 92px);
    overflow-y: auto;
  }

  .nav-mobile-panel a {
    padding: 10px 11px;
    color: var(--t2);
    text-decoration: none;
    font-size: 13px;
  }

  .nav-mobile-panel a + a {
    border-top: 1px solid var(--rulesoft);
  }

  .nav-mobile-panel .nav-mobile-cta {
    margin-top: 6px;
    border: 0;
    border-radius: 7px;
    background: var(--t1);
    color: #fff;
    text-align: center;
  }

  @media (max-width: 960px) {
    .nav-flow-slot {
      display: block;
      height: 68px;
      transition: height .34s cubic-bezier(.22,.61,.36,1);
    }

    .navlight {
      position: fixed !important;
      inset: 0 0 auto !important;
      z-index: 80 !important;
      height: 68px !important;
      padding: 0 16px 0 52px !important;
      flex-wrap: nowrap !important;
      gap: 10px !important;
      transition: transform .34s cubic-bezier(.22,.61,.36,1), opacity .24s ease, visibility 0s linear 0s !important;
      will-change: transform, opacity;
    }

    .navlight.is-nav-hidden {
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
      transform: translate3d(0,-110%,0) !important;
      transition: transform .34s cubic-bezier(.22,.61,.36,1), opacity .24s ease, visibility 0s linear .34s !important;
    }

    body.telotia-nav-hidden .nav-flow-slot {
      height: 54px;
    }

    .nav-brand img {
      height: 44px !important;
      width: 44px !important;
    }

    .nav-brand span {
      font-size: 12px !important;
      letter-spacing: 0.25em !important;
    }

    .nav-links,
    .nav-cta {
      display: none !important;
    }

    .nav-spacer {
      display: block !important;
    }

    .nav-mobile {
      display: block;
    }

    .nav-mobile[open] summary {
      border-color: var(--teal);
      color: var(--teal);
      background: rgba(42, 85, 165, 0.06);
    }
  }

  @media (max-width: 420px) {
    .nav-flow-slot {
      height: 64px;
    }

    body.telotia-nav-hidden .nav-flow-slot {
      height: 52px;
    }

    .navlight {
      height: 64px !important;
      min-height: 64px !important;
      padding-left: max(50px, env(safe-area-inset-left)) !important;
      padding-right: max(13px, env(safe-area-inset-right)) !important;
    }

    .nav-collapse {
      left: max(8px, env(safe-area-inset-left));
    }

    .nav-brand img {
      height: 38px !important;
      width: 38px !important;
    }

    .nav-brand span {
      font-size: 11px !important;
      letter-spacing: 0.22em !important;
    }
  }
</style>
