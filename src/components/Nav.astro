---
// Deduplicated nav, previously copy-pasted verbatim across all 6 site/*.html
// pages (byte-identical except `showSubnav` below).
//
// The Resources mega-menu's Art/Finance link lists are NOT hardcoded here --
// they're live content, rewritten daily by resource-sync/sync.py, which
// regex-edits the <!-- RES-MENU:*:START/END --> blocks directly inside each
// site/*.html file (all 6, independently). To keep that automation working
// unmodified, this component re-reads the same markers from site/index.html
// at build time rather than freezing a copy -- every deploy picks up
// whatever sync.py last wrote, exactly like the old per-page shim did.
import navRaw from '../../site/index.html?raw';

interface Props {
  showSubnav?: boolean;
}
const { showSubnav = true } = Astro.props;

function extractMenuBlock(html: string, marker: string): string {
  const re = new RegExp(
    `<!-- RES-MENU:${marker}:START -->[\\s\\S]*?<!-- RES-MENU:${marker}:END -->`
  );
  const m = html.match(re);
  if (!m) throw new Error(`Nav.astro: RES-MENU:${marker} block not found in site/index.html`);
  return m[0];
}

const artBlock = extractMenuBlock(navRaw, 'ART');
const financeBlock = extractMenuBlock(navRaw, 'FINANCE');
---

<!-- NAV -->
<nav class="navlight" style="position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:30px;padding:3px 64px;background:linear-gradient(90deg,rgba(248,250,253,.72) 0%,rgba(238,242,248,.66) 38%,rgba(150,178,222,.5) 70%,rgba(238,242,248,.62) 88%,rgba(248,250,253,.72) 100%);backdrop-filter:blur(11px);-webkit-backdrop-filter:blur(11px);border-bottom:1px solid rgba(40,25,25,.4);box-shadow:0 1px 0 rgba(220,224,229,.08),inset 0 1px 0 rgba(40,25,25,.5)">
    <a href="index.html" style="text-decoration:none"><div style="display:flex;align-items:center;gap:14px">
      <img src="telotia-logo-cut.png" alt="Telotia" style="height:72px;width:auto;display:block;flex-shrink:0;margin:0 -8px;position:relative;top:0"/>
      <span style="font-family:var(--fmono);font-size:14px;font-weight:500;letter-spacing:.34em;padding-left:.34em;color:#10182F">TELOTIA</span>
    </div></a>
    <div style={`display:${showSubnav ? 'flex' : 'none'};gap:26px;margin-left:6px`}>
      {showSubnav && (
        <>
          <a class="lk" href="process.html" style="font-size:13px">Process</a>
          <a class="lk" href="workspace.html" style="font-size:13px">Workspace</a>
          <a class="lk" href="demo.html" style="font-size:13px">Demo</a>
          <a class="lk" href="research.html" style="font-size:13px">Research</a>
          <a class="lk" href="consult.html" style="font-size:13px">Consult</a>
        </>
      )}
      <div class="nav-res">
        <a class="lk" href="/resource" style="font-size:13px">Resources</a>
        <div class="res-panel">
          <div class="res-col">
            <div class="res-col-title">Art</div>
            <Fragment set:html={artBlock} />
            <a class="res-viewall" href="/resource/art/">All art →</a>
          </div>
          <div class="res-col">
            <div class="res-col-title">Finance</div>
            <Fragment set:html={financeBlock} />
            <a class="res-viewall" href="/resource/finance/">All finance →</a>
          </div>
          <div class="res-col">
            <div class="res-col-title">Research</div>
            <span class="res-empty">Coming soon</span>
            <div class="res-col-title" style="margin-top:10px">Aquila</div>
            <span class="res-empty">Coming soon</span>
          </div>
        </div>
      </div>
    </div>
    <div style="flex:1"></div>
    <a class="btn-s" href="consult.html" style="font-size:13px;color:var(--t2);text-decoration:none;border:1px solid var(--rule);border-radius:8px;padding:8px 16px">Request a pilot</a>
  </nav>
