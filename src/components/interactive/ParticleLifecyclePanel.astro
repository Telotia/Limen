<section class="particle-lifecycle" aria-labelledby="particle-lifecycle-title">
  <div class="particle-lifecycle-panel">
    <div class="particle-lifecycle-copy">
      <span class="particle-lifecycle-label">Particle lifecycle</span>
      <h3 id="particle-lifecycle-title">A claim changes state before it resolves.</h3>
      <p class="particle-lifecycle-lede">The motion exposes the sequence behind the review: claims enter, gather around a shared evidence centre, split when needed, and leave with a traceable verdict.</p>

      <dl class="particle-lifecycle-states">
        <div><dt>Enter</dt><dd>One claim arrives from the document.</dd></div>
        <div><dt>Gather</dt><dd>Related evidence changes its path.</dd></div>
        <div><dt>Split</dt><dd>A compound statement becomes atomic.</dd></div>
        <div><dt>Resolve</dt><dd>The final trace keeps its source.</dd></div>
      </dl>
    </div>

    <div class="particle-lifecycle-stage">
      <canvas data-particle-lifecycle aria-label="Animated claim particle lifecycle"></canvas>
      <div class="particle-lifecycle-caption" aria-hidden="true">
        <span>Claim enters</span>
        <span>Chaotic evidence field</span>
        <span>Verdict trace</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { createAnimation } from '../../lib/dianoetica/core/engine';

  const canvas = document.querySelector('[data-particle-lifecycle]');

  if (canvas instanceof HTMLCanvasElement) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (reducedMotion.matches) {
      const context = canvas.getContext('2d');
      const drawFallback = () => {
        if (!context) return;
        const rect = canvas.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        canvas.width = Math.max(1, Math.round(rect.width * dpr));
        canvas.height = Math.max(1, Math.round(rect.height * dpr));
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        context.clearRect(0, 0, rect.width, rect.height);

        const cx = rect.width * .53;
        const cy = rect.height * .5;
        const radius = Math.min(rect.width, rect.height) * .25;
        const colors = ['#2A55A5', '#C13B33', '#D3A743', '#52645d'];

        const raw: { x: number; y: number }[] = [];
        let lx = .1;
        let ly = 0;
        let lz = 0;
        const dt = .008;

        for (let step = 0; step < 4300; step += 1) {
          const dx = 10 * (ly - lx);
          const dy = lx * (28 - lz) - ly;
          const dz = lx * ly - (8 / 3) * lz;
          lx += dx * dt;
          ly += dy * dt;
          lz += dz * dt;
          if (step > 700) raw.push({ x: lx, y: lz });
        }

        const minX = Math.min(...raw.map((point) => point.x));
        const maxX = Math.max(...raw.map((point) => point.x));
        const minY = Math.min(...raw.map((point) => point.y));
        const maxY = Math.max(...raw.map((point) => point.y));
        const points = raw.map((point) => ({
          x: cx + ((point.x - minX) / (maxX - minX) - .5) * radius * 3.15,
          y: cy + ((point.y - minY) / (maxY - minY) - .5) * radius * 2.15,
        }));

        context.lineCap = 'round';
        context.lineJoin = 'round';
        context.lineWidth = 1.1;
        context.strokeStyle = 'rgba(38, 56, 50, .21)';
        context.beginPath();
        points.forEach((point, index) => {
          if (index === 0) context.moveTo(point.x, point.y);
          else context.lineTo(point.x, point.y);
        });
        context.stroke();

        const markerIndexes = [.16, .38, .63, .86];
        colors.forEach((color, index) => {
          const point = points[Math.floor((points.length - 1) * markerIndexes[index])];
          context.fillStyle = color;
          context.beginPath();
          context.arc(point.x, point.y, index === 2 ? 6 : 4.5, 0, Math.PI * 2);
          context.fill();
        });
      };

      drawFallback();
      const observer = new ResizeObserver(drawFallback);
      observer.observe(canvas);
      window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
    } else {
      let animation: ReturnType<typeof createAnimation> | null = null;
      const startAnimation = () => {
        if (animation) return;
        animation = createAnimation(canvas, {
          backgroundColor: 'transparent',
          telosPattern: 'chaotic pattern',
          center: ({ width, height }) => ({ x: width * .53, y: height * .5 }),
          radius: ({ width, height }) => Math.min(width, height) * .27,
        });
      };

      // Do not let the attractor finish while it sits below the fold. Its
      // first visible state should always explain the claim entering the
      // evidence field, especially on the long mobile layout.
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        startAnimation();
        observer.disconnect();
      }, { threshold: .18 });

      observer.observe(canvas);
      window.addEventListener('pagehide', () => {
        observer.disconnect();
        animation?.destroy();
      }, { once: true });
    }
  }
</script>

