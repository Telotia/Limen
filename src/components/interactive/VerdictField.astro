<section class="verdict-field" aria-labelledby="verdict-field-title">
  <div class="verdict-field-heading">
    <div>
      <span class="verdict-field-label">Verdict field</span>
      <h3 id="verdict-field-title">Follow a claim through its evidence links.</h3>
    </div>
    <p>New nodes arrive as claims are separated. Select empty paper to grow the field, or select a node to prune its branch.</p>
  </div>

  <dl class="verdict-field-key" aria-label="Verdict meanings">
    <div class="is-supported"><dt>Supported</dt><dd>The cited corpus backs the claim.</dd></div>
    <div class="is-partial"><dt>Partial</dt><dd>The evidence supports only part of it.</dd></div>
    <div class="is-silent"><dt>Corpus silent</dt><dd>No cited support was found.</dd></div>
  </dl>

  <div id="tlSpikeWrap" class="verdict-field-window">
    <div class="verdict-field-wash" aria-hidden="true"></div>
    <canvas id="tlSpikeCanvas" aria-label="Interactive claim and verdict network. Tap empty paper to grow a claim. Tap a node to prune its branch."></canvas>
    <div id="tlKeywordLayer" aria-hidden="true"></div>
    <div id="tlNodeLayer" aria-hidden="true"></div>
    <p class="verdict-field-instruction">Click or tap empty paper to grow. Click or tap a node to prune.</p>
  </div>
</section>

