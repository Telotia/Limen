  .resource-hub:hover .resource-hub-artwork,.resource-hub[data-highlighted="true"] .resource-hub-artwork{opacity:.68;transform:scale(1.035)}
  .resource-network[data-active-topic]:not([data-active-topic=""]) .resource-hub[data-highlighted="false"]{opacity:.52}
