---
import catalog from '../../data/resource-catalog.json';

type TopicId = string;

interface ResourceEntry {
  kind: TopicId;
  categories?: TopicId[];
  cards?: string[];
  title: string;
  date: string;
  dateLabel: string;
  folderLabel: string;
  href: string;
  zhHref: string;
  image: string;
}

const MAX_PER_TOPIC = 30;
const entries = catalog as ResourceEntry[];

const topics = [
  {
    id: 'art', label: 'Art', note: 'RYB · visual culture',
    color: '#9D2933', colors: ['#9D2933', '#FFB61E', '#1685A9', '#161823'],
  },
  {
    id: 'news', label: 'News', note: 'Ink · systems in motion',
    color: '#1685A9', colors: ['#1685A9', '#50616D', '#FFB61E', '#161823'],
  },
  {
    id: 'science', label: 'Science', note: 'RGB · research and evidence',
    color: '#50616D', colors: ['#1685A9', '#789262', '#758A99', '#161823'],
  },
  {
    id: 'release', label: 'Release', note: 'CMYK · releases and editions',
    color: '#A78E44', colors: ['#FFB61E', '#9D2933', '#1685A9', '#161823'],
  },
] as const;

const topicById = new Map<TopicId, (typeof topics)[number]>(topics.map((topic) => [topic.id, topic]));

const nodeSizes = [54, 60, 50, 57, 63, 52, 59, 49, 61, 55] as const;

const entriesByTopic = new Map<TopicId, ResourceEntry[]>();
topics.forEach((topic) => {
  entriesByTopic.set(
    topic.id,
    entries.filter((entry) => (entry.categories ?? [entry.kind]).includes(topic.id)).slice(0, MAX_PER_TOPIC),
  );
});

const clusterUsage = Object.fromEntries(topics.map((topic) => [topic.id, 0])) as Record<TopicId, number>;
const seenEntries = new Set<string>();
const articleNodes: Array<ResourceEntry & {
  categories: TopicId[];
  cards: string[];
  palette: (typeof topics)[number];
  homeTopic: TopicId;
  size: number;
  id: string;
}> = [];

topics.forEach((topic) => {
  entriesByTopic.get(topic.id)?.forEach((entry) => {
    if (seenEntries.has(entry.href)) return;
    seenEntries.add(entry.href);

    const categories = entry.categories?.length ? entry.categories : [entry.kind];
    const preferredHome = categories.includes(entry.kind) ? entry.kind : categories[0];
    const homeTopic = clusterUsage[preferredHome] < MAX_PER_TOPIC ? preferredHome : topic.id;
    const home = topicById.get(homeTopic) ?? topics[0];
    const clusterIndex = clusterUsage[homeTopic];
    clusterUsage[homeTopic] += 1;

    articleNodes.push({
      ...entry,
      categories,
      cards: entry.cards?.length ? entry.cards : [entry.image],
      palette: home,
      homeTopic,
      size: nodeSizes[clusterIndex % nodeSizes.length],
      id: `resource-node-${articleNodes.length}`,
    });
  });
});

const connections = articleNodes.flatMap((entry) => entry.categories.flatMap((category) => {
  const topic = topics.find((candidate) => candidate.id === category);
  if (!topic) return [];
  return [{ topic: topic.id, color: topic.color, entry }];
}));
const faceConnections = topics.flatMap((from, fromIndex) => topics.slice(fromIndex + 1).map((to) => ({
  from: from.id,
  to: to.id,
})));
const facePlanes: Array<{ topics: string; color: string }> = [];
for (let first = 0; first < topics.length - 2; first += 1) {
  for (let second = first + 1; second < topics.length - 1; second += 1) {
    for (let third = second + 1; third < topics.length; third += 1) {
      facePlanes.push({
        topics: [topics[first].id, topics[second].id, topics[third].id].join('|'),
        color: topics[first].color,
      });
    }
  }
}
---

<section class="resource-explorer" data-resource-explorer hidden aria-labelledby="resource-explorer-title">
  <h2 id="resource-explorer-title" class="resource-explorer-title">Connected resource field</h2>

  <div class="resource-network" data-resource-network data-focused="false">
    <nav class="resource-mobile-pager" data-resource-mobile-pager aria-label="Resource topics">
      <button class="resource-mobile-step" type="button" data-mobile-topic-step="-1" aria-label="Previous topic">←</button>
      <div class="resource-mobile-current" aria-live="polite">
        <strong data-mobile-topic-label>{topics[0]?.label}</strong>
        <small><span data-mobile-topic-count>{entriesByTopic.get(topics[0]?.id)?.length ?? 0}</span> entries · swipe to change</small>
      </div>
      <button class="resource-mobile-step" type="button" data-mobile-topic-step="1" aria-label="Next topic">→</button>
      <div class="resource-mobile-tabs" role="tablist" aria-label="Choose a resource topic">
        {topics.map((topic, index) => (
          <button
            type="button"
            role="tab"
            data-mobile-topic={topic.id}
            data-mobile-topic-index={index}
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            {topic.label}
          </button>
        ))}
      </div>
    </nav>

    <svg class="resource-network-map" aria-hidden="true">
      <desc>Articles form semantic clusters around one or more topic centres. Distance and shared links indicate affinity.</desc>
      {facePlanes.map((face) => (
        <path class="resource-face-plane" data-face-topics={face.topics} style={`--face-color:${face.color}`} />
      ))}
      {faceConnections.map((connection) => (
        <path class="resource-face-connection" data-from-topic={connection.from} data-to-topic={connection.to} />
      ))}
      {topics.map((topic) => (
        <path class="resource-root-connection" data-topic={topic.id} />
      ))}
      {connections.map((connection) => (
        <path
          class="resource-article-connection"
          data-topic={connection.topic}
          data-entry-id={connection.entry.id}
          style={`--connection-color:${connection.color}`}
        />
      ))}
    </svg>

    <div class="resource-root-node" aria-hidden="true">
      <strong>Resources</strong>
    </div>

    {topics.map((topic, index) => (
      <button
        class="resource-hub"
        type="button"
        data-topic={topic.id}
        data-topic-index={index}
        data-highlighted="false"
        style={`--hub-color:${topic.color};--hub-c1:${topic.colors[0]};--hub-c2:${topic.colors[1]};--hub-c3:${topic.colors[2]};--hub-c4:${topic.colors[3]}`}
        aria-pressed="false"
      >
        <span class="resource-hub-artwork" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="resource-hub-count">{String(entriesByTopic.get(topic.id)?.length ?? 0).padStart(2, '0')}</span>
        <strong>{topic.label}</strong>
        <small>{topic.note}</small>
      </button>
    ))}

    <div class="resource-article-nodes">
      {articleNodes.map((entry, index) => (
        <button
          class="resource-article-node"
          type="button"
          data-entry-id={entry.id}
          data-topics={entry.categories.join(' ')}
          data-primary-topic={entry.homeTopic}
          data-node-index={index}
          data-highlighted="false"
          style={`--node-size:${entry.size}px;--node-delay:${index * -0.43}s;--node-accent:${entry.palette.color};--node-soft:${entry.palette.colors[1]}`}
          aria-label={`Preview ${entry.title}`}
        >
          <span class="resource-node-tile">
            <img src={entry.cards[0]} alt="" loading="lazy" />
            <span>{entry.date.slice(5).replace('-', ' / ')}</span>
          </span>
          <span class="resource-node-caption">{entry.title}</span>
        </button>
      ))}
    </div>

    <p class="resource-mobile-empty" data-resource-mobile-empty hidden>
      This layer is ready for its first field note.
    </p>

    <div class="resource-focus-layer" data-resource-focus-layer hidden>
      {articleNodes.map((entry) => (
        <article
          class="resource-focus-panel"
          data-entry-id={entry.id}
          data-primary-topic={entry.homeTopic}
          style={`--focus-x:50%;--focus-y:50%;--focus-accent:${entry.palette.color};--focus-c1:${entry.palette.colors[0]};--focus-c2:${entry.palette.colors[1]};--focus-c3:${entry.palette.colors[2]};--focus-c4:${entry.palette.colors[3]}`}
          hidden
        >
          <button class="resource-focus-close" type="button" aria-label="Return to all resource cards">×</button>
          <div class="resource-focus-carousel">
            <button class="resource-focus-step resource-focus-previous" type="button" aria-label="Previous card">
              <span aria-hidden="true">←</span>
            </button>
            <a class="resource-focus-card" href={entry.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${entry.title} in a new tab`}>
              <span class="resource-focus-images">
                {entry.cards.map((card, index) => (
                  <img src={card} alt="" data-slide-index={index} hidden={index !== 0} />
                ))}
              </span>
              <span class="resource-focus-copy">
                <span><strong>{entry.categories.join(' + ')}</strong><time datetime={entry.date}>{entry.dateLabel}</time></span>
                <b>{entry.title}</b>
                <small>Click again to open the full article ↗</small>
              </span>
            </a>
            <button class="resource-focus-step resource-focus-next" type="button" aria-label="Next card">
              <span aria-hidden="true">→</span>
            </button>
          </div>
          <p class="resource-focus-status" aria-live="polite">
            Card <span data-focus-current>01</span> / {String(entry.cards.length).padStart(2, '0')}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { Euler, Quaternion, Vector3 } from 'three';

  const explorer = document.querySelector<HTMLElement>('[data-resource-explorer]');

  if (explorer) {
    const network = explorer.querySelector<HTMLElement>('[data-resource-network]');
    const map = explorer.querySelector<SVGSVGElement>('.resource-network-map');
    const focusLayer = explorer.querySelector<HTMLElement>('[data-resource-focus-layer]');
    const hubs = [...explorer.querySelectorAll<HTMLButtonElement>('.resource-hub')];
    const articleButtons = [...explorer.querySelectorAll<HTMLButtonElement>('.resource-article-node')];
    const rootConnections = [...explorer.querySelectorAll<SVGPathElement>('.resource-root-connection')];
    const facePlanes = [...explorer.querySelectorAll<SVGPathElement>('.resource-face-plane')];
    const faceConnections = [...explorer.querySelectorAll<SVGPathElement>('.resource-face-connection')];
    const articleConnections = [...explorer.querySelectorAll<SVGPathElement>('.resource-article-connection')];
    const panels = [...explorer.querySelectorAll<HTMLElement>('.resource-focus-panel')];
    const mobilePager = explorer.querySelector<HTMLElement>('[data-resource-mobile-pager]');
    const mobileTopicLabel = explorer.querySelector<HTMLElement>('[data-mobile-topic-label]');
    const mobileTopicCount = explorer.querySelector<HTMLElement>('[data-mobile-topic-count]');
    const mobileEmptyState = explorer.querySelector<HTMLElement>('[data-resource-mobile-empty]');
    const mobileTopicTabs = [...explorer.querySelectorAll<HTMLButtonElement>('[data-mobile-topic]')];
    const mobileTopicSteps = [...explorer.querySelectorAll<HTMLButtonElement>('[data-mobile-topic-step]')];
    const mobileQuery = window.matchMedia('(max-width: 680px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const forward = new Vector3(0, 0, 1);
    const goldenAngle = Math.PI * (3 - Math.sqrt(5));
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
    const requestCompactNavigation = (reason: string) => {
      window.dispatchEvent(new CustomEvent('telotia:navigation-collapse', { detail: { reason } }));
    };

    type Projection = { x: number; y: number; depth: number; scale: number };
    type TopicModel = {
      id: string;
      normal: Vector3;
      tangentU: Vector3;
      tangentV: Vector3;
      hub: HTMLButtonElement;
      projection?: Projection;
    };
    type ArticleModel = {
      id: string;
      topics: string[];
      homeTopic: string;
      u: number;
      v: number;
      depthOffset: number;
      button: HTMLButtonElement;
      projection?: Projection;
    };

    const buildFaceNormals = (count: number) => {
      if (count === 4) {
        return [
          new Vector3(1, 1, 1),
          new Vector3(-1, -1, 1),
          new Vector3(-1, 1, -1),
          new Vector3(1, -1, -1),
        ].map((normal) => normal.normalize());
      }
      if (count === 1) return [new Vector3(0, 0, 1)];
      return Array.from({ length: count }, (_, index) => {
        const y = 1 - (index / (count - 1)) * 2;
        const radius = Math.sqrt(Math.max(0, 1 - y * y));
        const theta = index * goldenAngle;
        return new Vector3(Math.cos(theta) * radius, y, Math.sin(theta) * radius).normalize();
      });
    };

    const refreshOrientation = new Quaternion().setFromEuler(new Euler(
      (Math.random() - .5) * .22,
      (Math.random() - .5) * .38,
      (Math.random() - .5) * .12,
    ));
    const faceNormals = buildFaceNormals(hubs.length).map((normal) => normal.applyQuaternion(refreshOrientation));
    const topics: TopicModel[] = hubs.map((hub, index) => {
      const normal = faceNormals[index];
      const helper = Math.abs(normal.y) < .82 ? new Vector3(0, 1, 0) : new Vector3(1, 0, 0);
      const tangentU = new Vector3().crossVectors(helper, normal).normalize();
      const tangentV = new Vector3().crossVectors(normal, tangentU).normalize();
      return { id: hub.dataset.topic ?? `topic-${index}`, normal, tangentU, tangentV, hub };
    });
    const topicById = new Map(topics.map((topic) => [topic.id, topic]));
    const visibleFaceEdges = new Set<string>();
    if (topics.length <= 4) {
      faceConnections.forEach((path) => visibleFaceEdges.add([
        path.dataset.fromTopic ?? '',
        path.dataset.toTopic ?? '',
      ].sort().join('|')));
    } else {
      topics.forEach((topic) => {
        topics
          .filter((candidate) => candidate !== topic)
          .sort((a, b) => b.normal.dot(topic.normal) - a.normal.dot(topic.normal))
          .slice(0, 3)
          .forEach((neighbor) => visibleFaceEdges.add([topic.id, neighbor.id].sort().join('|')));
      });
    }
    const overviewQuaternion = new Quaternion().setFromEuler(new Euler(
      -.24 + (Math.random() - .5) * .12,
      .42 + (Math.random() - .5) * .2,
      -.04 + (Math.random() - .5) * .08,
    ));
    const currentQuaternion = overviewQuaternion.clone();

    const groupedButtons = new Map<string, HTMLButtonElement[]>();
    articleButtons.forEach((button) => {
      const id = button.dataset.primaryTopic ?? '';
      groupedButtons.set(id, [...(groupedButtons.get(id) ?? []), button]);
    });

    const articles: ArticleModel[] = [];
    groupedButtons.forEach((buttons, topicId) => {
      const phase = Math.random() * Math.PI * 2;
      const count = buttons.length;
      buttons.forEach((button, index) => {
        const radialProgress = count <= 1 ? 0 : Math.sqrt(index / Math.max(1, count - 1));
        const radius = count <= 1 ? .34 : .27 + radialProgress * .55;
        const angle = phase + index * goldenAngle + (Math.random() - .5) * .24;
        const radialJitter = 1 + (Math.random() - .5) * .11;
        articles.push({
          id: button.dataset.entryId ?? '',
          topics: button.dataset.topics?.split(' ').filter(Boolean) ?? [],
          homeTopic: topicId,
          u: Math.cos(angle) * radius * radialJitter,
          v: Math.sin(angle) * radius * radialJitter,
          depthOffset: (Math.random() - .5) * .045,
          button,
        });
      });
    });
    const articleById = new Map(articles.map((article) => [article.id, article]));

    let activeTopic = '';
    let focusMix = 0;
    let turnFrame = 0;
    let orbitFrame = 0;
    let activePanel: HTMLElement | null = null;
    let activeSlide = 0;
    let swipeStartX = 0;
    let swipeStartY = 0;
    let mobileTopicIndex = 0;
    let mobileSwipeStartX = 0;
    let mobileSwipeStartY = 0;
    let mobileSwipeGuard = false;

    const updateMobileTopic = (nextIndex: number, direction = 0) => {
      if (!network || !topics.length) return;
      closeFocus();
      mobileTopicIndex = (nextIndex + topics.length) % topics.length;
      const selected = topics[mobileTopicIndex];
      network.dataset.mobileTopic = selected.id;
      network.dataset.mobileDirection = direction < 0 ? 'previous' : direction > 0 ? 'next' : 'direct';
      const selectedTab = mobileTopicTabs[mobileTopicIndex];
      if (mobileTopicLabel) mobileTopicLabel.textContent = selectedTab?.textContent?.trim() || selected.id;
      const visibleCount = articleButtons.filter((button) => button.dataset.topics?.split(' ').includes(selected.id)).length;
      if (mobileTopicCount) mobileTopicCount.textContent = String(visibleCount);
      if (mobileEmptyState) mobileEmptyState.hidden = visibleCount > 0;
      mobileTopicTabs.forEach((tab, index) => tab.setAttribute('aria-selected', String(index === mobileTopicIndex)));
      articleButtons.forEach((button) => {
        const visible = button.dataset.topics?.split(' ').includes(selected.id) ?? false;
        button.dataset.mobileVisible = String(visible);
        button.setAttribute('aria-hidden', String(!visible));
        button.tabIndex = visible ? 0 : -1;
      });
      if (!reduceMotion && mobilePager) {
        mobilePager.classList.remove('is-switching');
        requestAnimationFrame(() => mobilePager.classList.add('is-switching'));
      }
    };

    const syncResponsiveMode = () => {
      if (!network) return;
      network.dataset.mobileLayer = String(mobileQuery.matches);
      if (mobileQuery.matches) updateMobileTopic(mobileTopicIndex);
      else {
        articleButtons.forEach((button) => {
          button.removeAttribute('data-mobile-visible');
          button.removeAttribute('aria-hidden');
          button.tabIndex = 0;
        });
        renderNetwork();
      }
    };

    const articlePoint = (article: ArticleModel) => {
      const planeId = activeTopic && article.topics.includes(activeTopic) ? activeTopic : article.homeTopic;
      const topic = topicById.get(planeId) ?? topics[0];
      const spread = activeTopic === planeId ? 1 + focusMix * .2 : 1;
      return topic.normal.clone()
        .multiplyScalar(.7 + article.depthOffset)
        .addScaledVector(topic.tangentU, article.u * spread)
        .addScaledVector(topic.tangentV, article.v * spread);
    };

    const renderNetwork = () => {
      if (!network || !map) return;
      const width = network.clientWidth;
      const height = network.clientHeight;
      if (!width || !height) return;
      const centerX = width / 2;
      const centerY = height / 2;
      const spatialScale = width < 700
        ? Math.min(width * .34, height * .29)
        : Math.min(width * .34, height * (activeTopic ? .29 : .33));
      const cameraDistance = 3.15;
      map.setAttribute('viewBox', `0 0 ${width} ${height}`);

      const project = (source: Vector3): Projection => {
        const point = source.clone().applyQuaternion(currentQuaternion);
        const perspective = cameraDistance / (cameraDistance - point.z);
        return {
          x: centerX + point.x * spatialScale * perspective,
          y: centerY + point.y * spatialScale * perspective,
          depth: point.z,
          scale: clamp(perspective * .9, .62, 1.2),
        };
      };

      topics.forEach((topic) => {
        const projected = project(topic.normal.clone().multiplyScalar(.7));
        const viewNormal = topic.normal.clone().applyQuaternion(currentQuaternion);
        topic.projection = projected;
        topic.hub.style.setProperty('--screen-x', `${projected.x - centerX}px`);
        topic.hub.style.setProperty('--screen-y', `${projected.y - centerY}px`);
        topic.hub.style.setProperty('--depth-scale', projected.scale.toFixed(3));
        topic.hub.style.setProperty('--depth-opacity', clamp(.48 + (projected.depth + 1) * .3, .3, 1).toFixed(3));
        topic.hub.style.setProperty('--tilt-x', `${clamp(-viewNormal.y * 18, -16, 16).toFixed(2)}deg`);
        topic.hub.style.setProperty('--tilt-y', `${clamp(viewNormal.x * 22, -19, 19).toFixed(2)}deg`);
        topic.hub.style.zIndex = String(20 + Math.round((projected.depth + 1) * 20));
      });

      articles.forEach((article) => {
        const projected = project(articlePoint(article));
        const planeId = activeTopic && article.topics.includes(activeTopic) ? activeTopic : article.homeTopic;
        const plane = topicById.get(planeId) ?? topics[0];
        const viewNormal = plane.normal.clone().applyQuaternion(currentQuaternion);
        article.projection = projected;
        const isCurrentFace = !activeTopic || article.topics.includes(activeTopic);
        const depthOpacity = clamp(.38 + (projected.depth + 1) * .3, .24, .96) * (isCurrentFace ? 1 : .16);
        article.button.style.setProperty('--screen-x', `${projected.x - centerX}px`);
        article.button.style.setProperty('--screen-y', `${projected.y - centerY}px`);
        article.button.style.setProperty('--depth-scale', projected.scale.toFixed(3));
        article.button.style.setProperty('--depth-opacity', depthOpacity.toFixed(3));
        article.button.style.setProperty('--depth-blur', `${clamp(-projected.depth * .32, 0, .45).toFixed(2)}px`);
        article.button.style.setProperty('--tilt-x', `${clamp(-viewNormal.y * 21, -19, 19).toFixed(2)}deg`);
        article.button.style.setProperty('--tilt-y', `${clamp(viewNormal.x * 25, -22, 22).toFixed(2)}deg`);
        article.button.style.zIndex = String(30 + Math.round((projected.depth + 1) * 28));
      });

      rootConnections.forEach((path) => {
        const topic = topicById.get(path.dataset.topic ?? '');
        const projected = topic?.projection;
        if (!projected) return;
        const bend = (projected.depth * 16) + ((topics.indexOf(topic) % 2) ? 8 : -8);
        path.setAttribute('d', `M ${centerX} ${centerY} Q ${(centerX + projected.x) / 2 + bend} ${(centerY + projected.y) / 2 - bend * .4} ${projected.x} ${projected.y}`);
        path.style.opacity = activeTopic && topic.id !== activeTopic ? '.035' : activeTopic ? '.32' : String(clamp(.08 + (projected.depth + 1) * .05, .07, .18));
      });

      faceConnections.forEach((path) => {
        const fromTopic = topicById.get(path.dataset.fromTopic ?? '');
        const toTopic = topicById.get(path.dataset.toTopic ?? '');
        const from = fromTopic?.projection;
        const to = toTopic?.projection;
        const key = [path.dataset.fromTopic ?? '', path.dataset.toTopic ?? ''].sort().join('|');
        if (!from || !to || !visibleFaceEdges.has(key)) {
          path.style.opacity = '0';
          return;
        }
        path.setAttribute('d', `M ${from.x} ${from.y} L ${to.x} ${to.y}`);
        path.style.opacity = activeTopic ? '.025' : String(clamp(.07 + (from.depth + to.depth + 2) * .025, .065, .16));
      });

      facePlanes.forEach((path) => {
        const ids = path.dataset.faceTopics?.split('|') ?? [];
        const faceTopics = ids.map((id) => topicById.get(id)).filter(Boolean) as TopicModel[];
        const projected = faceTopics.map((topic) => topic.projection).filter(Boolean) as Projection[];
        const hasVisibleEdges = ids.every((id, index) => ids.slice(index + 1).every((other) => (
          visibleFaceEdges.has([id, other].sort().join('|'))
        )));
        if (projected.length !== 3 || !hasVisibleEdges) {
          path.style.opacity = '0';
          return;
        }
        const averageDepth = projected.reduce((sum, point) => sum + point.depth, 0) / projected.length;
        path.setAttribute('d', `M ${projected[0].x} ${projected[0].y} L ${projected[1].x} ${projected[1].y} L ${projected[2].x} ${projected[2].y} Z`);
        path.style.opacity = activeTopic
          ? ids.includes(activeTopic) ? '.018' : '.004'
          : String(clamp(.018 + (averageDepth + 1) * .014, .014, .046));
      });

      articleConnections.forEach((path, index) => {
        const topic = topicById.get(path.dataset.topic ?? '');
        const article = articleById.get(path.dataset.entryId ?? '');
        const from = topic?.projection;
        const to = article?.projection;
        if (!from || !to) return;
        const bend = ((index % 5) - 2) * 5 + (to.depth - from.depth) * 12;
        path.setAttribute('d', `M ${from.x} ${from.y} Q ${(from.x + to.x) / 2 + bend} ${(from.y + to.y) / 2 - bend * .55} ${to.x} ${to.y}`);
        path.style.opacity = activeTopic && path.dataset.topic !== activeTopic ? '.018' : activeTopic ? '.48' : String(clamp(.08 + (to.depth + 1) * .06, .07, .2));
      });
    };

    const animateTurn = (target: Quaternion, targetMix: number) => {
      window.cancelAnimationFrame(turnFrame);
      window.cancelAnimationFrame(orbitFrame);
      network?.setAttribute('data-orbiting', 'false');
      const startQuaternion = currentQuaternion.clone();
      const startMix = focusMix;
      if (reduceMotion) {
        currentQuaternion.copy(target);
        focusMix = targetMix;
        renderNetwork();
        return;
      }
      const startedAt = performance.now();
      const duration = 980;
      network?.setAttribute('data-turning', 'true');
      const tick = (now: number) => {
        const progress = clamp((now - startedAt) / duration, 0, 1);
        const eased = 1 - Math.pow(1 - progress, 4);
        currentQuaternion.slerpQuaternions(startQuaternion, target, eased);
        focusMix = startMix + (targetMix - startMix) * eased;
        renderNetwork();
        if (progress < 1) turnFrame = window.requestAnimationFrame(tick);
        else network?.setAttribute('data-turning', 'false');
      };
      turnFrame = window.requestAnimationFrame(tick);
    };

    const updateTopicState = (topicId: string) => {
      activeTopic = topicId;
      hubs.forEach((hub) => {
        const highlighted = hub.dataset.topic === activeTopic;
        hub.dataset.highlighted = String(highlighted);
        hub.setAttribute('aria-pressed', String(highlighted));
      });
      articleButtons.forEach((button) => {
        const highlighted = !activeTopic || (button.dataset.topics?.split(' ').includes(activeTopic) ?? false);
        button.dataset.highlighted = String(highlighted);
      });
      articleConnections.forEach((connection) => {
        connection.dataset.highlighted = String(!activeTopic || connection.dataset.topic === activeTopic);
      });
      if (network) {
        network.dataset.activeTopic = activeTopic;
        network.dataset.topicFocused = String(Boolean(activeTopic));
      }
    };

    const renderPanel = () => {
      if (!activePanel) return;
      const slides = [...activePanel.querySelectorAll<HTMLImageElement>('[data-slide-index]')];
      const current = activePanel.querySelector<HTMLElement>('[data-focus-current]');
      slides.forEach((slide, index) => { slide.hidden = index !== activeSlide; });
      if (current) current.textContent = String(activeSlide + 1).padStart(2, '0');
      activePanel.querySelectorAll<HTMLButtonElement>('.resource-focus-step').forEach((button) => {
        button.disabled = slides.length <= 1;
      });
    };

    const closeFocus = () => {
      if (!network || !focusLayer) return;
      focusLayer.hidden = true;
      network.dataset.focused = 'false';
      panels.forEach((panel) => { panel.hidden = true; });
      articleButtons.forEach((button) => { button.dataset.selected = 'false'; });
      activePanel = null;
      activeSlide = 0;
    };

    const openFocus = (entryId: string) => {
      if (!network || !focusLayer) return;
      const nextPanel = panels.find((panel) => panel.dataset.entryId === entryId);
      const article = articleById.get(entryId);
      if (!nextPanel || !article?.projection) return;
      activePanel = nextPanel;
      activeSlide = 0;
      nextPanel.style.setProperty('--focus-x', `${(article.projection.x / network.clientWidth) * 100}%`);
      nextPanel.style.setProperty('--focus-y', `${(article.projection.y / network.clientHeight) * 100}%`);
      panels.forEach((panel) => { panel.hidden = panel !== nextPanel; });
      articleButtons.forEach((button) => { button.dataset.selected = String(button.dataset.entryId === entryId); });
      focusLayer.hidden = false;
      network.dataset.focused = 'true';
      renderPanel();
      nextPanel.querySelector<HTMLAnchorElement>('.resource-focus-card')?.focus({ preventScroll: true });
    };

    const stepFocus = (direction: number) => {
      if (!activePanel) return;
      const count = activePanel.querySelectorAll('[data-slide-index]').length;
      if (count <= 1) return;
      activeSlide = (activeSlide + direction + count) % count;
      renderPanel();
    };

    const selectTopic = (topicId: string) => {
      if (mobileQuery.matches) {
        const index = topics.findIndex((topic) => topic.id === topicId);
        if (index >= 0) updateMobileTopic(index, index > mobileTopicIndex ? 1 : -1);
        return;
      }
      closeFocus();
      updateTopicState(activeTopic === topicId ? '' : topicId);
      const target = activeTopic
        ? new Quaternion().setFromUnitVectors(topicById.get(activeTopic)?.normal.clone().normalize() ?? forward, forward)
        : overviewQuaternion.clone();
      animateTurn(target, activeTopic ? 1 : 0);
    };

    if (network) {
      let orbitPointerId = -1;
      let orbitLastX = 0;
      let orbitLastY = 0;
      let orbitLastAt = 0;
      let orbitVelocityX = 0;
      let orbitVelocityY = 0;
      let orbitDistance = 0;
      let orbitStarted = false;
      let autoOrbitLastAt = performance.now();
      let autoOrbitPausedUntil = 0;

      const isInteractiveTarget = (target: EventTarget | null) => target instanceof Element && Boolean(target.closest(
        '.resource-article-node,.resource-hub,.resource-root-node,.resource-focus-layer,a,button,input,select,textarea',
      ));
      const applyOrbit = (deltaX: number, deltaY: number, deltaRoll = 0) => {
        const sensitivity = Math.PI / Math.max(620, Math.min(network.clientWidth, network.clientHeight) * 1.65);
        const yaw = new Quaternion().setFromAxisAngle(new Vector3(0, 1, 0), deltaX * sensitivity);
        const pitch = new Quaternion().setFromAxisAngle(new Vector3(1, 0, 0), -deltaY * sensitivity);
        const roll = new Quaternion().setFromAxisAngle(new Vector3(0, 0, 1), deltaRoll * sensitivity);
        currentQuaternion.premultiply(yaw).premultiply(pitch).premultiply(roll).normalize();
        renderNetwork();
      };
      const stopOrbit = () => {
        window.cancelAnimationFrame(orbitFrame);
        network.dataset.orbiting = 'false';
      };
      const beginInertia = () => {
        if (reduceMotion || Math.hypot(orbitVelocityX, orbitVelocityY) < .025) {
          stopOrbit();
          return;
        }
        let lastAt = performance.now();
        const startedAt = lastAt;
        const tick = (now: number) => {
          const deltaTime = Math.min(32, now - lastAt);
          lastAt = now;
          applyOrbit(orbitVelocityX * deltaTime, orbitVelocityY * deltaTime);
          const damping = Math.pow(.88, deltaTime / 16.67);
          orbitVelocityX *= damping;
          orbitVelocityY *= damping;
          if (Math.hypot(orbitVelocityX, orbitVelocityY) > .008 && now - startedAt < 920) {
            orbitFrame = window.requestAnimationFrame(tick);
          } else {
            stopOrbit();
          }
        };
        network.dataset.orbiting = 'true';
        orbitFrame = window.requestAnimationFrame(tick);
      };
      const pauseAutoOrbit = (duration = 1500) => {
        autoOrbitPausedUntil = performance.now() + duration;
      };
      const orbitProfile = {
        direction: Math.random() > .5 ? 1 : -1,
        yawPhase: Math.random() * Math.PI * 2,
        pitchPhase: Math.random() * Math.PI * 2,
        rollPhase: Math.random() * Math.PI * 2,
        driftPhase: Math.random() * Math.PI * 2,
      };
      const runAutoOrbit = (now: number) => {
        const deltaTime = Math.min(32, Math.max(0, now - autoOrbitLastAt));
        autoOrbitLastAt = now;
        const canRotate = !reduceMotion
          && !mobileQuery.matches
          && !document.hidden
          && !activePanel
          && !activeTopic
          && network.dataset.turning !== 'true'
          && network.dataset.orbiting !== 'true'
          && now >= autoOrbitPausedUntil;
        if (canRotate) {
          const seconds = now / 1000;
          const yawRate = orbitProfile.direction * (
            .0085
            + Math.sin(seconds * .31 + orbitProfile.yawPhase) * .0045
          );
          const pitchRate = (
            Math.sin(seconds * .43 + orbitProfile.pitchPhase) * .0052
            + Math.cos(seconds * .17 + orbitProfile.driftPhase) * .0018
          );
          const rollRate = (
            Math.sin(seconds * .27 + orbitProfile.rollPhase) * .0034
            + Math.cos(seconds * .13 + orbitProfile.driftPhase) * .0012
          );
          applyOrbit(deltaTime * yawRate, deltaTime * pitchRate, deltaTime * rollRate);
          network.dataset.autoRotating = 'true';
        } else {
          network.dataset.autoRotating = 'false';
        }
        window.requestAnimationFrame(runAutoOrbit);
      };
      if (!reduceMotion) window.requestAnimationFrame(runAutoOrbit);
      document.addEventListener('visibilitychange', () => {
        autoOrbitLastAt = performance.now();
      });

      network.addEventListener('pointerdown', (event) => {
        if (event.button === 0) requestCompactNavigation('resource-panel-interaction');
        if (mobileQuery.matches && !activePanel) {
          mobileSwipeStartX = event.clientX;
          mobileSwipeStartY = event.clientY;
          return;
        }
        if (event.button !== 0 || activePanel || isInteractiveTarget(event.target)) return;
        pauseAutoOrbit();
        stopOrbit();
        window.cancelAnimationFrame(turnFrame);
        network.dataset.turning = 'false';
        orbitPointerId = event.pointerId;
        orbitLastX = event.clientX;
        orbitLastY = event.clientY;
        orbitLastAt = performance.now();
        orbitVelocityX = 0;
        orbitVelocityY = 0;
        orbitDistance = 0;
        orbitStarted = false;
        network.setPointerCapture(event.pointerId);
      });
      network.addEventListener('pointermove', (event) => {
        if (event.pointerId !== orbitPointerId || !network.hasPointerCapture(event.pointerId)) return;
        const now = performance.now();
        const deltaX = event.clientX - orbitLastX;
        const deltaY = event.clientY - orbitLastY;
        orbitDistance += Math.hypot(deltaX, deltaY);
        orbitLastX = event.clientX;
        orbitLastY = event.clientY;
        const deltaTime = Math.max(8, now - orbitLastAt);
        orbitLastAt = now;
        if (orbitDistance < 4) return;
        event.preventDefault();
        if (!orbitStarted) {
          orbitStarted = true;
          closeFocus();
          updateTopicState('');
          focusMix = 0;
          network.dataset.orbiting = 'true';
        }
        orbitVelocityX = orbitVelocityX * .58 + (deltaX / deltaTime) * .42;
        orbitVelocityY = orbitVelocityY * .58 + (deltaY / deltaTime) * .42;
        applyOrbit(deltaX, deltaY);
      });
      const releaseOrbit = (event: PointerEvent) => {
        if (mobileQuery.matches && !activePanel) {
          const deltaX = event.clientX - mobileSwipeStartX;
          const deltaY = event.clientY - mobileSwipeStartY;
          if (Math.abs(deltaX) >= 52 && Math.abs(deltaX) > Math.abs(deltaY) * 1.15) {
            event.preventDefault();
            mobileSwipeGuard = true;
            updateMobileTopic(mobileTopicIndex + (deltaX < 0 ? 1 : -1), deltaX < 0 ? 1 : -1);
            window.setTimeout(() => { mobileSwipeGuard = false; }, 280);
          }
          return;
        }
        if (event.pointerId !== orbitPointerId) return;
        orbitPointerId = -1;
        if (network.hasPointerCapture(event.pointerId)) network.releasePointerCapture(event.pointerId);
        if (orbitStarted) {
          pauseAutoOrbit(2200);
          beginInertia();
        }
        else stopOrbit();
      };
      network.addEventListener('pointerup', releaseOrbit);
      network.addEventListener('pointercancel', (event) => {
        if (event.pointerId !== orbitPointerId) return;
        orbitPointerId = -1;
        stopOrbit();
      });
      network.addEventListener('click', () => requestCompactNavigation('resource-panel-activation'));
    }

    articleButtons.forEach((button) => {
      let pointerId = -1;
      let startX = 0;
      let startY = 0;
      let moved = false;
      let suppressClick = false;
      let settleTimer = 0;

      const setPull = (x: number, y: number, rotation: number, scale: number) => {
        button.style.setProperty('--drag-x', `${x.toFixed(2)}px`);
        button.style.setProperty('--drag-y', `${y.toFixed(2)}px`);
        button.style.setProperty('--drag-r', `${rotation.toFixed(2)}deg`);
        button.style.setProperty('--pull-scale', scale.toFixed(3));
      };
      const settle = () => {
        window.clearTimeout(settleTimer);
        button.dataset.dragging = 'false';
        button.style.transition = reduceMotion ? 'none' : 'transform 420ms cubic-bezier(.22,1.18,.36,1)';
        setPull(0, 0, 0, 1);
        settleTimer = window.setTimeout(() => { button.style.removeProperty('transition'); }, 440);
      };

      button.addEventListener('pointerdown', (event) => {
        if (mobileQuery.matches) return;
        if (event.button !== 0 || activePanel) return;
        window.clearTimeout(settleTimer);
        pointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        moved = false;
        button.style.transition = 'none';
        button.setPointerCapture(event.pointerId);
      });
      button.addEventListener('pointermove', (event) => {
        if (event.pointerId !== pointerId || !button.hasPointerCapture(event.pointerId)) return;
        const rawX = event.clientX - startX;
        const rawY = event.clientY - startY;
        const distance = Math.hypot(rawX, rawY);
        if (distance < 3) return;
        event.preventDefault();
        moved = true;
        button.dataset.dragging = 'true';
        const limit = Math.min(56, Math.max(38, (network?.clientWidth ?? 840) * .045));
        const resistedDistance = limit * Math.tanh(distance / (limit * .78));
        const ratio = resistedDistance / distance;
        const pullX = rawX * ratio;
        const pullY = rawY * ratio;
        const tension = resistedDistance / limit;
        setPull(pullX, pullY, (pullX / limit) * 1.65, 1 + tension * .025);
      });
      const releasePointer = (event: PointerEvent) => {
        if (event.pointerId !== pointerId) return;
        suppressClick = moved;
        pointerId = -1;
        settle();
      };
      button.addEventListener('pointerup', releasePointer);
      button.addEventListener('pointercancel', releasePointer);
      button.addEventListener('click', () => {
        if (mobileSwipeGuard) return;
        if (suppressClick) {
          suppressClick = false;
          return;
        }
        const entryId = button.dataset.entryId ?? '';
        if (reduceMotion) {
          openFocus(entryId);
          return;
        }
        button.classList.remove('is-tapped');
        requestAnimationFrame(() => button.classList.add('is-tapped'));
        window.setTimeout(() => {
          button.classList.remove('is-tapped');
          openFocus(entryId);
        }, 230);
      });
    });

    hubs.forEach((hub) => hub.addEventListener('click', () => selectTopic(hub.dataset.topic ?? '')));
    mobileTopicTabs.forEach((tab) => tab.addEventListener('click', () => {
      const index = Number(tab.dataset.mobileTopicIndex ?? 0);
      updateMobileTopic(index, index > mobileTopicIndex ? 1 : index < mobileTopicIndex ? -1 : 0);
    }));
    mobileTopicSteps.forEach((button) => button.addEventListener('click', () => {
      const direction = Number(button.dataset.mobileTopicStep ?? 0);
      updateMobileTopic(mobileTopicIndex + direction, direction);
    }));
    panels.forEach((panel) => {
      panel.querySelector<HTMLButtonElement>('.resource-focus-close')?.addEventListener('click', closeFocus);
      panel.querySelector<HTMLButtonElement>('.resource-focus-previous')?.addEventListener('click', () => stepFocus(-1));
      panel.querySelector<HTMLButtonElement>('.resource-focus-next')?.addEventListener('click', () => stepFocus(1));
      panel.addEventListener('pointerdown', (event) => {
        swipeStartX = event.clientX;
        swipeStartY = event.clientY;
        panel.dataset.swiped = 'false';
      });
      panel.addEventListener('pointerup', (event) => {
        const deltaX = event.clientX - swipeStartX;
        const deltaY = event.clientY - swipeStartY;
        if (Math.abs(deltaX) < 54 || Math.abs(deltaX) < Math.abs(deltaY) * 1.25) return;
        panel.dataset.swiped = 'true';
        stepFocus(deltaX < 0 ? 1 : -1);
      });
      panel.querySelector<HTMLAnchorElement>('.resource-focus-card')?.addEventListener('click', (event) => {
        if (panel.dataset.swiped !== 'true') return;
        event.preventDefault();
        panel.dataset.swiped = 'false';
      });
    });

    focusLayer?.addEventListener('click', (event) => {
      if (event.target === focusLayer) closeFocus();
    });

    explorer.addEventListener('resource:select-kind', (event) => {
      if (!(event instanceof CustomEvent) || typeof event.detail !== 'string') return;
      selectTopic(event.detail);
    });
    explorer.addEventListener('resource:close-focus', closeFocus);
    window.addEventListener('keydown', (event) => {
      if (!activePanel) return;
      if (event.key === 'Escape') closeFocus();
      if (event.key === 'ArrowLeft') stepFocus(-1);
      if (event.key === 'ArrowRight') stepFocus(1);
    });

    mobileQuery.addEventListener('change', syncResponsiveMode);
    new ResizeObserver(() => { if (!mobileQuery.matches) renderNetwork(); }).observe(network as Element);
    renderNetwork();
    syncResponsiveMode();
  }
</script>

