---
import catalog from '../../data/resource-catalog.json';

interface ResourceEntry {
  kind: 'art' | 'news';
  title: string;
  date: string;
  dateLabel: string;
  folderLabel: string;
  href: string;
  zhHref: string;
  image: string;
}

interface MonthGroup {
  key: string;
  label: string;
  year: string;
  entries: ResourceEntry[];
}

const entries = catalog as ResourceEntry[];

const groupByMonth = (items: ResourceEntry[]): MonthGroup[] => {
  const groups = new Map<string, ResourceEntry[]>();
  for (const item of items) {
    const key = item.date.slice(0, 7);
    groups.set(key, [...(groups.get(key) ?? []), item]);
  }

  return [...groups.entries()].map(([key, monthEntries]) => {
    const date = new Date(`${key}-01T12:00:00`);
    return {
      key,
      label: date.toLocaleDateString('en-CA', { month: 'long' }),
      year: key.slice(0, 4),
      entries: monthEntries,
    };
  });
};

const collections = [
  {
    id: 'art',
    eyebrow: 'Observation practice',
    title: 'Art',
    deck: 'One work each day, read closely through composition, material, and attention.',
    entries: entries.filter((item) => item.kind === 'art'),
  },
  {
    id: 'news',
    eyebrow: 'Sourced daily brief',
    title: 'News',
    deck: 'Markets, technology, and second-order effects, filed with sources and a clear date.',
    entries: entries.filter((item) => item.kind === 'news'),
  },
] as const;
---

<section class="resources-page" aria-labelledby="resources-title">
  <span class="resources-ink resources-ink-top" aria-hidden="true"></span>
  <span class="resources-ink resources-ink-bottom" aria-hidden="true"></span>

  <header class="resources-intro">
    <div>
      <p class="resources-kicker">Telotia field notes</p>
      <h1 id="resources-title">Filed by time.</h1>
    </div>
    <div class="resources-intro-copy">
      <p>Art appreciations and sourced news briefings from the Telotia studio.</p>
      <nav aria-label="Resource collections">
        <a href="#art"><span>{String(collections[0].entries.length).padStart(2, '0')}</span> Art</a>
        <a href="#news"><span>{String(collections[1].entries.length).padStart(2, '0')}</span> News</a>
      </nav>
    </div>
  </header>

  {collections.map((collection, collectionIndex) => {
    const [featured, ...archive] = collection.entries;
    const months = groupByMonth(archive);

    return (
      <section id={collection.id} class:list={['resource-collection', `resource-collection-${collection.id}`]} aria-labelledby={`${collection.id}-title`}>
        <header class="collection-heading">
          <div>
            <p class="resources-kicker">{collection.eyebrow}</p>
            <h2 id={`${collection.id}-title`}>{collection.title}</h2>
          </div>
          <p>{collection.deck}</p>
        </header>

        {featured && (
          <article class="resource-feature">
            <a class="resource-feature-image" href={featured.href} aria-label={`Read ${featured.title}`}>
              <img src={featured.image} alt="" />
            </a>
            <div class="resource-feature-copy">
              <div class="resource-feature-meta">
                <span>Latest entry</span>
                <time datetime={featured.date}>{featured.dateLabel}</time>
              </div>
              <p class="resource-path"><span aria-hidden="true">⌞</span>{featured.folderLabel}</p>
              <h3><a href={featured.href}>{featured.title}</a></h3>
              <div class="resource-languages" aria-label="Available languages">
                <a href={featured.href}>Read in English</a>
                <a href={featured.zhHref} lang="zh">中文</a>
              </div>
            </div>
          </article>
        )}

        <div class="resource-archive" aria-label={`${collection.title} archive`}>
          {months.map((month) => (
            <details class="month-group">
              <summary class="month-heading">
                <p>{month.year}</p>
                <h3 id={`${collection.id}-${month.key}`}>{month.label}</h3>
                <span class="month-count">{month.entries.length} {month.entries.length === 1 ? 'entry' : 'entries'}</span>
                <span class="month-toggle" aria-hidden="true"></span>
              </summary>
              <div class="month-entries">
                {month.entries.map((item) => (
                  <article class="resource-row">
                    <time datetime={item.date}>
                      <span>{item.date.slice(8, 10)}</span>
                      {new Date(`${item.date}T12:00:00`).toLocaleDateString('en-CA', { weekday: 'short' })}
                    </time>
                    <div class="resource-row-copy">
                      <p class="resource-path">{item.folderLabel}</p>
                      <h4><a href={item.href}>{item.title}</a></h4>
                    </div>
                    <div class="resource-row-links">
                      <a href={item.href} aria-label={`Read ${item.title} in English`}>EN</a>
                      <a href={item.zhHref} lang="zh" aria-label={`Read ${item.title} in Chinese`}>中</a>
                    </div>
                  </article>
                ))}
              </div>
            </details>
          ))}
        </div>

        {collectionIndex === 0 && <a class="next-collection" href="#news">Continue to News <span aria-hidden="true">↓</span></a>}
      </section>
    );
  })}

</section>

<div class="resource-reader" role="dialog" aria-modal="true" aria-labelledby="resource-reader-title" hidden>
  <article class="resource-reader-card">
    <header class="resource-reader-bar">
      <div class="resource-reader-identity">
        <p id="resource-reader-date"></p>
        <h2 id="resource-reader-title">Resource reader</h2>
      </div>
      <nav class="resource-reader-navigation" aria-label="Article navigation">
        <button class="resource-reader-step resource-reader-older" type="button" aria-label="Read the older entry">
          <span aria-hidden="true">←</span> Older
        </button>
        <button class="resource-reader-step resource-reader-newer" type="button" aria-label="Read the newer entry">
          Newer <span aria-hidden="true">→</span>
        </button>
        <a class="resource-reader-direct" href="/resource.html">Open page</a>
        <button class="resource-reader-close" type="button" aria-label="Close reader">×</button>
      </nav>
    </header>
    <iframe class="resource-reader-frame" title="Resource article"></iframe>
  </article>
</div>

<script>
  const monthGroups = document.querySelectorAll<HTMLDetailsElement>('.month-group');

  monthGroups.forEach((group) => {
    group.addEventListener('toggle', () => {
      if (!group.open) return;

      const heading = group.querySelector<HTMLElement>('.month-heading');
      if (!heading) return;

      // Expanding a month near the footer can make the browser preserve the
      // bottom scroll anchor and land on the oldest entry. Re-anchor to the
      // month heading after the expanded layout has settled so the newest
      // entry remains the first record in view.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          const offset = 88;
          const top = window.scrollY + heading.getBoundingClientRect().top - offset;
          window.scrollTo({
            top: Math.max(0, top),
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        });
      });
    });
  });

  interface ReaderEntry {
    kind: string;
    title: string;
    date: string;
    href: string;
    zhHref: string;
  }

  const reader = document.querySelector<HTMLElement>('.resource-reader');
  const readerFrame = reader?.querySelector<HTMLIFrameElement>('.resource-reader-frame');
  const readerTitle = reader?.querySelector<HTMLElement>('#resource-reader-title');
  const readerDate = reader?.querySelector<HTMLElement>('#resource-reader-date');
  const readerDirect = reader?.querySelector<HTMLAnchorElement>('.resource-reader-direct');
  const readerOlder = reader?.querySelector<HTMLButtonElement>('.resource-reader-older');
  const readerNewer = reader?.querySelector<HTMLButtonElement>('.resource-reader-newer');
  const readerClose = reader?.querySelector<HTMLButtonElement>('.resource-reader-close');

  const readerEntries = [...document.querySelectorAll<HTMLElement>('.resource-feature, .resource-row')]
    .map((article): ReaderEntry | null => {
      const titleLink = article.querySelector<HTMLAnchorElement>('h3 a, h4 a');
      const chineseLink = article.querySelector<HTMLAnchorElement>('.resource-languages a[lang="zh"], .resource-row-links a[lang="zh"]');
      const date = article.querySelector<HTMLTimeElement>('time')?.dateTime;
      const collection = article.closest<HTMLElement>('.resource-collection');
      if (!titleLink || !chineseLink || !date || !collection?.id) return null;
      return {
        kind: collection.id,
        title: titleLink.textContent?.trim() ?? 'Resource article',
        date,
        href: titleLink.href,
        zhHref: chineseLink.href,
      };
    })
    .filter((entry): entry is ReaderEntry => Boolean(entry));

  let activeReaderEntry: ReaderEntry | null = null;
  let activeReaderLanguage: 'en' | 'zh' = 'en';
  let readerReturnFocus: HTMLElement | null = null;

  const entriesForActiveKind = () => readerEntries.filter((entry) => entry.kind === activeReaderEntry?.kind);

  const showReaderEntry = (entry: ReaderEntry, language: 'en' | 'zh' = activeReaderLanguage) => {
    if (!reader || !readerFrame || !readerTitle || !readerDate || !readerDirect) return;
    activeReaderEntry = entry;
    activeReaderLanguage = language;
    const href = language === 'zh' ? entry.zhHref : entry.href;
    readerTitle.textContent = entry.title;
    readerDate.textContent = `${entry.kind} · ${entry.date.replaceAll('-', ' / ')}`;
    readerFrame.src = href;
    readerFrame.title = entry.title;
    readerDirect.href = href;

    const siblings = entriesForActiveKind();
    const index = siblings.indexOf(entry);
    if (readerOlder) readerOlder.disabled = index >= siblings.length - 1;
    if (readerNewer) readerNewer.disabled = index <= 0;
    if (reader.hidden) {
      readerReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      reader.hidden = false;
      document.documentElement.classList.add('resource-reader-open');
      readerClose?.focus();
    }
  };

  const closeReader = () => {
    if (!reader || reader.hidden) return;
    reader.hidden = true;
    document.documentElement.classList.remove('resource-reader-open');
    if (readerFrame) readerFrame.src = 'about:blank';
    activeReaderEntry = null;
    readerReturnFocus?.focus();
    readerReturnFocus = null;
  };

  const stepReader = (direction: 'older' | 'newer') => {
    if (!activeReaderEntry) return;
    const siblings = entriesForActiveKind();
    const index = siblings.indexOf(activeReaderEntry);
    const nextIndex = direction === 'older' ? index + 1 : index - 1;
    const nextEntry = siblings[nextIndex];
    if (nextEntry) showReaderEntry(nextEntry);
  };

  document.querySelectorAll<HTMLAnchorElement>('.resource-feature a[href*="/resource/"], .resource-row a[href*="/resource/"]')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const article = link.closest<HTMLElement>('.resource-feature, .resource-row');
        const date = article?.querySelector<HTMLTimeElement>('time')?.dateTime;
        const kind = article?.closest<HTMLElement>('.resource-collection')?.id;
        const entry = readerEntries.find((candidate) => candidate.date === date && candidate.kind === kind);
        if (!entry) return;
        event.preventDefault();
        showReaderEntry(entry, link.lang === 'zh' || link.href.includes('/zh/') ? 'zh' : 'en');
      });
    });

  readerOlder?.addEventListener('click', () => stepReader('older'));
  readerNewer?.addEventListener('click', () => stepReader('newer'));
  readerClose?.addEventListener('click', closeReader);
  reader?.addEventListener('click', (event) => {
    if (event.target === reader) closeReader();
  });

  const bindReaderSwipe = () => {
    const frameDocument = readerFrame?.contentDocument;
    if (!frameDocument) return;
    let startX = 0;
    let startY = 0;
    frameDocument.addEventListener('touchstart', (event) => {
      const touch = event.changedTouches[0];
      startX = touch.clientX;
      startY = touch.clientY;
    }, { passive: true });
    frameDocument.addEventListener('touchend', (event) => {
      const touch = event.changedTouches[0];
      const deltaX = touch.clientX - startX;
      const deltaY = touch.clientY - startY;
      if (Math.abs(deltaX) < 64 || Math.abs(deltaX) < Math.abs(deltaY) * 1.25) return;
      stepReader(deltaX < 0 ? 'newer' : 'older');
    }, { passive: true });
  };

  readerFrame?.addEventListener('load', bindReaderSwipe);
  window.addEventListener('keydown', (event) => {
    if (!reader || reader.hidden) return;
    if (event.key === 'Escape') closeReader();
    if (event.key === 'ArrowLeft') stepReader('older');
    if (event.key === 'ArrowRight') stepReader('newer');
  });
</script>

<style>
  .resources-page{position:relative;isolation:isolate;width:100%;overflow:hidden;padding:clamp(76px,8vw,118px) 64px clamp(92px,10vw,148px)}
  .resources-page>*:not(.resources-ink){position:relative;z-index:1}
  .resources-ink{position:absolute;z-index:0;display:block;pointer-events:none;background-repeat:no-repeat;background-size:contain;mix-blend-mode:multiply}
  .resources-ink-top{width:clamp(360px,46vw,720px);height:clamp(230px,31vw,460px);top:20px;right:clamp(-230px,-11vw,-78px);background-image:url('/assets/ink-wash/05-bamboo-right.webp');background-position:right top;opacity:.16;filter:grayscale(.18) contrast(1.18)}
  .resources-ink-bottom{width:clamp(440px,56vw,860px);height:clamp(190px,24vw,350px);left:clamp(-270px,-13vw,-108px);bottom:18px;background-image:url('/assets/ink-wash/08-water-left.webp');background-position:left bottom;opacity:.12;filter:saturate(.6) contrast(1.16)}
  .resources-intro,.resource-collection{width:min(1180px,100%);margin-inline:auto}
  .resources-kicker,.resource-feature-meta,.resource-path,.month-heading p,.month-heading span,.resource-row time,.resource-row-links{font-family:var(--fmono);text-transform:uppercase;letter-spacing:.14em}
  .resources-kicker{color:var(--teal);font-size:10.5px;font-weight:500}
  .resources-intro{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(310px,.62fr);align-items:end;gap:clamp(38px,8vw,118px);padding-bottom:clamp(62px,8vw,102px)}
  .resources-intro h1{max-width:780px;margin-top:14px;color:var(--t1);font-size:clamp(64px,9vw,122px);line-height:.84}
  .resources-intro-copy{padding:0 0 8px 24px;border-left:1px solid rgba(193,59,51,.44)}
  .resources-intro-copy>p{max-width:430px;color:var(--t2);font-size:clamp(17px,1.5vw,21px);line-height:1.55}
  .resources-intro nav{display:flex;gap:10px;margin-top:26px}
  .resources-intro nav a{display:inline-flex;align-items:center;gap:10px;padding:8px 12px;border:1px solid rgba(23,32,29,.24);border-radius:999px;color:var(--t2);font-family:var(--fmono);font-size:10px;letter-spacing:.08em;text-decoration:none;transition:border-color .2s var(--ease),background .2s var(--ease)}
  .resources-intro nav a:hover{border-color:rgba(42,85,165,.55);background:rgba(248,247,242,.62)}
  .resources-intro nav span{color:var(--gold2)}
  .resource-collection{scroll-margin-top:92px;padding-top:38px;border-top:1px solid rgba(23,32,29,.28)}
  .resource-collection+.resource-collection{margin-top:clamp(104px,13vw,172px)}
  .collection-heading{display:grid;grid-template-columns:minmax(260px,.82fr) minmax(300px,.72fr);align-items:end;justify-content:space-between;gap:50px;padding-bottom:30px}
  .collection-heading h2{margin-top:8px;color:var(--t1);font-size:clamp(42px,6vw,72px);line-height:.95}
  .collection-heading>p{justify-self:end;max-width:460px;color:var(--t3);font-size:15px;line-height:1.62}
  .resource-feature{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(340px,.72fr);min-height:clamp(420px,43vw,560px);overflow:hidden;border:1px solid rgba(23,32,29,.22);border-radius:18px;background:rgba(248,247,242,.82);box-shadow:0 28px 66px -50px rgba(23,32,29,.62),inset 0 1px rgba(255,255,255,.74)}
  .resource-feature-image{display:block;overflow:hidden;background:var(--surface-selected)}
  .resource-feature-image img{display:block;width:100%;height:100%;object-fit:cover;filter:saturate(.78) contrast(1.04);transition:transform 1.05s var(--ease),filter .4s var(--ease)}
  .resource-feature-image:hover img{transform:scale(1.018);filter:saturate(.94) contrast(1.06)}
  .resource-collection-news .resource-feature-image img{object-position:center top}
  .resource-feature-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(34px,5vw,68px);background:radial-gradient(circle at 100% 0,rgba(227,163,44,.1),transparent 34%),linear-gradient(145deg,rgba(248,247,242,.97),rgba(238,235,226,.94))}
  .resource-feature-meta{display:flex;justify-content:space-between;gap:16px;color:var(--t4);font-size:9px}
  .resource-feature-meta span{color:var(--vermilion)}
  .resource-path{overflow-wrap:anywhere;color:var(--t4);font-size:9px;line-height:1.5;text-transform:none;letter-spacing:.055em}
  .resource-feature-copy>.resource-path{margin-top:58px}
  .resource-feature-copy>.resource-path span{margin-right:8px;color:var(--gold2)}
  .resource-feature h3{margin-top:15px;color:var(--t1);font-family:var(--fdisplay);font-size:clamp(28px,3vw,44px);font-weight:500;line-height:1.08}
  .resource-feature h3 a,.resource-row h4 a{color:inherit;text-decoration:none}
  .resource-feature h3 a:hover,.resource-row h4 a:hover{color:var(--teal)}
  .resource-languages{display:flex;gap:20px;margin-top:42px}
  .resource-languages a{color:var(--t2);font-family:var(--fmono);font-size:10.5px;letter-spacing:.04em;text-decoration:none;border-bottom:1px solid rgba(23,32,29,.28);padding-bottom:4px}
  .resource-languages a:hover{color:var(--teal);border-color:var(--teal)}
  .resource-archive{margin-top:clamp(54px,7vw,86px)}
  .month-group{overflow-anchor:none;border-top:1px solid rgba(23,32,29,.24)}
  .month-group:last-child{border-bottom:1px solid rgba(23,32,29,.24)}
  .month-heading{display:grid;grid-template-columns:160px minmax(0,1fr) auto 30px;align-items:baseline;gap:clamp(26px,5vw,74px);padding:25px 0;cursor:pointer;list-style:none}
  .month-heading::-webkit-details-marker{display:none}
  .month-heading p,.month-heading span{color:var(--t4);font-size:9px}
  .month-heading h3{color:var(--t1);font-family:var(--fdisplay);font-size:29px;font-weight:500}
  .month-count{justify-self:end}
  .month-toggle{position:relative;align-self:center;width:28px;height:28px;border:1px solid rgba(23,32,29,.23);border-radius:50%;transition:transform .25s var(--ease),border-color .2s var(--ease)}
  .month-toggle::before,.month-toggle::after{content:"";position:absolute;left:50%;top:50%;width:10px;height:1px;background:var(--t3);transform:translate(-50%,-50%)}
  .month-toggle::after{transform:translate(-50%,-50%) rotate(90deg)}
  .month-heading:hover .month-toggle{border-color:rgba(42,85,165,.55)}
  .month-group[open] .month-toggle{transform:rotate(45deg)}
  .month-entries{min-width:0;margin-left:calc(160px + clamp(26px,5vw,74px))}
  .month-group:not([open])>.month-entries{display:none}
  .resource-row{display:grid;grid-template-columns:60px minmax(0,1fr) auto;gap:22px;align-items:center;min-height:128px;padding:23px 0;border-bottom:1px solid rgba(23,32,29,.17)}
  .resource-row time{color:var(--t4);font-size:9px;text-align:center}
  .resource-row time span{display:block;margin-bottom:4px;color:var(--t1);font-family:var(--fdisplay);font-size:32px;line-height:.9;letter-spacing:0}
  .resource-row-copy{min-width:0}
  .resource-row h4{max-width:720px;margin-top:7px;color:var(--t1);font-family:var(--fdisplay);font-size:clamp(20px,2.1vw,27px);font-weight:500;line-height:1.15}
  .resource-row-links{display:flex;gap:7px;font-size:9px;letter-spacing:.08em}
  .resource-row-links a{display:grid;place-items:center;min-width:34px;height:30px;border:1px solid rgba(23,32,29,.22);border-radius:999px;color:var(--t3);text-decoration:none;transition:color .2s var(--ease),border-color .2s var(--ease),background .2s var(--ease)}
  .resource-row-links a:hover{color:var(--teal);border-color:rgba(42,85,165,.52);background:rgba(42,85,165,.05)}
  .next-collection{display:flex;align-items:center;justify-content:space-between;margin-top:54px;padding:19px 0;border-top:1px solid rgba(23,32,29,.28);border-bottom:1px solid rgba(23,32,29,.28);color:var(--t2);font-family:var(--fmono);font-size:11px;letter-spacing:.08em;text-decoration:none}
  .next-collection span{color:var(--gold2);font-size:18px;transition:transform .2s var(--ease)}
  .next-collection:hover span{transform:translateY(3px)}
  :global(html.resource-reader-open){overflow:hidden}
  .resource-reader{position:fixed;z-index:1000;inset:0;display:grid;place-items:center;padding:14px;background:rgba(15,23,25,.34);backdrop-filter:blur(9px);color:var(--t1);cursor:zoom-out}
  .resource-reader[hidden]{display:none}
  .resource-reader-card{display:grid;grid-template-rows:auto minmax(0,1fr);width:calc(100vw - clamp(24px,5vw,96px));height:calc(100vh - clamp(24px,5vw,96px));overflow:hidden;border:1px solid rgba(23,32,29,.34);border-radius:18px;background:#f8f7f2;box-shadow:0 32px 90px rgba(11,18,20,.28);cursor:default}
  .resource-reader-bar{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:68px;padding:10px 12px 10px 22px;border-bottom:1px solid rgba(23,32,29,.2);background:linear-gradient(90deg,#f8f7f2,rgba(232,231,227,.92))}
  .resource-reader-identity{min-width:0}
  .resource-reader-identity p{color:var(--gold2);font-family:var(--fmono);font-size:8.5px;letter-spacing:.12em;text-transform:uppercase}
  .resource-reader-identity h2{overflow:hidden;margin-top:4px;color:var(--t1);font-family:var(--fdisplay);font-size:18px;font-weight:500;line-height:1.1;text-overflow:ellipsis;white-space:nowrap}
  .resource-reader-navigation{display:flex;align-items:center;gap:7px;flex:0 0 auto}
  .resource-reader-step,.resource-reader-close,.resource-reader-direct{display:inline-flex;align-items:center;justify-content:center;min-height:36px;border:1px solid rgba(23,32,29,.2);border-radius:999px;background:rgba(255,255,255,.55);color:var(--t2);font-family:var(--fmono);font-size:9px;letter-spacing:.04em;text-decoration:none;transition:border-color .2s var(--ease),background .2s var(--ease),color .2s var(--ease)}
  .resource-reader-step{gap:7px;padding:0 13px}
  .resource-reader-direct{padding:0 14px}
  .resource-reader-close{width:36px;padding:0;font-family:var(--fbody);font-size:20px}
  .resource-reader-step:hover:not(:disabled),.resource-reader-close:hover,.resource-reader-direct:hover{border-color:rgba(42,85,165,.55);background:#fff;color:var(--teal)}
  .resource-reader-step:disabled{opacity:.34;cursor:not-allowed}
