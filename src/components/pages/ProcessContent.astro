---
import ParticleLifecyclePanel from '../interactive/ParticleLifecyclePanel.astro';
---

<section id="process" style="position:relative;padding:96px 64px;background:transparent;border-top:1px solid var(--rulesoft)">
    <div style="max-width:1180px;margin:0 auto">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:48px">
        <div>
          <span style="font-family:var(--fmono);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--teal)">How it works</span>
          <h2 style="font-weight:700;font-size:42px;line-height:1.08;letter-spacing:-.02em;margin-top:12px;color:var(--t1)">Decompose. Search. Grade.</h2>
        </div>
        <p style="font-size:18px;line-height:1.55;color:var(--t2);max-width:420px">From product documentation to reviewable proof, every claim is separated, searched, graded, and linked back to source evidence.</p>
      </div>

      <div class="process-window" style="display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:48px;background:var(--rulesoft);border:1px solid var(--rulesoft);border-radius:16px;overflow:hidden">
        <article style="background:var(--surface-paper);padding:30px">
          <svg viewBox="0 0 300 180" style="width:100%;height:auto;display:block">
            <rect x="34" y="34" width="86" height="112" rx="2" fill="none" stroke="var(--t3)" stroke-width="1"/>
            <line x1="50" y1="60" x2="104" y2="60" stroke="var(--t4)" stroke-width="1"/><line x1="50" y1="80" x2="104" y2="80" stroke="var(--t4)" stroke-width="1"/><line x1="50" y1="100" x2="104" y2="100" stroke="var(--t4)" stroke-width="1"/><line x1="50" y1="120" x2="86" y2="120" stroke="var(--t4)" stroke-width="1"/>
            <line x1="120" y1="70" x2="208" y2="48" stroke="var(--teal2)" stroke-width="1" stroke-dasharray="4 5" style="animation:dashFlow 1.6s linear infinite"/><line x1="120" y1="90" x2="226" y2="88" stroke="var(--teal2)" stroke-width="1" stroke-dasharray="4 5" style="animation:dashFlow 1.6s linear infinite;animation-delay:-.5s"/><line x1="120" y1="110" x2="208" y2="132" stroke="var(--teal2)" stroke-width="1" stroke-dasharray="4 5" style="animation:dashFlow 1.6s linear infinite;animation-delay:-1s"/>
            <circle cx="214" cy="48" r="4" fill="var(--sand)" style="animation:pulseO 2.4s ease-in-out infinite"/><circle cx="232" cy="88" r="4" fill="var(--teal)" style="animation:pulseO 2.4s ease-in-out infinite;animation-delay:-.4s"/><circle cx="214" cy="132" r="4" fill="var(--sand)" style="animation:pulseO 2.4s ease-in-out infinite;animation-delay:-.8s"/>
            <circle cx="248" cy="62" r="3" fill="var(--teal)" style="animation:pulseO 2.4s ease-in-out infinite;animation-delay:-1.2s"/><circle cx="252" cy="112" r="3" fill="var(--sand)" style="animation:pulseO 2.4s ease-in-out infinite;animation-delay:-1.6s"/>
          </svg>
          <span style="font-family:var(--fmono);font-size:11px;letter-spacing:.14em;color:var(--gold);text-transform:uppercase">Step 01</span>
          <h3 style="font-weight:600;font-size:23px;margin-top:10px;color:var(--t1)">Decompose</h3>
          <p style="font-size:15px;line-height:1.6;color:var(--t2);margin-top:10px">Telotia breaks the document into atomic claims, down to the level where each one can be checked on its own. Not paragraphs. Individual propositions, each independently verifiable.</p>
        </article>
        <article style="background:var(--surface-paper);padding:30px">
          <svg viewBox="0 0 300 180" style="width:100%;height:auto;display:block">
            <circle cx="150" cy="90" r="56" fill="none" stroke="var(--teal)" stroke-width="1"/>
            <circle cx="150" cy="90" r="30" fill="rgba(22,133,169,.14)" stroke="var(--teal2)" stroke-width="1"/>
            <g class="figspin" style="animation:spinSlow 52s linear infinite">
              <g stroke-width="1" opacity=".7">
                <line x1="150" y1="90" x2="226" y2="62" stroke="var(--sand)"/><line x1="150" y1="90" x2="232" y2="108" stroke="var(--sand)"/><line x1="150" y1="90" x2="92" y2="44" stroke="var(--sand)"/><line x1="150" y1="90" x2="74" y2="104" stroke="var(--sand)"/><line x1="150" y1="90" x2="148" y2="160" stroke="var(--sand)"/>
              </g>
              <circle cx="226" cy="62" r="3.5" fill="var(--sand)"/><circle cx="232" cy="108" r="3.5" fill="var(--teal)"/><circle cx="92" cy="44" r="3.5" fill="var(--teal)"/><circle cx="74" cy="104" r="3.5" fill="var(--sand)"/><circle cx="148" cy="160" r="3.5" fill="var(--teal)"/>
            </g>
          </svg>
          <span style="font-family:var(--fmono);font-size:11px;letter-spacing:.14em;color:var(--gold);text-transform:uppercase">Step 02</span>
          <h3 style="font-weight:600;font-size:23px;margin-top:10px;color:var(--t1)">Search the evidence</h3>
          <p style="font-size:15px;line-height:1.6;color:var(--t2);margin-top:10px">Each claim is matched against your evidence base, the corpus you supplied, not the open web. The search is scoped to what you trust and can cite.</p>
        </article>
        <article style="background:var(--surface-paper);padding:30px">
          <svg viewBox="0 0 300 180" style="width:100%;height:auto;display:block">
            <circle cx="150" cy="90" r="64" fill="none" stroke="var(--rule)" stroke-width="1"/>
            <circle cx="150" cy="90" r="15" fill="none" stroke="var(--t3)" stroke-width="1"/>
            <g class="figspin" style="animation:spinRev 78s linear infinite">
              <line x1="150" y1="90" x2="150" y2="26" stroke="var(--teal)" stroke-width="1"/><line x1="150" y1="90" x2="205" y2="58" stroke="var(--teal)" stroke-width="1"/><line x1="150" y1="90" x2="205" y2="122" stroke="var(--teal)" stroke-width="1"/>
              <line x1="150" y1="90" x2="95" y2="122" stroke="var(--sand)" stroke-width="1" stroke-dasharray="4 4" style="animation:dashFlow 2s linear infinite"/><line x1="150" y1="90" x2="95" y2="58" stroke="var(--sand)" stroke-width="1" stroke-dasharray="4 4" style="animation:dashFlow 2s linear infinite;animation-delay:-.6s"/>
              <line x1="150" y1="90" x2="150" y2="154" stroke="var(--t4)" stroke-width="1" stroke-dasharray="2 5" opacity=".6"/>
              <circle cx="150" cy="26" r="6" fill="var(--teal)" style="animation:pulseO 2.6s ease-in-out infinite"/><circle cx="205" cy="58" r="6" fill="var(--teal)" style="animation:pulseO 2.6s ease-in-out infinite;animation-delay:-.5s"/><circle cx="205" cy="122" r="6" fill="var(--teal)" style="animation:pulseO 2.6s ease-in-out infinite;animation-delay:-1s"/>
              <circle cx="95" cy="122" r="6" fill="none" stroke="var(--sand)" stroke-width="1.4"/><circle cx="95" cy="58" r="6" fill="none" stroke="var(--sand)" stroke-width="1.4"/>
              <circle cx="150" cy="154" r="6" fill="none" stroke="var(--t4)" stroke-width="1.2"/>
            </g>
          </svg>
          <span style="font-family:var(--fmono);font-size:11px;letter-spacing:.14em;color:var(--gold);text-transform:uppercase">Step 03</span>
          <h3 style="font-weight:600;font-size:23px;margin-top:10px;color:var(--t1)">Grade and cite</h3>
          <p style="font-size:15px;line-height:1.6;color:var(--t2);margin-top:10px">Every claim gets a graded verdict: Supported, Partial, or Unsupported. Each linked to the exact source in your corpus. No aggregate scores, no summaries.</p>
        </article>
      </div>

      <ParticleLifecyclePanel />
    </div>
  </section>
