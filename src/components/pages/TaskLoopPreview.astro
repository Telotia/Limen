---
import { loopSteps } from '../../scripts/task-loop-model';
---
<!doctype html>
<html lang="en-CA">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" /><title>Task loop preview | Telotia</title>
  <meta name="description" content="A dev preview following one illustrative task from a pharmacy through professional support and back for review." />
  <link rel="preload" href="/assets/resource-intro/Inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="data:," />
</head>
<body>
  <a class="skip" href="#walkthrough">Skip to the written walkthrough</a>
  <header class="wrap"><a href="#top" aria-label="Telotia"><img class="logo" src="/assets/resource-intro/telotia-wordmark-temporary.png" width="210" height="68" alt="Telotia" /></a><p>Dev preview <span>·</span> Task loop</p></header>
  <main id="top">
    <div class="wrap introduction"><h1>One task.<br />A complete loop.</h1><p>From the originating pharmacy to professional support.<br class="wide" /> Then back to that same pharmacy for review.</p><a href="#task-story">Follow T-01 <span aria-hidden="true">↓</span></a></div>
    <section id="task-story" class="story wrap" aria-label="Follow task T-01">
      <div class="pin">
        <div class="caption"><h2 data-loop-title>One task, from Pharmacy A.</h2><p class="task-origin">T-01 · Pharmacy A</p></div>
        <ul class="particle-legend" aria-label="Particle colors">
          <li><span class="legend-swatch tracked" aria-hidden="true"></span>T-01 · Tracked task</li>
          <li><span class="legend-pair" aria-hidden="true"><span class="legend-swatch background-gray"></span><span class="legend-swatch background-cyan"></span></span>Other tasks</li>
        </ul>
        <div class="drawing"><canvas aria-hidden="true"></canvas></div>
        <div class="controls" aria-label="Animation controls">
          <button type="button" data-play disabled>Play</button>
          <input type="range" min="0" max="1000" value="0" step="1" data-scrub disabled aria-label="Journey progress" aria-valuetext="Origin: Pharmacy A" />
          <p class="hint" data-loop-hint>Plays once on entry</p>
        </div>
      </div>
    </section>
    <details class="wrap walkthrough" id="walkthrough"><summary>Read the journey</summary><p>Illustrative tasks and pharmacy labels.</p><ol>{loopSteps.map((step, index) => <li id={`step-${index}`}><h3>{step.title}</h3><p>{step.body}</p></li>)}</ol></details>
  </main>
  <footer class="wrap"><p>Telotia · Montréal</p><p>One task. Back to its origin.</p></footer>
  <script>import { mountTaskLoop } from '../../scripts/task-loop'; mountTaskLoop();</script>
</body>
</html>
<style is:global>
@font-face { font-family: Inter; src: url('/assets/resource-intro/Inter-latin-wght-normal.woff2') format('woff2'); font-weight: 100 900; font-display: swap; }
:root { --ink: #282D32; --muted: #617075; --teal: #00545A; --line: #DEE6E4; background: white; color: var(--ink); font: 400 16px/1.55 Inter, Arial, sans-serif; font-feature-settings: 'cv11' 1; scroll-behavior: smooth; }
* { box-sizing: border-box; } body { margin: 0; } button, input { font: inherit; } a { color: inherit; } ::selection { background: #EAF4F2; } :focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; } .wrap { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
header { display: flex; align-items: center; justify-content: space-between; padding-block: 24px; } .logo { display: block; object-fit: cover; } header p, footer, .hint { color: var(--muted); font-size: 13px; } header p span { margin-inline: 8px; } h1, h2, h3, p { margin-top: 0; } h1, h2, h3 { font-weight: 400; }
.introduction { padding-block: 64px 72px; display: grid; grid-template-columns: 1.1fr 1fr; column-gap: 64px; align-items: end; } h1 { font-size: clamp(48px, 6.6vw, 88px); line-height: 1.05; letter-spacing: -.04em; margin-bottom: 0; grid-row: span 2; } .introduction p { font-size: 22px; color: var(--muted); margin-bottom: 24px; } .introduction a { justify-self: start; text-underline-offset: 6px; min-height: 44px; color: var(--teal); } .introduction a span { padding-left: 16px; }
.story { border-top: 1px solid var(--line); } .pin { padding-block: 24px 20px; background: white; } .caption { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 74px; } .caption h2 { font-size: clamp(24px, 3vw, 40px); line-height: 1.15; letter-spacing: -.03em; margin: 0; } .task-origin { color: var(--teal); font-size: 12px; margin: 0; white-space: nowrap; }
.particle-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 24px; list-style: none; padding: 0; margin: 4px 0 12px; color: var(--muted); font-size: 12px; } .particle-legend li { display: flex; align-items: center; gap: 8px; } .legend-swatch { display: inline-block; width: 9px; height: 9px; border-radius: 2px; flex: none; } .tracked { background: #00545A; } .background-gray { background: #75817E; } .background-cyan { background: #9CBEBD; } .legend-pair { display: inline-flex; gap: 3px; }
.drawing { display: none; position: relative; flex: 1; min-height: 250px; } canvas { width: 100%; height: 100%; display: block; }
.controls { display: flex; gap: 24px; align-items: center; padding-block: 12px; } button { min-height: 44px; border: 1px solid var(--line); border-radius: 24px; background: white; color: var(--teal); padding: 8px 16px; min-width: 80px; cursor: pointer; transition: background 160ms ease; } button:hover { background: #EAF4F2; } button:disabled { opacity: .5; cursor: default; } input { flex: 1; width: 0; accent-color: var(--teal); min-height: 44px; cursor: pointer; } .hint { margin: 0; white-space: nowrap; font-size: 12px; }
.walkthrough { padding-block: 28px; border-top: 1px solid var(--line); } .walkthrough summary { cursor: pointer; color: var(--muted); min-height: 44px; } .walkthrough > p { margin-top: 20px; } .walkthrough p { color: var(--muted); } .walkthrough ol { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 64px; padding-left: 24px; margin-top: 40px; } .walkthrough h3 { font-size: 20px; margin-bottom: 8px; } .walkthrough li { padding-left: 8px; } footer { display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid var(--line); padding-block: 24px; } .skip { position: absolute; top: -100px; left: 20px; z-index: 4; background: white; padding: 12px; } .skip:focus { top: 12px; }
.task-loop-on .story { height: auto; } .task-loop-on .pin { position: relative; height: min(760px, 100svh); display: flex; flex-direction: column; } .task-loop-on .drawing { display: block; }
@media (max-width: 767px) { .wrap { width: calc(100% - 40px); } header { padding-block: 16px; } .logo { width: 150px; height: 49px; margin-left: -12px; } header p { font-size: 11px; max-width: 100px; text-align: right; } .introduction { display: block; padding-block: 40px; } h1 { margin-bottom: 28px; } .introduction p { font-size: 18px; } .wide { display: none; } .pin { padding-block: 16px 10px; } .caption { flex-direction: column; align-items: start; gap: 8px; min-height: 96px; justify-content: start; } .caption h2 { font-size: 25px; } .particle-legend { font-size: 11px; column-gap: 16px; } .drawing { min-height: 220px; } .controls { gap: 12px; padding-block: 8px; } button { font-size: 12px; } .hint { display: none; } .walkthrough ol { grid-template-columns: 1fr; gap: 20px; } footer { flex-direction: column; gap: 0; } }
@media (prefers-reduced-motion: reduce) { :root { scroll-behavior: auto; } .task-loop-on .story { height: auto; } .task-loop-on .pin { position: relative; height: auto; } .drawing { flex: none; height: 420px; } [data-play] { display: none; } button { transition: none; } }
@media (max-height: 650px) { .task-loop-on .story { height: auto; } .task-loop-on .pin { position: relative; height: auto; } .drawing { height: 360px; flex: none; } }
</style>
