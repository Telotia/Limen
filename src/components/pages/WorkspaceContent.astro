            <div style="font-family:var(--fmono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--t4);margin-top:26px;padding-top:18px;border-top:1px solid var(--rulesoft)">Audit trail</div>
            <div style="display:flex;flex-direction:column;gap:12px;margin-top:14px">
              <div style="display:flex;gap:12px"><span style="font-family:var(--fmono);font-size:11px;color:var(--t4);flex-shrink:0">09:42:11</span><span style="font-size:13px;color:var(--t2)"><strong style="color:var(--t1);font-weight:500">document</strong> · 18 atomic claims extracted</span></div>
              <div style="display:flex;gap:12px"><span style="font-family:var(--fmono);font-size:11px;color:var(--t4);flex-shrink:0">09:42:38</span><span style="font-size:13px;color:var(--t2)"><strong style="color:var(--t1);font-weight:500">corpus</strong> · 47 supplied files indexed</span></div>
              <div style="display:flex;gap:12px"><span style="font-family:var(--fmono);font-size:11px;color:var(--t4);flex-shrink:0">09:43:02</span><span style="font-size:13px;color:var(--t2)"><strong style="color:var(--gold);font-weight:500">review</strong> · claim-027 requires reviewer note</span></div>
              <div style="display:flex;gap:12px"><span style="font-family:var(--fmono);font-size:11px;color:var(--t4);flex-shrink:0">09:44:19</span><span style="font-size:13px;color:var(--t2)"><strong style="color:var(--t1);font-weight:500">source</strong> · page citation attached</span></div>
              <div style="display:flex;gap:12px"><span style="font-family:var(--fmono);font-size:11px;color:var(--t4);flex-shrink:0">09:45:06</span><span style="font-size:13px;color:var(--t2)"><strong style="color:var(--t1);font-weight:500">package</strong> · proof bundle draft ready</span></div>
            </div>
          </aside>
            </div>

            <div data-wpage="1" style="display:none;padding:22px 24px">
