            </div>

            <div data-wpage="2" style="display:none;padding:22px 24px">
              <div style="font-family:var(--fmono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--t4)">Verdict queue / run summary</div>
              <h3 style="font-weight:600;font-size:20px;color:var(--t1);margin-top:8px;max-width:620px">18 claims graded. Each links back to its source.</h3>
              <div style="margin-top:20px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px">
                <div style="border:1px solid var(--rule);border-radius:10px;padding:16px 18px;background:var(--surface-paper)">
                  <div style="display:flex;align-items:center;gap:8px"><span style="width:8px;height:8px;border-radius:50%;background:var(--teal)"></span><span style="font-family:var(--fmono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--t3)">Supported</span></div>
                  <div style="font-size:30px;font-weight:700;color:var(--t1);margin-top:8px">11</div>
                </div>
                <div style="border:1px solid var(--rule);border-radius:10px;padding:16px 18px;background:var(--surface-paper)">
                  <div style="display:flex;align-items:center;gap:8px"><span style="width:8px;height:8px;border-radius:50%;border:1.4px solid var(--gold)"></span><span style="font-family:var(--fmono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--t3)">Partial</span></div>
                  <div style="font-size:30px;font-weight:700;color:var(--t1);margin-top:8px">4</div>
