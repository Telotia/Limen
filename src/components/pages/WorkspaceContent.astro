---
import ClaimFlow from '../workspace/ClaimFlow.astro';
---

<section id="workspace" style="position:relative;padding:96px 64px;background:transparent;border-top:1px solid var(--rulesoft)">
    <div class="section-mark section-mark-right" style="position:absolute;right:34px;top:120px;writing-mode:vertical-rl;color:var(--t4)">齋</div>
    <div style="max-width:1180px;margin:0 auto">
      <span style="font-family:var(--fmono);font-size:11px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--teal)">Workspace</span>
      <h2 style="font-weight:700;font-size:42px;line-height:1.08;letter-spacing:-.02em;margin-top:12px;color:var(--t1);max-width:760px">Inspect each claim before sign-off.</h2>
      <p style="font-size:18px;line-height:1.55;color:var(--t2);max-width:660px;margin-top:14px">The interactive mockup shows the review surface as document work: claim graph, verdict queue, source passage, and audit trail.</p>

      <div id="tlWsShell" class="workspace-window glow-wrap" data-active-tab="0" style="position:relative;margin-top:40px;border:1px solid var(--t2);border-radius:10px;overflow:hidden;background:rgba(239,238,233,.92);box-shadow:0 2px 0 var(--rule),0 18px 44px -30px rgba(23,32,29,.42)">
        <div class="workspace-toolbar" style="display:flex;align-items:center;gap:18px;padding:14px 20px;border-bottom:1px solid var(--rulesoft);background:rgba(245,243,237,.72)">
          <span class="window-controls" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="workspace-product" style="font-family:var(--fmono);font-size:12px;letter-spacing:.14em;color:var(--t1)">TELOTIA REVIEW</span>
          <span class="workspace-run" style="font-family:var(--fmono);font-size:11px;color:var(--t4)">run_2026_05_25_import_package / canadian_health_equipment</span>
          <span class="workspace-spacer" style="flex:1"></span>
          <span class="human-review-status" style="display:inline-flex;align-items:center;gap:7px;font-family:var(--fmono);font-size:11px;color:var(--tealglow)"><span style="width:6px;height:6px;border-radius:50%;background:var(--tealglow);animation:pulseDot 1.2s var(--ease) infinite;flex:0 0 auto"></span>human review required</span>
        </div>
        <div class="workspace-art" aria-hidden="true"></div>
        <div class="workspace-window-body" style="display:grid;grid-template-columns:56px 1fr">
          <nav id="tlWsRail" style="display:flex;flex-direction:column;gap:8px;padding:16px 0;align-items:center;border-right:1px solid var(--rulesoft)">
            <button class="wrail" data-wpage="0" type="button" title="Document review" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:rgba(58,124,196,.16);border:1px solid var(--teal2);color:var(--teal);cursor:pointer"><svg viewBox="0 0 24 24" width="18" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M7 3.5h7l3 3v14H7z"/><path d="M14 3.5v4h4"/><path d="M9.5 12h5"/><path d="M9.5 15.5h5"/></svg></button>
            <button class="wrail" data-wpage="1" type="button" title="Evidence search" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:none;border:1px solid transparent;color:var(--t4);cursor:pointer"><svg viewBox="0 0 24 24" width="18" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="10.5" cy="10.5" r="4.5"/><path d="M14 14l5 5"/></svg></button>
            <button class="wrail" data-wpage="2" type="button" title="Verdict queue" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:none;border:1px solid transparent;color:var(--t4);cursor:pointer"><svg viewBox="0 0 24 24" width="18" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="7"/><path d="M8.7 12.2l2.2 2.2 4.6-5"/></svg></button>
            <button class="wrail" data-wpage="3" type="button" title="Proof package" style="width:40px;height:40px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:none;border:1px solid transparent;color:var(--t4);cursor:pointer"><svg viewBox="0 0 24 24" width="18" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4.5 8.5 12 4l7.5 4.5v7L12 20l-7.5-4.5z"/><path d="M12 13v7"/></svg></button>
          </nav>
          <div id="tlWsPages" style="position:relative;min-height:712px">
