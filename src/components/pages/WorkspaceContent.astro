                </div>
                <div class="crow" data-ws-row data-id="claim-041" data-note="Reads as a completeness claim over every external warning. Each outer carton must carry bilingual text." data-claim="The supplied corpus demonstrates bilingual labelling for all external warnings." data-verdict="Unsupported" data-passage="No supplied label image or packaging proof contains the French warning text for the outer carton." data-source="No cited passage" data-color="#C13B33" style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 16px;background:var(--surface-paper)">
                  <span style="display:block"><strong style="display:block;font-size:14px;color:var(--t1);font-weight:500">The supplied corpus demonstrates bilingual labelling for all external warnings.</strong><small style="font-family:var(--fmono);font-size:10px;color:var(--t4)">claim-041 / No cited passage</small></span>
                  <span style="flex-shrink:0;font-family:var(--fmono);font-size:11px;color:var(--t3);border:1px solid var(--rule);border-radius:3px;padding:3px 8px">Unsupported</span>
                </div>
              </div>
            </div>
          </div>
          <aside style="padding:22px 22px;background:rgba(245,243,237,.58)">
            <div style="font-family:var(--fmono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--t4)">Source passage</div>
            <h3 id="tlWsVerdict" style="font-weight:600;font-size:19px;color:var(--teal);margin-top:10px">Supported</h3>
            <p id="tlWsPassage" style="font-size:14px;line-height:1.6;color:var(--t2);margin-top:8px">Importer file IFU-22, page 4 lists model QX-180 and lot range A17–A19 with matching manufacturer references.</p>
