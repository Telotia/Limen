                  <span style="flex-shrink:0;font-family:var(--fmono);font-size:11px;color:var(--gold);border:1px solid var(--gold2);border-radius:3px;padding:3px 8px">Partial</span>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:13px 16px;background:var(--surface-paper)">
                  <span style="display:block"><strong style="display:block;font-size:14px;color:var(--t1);font-weight:500">The supplied corpus demonstrates bilingual labelling for all external warnings.</strong><small style="font-family:var(--fmono);font-size:10px;color:var(--t4)">claim-041 / No cited passage</small></span>
                  <span style="flex-shrink:0;font-family:var(--fmono);font-size:11px;color:var(--t3);border:1px solid var(--rule);border-radius:3px;padding:3px 8px">Unsupported</span>
