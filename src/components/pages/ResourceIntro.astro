---
import ComingSoon from '../ComingSoon.astro';

interface Props { isProd?: boolean; }
const { isProd = false } = Astro.props;

const words = {
  en: {
    title: 'Clearer coordination for pharmacy teams | Telotia',
    description: 'Telotia is developing a product to help pharmacies and pharmacists coordinate professional resources.',
    skip: 'Skip to content', nav: 'Main navigation', language: 'Language',
    purposeNav: 'Purpose', approachNav: 'Approach', contactNav: 'Contact',
    eyebrow: 'Purposeful innovation, starting with pharmacy',
    headline: 'Clearer coordination.\nMore room for care.',
    lead: 'Telotia is developing a product to help pharmacies and pharmacists coordinate professional resources.',
    primary: 'What we’re working on', secondary: 'Get in touch',
    contextLabel: 'Our starting point', context: 'Pharmacies.\nPharmacists.\nThe work around care.',
    purposeLabel: '01 / Purpose', purposeTitle: 'Coordination is work, too.',
    purposeBody: 'Professional support involves more than finding the right expertise. Communication, context and responsibility also need to be clear.',
    purposeAim: 'Our aim is to reduce the communication and operational burden around professional support.',
    approachLabel: '02 / Approach', approachTitle: 'Clear information.\nProfessional judgment.',
    pharmaciesTitle: 'For pharmacies', pharmaciesBody: 'A clearer way to coordinate the professional support their teams need.',
    pharmacistsTitle: 'For pharmacists', pharmacistsBody: 'Useful context and clear responsibility, with professional judgment staying in professional hands.',
    contactLabel: '03 / Conversation', contactTitle: 'Better coordination\nstarts with listening.',
    contactBody: 'We welcome conversations with people who understand the everyday work of pharmacy.',
    development: 'In development. The product direction and design concepts are still being tested.',
    footer: 'Telotia · Montréal', top: 'Back to top',
  },
  fr: {
    title: 'Une coordination plus claire en pharmacie | Telotia',
    description: 'Telotia développe un produit pour aider les pharmacies et les pharmaciens à coordonner les ressources professionnelles.',
    skip: 'Aller au contenu', nav: 'Navigation principale', language: 'Langue',
    purposeNav: 'Objectif', approachNav: 'Approche', contactNav: 'Contact',
    eyebrow: 'L’innovation avec un but, en commençant par la pharmacie',
    headline: 'Une coordination plus claire.\nPlus de place aux soins.',
    lead: 'Telotia développe un produit pour aider les pharmacies et les pharmaciens à coordonner les ressources professionnelles.',
    primary: 'Ce que nous préparons', secondary: 'Nous contacter',
    contextLabel: 'Notre point de départ', context: 'Les pharmacies.\nLes pharmaciens.\nLe travail autour des soins.',
    purposeLabel: '01 / Objectif', purposeTitle: 'Coordonner, c’est aussi du travail.',
    purposeBody: 'Le soutien professionnel ne se limite pas à trouver la bonne expertise. La communication, le contexte et les responsabilités doivent aussi être clairs.',
    purposeAim: 'Notre objectif est de réduire la charge de communication et d’organisation liée au soutien professionnel.',
    approachLabel: '02 / Approche', approachTitle: 'Une information claire.\nUn jugement professionnel.',
    pharmaciesTitle: 'Pour les pharmacies', pharmaciesBody: 'Une façon plus claire de coordonner le soutien professionnel dont leurs équipes ont besoin.',
    pharmacistsTitle: 'Pour les pharmaciens', pharmacistsBody: 'Un contexte utile et des responsabilités claires. Le jugement professionnel demeure entre les mains des professionnels.',
    contactLabel: '03 / Échange', contactTitle: 'Mieux coordonner\ncommence par écouter.',
    contactBody: 'Nous souhaitons échanger avec les personnes qui connaissent le travail quotidien en pharmacie.',
    development: 'En développement. L’orientation du produit et les concepts de design sont encore à l’essai.',
    footer: 'Telotia · Montréal', top: 'Retour en haut',
  },
};
const copy = words.en;
---

<!doctype html>
<html lang="en-CA" data-page={isProd ? 'production-teaser' : 'pharmacy-intro'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content={isProd ? 'Purposeful innovation, starting with pharmacy.' : copy.description} />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{isProd ? 'Telotia' : copy.title}</title>
    {!isProd && <link rel="preload" href="/assets/resource-intro/Inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="data:," />
  </head>
  <body id="top">
    {isProd ? <ComingSoon /> : (<>
    <a class="skip" href="#main" data-copy="skip">{copy.skip}</a>
    <header class="site-header wrap">
      <a class="brand" href="/resource" aria-label="Telotia">
        <img src="/assets/resource-intro/telotia-wordmark-temporary.png" alt="Telotia" width="210" height="68" />
      </a>
      <nav aria-label={copy.nav} data-nav>
        <a href="#purpose" data-copy="purposeNav">{copy.purposeNav}</a>
        <a href="#approach" data-copy="approachNav">{copy.approachNav}</a>
        <a href="#contact" data-copy="contactNav">{copy.contactNav}</a>
      </nav>
      <div class="language" role="group" aria-label={copy.language} data-language>
        <button type="button" data-lang="en" aria-pressed="true" aria-label="English">EN</button>
        <span aria-hidden="true">/</span>
        <button type="button" data-lang="fr" aria-pressed="false" aria-label="Français">FR</button>
      </div>
    </header>

    <main id="main" class="wrap">
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow" data-copy="eyebrow">{copy.eyebrow}</p>
        <h1 id="hero-title" data-copy="headline">{copy.headline}</h1>
        <div class="hero-bottom">
          <div>
            <p class="lead" data-copy="lead">{copy.lead}</p>
            <div class="hero-actions">
              <a class="button" href="#purpose" data-copy="primary">{copy.primary}</a>
              <a class="text-link" href="mailto:hello@telotia.com" data-copy="secondary">{copy.secondary}</a>
            </div>
          </div>
          <aside class="starting-point">
            <p class="label" data-copy="contextLabel">{copy.contextLabel}</p>
            <p data-copy="context">{copy.context}</p>
          </aside>
        </div>
      </section>

      <section class="purpose section" id="purpose" aria-labelledby="purpose-title">
        <div>
          <p class="label" data-copy="purposeLabel">{copy.purposeLabel}</p>
          <h2 id="purpose-title" data-copy="purposeTitle">{copy.purposeTitle}</h2>
        </div>
        <div class="section-copy">
          <p data-copy="purposeBody">{copy.purposeBody}</p>
          <p data-copy="purposeAim">{copy.purposeAim}</p>
        </div>
      </section>

      <section class="approach section" id="approach" aria-labelledby="approach-title">
        <div>
          <p class="label" data-copy="approachLabel">{copy.approachLabel}</p>
          <h2 id="approach-title" data-copy="approachTitle">{copy.approachTitle}</h2>
        </div>
        <div class="section-copy audiences">
          <div>
            <h3 data-copy="pharmaciesTitle">{copy.pharmaciesTitle}</h3>
            <p data-copy="pharmaciesBody">{copy.pharmaciesBody}</p>
          </div>
          <div>
            <h3 data-copy="pharmacistsTitle">{copy.pharmacistsTitle}</h3>
            <p data-copy="pharmacistsBody">{copy.pharmacistsBody}</p>
          </div>
        </div>
      </section>

      <section class="contact section" id="contact" aria-labelledby="contact-title">
        <div>
          <p class="label" data-copy="contactLabel">{copy.contactLabel}</p>
          <h2 id="contact-title" data-copy="contactTitle">{copy.contactTitle}</h2>
        </div>
        <div class="section-copy">
          <p data-copy="contactBody">{copy.contactBody}</p>
          <a class="email" href="mailto:hello@telotia.com">hello@telotia.com<span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer class="wrap site-footer">
      <p class="development" data-copy="development">{copy.development}</p>
      <div class="footer-line">
        <p data-copy="footer">{copy.footer}</p>
        <a href="#top" data-copy="top">{copy.top}</a>
      </div>
    </footer>

    <script is:inline define:vars={{ words }}>
      const languageButtons = document.querySelectorAll('[data-lang]');
      function setLanguage(language, updateAddress = true) {
        const chosen = language === 'fr' ? 'fr' : 'en';
        const text = words[chosen];
        document.documentElement.lang = chosen === 'fr' ? 'fr-CA' : 'en-CA';
        document.title = text.title;
        document.querySelector('meta[name="description"]').content = text.description;
        document.querySelector('[data-nav]').setAttribute('aria-label', text.nav);
        document.querySelector('[data-language]').setAttribute('aria-label', text.language);
        document.querySelectorAll('[data-copy]').forEach((element) => {
          element.textContent = text[element.dataset.copy];
        });
        languageButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.lang === chosen)));
        if (updateAddress) {
          const url = new URL(window.location.href);
          if (chosen === 'fr') url.searchParams.set('lang', 'fr');
          else url.searchParams.delete('lang');
          history.replaceState(null, '', url);
        }
      }
      languageButtons.forEach((button) => button.addEventListener('click', () => setLanguage(button.dataset.lang)));
      setLanguage(new URLSearchParams(location.search).get('lang'), false);
    </script>
    </>)}
  </body>
</html>

<style>
  @font-face {
    font-family: 'Inter';
    src: url('/assets/resource-intro/Inter-latin-wght-normal.woff2') format('woff2');
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
  }
  :global(html[data-page='pharmacy-intro']) {
    --bg: #FFFFFF;
    --text: #282D32;
    --text-secondary: #617075;
    --teal: #00545A;
    --border: #DEE6E4;
    background: var(--bg);
    scroll-padding-top: 32px;
  }
  :global(html[data-page='pharmacy-intro'] *) { box-sizing: border-box; }
  :global(html[data-page='pharmacy-intro'] body) {
    margin: 0;
    position: relative;
    isolation: isolate;
    background: var(--bg);
    color: var(--text);
    font: 400 16px/1.625 'Inter', Arial, sans-serif;
    font-feature-settings: 'cv11' 1;
    -webkit-font-smoothing: antialiased;
  }
  :global(html[data-page='production-teaser'] body) { margin: 0; }
  /* One material detail retained from the archive: a quiet xuan-paper fibre. */
  :global(html[data-page='pharmacy-intro'] body)::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/assets/ink-wash/textures/xuan-paper-generated.jpg') repeat;
    background-size: 680px 680px;
    opacity: .20;
    pointer-events: none;
  }
  :global(html[data-page='pharmacy-intro'] a) { color: inherit; }
  :global(html[data-page='pharmacy-intro'] :focus-visible) { outline: 2px solid var(--teal); outline-offset: 4px; }
  :global(html[data-page='pharmacy-intro'] ::selection) { background: #EAF4F2; color: var(--text); }
  .wrap { width: min(1200px, calc(100% - 96px)); margin-inline: auto; }
  .site-header { display: flex; align-items: center; gap: 40px; padding-block: 24px; }
  .brand { display: block; margin-left: -20px; flex: none; }
  .brand img { display: block; width: 210px; height: 68px; object-fit: cover; }
  nav { display: flex; margin-left: auto; gap: 32px; align-items: center; }
  nav a, .language button { font-size: 14px; font-weight: 500; text-decoration: none; }
  nav a { display: flex; align-items: center; min-height: 44px; }
  nav a:hover, .footer-line a:hover { color: var(--teal); }
  .language { display: flex; align-items: center; gap: 4px; font-size: 12px; color: var(--text-secondary); }
  .language button { font-family: inherit; color: var(--text-secondary); border: 0; padding: 8px; min-width: 36px; min-height: 44px; background: transparent; cursor: pointer; }
  .language button[aria-pressed='true'] { color: var(--text); text-decoration: underline; text-underline-offset: 5px; }
  .hero { padding-block: 92px 104px; }
  .eyebrow, .label { margin: 0 0 24px; font-size: 14px; line-height: 20px; font-weight: 500; color: var(--text-secondary); }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2, h3 { font-weight: 400; }
  h1 { white-space: pre-line; font-size: clamp(54px, 6.7vw, 88px); line-height: 1.08; letter-spacing: -.04em; margin-bottom: 48px; max-width: 1140px; }
  .hero-bottom { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 96px; align-items: end; }
  .lead { font-size: 20px; line-height: 1.55; color: var(--text-secondary); max-width: 630px; margin-bottom: 32px; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; }
  .button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; border-radius: 8px; padding: 12px 24px; background: var(--text); color: #FFFFFF; font-size: 14px; font-weight: 500; text-decoration: none; transition: background 150ms cubic-bezier(.4,0,.2,1); }
  .button:hover { background: var(--teal); }
  .text-link { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; color: var(--teal); text-decoration: underline; text-underline-offset: 4px; }
  .starting-point { padding-left: 32px; border-left: 1px solid var(--border); }
  .starting-point .label { margin-bottom: 16px; }
  .starting-point > p:last-child { white-space: pre-line; font-size: 18px; line-height: 1.7; margin: 0; }
  .section { display: grid; grid-template-columns: 1fr 1fr; gap: 96px; padding-block: 80px; border-top: 1px solid var(--border); scroll-margin-top: 32px; }
  h2 { font-size: 42px; line-height: 1.18; letter-spacing: -.025em; white-space: pre-line; margin-bottom: 0; max-width: 520px; }
  .section-copy { padding-top: 44px; }
  .section-copy p { color: var(--text-secondary); max-width: 560px; font-size: 18px; line-height: 1.65; margin-bottom: 24px; }
  .section-copy > p:last-child { margin-bottom: 0; }
  h3 { font-size: 22px; line-height: 1.4; letter-spacing: -.015em; margin-bottom: 12px; }
  .audiences { display: flex; flex-direction: column; gap: 32px; }
  .audiences p { margin-bottom: 0; }
  .email { display: inline-flex; align-items: center; gap: 24px; font-size: 24px; letter-spacing: -.015em; text-decoration: none; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .email span { color: var(--teal); }
  .site-footer { border-top: 1px solid var(--border); padding-block: 32px; color: var(--text-secondary); font-size: 12px; line-height: 1.5; }
  .development { margin-bottom: 32px; max-width: 680px; }
  .footer-line { display: flex; justify-content: space-between; gap: 24px; align-items: center; }
  .footer-line p { margin: 0; }
  .footer-line a { display: flex; align-items: center; min-height: 44px; text-underline-offset: 4px; }
  .skip { position: absolute; top: -80px; left: 20px; padding: 12px; background: #FFFFFF; z-index: 5; }
  .skip:focus { top: 16px; }
  @media (max-width: 1023px) {
    .wrap { width: calc(100% - 64px); }
    .site-header { gap: 24px; }
    nav { gap: 24px; }
    .hero { padding-block: 64px 80px; }
    .hero-bottom, .section { gap: 48px; }
    h2 { font-size: 36px; }
  }
  @media (max-width: 767px) {
    .wrap { width: calc(100% - 40px); }
    .site-header { flex-wrap: wrap; padding-block: 16px; gap: 8px; }
    .brand { margin-left: -16px; }
    .brand img { width: 190px; height: 62px; }
    .language { margin-left: auto; }
    nav { order: 3; width: 100%; margin: 0; gap: 28px; }
    .hero { padding-block: 56px 64px; }
    .eyebrow { max-width: 310px; margin-bottom: 24px; }
    h1 { font-size: clamp(42px, 8.5vw, 60px); letter-spacing: -.035em; line-height: 1.12; margin-bottom: 32px; }
    .hero-bottom { grid-template-columns: 1fr; gap: 48px; }
    .lead { font-size: 18px; }
    .starting-point { padding-left: 20px; }
    .starting-point > p:last-child { font-size: 16px; }
    .section { grid-template-columns: 1fr; gap: 24px; padding-block: 56px; }
    .section-copy { padding-top: 0; }
    .section-copy p { font-size: 16px; }
    h2 { font-size: 32px; line-height: 1.2; }
    h3 { font-size: 21px; }
    .section .label { margin-bottom: 16px; }
    .email { font-size: 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .button { transition: none; } }
</style>
