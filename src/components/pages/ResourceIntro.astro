---
import ComingSoon from '../ComingSoon.astro';
import CoordinationMotion from '../resource/CoordinationMotion.astro';
import { words, type ResourcePage } from '../../data/resource-company';
interface Props { isProd?: boolean; page?: ResourcePage; }
const { isProd = false, page = 'home' } = Astro.props;
const copy = words.en;
const routes: ResourcePage[] = ['home', 'approach'];
const route = (key: ResourcePage) => key === 'home' ? '/resource' : `/resource/${key}`;
---
<!doctype html>
<html lang="en-CA" data-page={isProd ? 'production-teaser' : 'pharmacy-intro'} data-section={page}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" /><meta name="description" content={isProd ? 'Purposeful innovation, starting with pharmacy.' : copy.description} />
  <meta name="theme-color" content="#FFFFFF" /><title>{isProd ? 'Telotia' : `${copy[`${page}Nav`]} | Telotia`}</title>
  {!isProd && <link rel="preload" href="/assets/resource-intro/Inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />}
  <link rel="icon" href="data:," />
</head>
<body>
{isProd ? <ComingSoon /> : (<>
  <a class="skip" href="#main" data-copy="skip">{copy.skip}</a>
  <header class="site-header wrap">
    <a class="brand" href="/resource" data-route aria-label="Telotia"><img src="/assets/resource-intro/telotia-wordmark-temporary.png" alt="Telotia" width="210" height="68" /></a>
    <nav aria-label={copy.nav} data-nav>{routes.map(key => <a href={route(key)} data-route aria-current={page === key ? 'page' : undefined} data-copy={`${key}Nav`}>{copy[`${key}Nav`]}</a>)}</nav>
    <div class="language" role="group" aria-label={copy.language} data-language><button type="button" data-lang="en" aria-pressed="true" aria-label="English">EN</button><span aria-hidden="true">/</span><button type="button" data-lang="fr" aria-pressed="false" aria-label="Français">FR</button></div>
  </header>
  <main id="main" class="wrap">
  {page === 'home' ? <>
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow" data-copy="eyebrow">{copy.eyebrow}</p>
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 id="hero-title" data-copy="headline">{copy.headline}</h1>
          <p class="lead" data-copy="lead">{copy.lead}</p>
          <div class="hero-actions"><a class="button" href="/resource/approach" data-route><span data-copy="primary">{copy.primary}</span><img src="/assets/resource-intro/morph/arrow-right.svg" alt="" width="22" height="22" /></a><a class="text-link" href="#contact" data-copy="secondary">{copy.secondary}</a></div>
        </div>
        <aside class="hero-aside"><CoordinationMotion /><p class="aside-note" data-copy="context">{copy.context}</p></aside>
      </div>
    </section>
  </> : <>
    <section class="inner-hero" aria-labelledby="page-title"><p class="eyebrow" data-copy="approachLabel">{copy.approachLabel}</p><h1 id="page-title" data-copy="approachTitle">{copy.approachTitle}</h1><p class="inner-lead" data-copy="companyIntro">{copy.companyIntro}</p></section>
    <section class="statement"><h2 data-copy="companyStatement">{copy.companyStatement}</h2><div><p data-copy="approachIntro">{copy.approachIntro}</p><p data-copy="companyBody">{copy.companyBody}</p></div></section>
    <div class="detail-grid"><section><h2 data-copy="pharmaciesTitle">{copy.pharmaciesTitle}</h2><p data-copy="pharmaciesBody">{copy.pharmaciesBody}</p></section><section><h2 data-copy="pharmacistsTitle">{copy.pharmacistsTitle}</h2><p data-copy="pharmacistsBody">{copy.pharmacistsBody}</p></section></div>
  </>}
  </main>
  <footer id="contact" class="wrap site-footer" aria-label={copy.contactFooter} data-contact-footer>
    <div class="footer-brand"><p>Telotia <span aria-hidden="true">·</span> Montréal</p><p data-copy="footer">{copy.footer}</p></div>
    <div class="footer-contact"><p class="footer-label" data-copy="secondary">{copy.secondary}</p><a href="mailto:hello@telotia.com">hello@telotia.com<img src="/assets/resource-intro/morph/arrow-right.svg" alt="" width="20" height="20" /></a></div>
  </footer>
  <script is:inline define:vars={{ words, page }}>
    function setLanguage(language, updateAddress = true) {
      const chosen = language === 'fr' ? 'fr' : 'en', text = words[chosen];
      document.documentElement.lang = chosen === 'fr' ? 'fr-CA' : 'en-CA';
      document.title = `${text[`${page}Nav`]} | Telotia`;
      document.querySelector('meta[name="description"]').content = text.description;
      document.querySelector('[data-nav]').setAttribute('aria-label', text.nav);
      document.querySelector('[data-language]').setAttribute('aria-label', text.language);
      document.querySelector('[data-contact-footer]').setAttribute('aria-label', text.contactFooter);
      document.querySelectorAll('[data-copy]').forEach(el => { if (text[el.dataset.copy]) el.textContent = text[el.dataset.copy]; });
      document.querySelectorAll('[data-lang]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.lang === chosen)));
      document.querySelectorAll('[data-route]').forEach(link => { const url = new URL(link.href); if (chosen === 'fr') url.searchParams.set('lang', 'fr'); else url.searchParams.delete('lang'); link.href = url.pathname + url.search; });
      if (updateAddress) { const url = new URL(location.href); if (chosen === 'fr') url.searchParams.set('lang', 'fr'); else url.searchParams.delete('lang'); history.replaceState(null, '', url); }
      document.dispatchEvent(new CustomEvent('resource-language', { detail: chosen }));
    }
    document.querySelectorAll('[data-lang]').forEach(button => button.addEventListener('click', () => setLanguage(button.dataset.lang)));
    setLanguage(new URLSearchParams(location.search).get('lang'), false);
  </script>
</>)}
</body></html>
<style>
@font-face { font-family: 'Inter'; src: url('/assets/resource-intro/Inter-latin-wght-normal.woff2') format('woff2'); font-style: normal; font-weight: 100 900; font-display: swap; }
:global(html[data-page='pharmacy-intro']) { --text: #282D32; --text-secondary: #617075; --teal: #00545A; --border: #DEE6E4; background: #FFFFFF; }
:global(html[data-page='pharmacy-intro'] *) { box-sizing: border-box; }
:global(html[data-page='pharmacy-intro'] body) { margin: 0; position: relative; isolation: isolate; color: var(--text); font: 400 16px/1.625 'Inter', Arial, sans-serif; font-feature-settings: 'cv11' 1; -webkit-font-smoothing: antialiased; min-height: 100svh; display: flex; flex-direction: column; }
:global(html[data-page='production-teaser'] body) { margin: 0; }
:global(html[data-page='pharmacy-intro'] body)::before { content: ''; position: absolute; inset: 0; z-index: -1; background: url('/assets/ink-wash/textures/xuan-paper-generated.jpg') repeat; background-size: 680px; opacity: .20; pointer-events: none; }
:global(html[data-page='pharmacy-intro'] a) { color: inherit; }
:global(html[data-page='pharmacy-intro'] :focus-visible) { outline: 2px solid var(--teal); outline-offset: 5px; }
:global(html[data-page='pharmacy-intro'] ::selection) { background: #EAF4F2; }
.wrap { width: min(1200px, calc(100% - 96px)); margin-inline: auto; }
.site-header { display: flex; align-items: center; gap: 32px; padding-block: 56px 24px; }
.brand { display: block; margin-left: -20px; flex: none; }
.brand img { display: block; width: 210px; height: 68px; object-fit: cover; }
nav { display: flex; margin-left: auto; gap: 32px; align-items: center; }
nav a { position: relative; display: flex; align-items: center; min-height: 44px; font-size: 14px; font-weight: 500; text-decoration: none; }
nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 5px; height: 1px; background: var(--teal); transform: scaleX(0); transform-origin: left; transition: transform 240ms ease; }
nav a:hover::after, nav a[aria-current='page']::after { transform: scaleX(1); }
.language { display: flex; align-items: center; gap: 2px; font-size: 12px; color: var(--text-secondary); }
.language button { font: 500 12px 'Inter', sans-serif; color: var(--text-secondary); border: 0; min-width: 32px; min-height: 44px; background: transparent; cursor: pointer; }
.language button[aria-pressed='true'] { color: var(--text); text-decoration: underline; text-underline-offset: 6px; }
h1, h2, p { margin-top: 0; } h1, h2 { font-weight: 400; }
.hero { padding-block: 88px 80px; }
.eyebrow { margin-bottom: 32px; font-size: 12px; line-height: 20px; letter-spacing: .16em; text-transform: uppercase; color: var(--text-secondary); }
.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 264px; gap: 48px; align-items: start; }
h1 { white-space: pre-line; font-size: clamp(80px, 10.5vw, 152px); line-height: 1.02; letter-spacing: -.055em; margin-bottom: 32px; }
.lead { font-size: clamp(22px, 2.15vw, 30px); line-height: 1.5; color: var(--text-secondary); margin-bottom: 36px; max-width: 790px; }
.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 32px; }
.button { display: inline-flex; align-items: center; gap: 24px; min-height: 52px; border-radius: 8px; padding: 14px 24px; background: var(--teal); color: #FFFFFF !important; font-size: 15px; font-weight: 500; text-decoration: none; transition: background 150ms ease; }
.button:hover { background: var(--text); } .button img { filter: brightness(0) invert(1); }
.text-link { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 500; color: var(--teal) !important; text-underline-offset: 6px; }
.aside-note { white-space: pre-line; font-size: 17px; line-height: 1.7; padding-left: 24px; border-left: 1px solid var(--border); margin: 44px 0 0; }
.next-page { display: flex; align-items: center; gap: 40px; border-top: 1px solid var(--border); padding-block: 28px; text-decoration: none; font-size: 26px; }
.index { width: 64px; flex: none; font-size: 13px; color: var(--text-secondary); }
.next-page > img { margin-left: auto; transition: transform 240ms ease; } .next-page:hover > img { transform: translateX(6px); }
.site-footer { border-top: 1px solid var(--border); padding-block: 24px; display: flex; justify-content: space-between; gap: 32px; font-size: 12px; color: var(--text-secondary); } .site-footer p { margin: 0; }
.inner-hero { padding-block: 88px 64px; }
.inner-hero h1 { max-width: 1100px; font-size: clamp(54px, 7vw, 96px); line-height: 1.08; margin-bottom: 40px; }
.inner-lead { font-size: 24px; line-height: 1.6; color: var(--text-secondary); max-width: 760px; margin-bottom: 0; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; border-top: 1px solid var(--border); padding-block: 48px 80px; }
h2 { font-size: 28px; line-height: 1.3; letter-spacing: -.02em; margin-bottom: 20px; }
.detail-grid p, .statement p, .contact-details p { font-size: 18px; color: var(--text-secondary); max-width: 560px; }
.statement { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; border-top: 1px solid var(--border); padding-block: 48px 80px; }
.contact-details { border-top: 1px solid var(--border); padding-block: 48px 80px; }
.email { display: inline-flex; align-items: center; gap: 40px; padding-bottom: 8px; font-size: clamp(26px, 4vw, 48px); letter-spacing: -.025em; text-decoration: none; border-bottom: 1px solid var(--border); } .contact-details .location { margin: 32px 0 0; font-size: 14px; }
.skip { position: absolute; top: -80px; left: 20px; padding: 12px; background: #FFFFFF; z-index: 5; } .skip:focus { top: 16px; }
main { flex: 1; animation: arrive 400ms cubic-bezier(.2,.7,.3,1) both; } @keyframes arrive { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 1100px) { .wrap { width: calc(100% - 64px); } nav { gap: 24px; } .site-header { gap: 20px; } .hero-grid { grid-template-columns: minmax(0, 1fr) 220px; gap: 32px; } .hero { padding-block: 80px; } h1 { font-size: clamp(74px, 10vw, 110px); } .lead { font-size: 23px; } .aside-note { font-size: 16px; padding-left: 20px; } }
@media (max-width: 767px) {
  .wrap { width: calc(100% - 40px); } .site-header { flex-wrap: wrap; gap: 8px; padding-block: 16px; } .brand { margin-left: -16px; } .brand img { width: 190px; height: 62px; } .language { margin-left: auto; } nav { order: 3; width: 100%; margin: 0; gap: 26px; } nav a { font-size: 13px; }
  .hero { padding-block: 56px; } .eyebrow { margin-bottom: 28px; font-size: 11px; } .hero-grid { grid-template-columns: 1fr; gap: 40px; } h1 { font-size: clamp(56px, 15vw, 104px); line-height: 1.04; margin-bottom: 28px; } .lead { font-size: 20px; } .hero-actions { gap: 24px; } .button { font-size: 14px; padding-inline: 20px; gap: 16px; }
  .hero-aside { display: grid; grid-template-columns: 160px 1fr; gap: 24px; align-items: center; } .aside-note { margin: 0; padding-left: 16px; font-size: 14px; } .next-page { font-size: 22px; gap: 20px; padding-block: 24px; } .index { width: 24px; } .site-footer { flex-direction: column; gap: 12px; }
  .inner-hero { padding-block: 56px 40px; } .inner-hero h1 { font-size: clamp(44px, 11vw, 70px); } .inner-lead { font-size: 20px; } .detail-grid, .statement { grid-template-columns: 1fr; gap: 32px; padding-block: 40px 56px; } h2 { font-size: 26px; } .detail-grid p, .statement p, .contact-details p { font-size: 16px; } .contact-details { padding-block: 40px 64px; }
}
@media (max-width: 359px) { nav { gap: 20px; } .hero-aside { grid-template-columns: 140px 1fr; gap: 16px; } h1 { font-size: 51px; } }
@media (prefers-reduced-motion: reduce) { main { animation: none; } nav a::after, .button, .next-page > img { transition: none; } }
.footer-brand { display: grid; gap: 8px; align-content: start; }
.footer-contact { min-width: 230px; }
.footer-label { font-size: 12px; margin-bottom: 8px !important; }
.footer-contact a { display: inline-flex; align-items: center; gap: 24px; min-height: 44px; color: var(--teal); font-size: 16px; text-decoration: none; }
.footer-contact a:hover { text-decoration: underline; text-underline-offset: 5px; }
.site-footer { scroll-margin-top: 24px; }
.statement p:last-child { margin-bottom: 0; }
@media (max-width: 767px) { .site-footer { gap: 24px; } }
</style>
