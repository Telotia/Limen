---
// Deduplicated footer, previously copy-pasted verbatim across all 6 site/*.html
// pages (byte-identical except the two props below). The `tlFooterInk` canvas
// here is populated by ink-init.js's footer-ripple IIFE, unchanged by this
// component -- that script is still loaded page-side exactly as before.
interface Props {
  showSecondaryLinks?: boolean;
  tagline?: string;
}
const {
  showSecondaryLinks = true,
  tagline = 'Evidence-grade audit for Canadian health-equipment imports.',
} = Astro.props;
---

<!-- FOOTER -->
<footer style="position: relative; padding: 56px 64px 0; background: transparent; border-top: 1px solid var(--rulesoft); overflow: hidden; height: 200px">
    <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;display:flex;align-items:flex-start;justify-content:space-between;gap:40px">
      <div>
        <div style="font-family:var(--fmono);font-size:14px;font-weight:500;letter-spacing:.34em;padding-left:.34em;color:var(--t1)">TELOTIA</div>
        <div style="font-family:var(--fmono);font-size:12px;color:var(--t4);margin-top:8px">Montreal / private beta / evidence review workspace</div>
      </div>
      <div style="font-size:13px;line-height:1.6;color:var(--t3);max-width:380px">This software supports claim review and proof package preparation. It does not provide regulatory approval.</div>
      <div style="display:flex;flex-direction:column;gap:9px;text-align:right">
        <a class="lk" href="mailto:hello@telotia.com" style="font-size:13px">hello@telotia.com</a>
        {showSecondaryLinks ? (
          <>
            <a class="lk" href="demo.html" style="font-size:13px">Demo</a>
            <a class="lk" href="consult.html" style="font-size:13px">Request a pilot</a>
          </>
        ) : (
          <Fragment set:html={`<!-- <a class="lk" href="demo.html" style="font-size:13px">Demo</a> -->\n        <!-- <a class="lk" href="consult.html" style="font-size:13px">Request a pilot</a> -->`} />
        )}
      </div>
    </div>
    <div style="position:relative;z-index:1;max-width:1180px;margin:36px auto 0;padding-top:20px;border-top:1px solid var(--rulesoft);font-family:var(--fmono);font-size:12px;color:var(--t4)">© 2026 Telotia · {tagline}</div>
    <canvas id="tlFooterInk" aria-hidden="true" style="position:absolute;left:0;bottom:0;width:100%;height:100%;object-fit:cover;object-position:left center;opacity:.72;mix-blend-mode:multiply;pointer-events:none;z-index:0;-webkit-mask-image:linear-gradient(90deg,#000 0%,#000 20%,rgba(0,0,0,.5) 56%,rgba(0,0,0,0) 84%);mask-image:linear-gradient(90deg,#000 0%,#000 20%,rgba(0,0,0,.5) 56%,rgba(0,0,0,0) 84%)"></canvas>
  </footer>
