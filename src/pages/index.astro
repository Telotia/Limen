      html[data-theme="night"] .term-card:hover {
        background:
          radial-gradient(circle at 82% 18%, rgba(110, 66, 193, 0.14), transparent 34%),
          radial-gradient(circle at 16% 80%, rgba(89, 144, 192, 0.10), transparent 30%),
          linear-gradient(135deg, rgba(16, 42, 107, 0.56) 0%, rgba(13, 18, 42, 0.92) 100%);
