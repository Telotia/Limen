---
import Consult from '../components/home/Consult.astro';
import Demo from '../components/home/Demo.astro';
import Glossary from '../components/home/Glossary.astro';
import Hero from '../components/home/Hero.astro';
import PageInk from '../components/home/PageInk.astro';
import Process from '../components/home/Process.astro';
import Research from '../components/home/Research.astro';
import Verdict from '../components/home/Verdict.astro';
import Workspace from '../components/home/Workspace.astro';
import MarketingShell from '../layouts/MarketingShell.astro';

const isProd = (process.env.LIMEN_ENV ?? 'dev') === 'prod';
---

<MarketingShell
  isProd={isProd}
  title={isProd ? 'Telotia | Arriving September 2026' : 'Telotia | Claim-to-evidence validation'}
  description={isProd
    ? 'Every claim, held to the evidence behind it. Arriving September 2026 in Montreal.'
    : 'Evidence-grade claim review for Canadian health-equipment imports.'}
>
  <PageInk />
  <Hero />
  <Process />
  <Verdict />
  <Glossary />
  <Workspace />
  <Demo />
  <Research />
  <Consult />
</MarketingShell>
