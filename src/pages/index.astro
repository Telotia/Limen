      html[data-theme-pref="system"] .app-preview-shell {
        --night-ink: #edf1ff;
        --night-ink-2: #cfd7f2;
        --night-ink-3: #9eaccf;
        --app-muted: #aab6d6;
        --app-faint: #7c89ab;
        --app-line-soft: rgba(154, 172, 222, 0.18);
        background:
          radial-gradient(circle at 78% 0%, rgba(127, 147, 216, 0.20), transparent 24rem),
          linear-gradient(135deg, rgba(29, 40, 73, 0.95), rgba(12, 21, 45, 0.98));
        border-color: rgba(154, 172, 222, 0.20);
