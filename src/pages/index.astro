      .tel-section {
        position: relative;
        padding: 88px 0;
      }

      .tel-section::before {
        position: absolute;
        inset: -220px 0;
        content: '';
        pointer-events: none;
        opacity: 0;
      }

      .tel-container {
        position: relative;
        z-index: 1;
        width: calc(100% - 32px);
        max-width: 1180px;
        margin: 0 auto;
      }

      .paper-section {
        background:
          radial-gradient(circle at 18% 16%, rgba(137, 176, 230, 0.10), transparent 28%),
          radial-gradient(circle at 82% 72%, rgba(120, 135, 210, 0.08), transparent 30%),
          radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.55), transparent 24%),
          linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
      }

      .paper-section.alt {
        background:
          radial-gradient(circle at 72% 22%, rgba(120, 135, 210, 0.09), transparent 30%),
          radial-gradient(circle at 15% 68%, rgba(137, 176, 230, 0.08), transparent 28%),
          radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.45), transparent 25%),
          linear-gradient(180deg, var(--paper-2) 0%, var(--paper) 100%);
      }

      .tel-section .tel-label {
        margin-bottom: 12px;
        color: var(--ink-3);
      }

      .section-title {
        max-width: 850px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 46px;
        font-weight: 400;
        line-height: 1.12;
      }

      .section-lede {
        max-width: 720px;
        margin-top: 15px;
        color: var(--ink-2);
        font-family: var(--font-display);
        font-size: 20px;
        font-weight: 340;
        line-height: 1.55;
      }

      .graph-panel,
      .install-block {
        color: var(--night-ink);
        background:
          radial-gradient(circle at 8% 0%, rgb(91 124 250 / 0.12), transparent 34%),
          var(--ocean);
        border: 1px solid rgb(216 214 232 / 0.2);
        box-shadow: var(--shadow-night);
      }

      .graph-panel {
        position: relative;
        margin-top: 38px;
        padding: 30px;
        overflow: hidden;
        border-radius: 12px;
      }

      .graph-panel::before {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(#ffffff1f 0.7px, transparent 0.8px),
          radial-gradient(#dea19314 0.5px, transparent 0.6px);
        background-size: 23px 23px, 13px 9px;
        content: '';
        pointer-events: none;
      }

      .graph-head,
      .graph-scroll {
        position: relative;
      }

      .graph-head {
        display: flex;
        gap: 20px;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
      }

      .graph-title {
        font-family: var(--font-display);
        font-size: 17px;
      }

      .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .legend span {
        display: inline-flex;
        gap: 6px;
        align-items: center;
        color: var(--night-ink-3);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .swatch {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
      }

      .swatch.active {
        background: var(--rose);
      }

      .swatch.complete {
        background: #3a4664;
      }

      .swatch.reentry {
        background: transparent;
        border: 1px dashed var(--night-ink-3);
      }

      .graph-scroll {
        overflow-x: auto;
        padding-bottom: 2px;
      }

      .graph-scroll svg {
        min-width: 760px;
      }

      .cycle {
        display: grid;
        grid-template-columns: 210px minmax(0, 1fr);
        gap: 34px 28px;
        max-width: 920px;
        margin-top: 54px;
      }

      .cycle dt {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 23px;
        font-weight: 420;
      }

      .cycle dt small {
        display: block;
        margin-bottom: 5px;
        color: var(--ink-3);
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .cycle dd {
        max-width: 660px;
        color: var(--ink-2);
      }

      .vocab-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        margin-top: 38px;
        overflow: hidden;
        background: var(--rule);
        border: 1px solid var(--rule);
        border-radius: 8px;
        box-shadow: var(--shadow-paper);
      }

      .term-card {
        min-height: 190px;
        padding: 24px 26px;
        background: var(--paper);
        transition: background 120ms var(--ease-paper);
      }

      .term-card:hover {
        background: var(--paper-2);
      }

      .term-name {
        margin-top: 7px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 380;
      }

      .term-def {
        margin-top: 8px;
        color: var(--ink-2);
        font-size: 14px;
        line-height: 1.56;
      }

      .tel-narrow {
        max-width: 720px;
      }

      .install-block {
        margin-top: 32px;
        padding: 24px 26px 22px;
        border-radius: 8px;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1.75;
      }

      .install-block .prompt {
        margin-right: 8px;
        color: var(--night-ink-3);
        user-select: none;
      }

      .install-block .cmd {
        color: var(--night-ink);
      }

      .install-block .arg {
        color: var(--rose);
      }

      .install-block .cmt {
        color: var(--night-ink-3);
      }

      .install-gap {
        height: 12px;
      }

      .install-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: 36px;
        border-top: 1px solid var(--rule);
      }

      .install-meta .cell {
        padding: 18px 24px 18px 0;
        border-right: 1px solid var(--rule);
      }

      .install-meta .cell:last-child {
        border-right: 0;
      }

      .install-meta .value {
        margin-top: 5px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 18px;
      }

      .install-meta .mono {
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 13px;
      }

      .norma-download-block {
        position: relative;
        z-index: 1;
        min-height: 460px;
        margin-top: 56px;
        overflow: hidden;
        isolation: isolate;
        border: 1px solid rgb(216 214 232 / 0.14);
        border-radius: 28px;
        background:
          radial-gradient(circle at 78% 44%, rgba(73, 139, 255, 0.18), transparent 28rem),
          #020308;
        box-shadow: var(--shadow-night);
        color: #fff;
        cursor: none;
      }

      .norma-download-block::before {
        position: absolute;
        inset: 0;
        z-index: 1;
        content: '';
        pointer-events: none;
        background:
          radial-gradient(circle at 16% 52%, rgba(0, 0, 0, 0.60), transparent 18rem),
          linear-gradient(90deg, rgba(0, 0, 0, 0.74) 0%, rgba(0, 0, 0, 0.28) 42%, transparent 76%);
      }

      .norma-ripple-canvas {
        position: absolute;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        display: block;
      }

      .norma-download-content {
        position: relative;
        z-index: 2;
        display: flex;
        min-height: 460px;
        width: min(640px, 52%);
        flex-direction: column;
        justify-content: center;
        padding: clamp(34px, 6vw, 76px);
        color: inherit;
      }

      .norma-download-content::before {
        position: absolute;
        inset: clamp(24px, 4.5vw, 52px) clamp(18px, 3.4vw, 40px);
        z-index: -1;
        content: '';
        pointer-events: none;
        border-radius: 22px;
        opacity: 0;
      }

      .norma-download-title {
        max-width: 13ch;
        color: currentColor;
        font-family: var(--font-sans);
        font-size: clamp(40px, 5.6vw, 64px);
        font-weight: 500;
        line-height: 0.98;
        letter-spacing: 0;
      }

      .norma-download-copy {
        max-width: 26rem;
        margin-top: 18px;
        color: rgba(255, 255, 255, 0.70);
        font-size: 15px;
        line-height: 1.55;
      }

      .norma-download-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 30px;
      }

      .norma-download-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 24px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-family: var(--font-sans);
        font-size: 15px;
        font-weight: 520;
        line-height: 1;
        text-decoration: none;
        transition:
          transform 140ms var(--ease-paper),
          border-color 140ms var(--ease-paper),
          background 140ms var(--ease-paper),
          color 140ms var(--ease-paper);
      }

      .norma-download-button:hover,
      .norma-download-button:focus-visible {
        transform: translateY(-1px);
      }

      .norma-download-button--primary {
        color: #03040a;
        background: rgba(255, 255, 255, 0.96);
      }

      .norma-download-button--secondary {
        color: #fff;
        background: rgba(255, 255, 255, 0.16);
        border-color: rgba(255, 255, 255, 0.16);
      }

      .norma-platform-note {
        margin-top: 18px;
        color: rgba(255, 255, 255, 0.46);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .norma-cursor {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 4;
        width: 56px;
        height: 66px;
        opacity: 0;
        pointer-events: none;
        transform: translate3d(-999px, -999px, 0);
        transition: opacity 120ms var(--ease-paper);
        filter:
          drop-shadow(0 0 8px rgba(20, 86, 255, 0.72))
          drop-shadow(0 0 18px rgba(41, 133, 255, 0.46));
      }

      .norma-download-block[data-pointer='inside'] .norma-cursor {
        opacity: 1;
      }

      .norma-cursor svg {
        width: 100%;
        height: 100%;
        display: block;
        overflow: visible;
      }

      .norma-cursor-line {
        stroke: rgba(7, 74, 255, 0.98);
        stroke-width: 2.7;
        stroke-linejoin: round;
        filter:
          drop-shadow(0 0 4px rgba(7, 74, 255, 0.88))
          drop-shadow(0 0 10px rgba(55, 137, 255, 0.54));
        animation: norma-line-shimmer 5.4s ease-in-out infinite;
      }

      .norma-cursor-line-glint {
        stroke: rgba(250, 253, 255, 0.92);
        stroke-width: 1;
        stroke-linejoin: round;
      }

      .norma-cursor-star {
        transform-box: fill-box;
        transform-origin: center;
        animation: norma-star-twinkle 4.4s ease-in-out infinite;
      }

      .norma-cursor-burst {
        stroke: rgba(250, 253, 255, 0.98);
        stroke-width: 1.55;
        stroke-linecap: round;
        transform-box: fill-box;
        transform-origin: center;
        filter: drop-shadow(0 0 5px rgba(19, 96, 255, 0.62));
        animation: norma-burst-twinkle 4.4s ease-in-out infinite;
      }

      .norma-cursor-star:nth-of-type(1),
      .norma-cursor-burst:nth-of-type(1) {
        animation-delay: -0.2s;
      }

      .norma-cursor-star:nth-of-type(2),
      .norma-cursor-burst:nth-of-type(2) {
        animation-delay: -0.76s;
      }

      .norma-cursor-star:nth-of-type(3),
      .norma-cursor-burst:nth-of-type(3) {
        animation-delay: -1.18s;
      }

      .norma-cursor-star:nth-of-type(4),
      .norma-cursor-burst:nth-of-type(4) {
        animation-delay: -1.54s;
      }

      .norma-cursor-star:nth-of-type(5),
      .norma-cursor-burst:nth-of-type(5) {
        animation-delay: -0.42s;
      }

      @keyframes norma-star-twinkle {
        0%,
        100% {
          opacity: 0.86;
          transform: scale(0.92);
        }

        46% {
          opacity: 1;
          transform: scale(1.34);
        }
      }

      @keyframes norma-burst-twinkle {
        0%,
        100% {
          opacity: 0.30;
          transform: scale(0.50) rotate(0deg);
        }

        46% {
          opacity: 1;
          transform: scale(1.52) rotate(8deg);
        }
      }

      @keyframes norma-line-shimmer {
        0%,
        100% {
          opacity: 0.82;
        }

        48% {
          opacity: 1;
        }
      }

      .assessment-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        margin-top: 34px;
      }

      .card {
        padding: 23px 24px 24px;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: 8px;
        box-shadow: var(--shadow-paper);
      }

      .card.weak {
        background: var(--paper);
      }

      .card h3 {
        margin: 0 0 11px;
      }

      .card ul {
        display: grid;
        gap: 0;
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .card li {
        display: grid;
        grid-template-columns: 18px minmax(0, 1fr);
        gap: 10px;
        padding: 9px 0;
        color: var(--ink-2);
        border-top: 1px solid var(--rule-soft);
        font-size: 14px;
        line-height: 1.55;
      }

      .card li:first-child {
        padding-top: 0;
        border-top: 0;
      }

      .card .mark {
        color: var(--blue);
        font-family: var(--font-display);
        font-style: italic;
      }

      .card.weak .mark {
        color: var(--rose-soft);
      }

      .assessment-note {
        max-width: 720px;
        margin-top: 34px;
        color: var(--ink-2);
        font-family: var(--font-display);
        font-size: 18px;
        font-style: italic;
      }

      .tel-footer {
        position: relative;
        overflow: hidden;
        padding: 64px 0 36px;
        color: var(--night-ink-3);
        background:
          radial-gradient(ellipse 110% 90% at 50% 100%, #0f1738 0%, #060b1a 80%),
          #060b1a;
      }

      .tel-footer::before {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(#ffffff14 0.5px, transparent 0.7px);
        background-size: 17px 17px;
        content: '';
        pointer-events: none;
      }

      .footer-inner {
        position: relative;
        width: calc(100% - 32px);
        max-width: 1180px;
        margin: 0 auto;
      }

      .footer-inner .tel-label {
        margin-bottom: 24px;
        color: var(--night-ink-3);
      }

      .repo-chain {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 36px;
      }

      .repo-card {
        display: flex;
        flex-direction: column;
        gap: 7px;
      }

      .repo-name {
        color: var(--night-ink);
        font-family: var(--font-display);
        font-size: 24px;
      }

      .repo-desc {
        max-width: 290px;
        color: var(--night-ink-3);
        font-size: 13px;
        line-height: 1.5;
      }

      .repo-card a {
        width: fit-content;
        margin-top: 5px;
        color: var(--night-ink-3);
        font-family: var(--font-mono);
        font-size: 11px;
        text-decoration: none;
        border-bottom: 1px solid rgb(216 214 232 / 0.2);
      }

      .repo-card a:hover {
        color: var(--night-ink);
        border-color: var(--night-ink-3);
      }

      .footer-bottom {
        display: flex;
        gap: 18px;
        align-items: center;
        margin-top: 48px;
        padding-top: 22px;
        border-top: 1px solid rgb(216 214 232 / 0.18);
      }

      .footer-bottom .brand-mark {
        width: 18px;
        height: 18px;
        flex-basis: 18px;
      }

      .footer-copy {
        color: var(--night-ink-3);
        font-family: var(--font-display);
        font-size: 13px;
        font-style: italic;
      }

      .footer-spacer {
        flex: 1;
      }

      .footer-bottom a {
        color: var(--night-ink-3);
        font-size: 12px;
        text-decoration: none;
        border-bottom: 1px solid rgb(216 214 232 / 0.2);
      }

      .footer-bottom a:hover {
        color: var(--night-ink);
      }

      /* ── Night theme vars ── */
      html[data-theme="night"] {
        color-scheme: dark;
        --paper: #0a1430;
        --paper-2: #0f1c3a;
        --paper-3: #132449;
        --paper-edge: #2a3a61;
        --ink: #f4f0ff;
        --ink-2: #d8d6e8;
        --ink-3: #b9b2d6;
        --ink-4: #8f98bb;
        --rule: #2a3a61;
        --rule-soft: rgb(216 214 232 / 0.14);
      }

      html[data-theme="night"] body {
        background: #060d22;
        color: var(--night-ink);
      }

      html[data-theme="night"] .tel-page {
        background: #060d22;
      }

      html[data-theme="night"] .paper-section {
        background:
          url('/assets/principia/stars.svg') center / cover no-repeat,
          radial-gradient(circle at 72% 18%, rgba(75, 46, 131, 0.20), transparent 36%),
          radial-gradient(circle at 28% 62%, rgba(110, 66, 193, 0.10), transparent 34%),
          radial-gradient(circle at 14% 22%, rgba(89, 144, 192, 0.08), transparent 30%),
          linear-gradient(180deg, #070A18 0%, #0B1028 100%);
        border-bottom: none;
      }

      html[data-theme="night"] .paper-section.alt {
        background:
          url('/assets/principia/stars.svg') center / cover no-repeat,
          radial-gradient(circle at 20% 20%, rgba(110, 66, 193, 0.18), transparent 34%),
          radial-gradient(circle at 76% 68%, rgba(75, 46, 131, 0.12), transparent 36%),
          radial-gradient(circle at 88% 14%, rgba(89, 144, 192, 0.07), transparent 28%),
          linear-gradient(180deg, #0B1028 0%, #070A18 100%);
        border-bottom: none;
      }

      html[data-theme="night"] .section-title,
      html[data-theme="night"] .cycle dt,
      html[data-theme="night"] .term-name,
      html[data-theme="night"] .install-meta .value,
      html[data-theme="night"] .repo-name {
        color: var(--night-ink);
      }

      html[data-theme="night"] .section-lede,
      html[data-theme="night"] .cycle dd,
      html[data-theme="night"] .term-def,
      html[data-theme="night"] .install-meta .mono,
      html[data-theme="night"] .card li,
      html[data-theme="night"] .assessment-note {
