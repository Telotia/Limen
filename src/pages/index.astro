    <script is:inline>
      (function () {
        var STORAGE_KEY = 'theme';

        function getSystemTheme() {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'daylight';
        }

        function applyTheme(pref) {
          var resolved = pref === 'system' ? getSystemTheme() : pref;
          document.documentElement.setAttribute('data-theme', resolved);
          document.documentElement.setAttribute('data-theme-pref', pref);
          document.querySelectorAll('.theme-btn').forEach(function (btn) {
            btn.classList.toggle('is-active', btn.dataset.themeValue === pref);
          });
          localStorage.setItem(STORAGE_KEY, pref);
        }

        document.querySelectorAll('.theme-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            applyTheme(btn.dataset.themeValue);
          });
        });

        var stored = localStorage.getItem(STORAGE_KEY) || 'system';
        applyTheme(stored);

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          var pref = localStorage.getItem(STORAGE_KEY) || 'system';
          if (pref === 'system') {
            document.documentElement.setAttribute('data-theme', getSystemTheme());
            document.documentElement.setAttribute('data-theme-pref', 'system');
          }
        });

        // Scroll-aware nav: dark over hero, themed when scrolled
        var hero = document.querySelector('.tel-hero');
        function updateNavScroll() {
          var threshold = hero ? hero.offsetHeight * 0.72 : 300;
          if (window.scrollY < threshold) {
            document.documentElement.setAttribute('data-nav-at-hero', '');
          } else {
            document.documentElement.removeAttribute('data-nav-at-hero');
          }
        }
        updateNavScroll();
        window.addEventListener('scroll', updateNavScroll, { passive: true });

        var starField = document.querySelector('[data-star-field]');
        var constellationField = document.querySelector('[data-constellation-field]');
        var resizeTimer;
        var twinkleTimer;
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        function randomRange(min, max) {
          return min + Math.random() * (max - min);
        }

        function getFieldHeight() {
          var page = document.querySelector('.tel-page');
          return Math.max(
            window.innerHeight,
            page instanceof HTMLElement ? page.scrollHeight : document.documentElement.scrollHeight,
          );
        }

        function scheduleTwinkle() {
          window.clearTimeout(twinkleTimer);
          if (reducedMotion.matches || !(starField instanceof HTMLElement)) return;

          twinkleTimer = window.setTimeout(function pulseStars() {
            if (!(starField instanceof HTMLElement)) return;
            var stars = Array.from(starField.querySelectorAll('.twinkle-star'));
            var pulseCount = Math.max(1, Math.round(stars.length * randomRange(0.025, 0.065)));

            for (var i = 0; i < pulseCount; i += 1) {
              var star = stars[Math.floor(Math.random() * stars.length)];
              if (!(star instanceof HTMLElement)) continue;

              star.classList.add('is-glowing');
              star.style.opacity = star.style.getPropertyValue('--star-high') || '0.72';
              star.style.transform = 'scale(' + (star.style.getPropertyValue('--star-scale') || '1.55') + ')';
              star.style.filter = 'brightness(1.68)';
              window.setTimeout(function (glowingStar) {
                glowingStar.classList.remove('is-glowing');
                glowingStar.style.opacity = glowingStar.style.getPropertyValue('--star-low') || '0.08';
                glowingStar.style.transform = 'scale(0.82)';
                glowingStar.style.filter = 'brightness(0.98)';
              }, randomRange(520, 1500), star);
            }

            scheduleTwinkle();
          }, randomRange(360, 980));
        }

        function populateConstellations() {
          if (!(constellationField instanceof SVGSVGElement)) return;
          var svgNS = 'http://www.w3.org/2000/svg';
          var fieldHeight = getFieldHeight();
          var fieldWidth = Math.max(window.innerWidth, document.documentElement.clientWidth);
          var constellationCount = Math.round(Math.min(9, Math.max(4, fieldHeight / 1120)));

          constellationField.setAttribute('viewBox', '0 0 ' + fieldWidth + ' ' + fieldHeight);
          constellationField.setAttribute('preserveAspectRatio', 'none');
          constellationField.style.height = fieldHeight + 'px';
          constellationField.textContent = '';

          for (var groupIndex = 0; groupIndex < constellationCount; groupIndex += 1) {
            var segmentTop = (fieldHeight / constellationCount) * groupIndex;
            var baseY = segmentTop + randomRange(80, fieldHeight / constellationCount - 80);
            var baseX = randomRange(-fieldWidth * 0.06, fieldWidth * 0.94);
            var pointCount = Math.floor(randomRange(3, 5.99));
            var points = [];

            for (var p = 0; p < pointCount; p += 1) {
              var driftX = (p - 1.3) * randomRange(92, 190);
              points.push({
                x: Math.max(-40, Math.min(fieldWidth + 40, baseX + driftX + randomRange(-80, 120))),
                y: Math.max(20, Math.min(fieldHeight - 20, baseY + randomRange(-190, 190))),
              });
            }

            var path = document.createElementNS(svgNS, 'path');
            path.setAttribute(
              'd',
              points
                .map(function (point, index) {
                  return (index === 0 ? 'M ' : 'L ') + point.x.toFixed(1) + ' ' + point.y.toFixed(1);
                })
                .join(' '),
            );
            path.setAttribute('class', 'constellation-thread');
            path.style.setProperty('--constellation-opacity', randomRange(0.22, 0.48).toFixed(2));
            constellationField.appendChild(path);

            points.forEach(function (point, pointIndex) {
              var node = document.createElementNS(svgNS, 'circle');
              node.setAttribute('class', 'constellation-node' + (pointIndex === 0 ? ' is-anchor' : ''));
              node.setAttribute('cx', point.x.toFixed(1));
              node.setAttribute('cy', point.y.toFixed(1));
              node.setAttribute('r', randomRange(2.1, pointIndex === 0 ? 4.2 : 3.2).toFixed(1));
              node.style.setProperty('--constellation-node-opacity', randomRange(0.38, 0.78).toFixed(2));
              constellationField.appendChild(node);
            });
          }

          var watermarkCount = Math.round(Math.min(7, Math.max(3, fieldHeight / 1500)));
          for (var w = 0; w < watermarkCount; w += 1) {
            var y = randomRange(180, fieldHeight - 160);
            var x1 = randomRange(-fieldWidth * 0.12, fieldWidth * 0.2);
            var x2 = randomRange(fieldWidth * 0.78, fieldWidth * 1.12);
            var c1x = randomRange(fieldWidth * 0.22, fieldWidth * 0.42);
            var c2x = randomRange(fieldWidth * 0.58, fieldWidth * 0.76);
            var c1y = y + randomRange(-140, 140);
            var c2y = y + randomRange(-140, 140);
            var watermark = document.createElementNS(svgNS, 'path');
            watermark.setAttribute(
              'd',
              'M ' +
                x1.toFixed(1) +
                ' ' +
                y.toFixed(1) +
                ' C ' +
                c1x.toFixed(1) +
                ' ' +
                c1y.toFixed(1) +
                ', ' +
                c2x.toFixed(1) +
                ' ' +
                c2y.toFixed(1) +
                ', ' +
                x2.toFixed(1) +
                ' ' +
                (y + randomRange(-90, 90)).toFixed(1),
            );
            watermark.setAttribute('class', 'paper-watermark');
            watermark.style.setProperty('--watermark-opacity', randomRange(0.035, 0.075).toFixed(2));
            constellationField.appendChild(watermark);
          }

          var orbitCount = Math.round(Math.min(5, Math.max(2, fieldHeight / 2100)));
          for (var o = 0; o < orbitCount; o += 1) {
            var orbit = document.createElementNS(svgNS, 'ellipse');
            var cx = randomRange(fieldWidth * 0.12, fieldWidth * 0.88);
            var cy = randomRange(260, fieldHeight - 260);
            orbit.setAttribute('class', 'moon-orbit');
            orbit.setAttribute('cx', cx.toFixed(1));
            orbit.setAttribute('cy', cy.toFixed(1));
            orbit.setAttribute('rx', randomRange(140, 300).toFixed(1));
            orbit.setAttribute('ry', randomRange(24, 74).toFixed(1));
            orbit.setAttribute('transform', 'rotate(' + randomRange(-18, 18).toFixed(1) + ' ' + cx.toFixed(1) + ' ' + cy.toFixed(1) + ')');
            orbit.style.setProperty('--orbit-opacity', randomRange(0.08, 0.16).toFixed(2));
            constellationField.appendChild(orbit);
          }

          var prismCount = Math.round(Math.min(4, Math.max(2, fieldHeight / 2600)));
          for (var pr = 0; pr < prismCount; pr += 1) {
            var startX = randomRange(fieldWidth * 0.10, fieldWidth * 0.78);
            var startY = randomRange(220, fieldHeight - 220);
            var length = randomRange(160, 320);
            var slope = randomRange(-34, 34);
            ['is-cyan', 'is-violet', 'is-rose'].forEach(function (tone, toneIndex) {
              var line = document.createElementNS(svgNS, 'line');
              var offset = (toneIndex - 1) * 4;
              line.setAttribute('class', 'prism-streak ' + tone);
              line.setAttribute('x1', startX.toFixed(1));
              line.setAttribute('y1', (startY + offset).toFixed(1));
              line.setAttribute('x2', (startX + length).toFixed(1));
              line.setAttribute('y2', (startY + slope + offset).toFixed(1));
              line.style.setProperty('--prism-opacity', randomRange(0.08, 0.16).toFixed(2));
              constellationField.appendChild(line);
            });
          }
        }

        function populateStars() {
          if (!(starField instanceof HTMLElement)) return;
          var fieldHeight = getFieldHeight();
          var starCount = Math.round(Math.min(96, Math.max(42, fieldHeight / 118)));
          var stars = document.createDocumentFragment();
          starField.style.height = fieldHeight + 'px';
          starField.textContent = '';

          for (var i = 0; i < starCount; i += 1) {
            var star = document.createElement('span');
            var temperament = Math.random();
            var cross = Math.random() > 0.78;
            var bright = temperament > 0.78;
            var blue = !bright && !cross && temperament < 0.20;
            var size = cross ? randomRange(1.5, 2.6) : bright ? randomRange(1.7, 3.2) : randomRange(0.75, 1.85);
            var low = cross
              ? randomRange(0.13, 0.30)
              : bright
                ? randomRange(0.20, 0.42)
                : randomRange(0.055, 0.16);
            var high = cross
              ? randomRange(0.58, 0.98)
              : bright
                ? randomRange(0.70, 1)
                : randomRange(0.30, 0.64);

            star.className =
              'twinkle-star' +
              (cross ? ' is-cross' : bright ? ' is-bright' : blue ? ' is-blue' : '');
            star.style.setProperty('--star-left', randomRange(1, 99).toFixed(2) + '%');
            star.style.setProperty('--star-top', randomRange(0, fieldHeight).toFixed(0) + 'px');
            star.style.setProperty('--star-size', size.toFixed(2) + 'px');
            star.style.setProperty('--star-glow', (size * randomRange(5, 11)).toFixed(2) + 'px');
            star.style.setProperty('--star-low', low.toFixed(3));
            star.style.setProperty('--star-mid', ((low + high) * 0.34).toFixed(3));
            star.style.setProperty('--star-high', high.toFixed(3));
            star.style.setProperty('--star-scale', randomRange(1.1, bright ? 2.25 : 1.72).toFixed(2));
            star.style.setProperty('--star-rise', randomRange(540, 1280).toFixed(0) + 'ms');
            star.style.opacity = low.toFixed(3);
            stars.appendChild(star);
          }

          var dustCount = Math.round(Math.min(64, Math.max(24, fieldHeight / 190)));
          for (var d = 0; d < dustCount; d += 1) {
            var dust = document.createElement('span');
            var dustSize = randomRange(0.65, 1.85);
            dust.className = 'moon-dust';
            dust.style.setProperty('--dust-left', randomRange(1, 99).toFixed(2) + '%');
            dust.style.setProperty('--dust-top', randomRange(0, fieldHeight).toFixed(0) + 'px');
            dust.style.setProperty('--dust-size', dustSize.toFixed(2) + 'px');
            dust.style.setProperty('--dust-opacity', randomRange(0.035, 0.12).toFixed(3));
            stars.appendChild(dust);
          }

          starField.appendChild(stars);
          scheduleTwinkle();
        }

        function populateAtmosphere() {
          populateConstellations();
          populateStars();
        }

        populateAtmosphere();
        window.addEventListener('resize', function () {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(populateAtmosphere, 240);
        });
      })();
    </script>

    <script>
      import { createAnimation } from '../lib/dianoetica/core/engine';

      const animationHandles = Array.from(
        document.querySelectorAll('[data-decor-animation]'),
      )
        .filter((canvas): canvas is HTMLCanvasElement => canvas instanceof HTMLCanvasElement)
        .map((canvas) => {
          const isCircle = canvas.dataset.decorAnimation === 'circle';

          return createAnimation(canvas, {
            backgroundColor: 'transparent',
            telosPattern: isCircle ? 'circle' : 'chaotic pattern',
            center: ({ width, height }) => ({
              x: width * 0.5,
              y: height * (isCircle ? 0.5 : 0.54),
            }),
            radius: ({ width, height }) =>
              isCircle
                ? Math.min(width, height) * 0.21  // canvas is 2.1× layout anchor; 0.21 ≈ visual 0.44
                : Math.min(width, height) * 0.34, // canvas is oversized; keep chaotic visibly full in hero
          });
        });

      const app = document.querySelector('[data-vivarium-app]');

      if (app instanceof HTMLElement) {
        const chamberLabels = {
          telos: 'TELOS / CRYSTALLIZED',
          inspection: 'INSPECTION / COMPLETE',
          synthesis: 'SYNTHESIS / ITERATE',
          debate: 'DEBATE / OSC-2',
          experiment: 'EXPERIMENT / APPARATUS',
          slice: 'SLICE / PARTIAL',
        };

        const chamberState = app.querySelector('[data-chamber-state]');
        const chamberReadout = app.querySelector('[data-chamber-readout]');
        const sliceReadout = app.querySelector('[data-slice-readout]');
        const appTitle = app.querySelector('[data-app-title]');

        app.querySelectorAll('[data-chamber]').forEach((button) => {
          button.addEventListener('click', () => {
            if (!(button instanceof HTMLButtonElement)) return;
            const chamber = button.dataset.chamber ?? 'synthesis';

            app.querySelectorAll('[data-chamber]').forEach((chamberButton) => {
              chamberButton.classList.toggle('is-active', chamberButton === button);
            });

            app.querySelectorAll('[data-event-chamber]').forEach((row) => {
              row.classList.toggle(
                'is-highlighted',
                row instanceof HTMLElement && row.dataset.eventChamber === chamber,
              );
            });

            const label = chamberLabels[chamber as keyof typeof chamberLabels] ?? chamber;
            if (chamberState) chamberState.textContent = label.toLowerCase();
            if (chamberReadout) chamberReadout.textContent = label;
          });
        });

        // Slice detail panel
        const detailOverlay = document.getElementById('sliceDetailOverlay');
        const detailVerdict = document.getElementById('sliceDetailVerdict');
        const detailId = document.getElementById('sliceDetailId');
        const detailTitle = document.getElementById('sliceDetailTitle');
        const detailTheory = document.getElementById('sliceDetailTheory');
        const detailEvidence = document.getElementById('sliceDetailEvidence');
        const detailState = document.getElementById('sliceDetailState');
        const detailClose = document.getElementById('sliceDetailClose');
        const copyIdBtn = document.getElementById('sliceCopyId');

        const verdictPillClasses: Record<string, string> = {
          partial: 'slice-detail-pill--partial',
          proven: 'slice-detail-pill--proven',
          open: 'slice-detail-pill--open',
          falsified: 'slice-detail-pill--falsified',
        };

        function openSliceDetail(el: HTMLElement) {
          const id = el.dataset.slice ?? '';
          const verdict = el.dataset.verdict ?? 'Open';
          const title = el.dataset.title ?? '';
          const theory = el.dataset.sliceTheory ?? '';
          const evidence = el.dataset.sliceEvidence ?? '';
          const chamber = el.dataset.sliceChamber ?? '';
          const reentries = el.dataset.sliceReentries ?? '0';
          const last = el.dataset.sliceLast ?? '';
          const note = el.dataset.sliceNote ?? '';

          const key = verdict.toLowerCase();
          if (detailVerdict) {
            detailVerdict.textContent = verdict;
            detailVerdict.className = `slice-detail-pill ${verdictPillClasses[key] ?? ''}`;
            const dot = document.createElement('span');
            dot.className = 'pill-dot';
            detailVerdict.prepend(dot);
          }
          if (detailId) detailId.textContent = id;
          if (detailTitle) detailTitle.textContent = title;
          if (detailTheory) detailTheory.textContent = theory;
          if (detailEvidence) detailEvidence.textContent = evidence;
          if (detailState) {
            detailState.innerHTML = `
              <dt>chamber</dt><dd>${chamber}</dd>
              <dt>re-entries</dt><dd>${reentries}</dd>
              <dt>last engaged</dt><dd>${last}</dd>
              <dt>note</dt><dd class="sd-note">${note}</dd>
            `;
          }
          if (copyIdBtn) {
            copyIdBtn.onclick = () => navigator.clipboard?.writeText(id);
          }
          detailOverlay?.removeAttribute('aria-hidden');
        }

        function closeSliceDetail() {
          detailOverlay?.setAttribute('aria-hidden', 'true');
        }

        detailClose?.addEventListener('click', closeSliceDetail);
        detailOverlay?.addEventListener('click', (e) => {
          if (e.target === detailOverlay) closeSliceDetail();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeSliceDetail();
        });

        app.querySelectorAll('[data-slice]').forEach((card) => {
          const activate = () => {
            if (!(card instanceof HTMLElement)) return;
            const slice = card.dataset.slice ?? '';
            const verdict = card.dataset.verdict ?? 'Open';
            const title = card.dataset.title ?? '';

            app.querySelectorAll('[data-slice]').forEach((c) => {
              c.setAttribute('aria-selected', 'false');
            });
            card.setAttribute('aria-selected', 'true');

            if (sliceReadout) sliceReadout.textContent = `${slice} / ${verdict}`;
            if (appTitle && title) appTitle.textContent = title;

            openSliceDetail(card);
          };

          card.addEventListener('click', activate);
          card.addEventListener('keydown', (e) => {
            if (e instanceof KeyboardEvent && (e.key === 'Enter' || e.key === ' ')) {
              e.preventDefault();
              activate();
            }
          });
        });
      }

      type NormaPoint = { x: number; y: number };
      type NormaParticle = {
        nx: number;
        ny: number;
        phase: number;
        size: number;
        tone: number;
        spin: number;
      };

      function createNormaRipple(canvas: HTMLCanvasElement) {
        const block = canvas.closest('[data-norma-download]');
        const context = canvas.getContext('2d', { alpha: true });
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        if (!(block instanceof HTMLElement) || !(context instanceof CanvasRenderingContext2D)) {
          return { destroy() {} };
        }

        const blockElement = block;
        const cursor = blockElement.querySelector('[data-norma-cursor]');
        const ctx = context;
        let frame = 0;
        let width = 1;
        let height = 1;
        let dpr = 1;
        let particles: NormaParticle[] = [];
        let fieldSpecks: NormaParticle[] = [];
        let pointerX = 0;
        let pointerY = 0;
        let targetX = 0;
        let targetY = 0;
        let inside = false;
        const startedAt = performance.now();
        const palette = [
          [38, 236, 238],
          [70, 154, 255],
          [129, 108, 255],
          [219, 63, 244],
        ];

        function pseudo(index: number) {
          return Math.abs(Math.sin(index * 127.13 + 17.7) * 43758.5453123) % 1;
        }

        function colorAt(tone: number, alpha: number) {
          const span = palette.length - 1;
          const scaled = Math.max(0, Math.min(0.999, tone)) * span;
          const index = Math.floor(scaled);
          const mix = scaled - index;
          const from = palette[index];
          const to = palette[Math.min(index + 1, palette.length - 1)];
          const r = Math.round(from[0] + (to[0] - from[0]) * mix);
          const g = Math.round(from[1] + (to[1] - from[1]) * mix);
          const b = Math.round(from[2] + (to[2] - from[2]) * mix);
          return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        }

        function fallbackPoints() {
          const points: NormaPoint[] = [];
          for (let i = 0; i < 1500; i += 1) {
            const t = (i / 1500) * Math.PI * 2;
            const lobe = i % 2 === 0 ? -1 : 1;
            const ring = (i % 5) / 5;
            const radius = 0.22 + ring * 0.11 + Math.sin(t * 3 + ring) * 0.012;
            points.push({
              x: 0.5 + lobe * 0.20 + Math.cos(t) * radius * 0.78,
              y: 0.5 + Math.sin(t) * radius * 0.56,
            });
          }
          return points;
        }

        function makeParticles(points: NormaPoint[]) {
          if (!points.length) return;
          particles = points.map((point, index) => {
            const nx = (point.x - 0.5) * 2.1;
            const ny = (point.y - 0.5) * 1.65;
            return {
              nx,
              ny,
              phase: pseudo(index) * Math.PI * 2,
              size: 0.72 + pseudo(index + 19) * 2.15,
              tone: Math.max(0, Math.min(1, point.x * 0.84 + pseudo(index + 5) * 0.16)),
              spin: pseudo(index + 41) * Math.PI,
            };
          });
        }

        function makeSpecks() {
          const count = Math.round(Math.min(420, Math.max(140, (width * height) / 5200)));
          fieldSpecks = Array.from({ length: count }, (_, index) => ({
            nx: pseudo(index + 311) * 2 - 1,
            ny: pseudo(index + 719) * 2 - 1,
            phase: pseudo(index + 1009) * Math.PI * 2,
            size: 0.35 + pseudo(index + 208) * 1.35,
            tone: pseudo(index + 404),
            spin: pseudo(index + 909) * Math.PI,
          }));
        }

        function resize() {
          const rect = canvas.getBoundingClientRect();
          dpr = Math.min(2, window.devicePixelRatio || 1);
          width = Math.max(1, rect.width);
          height = Math.max(1, rect.height);
          canvas.width = Math.round(width * dpr);
          canvas.height = Math.round(height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          if (!pointerX && !pointerY) {
            pointerX = targetX = width * 0.68;
            pointerY = targetY = height * 0.42;
          }
          makeSpecks();
        }

        function normalizeVectorPoints(rawPoints: NormaPoint[]) {
          const minX = Math.min(...rawPoints.map((point) => point.x));
          const maxX = Math.max(...rawPoints.map((point) => point.x));
          const minY = Math.min(...rawPoints.map((point) => point.y));
          const maxY = Math.max(...rawPoints.map((point) => point.y));
          const spanX = Math.max(1, maxX - minX);
          const spanY = Math.max(1, maxY - minY);
          const maxPoints = 2200;
          const normalized: NormaPoint[] = [];

          for (let i = 0; i < Math.min(maxPoints, rawPoints.length); i += 1) {
            const point = rawPoints[(i * 1543) % rawPoints.length];
            normalized.push({
              x: (point.x - minX) / spanX,
              y: (point.y - minY) / spanY,
            });
          }

          return normalized;
        }

        function parsePointPairs(points: string | null) {
          if (!points) return [];
          const numbers = Array.from(points.matchAll(/-?\d*\.?\d+(?:e[-+]?\d+)?/gi)).map((match) =>
            Number.parseFloat(match[0]),
          );
          const parsed: NormaPoint[] = [];
          for (let i = 0; i < numbers.length - 1; i += 2) {
            if (Number.isFinite(numbers[i]) && Number.isFinite(numbers[i + 1])) {
              parsed.push({ x: numbers[i], y: numbers[i + 1] });
            }
          }
          return parsed;
        }

        async function sampleSvgPoints(src: string) {
          const response = await fetch(src);
          if (!response.ok) throw new Error('Norma SVG failed to load');

          const svgText = await response.text();
          const doc = new DOMParser().parseFromString(svgText, 'image/svg+xml');
          const elements = Array.from(doc.querySelectorAll('.cls-1'));
          const rawPoints: NormaPoint[] = [];

          elements.forEach((element) => {
            const tag = element.tagName.toLowerCase();

            if (tag === 'circle' || tag === 'ellipse') {
              const x = Number.parseFloat(element.getAttribute('cx') || '');
              const y = Number.parseFloat(element.getAttribute('cy') || '');
              if (Number.isFinite(x) && Number.isFinite(y)) rawPoints.push({ x, y });
              return;
            }

            if (tag === 'polygon' || tag === 'polyline') {
              const points = parsePointPairs(element.getAttribute('points'));
              if (points.length) {
                const center = points.reduce(
                  (sum, point) => ({ x: sum.x + point.x, y: sum.y + point.y }),
                  { x: 0, y: 0 },
                );
                rawPoints.push({ x: center.x / points.length, y: center.y / points.length });
              }
              return;
            }

            if (tag === 'path') {
              const d = element.getAttribute('d') || '';
              const move = d.match(/[Mm]\s*(-?\d*\.?\d+(?:e[-+]?\d+)?)[,\s]+(-?\d*\.?\d+(?:e[-+]?\d+)?)/i);
              if (move) {
                const x = Number.parseFloat(move[1]);
                const y = Number.parseFloat(move[2]);
                if (Number.isFinite(x) && Number.isFinite(y)) rawPoints.push({ x, y });
              }
            }
          });

          if (rawPoints.length < 60) {
            throw new Error('Norma SVG vector points were not readable');
          }

          return normalizeVectorPoints(rawPoints);
        }

        function draw() {
          const t = (performance.now() - startedAt) / 1000;
          ctx.clearRect(0, 0, width, height);
          const isBlackPanel = document.documentElement.getAttribute('data-theme') === 'daylight';
          const autoX = width * (0.67 + Math.cos(t * 0.22) * 0.06);
          const autoY = height * (0.46 + Math.sin(t * 0.28) * 0.12);

          pointerX += ((inside ? targetX : autoX) - pointerX) * 0.055;
          pointerY += ((inside ? targetY : autoY) - pointerY) * 0.055;

          ctx.globalCompositeOperation = isBlackPanel ? 'lighter' : 'source-over';
          fieldSpecks.forEach((speck, index) => {
            const x = width * (0.5 + speck.nx * 0.58);
            const y = height * (0.5 + speck.ny * 0.58);
            const shimmer = 0.35 + Math.sin(t * 0.8 + speck.phase) * 0.22;
            ctx.fillStyle = colorAt(speck.tone, (isBlackPanel ? 0.30 : 0.22) * shimmer);
            ctx.beginPath();
            ctx.arc(x, y, speck.size * (index % 7 === 0 ? 1.9 : 1), 0, Math.PI * 2);
            ctx.fill();
          });

          const baseX = width * (width < 760 ? 0.58 : 0.66);
          const baseY = height * (width < 760 ? 0.34 : 0.50);
          const centerX = baseX + (pointerX - baseX) * 0.10;
          const centerY = baseY + (pointerY - baseY) * 0.13;
          const scale = Math.min(width, height) * (width < 760 ? 0.42 : 0.62);
          const breath = 1 + Math.sin(t * 0.72) * 0.035;

          particles.forEach((particle) => {
            const x0 = centerX + particle.nx * scale * breath;
            const y0 = centerY + particle.ny * scale * breath;
            const dx = x0 - pointerX;
            const dy = y0 - pointerY;
            const dist = Math.sqrt(dx * dx + dy * dy) || 1;
            const wave = Math.sin(dist * 0.033 - t * 4.2 + particle.phase) * Math.exp(-dist / 520);
            const drift = Math.sin(t * 1.15 + particle.phase) * 4.8;
            const influence = inside ? 30 : 18;
            const x = x0 + (dx / dist) * wave * influence + Math.cos(particle.phase + t * 0.4) * drift;
            const y = y0 + (dy / dist) * wave * influence + Math.sin(particle.phase + t * 0.35) * drift;
            const alpha = isBlackPanel ? 0.42 + Math.max(0, wave) * 0.35 : 0.32 + Math.max(0, wave) * 0.24;
            const angle = Math.atan2(dy, dx) + particle.spin;

            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle);
            ctx.fillStyle = colorAt(particle.tone, alpha);
            ctx.beginPath();
            ctx.ellipse(0, 0, particle.size * (1.8 + Math.abs(wave) * 2.2), particle.size * 0.58, 0, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          });

          ctx.globalCompositeOperation = 'source-over';
          if (!reducedMotion.matches) {
            frame = requestAnimationFrame(draw);
          }
        }

        function movePointer(event: PointerEvent) {
          const rect = blockElement.getBoundingClientRect();
          targetX = event.clientX - rect.left;
          targetY = event.clientY - rect.top;
          if (cursor instanceof HTMLElement) {
            cursor.style.transform = `translate3d(${targetX - 27}px, ${targetY - 32}px, 0)`;
          }
        }

        function enterPointer(event: PointerEvent) {
          inside = true;
          blockElement.dataset.pointer = 'inside';
          movePointer(event);
        }

        function leavePointer() {
          inside = false;
          delete blockElement.dataset.pointer;
        }

        resize();
        makeParticles(fallbackPoints());
        sampleSvgPoints(blockElement.dataset.particleSrc || '/assets/principia/chaotic-p.svg')
          .then(makeParticles)
          .catch(() => makeParticles(fallbackPoints()));

        blockElement.addEventListener('pointerenter', enterPointer);
        blockElement.addEventListener('pointermove', movePointer);
        blockElement.addEventListener('pointerleave', leavePointer);
        window.addEventListener('resize', resize);
        draw();

        return {
          destroy() {
            cancelAnimationFrame(frame);
            blockElement.removeEventListener('pointerenter', enterPointer);
            blockElement.removeEventListener('pointermove', movePointer);
            blockElement.removeEventListener('pointerleave', leavePointer);
            window.removeEventListener('resize', resize);
          },
        };
      }

      const normaRippleHandles = Array.from(document.querySelectorAll('[data-norma-ripple]'))
        .filter((canvas): canvas is HTMLCanvasElement => canvas instanceof HTMLCanvasElement)
        .map((canvas) => createNormaRipple(canvas));

      window.addEventListener(
        'pagehide',
        () => {
          animationHandles.forEach((animation) => animation.destroy());
          normaRippleHandles.forEach((animation) => animation.destroy());
        },
        { once: true },
      );
    </script>
  </body>
</html>
