---
const limenEnv = process.env.LIMEN_ENV ?? 'dev';
const isProd = limenEnv === 'prod';

const navItems = [
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Showcase', href: '#showcase' },
  { label: 'About', href: '#about' },
];

const heroMeta = [
  { label: 'Granularity', value: 'Atomic claims, not paragraphs' },
  { label: 'Evidence base', value: 'The corpus you choose' },
  { label: 'Verdicts', value: 'Supported / Partial / No support found' },
];

const appChambers = [
  { id: 'telos', label: 'Document', state: 'loaded' },
  { id: 'inspection', label: 'Corpus', state: 'indexed' },
  { id: 'synthesis', label: 'Decompose', state: 'active' },
  { id: 'debate', label: 'Match', state: 'pending' },
  { id: 'experiment', label: 'Grade', state: 'pending' },
  { id: 'slice', label: 'Review', state: 'ready' },
];

const appEvents = [
  {
    time: '10:42:01.412',
    chamber: 'telos',
    event: 'loaded',
    detail: 'doc_paper_8f0a1b34 / 4,312 words',
  },
  {
    time: '10:42:14.339',
    chamber: 'inspection',
    event: 'indexed',
    detail: '47 papers / Concordia Design Lab / 2006–2024',
  },
  {
    time: '10:42:31.770',
    chamber: 'synthesis',
    event: 'decomposed',
    detail: '18 atomic claims extracted',
  },
  {
    time: '10:42:55.218',
    chamber: 'debate',
    event: 'search',
    detail: 'claim_5 / 3 candidate passages found',
  },
  {
    time: '10:43:12.554',
    chamber: 'experiment',
    event: 'graded',
    detail: 'verdict=Supported / Zeng 2015 §3.2',
  },
  {
    time: '10:44:02.004',
    chamber: 'slice',
    event: 'reviewed',
    detail: '12 of 18 claims graded / 6 remaining',
  },
];

const appSlices = [
  {
    id: 'claim_a3f2b9c1',
    title: 'Design intent can be expressed independently of implementation.',
    verdict: 'Supported',
    chamber: 'Decompose ▸ Grade',
    reentries: 0,
    last: '4 min ago',
    note: 'two independent passages corroborate',
    theory: 'The paper asserts that design rationale, captured at sufficient granularity, allows reconstruction of intent without the original process.',
    evidence: 'Zeng (2015) §3.2 models design intent as a structured object separable from artifact description. Zhou & Zeng (2019) §2.1 provides a second independent encoding. Both retrieved and cited.',
  },
  {
    id: 'claim_4d12e0',
    title: 'Co-creative AI systems reduce cognitive load in early-stage ideation.',
    verdict: 'Partial',
    chamber: 'Decompose ▸ Grade ▸ Re-check',
    reentries: 1,
    last: '12 min ago',
    note: 'supported for visual tasks; corpus silent on verbal ideation',
    theory: 'The claim applies broadly to divergent-phase ideation. This corpus only covers one modality.',
    evidence: 'Hua & Zeng (2022) supports the claim for sketch-based tasks. No corpus passage covers verbal or text-based modalities. Partial support graded accordingly.',
  },
  {
    id: 'claim_9bc717',
    title: 'Analogical reasoning is the primary driver of cross-domain innovation.',
    verdict: 'No support',
    chamber: 'Decompose ▸ Grade',
    reentries: 0,
    last: 'just now',
    note: 'no matching passages in this corpus',
    theory: 'The corpus does not speak to this mechanism.',
    evidence: '(no matching passages in this corpus — not a verdict on the claim itself)',
  },
];

const graphNodes = [
  { id: 'document', x: 60, y: 110, label: 'Document' },
  { id: 'corpus', x: 200, y: 60, label: 'Corpus' },
  { id: 'decompose', x: 340, y: 110, label: 'Decompose', active: true },
  { id: 'match', x: 510, y: 60, label: 'Match' },
  { id: 'grade', x: 510, y: 160, label: 'Grade' },
  { id: 'cite', x: 660, y: 110, label: 'Cite' },
  { id: 'review', x: 820, y: 110, label: 'Review', terminal: true },
];

const graphNodeById = Object.fromEntries(graphNodes.map((node) => [node.id, node]));

const graphEdges = [
  { from: 'document', to: 'decompose' },
  { from: 'corpus', to: 'decompose' },
  { from: 'decompose', to: 'match' },
  { from: 'decompose', to: 'grade' },
  { from: 'match', to: 'grade' },
  { from: 'grade', to: 'cite' },
  { from: 'cite', to: 'review', terminal: true },
  { from: 'review', to: 'decompose', dashed: true, label: 're-check' },
];

const cycleSteps = [
  {
    step: 'Step 1',
    title: 'Decompose',
    body:
      'We break the document into atomic claims, down to the level where each one can be checked on its own. Not paragraphs — individual propositions, each independently verifiable.',
  },
  {
    step: 'Step 2',
    title: 'Search the evidence',
    body:
      'Each claim is matched against your evidence base — the corpus you supplied, not the open web. The search is scoped to what you trust and can cite.',
  },
  {
    step: 'Step 3',
    title: 'Grade and cite',
    body:
      'Every claim gets a graded verdict — Supported, Partially supported, or No support found — each linked to the exact source in your corpus. No aggregate scores, no summaries.',
  },
];

const terms = [
  {
    term: 'Supported',
    pos: 'verdict',
    def:
      'Evidence in the corpus backs the claim. The supporting passage is retrieved and cited exactly.',
  },
  {
    term: 'Partially supported',
    pos: 'verdict',
    def:
      'Some of the claim is backed; part is not, or only holds under specific conditions. Graded, non-binary — not collapsed to true or false.',
  },
  {
    term: 'No support found',
    pos: 'verdict',
    def:
      'This corpus is silent on the claim — not that the claim is wrong. Results are a starting point for a human reviewer, not a final verdict on the work.',
  },
  {
    term: 'Atomic claim',
    pos: 'noun',
    def:
      'A single proposition that can be checked independently. Telotia decomposes documents to this level before searching.',
  },
  {
    term: 'Evidence base',
    pos: 'noun',
    def:
      'The corpus you supply and trust. Telotia checks claims against this — not the open web. You choose what counts as evidence.',
  },
  {
    term: 'Decomposition',
    pos: 'noun',
    def:
      'Breaking a document into its individual atomic claims, each independently checkable. The first step before any search or grading.',
  },
];

const demonstrates = [
  'End-to-end claim decomposition on real research documents.',
  'Graded, non-binary verdicts: Supported, Partially supported, No support found.',
  'Every verdict linked to the exact passage in the corpus that supports it.',
  'The showcase runs on a fixed, citable evidence base — Concordia Design Lab publications (2006–2024).',
  '"No support found" is distinguished from "false" — the corpus is silent, not refuting.',
];

const limits = [
  'Benchmark numbers: the evaluation against SPOT / PaperBench is in progress, not yet published.',
  'The product is not yet generally available; we are in private early access.',
  '"Bring your own model" is under development — not yet a committed feature.',
  'The showcase demonstrates one trusted corpus — results on other corpora may vary.',
];

const repos = [
  {
    step: 'Get in touch',
    name: 'hello@telotia.com',
    desc:
      'We are looking for design partners in evidence-heavy fields and collaborators who want to help define what rigorous AI claim-checking looks like.',
    href: 'mailto:hello@telotia.com',
  },
  {
    step: 'Early access',
    name: 'Request access',
    desc:
      'The product is in private beta. If your work involves validating claims against a trusted evidence base, we want to hear from you.',
    href: 'mailto:hello@telotia.com',
  },
  {
    step: 'Evidence page',
    name: 'Benchmark results',
    desc:
      'We are building an open benchmark to measure how well Telotia separates supported claims from unsupported ones. Method and results will be published here — including where we fall short.',
    href: '#',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Telotia</title>
    <meta
      name="description"
      content="Give Telotia a document and a body of evidence you trust. It breaks the document into its individual claims and shows you, claim by claim, what the evidence supports — and what it doesn't."
    />
    {!isProd && <meta name="robots" content="noindex,nofollow" />}
    <style>
      @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;450;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap');

      :root {
        color-scheme: light;
        --paper: #F7F9FD;
        --paper-2: #F1F5FB;
        --paper-3: #E8EEF8;
        --paper-edge: #CBD6E8;
        --ink: #14203A;
        --ink-2: #31405F;
        --ink-3: #6A7691;
        --ink-4: #8f98bb;
        --rule: #CBD6E8;
        --rule-soft: #DDE5F0;
        --night: #0a1430;
        --night-2: #162244;
        --night-3: #1f3160;
        --night-rule: #2a3656;
        --night-ink: #f4f0ff;
        --night-ink-2: #d8d6e8;
        --night-ink-3: #b9b2d6;
        --rose: #dea193;
        --rose-soft: #b07a6a;
        --blue: #5990c0;
        --violet: #6d4bc3;
        --ocean: radial-gradient(
          ellipse 130% 90% at 50% 0%,
          #213d6f 0%,
          #0f1f44 45%,
          #060d22 100%
        );
        --font-display: 'Newsreader', 'Iowan Old Style', Georgia, serif;
        --font-sans: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont,
          'Segoe UI', system-ui, sans-serif;
        --font-mono: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace,
          SFMono-Regular, Consolas, monospace;
        --ease-paper: cubic-bezier(0.2, 0.6, 0.2, 1);
        --shadow-paper: 0 1px 0 var(--paper-edge), 0 2px 8px -4px #10182f12;
        --shadow-night: 0 18px 48px rgb(0 0 0 / 0.28);
        --moon: #f9fbff;
        --moon-2: #eef5ff;
        --moon-3: #dfeafd;
        --moon-blue: #d7e8ff;
        --blue-deep: #102a6b;
        --blue-mid: #2f6fa8;
        --blue-soft: #78aee6;
        /* App shell — always dark regardless of site theme */
        --app-shell: #071025;
        --app-rail: #0b1732;
        --app-panel: #0f1c3a;
        --app-panel-2: #132449;
        --app-line: #2a3a61;
        --app-line-soft: rgb(216 214 232 / 0.14);
        --app-muted: #9ea8ca;
        --app-faint: #707b9f;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 15px;
        line-height: 1.6;
        font-feature-settings: 'ss01', 'cv11';
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
      }

      p,
      h1,
      h2,
      h3,
      dl,
      dd {
        margin: 0;
      }

      img,
      svg {
        display: block;
      }

      .tel-page {
        min-height: 100vh;
        background:
          radial-gradient(circle at 8% 32rem, rgb(89 144 192 / 0.12), transparent 22rem),
          linear-gradient(180deg, #f6f7fb 0%, #eef1f7 100%);
      }

      .tel-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        color: var(--night-ink);
        background: rgb(6 11 26 / 0.84);
        border-bottom: 1px solid rgb(216 214 232 / 0.18);
        backdrop-filter: blur(10px);
        transition:
          color 320ms var(--ease-paper),
          background 320ms var(--ease-paper),
          border-color 320ms var(--ease-paper);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .tel-nav {
        color: var(--ink);
        background: rgb(247 249 253 / 0.90);
        border-bottom: 1px solid var(--rule-soft);
      }

      .tel-nav-inner {
        width: calc(100% - 32px);
        max-width: 1180px;
        min-height: 58px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        text-decoration: none;
      }

      .brand-mark {
        width: 22px;
        height: 22px;
        flex: 0 0 22px;
        color: var(--rose);
        background: currentColor;
        -webkit-mask: url('/assets/principia/principia-mark.svg') center /
          contain no-repeat;
        mask: url('/assets/principia/principia-mark.svg') center / contain no-repeat;
      }

      .brand-name {
        font-family: var(--font-sans);
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.22em;
        line-height: 1;
        text-transform: uppercase;
      }

      .brand-org {
        padding-left: 10px;
        border-left: 1px solid rgb(216 214 232 / 0.2);
        color: var(--night-ink-3);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        transition:
          color 320ms var(--ease-paper),
          border-color 320ms var(--ease-paper);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .brand-org {
        border-left-color: var(--rule);
        color: var(--ink-3);
      }

      .nav-links {
        display: flex;
        gap: 22px;
        align-items: center;
        margin-left: 6px;
      }

      .nav-links a,
      .repo-link {
        color: var(--night-ink-3);
        font-size: 13px;
        text-decoration: none;
        transition:
          color 140ms var(--ease-paper),
          border-color 140ms var(--ease-paper);
      }

      .nav-links a:hover,
      .repo-link:hover {
        color: var(--night-ink);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .nav-links a,
      html[data-theme="daylight"]:not([data-nav-at-hero]) .repo-link {
        color: var(--ink-3);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .nav-links a:hover,
      html[data-theme="daylight"]:not([data-nav-at-hero]) .repo-link:hover {
        color: var(--ink);
      }

      .nav-spacer {
        flex: 1;
      }

      .repo-link {
        font-family: var(--font-mono);
        font-size: 12px;
        white-space: nowrap;
      }

      .theme-switcher {
        display: flex;
        gap: 2px;
        align-items: center;
        padding: 3px;
        background: rgb(255 255 255 / 0.07);
        border-radius: 8px;
      }

      .theme-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border: 0;
        border-radius: 5px;
        background: transparent;
        color: var(--night-ink-3);
        cursor: pointer;
        transition:
          color 140ms var(--ease-paper),
          background 140ms var(--ease-paper),
          box-shadow 140ms var(--ease-paper);
      }

      .theme-btn:hover {
        color: var(--night-ink);
        background: rgb(255 255 255 / 0.07);
      }

      .theme-btn.is-active {
        color: var(--night-ink);
        background: rgb(255 255 255 / 0.11);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .theme-switcher {
        background: rgb(0 0 0 / 0.06);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .theme-btn {
        color: var(--ink-3);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .theme-btn:hover {
        color: var(--ink);
        background: rgb(0 0 0 / 0.05);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .theme-btn.is-active {
        color: var(--ink);
        background: var(--paper);
        box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
      }

      .tel-hero {
        position: relative;
        min-height: calc(100vh - 96px);
        overflow: hidden;
        color: var(--night-ink);
        background:
          /* primary violet bloom — upper right, most visible */
          radial-gradient(circle at 72% 22%, rgba(75, 46, 131, 0.28) 0%, transparent 34%),
          /* secondary cosmic indigo — lower center */
          radial-gradient(circle at 38% 64%, rgba(110, 66, 193, 0.16) 0%, transparent 30%),
          /* cool blue-violet whisper — upper left */
          radial-gradient(circle at 18% 18%, rgba(89, 144, 192, 0.12) 0%, transparent 28%),
          /* rose-gold atmospheric warmth — far right edge */
          radial-gradient(circle at 95% 55%, rgba(222, 161, 147, 0.07) 0%, transparent 22%),
          /* deep indigo field — center mass */
          radial-gradient(ellipse 110% 70% at 50% 45%, rgba(43, 47, 128, 0.18) 0%, transparent 60%),
          linear-gradient(180deg, #070A18 0%, #0B1028 55%, #060d22 100%);
      }

      .tel-hero::before,
      .tel-hero::after {
        position: absolute;
        inset: 0;
        content: '';
        pointer-events: none;
      }

      .tel-hero::before {
        background:
          radial-gradient(circle, #ffffff06 0.22px, transparent 0.42px),
          radial-gradient(circle, #ffffff09 0.26px, transparent 0.48px),
          radial-gradient(circle, #ffffff0c 0.30px, transparent 0.54px),
          url('/assets/principia/stars.svg');
        background-size:
          71px 67px,
          113px 97px,
          179px 163px,
          cover;
        background-repeat:
          repeat,
          repeat,
          repeat,
          no-repeat;
        background-position:
          0 0,
          41px 13px,
          83px 47px,
          center;
      }

      .tel-hero::after {
        opacity: 0.22;
        background: var(--night-ink);
        -webkit-mask: url('/assets/principia/constellation-bg.svg') right 6% top
          10% / min(820px, 78vw) auto no-repeat;
        mask: url('/assets/principia/constellation-bg.svg') right 6% top 10% /
          min(820px, 78vw) auto no-repeat;
      }

      html[data-theme="night"] .tel-hero::after {
        display: none;
      }

      .pull-id {
        position: absolute;
        top: 28px;
        right: max(24px, calc((100% - 1180px) / 2));
        z-index: 2;
        color: var(--night-ink-3);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .tel-hero-inner {
        position: relative;
        z-index: 1;
        width: calc(100% - 32px);
        max-width: 1180px;
        margin: 0 auto;
        padding: 102px 0 82px;
      }

      .hero-status,
      .tel-label {
        color: var(--rose);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .hero-status {
        display: flex;
        gap: 12px;
        align-items: center;
      }

      .hero-title-row {
        display: flex;
        justify-content: space-between;
        gap: clamp(22px, 4vw, 56px);
        align-items: center;
        margin-top: 18px;
      }

      .hero-copy-block {
        padding-left: clamp(24px, 4.6vw, 78px);
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--rose);
        box-shadow: 0 0 0 4px rgb(222 161 147 / 0.12);
      }

      .hero-title {
        margin: 0;
        line-height: 1;
      }

      .hero-wordmark {
        display: block;
        width: clamp(280px, 42vw, 640px);
        height: auto;
      }

      .decor-animation {
        position: relative;
        flex: 0 0 auto;
        overflow: visible;         /* no container clipping — animation breathes freely */
        background: transparent;
        mix-blend-mode: screen;
        pointer-events: none;
      }

      /* canvas is larger than its layout anchor and extends in all directions */
      .decor-animation canvas {
        position: absolute;
        display: block;
      }

      .decor-animation-chaotic {
        width: clamp(360px, 42vw, 560px);
        height: clamp(220px, 25vw, 340px);
        opacity: 0.92;
        margin-top: -22px;
      }

      .decor-animation-chaotic canvas {
        top: -40%;
        left: -8%;
        width: 146%;
        height: 182%;
      }

      .decor-animation-circle {
        width: clamp(180px, 20vw, 240px);
        height: clamp(180px, 20vw, 240px);
      }

      .decor-animation-circle canvas {
        top: -55%;
        left: -55%;
        width: 210%;
        height: 210%;
      }

      .hero-thesis {
        max-width: min(1040px, 100%);
        margin-top: 34px;
        color: var(--night-ink-2);
        font-family: var(--font-display);
        font-size: clamp(46px, 4.4vw, 78px);
        font-weight: 340;
        line-height: 1.06;
        overflow-wrap: break-word;
        white-space: normal;
      }

      .hero-line {
        display: block;
      }

      .hero-thesis em,
      .section-title em,
      .cycle dd em,
      .assessment-note em {
        color: var(--rose);
        font-family: var(--font-display);
        font-style: italic;
      }

      .hero-copy {
        max-width: 880px;
        margin-top: 42px;
        color: var(--night-ink-2);
        font-family: var(--font-display);
        font-size: clamp(23px, 1.6vw, 29px);
        font-weight: 340;
        line-height: 1.48;
        overflow-wrap: break-word;
        white-space: normal;
      }

      .hero-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 48px;
        max-width: min(980px, 100%);
        margin-top: 40px;
      }

      .hero-meta .cell {
        padding-top: 12px;
        border-top: 1px solid rgb(216 214 232 / 0.2);
      }

      .meta-label,
      .term-pos,
      .card h3,
      .repo-step {
        color: var(--ink-3);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .hero-meta .meta-label {
        color: var(--night-ink-3);
      }

      .meta-value {
        margin-top: 5px;
        color: var(--night-ink);
        font-family: var(--font-display);
        font-size: 18px;
      }

      .hero-cta-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 36px;
      }

      .hero-cta-primary,
      .hero-cta-secondary {
        display: inline-flex;
        align-items: center;
        padding: 10px 22px;
        border-radius: 6px;
        font-family: var(--font-sans);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background 200ms var(--ease-paper), color 200ms var(--ease-paper);
      }

      .hero-cta-primary {
        background: rgb(255 255 255 / 0.92);
        color: #0a1430;
      }

      .hero-cta-primary:hover { background: #ffffff; }

      .hero-cta-secondary {
        background: rgb(255 255 255 / 0.10);
        color: var(--night-ink);
        border: 1px solid rgb(255 255 255 / 0.18);
      }

      .hero-cta-secondary:hover { background: rgb(255 255 255 / 0.15); }

      html[data-theme="daylight"] .hero-cta-primary {
