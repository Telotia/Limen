---
import devStatus from '../data/dev-status.json';

const limenEnv = process.env.LIMEN_ENV ?? 'dev';
const isProd = limenEnv === 'prod';

const completedItems = devStatus.items.filter((item) => item.status === 'done');
const openItems = devStatus.items.filter((item) => item.status !== 'done');

const flowSteps = [
  {
    title: 'Feature work',
    steps: [
      'Branch from dev with feature/<short-name>.',
      'Open a PR into dev with a conventional title.',
      'Squash-merge after CI is green.',
      'Merge deploys the debug dashboard to dev.telotia.com.',
    ],
  },
  {
    title: 'Production release',
    steps: [
      'Open a release PR from dev into main.',
      'Use a conventional release PR title.',
      'Merge commit into main to preserve dev history.',
      'Main deploys telotia.com, smoke-tests it, then publishes a GitHub release.',
    ],
  },
  {
    title: 'Hotfix',
    steps: [
      'Branch directly from main when production is blocked.',
      'Open the PR into main with a fix(<scope>) title.',
      'After merge and deploy, merge main back into dev.',
      'Use only for urgent production fixes.',
    ],
  },
];

const commandGroups = [
  {
    title: 'Local',
    commands: [
      'bun install',
      'bun run dev',
      'bun run check',
      'bun test',
      'bun run build:dev',
      'bun run build:prod',
    ],
  },
  {
    title: 'Cloudflare',
    commands: [
      'bun run smoke:dev',
      'bun run cf:deploy:dev',
      'bun run smoke:prod',
      'bunx wrangler deploy --env production --dry-run',
    ],
  },
];

const links = [
  { label: 'Dev dashboard', href: 'https://dev.telotia.com' },
  { label: 'Production', href: 'https://telotia.com' },
  { label: 'Fallback dev URL', href: 'https://limen-dev.pdec-prog.workers.dev' },
  { label: 'Releases', href: 'https://github.com/Telotia/Limen/releases' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{isProd ? 'Telotia' : 'Limen dev dashboard'}</title>
    <meta
      name="description"
      content={isProd ? 'Telotia' : 'Limen development dashboard'}
    />
    {!isProd && <meta name="robots" content="noindex,nofollow" />}
    <style>
      :root {
        color-scheme: light;
        --bg: #f7f7f4;
        --surface: #ffffff;
        --surface-muted: #f1f4f2;
        --ink: #17201d;
        --muted: #62716a;
        --border: #dce3df;
        --green: #1d7f59;
        --green-soft: #dff2e9;
        --blue: #315f8c;
        --blue-soft: #e3edf7;
        --amber: #9c6323;
        --amber-soft: #f7ead7;
        --shadow: 0 18px 50px rgb(24 38 31 / 0.08);
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          'Segoe UI', sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          linear-gradient(180deg, rgb(255 255 255 / 0.72), transparent 28rem),
          var(--bg);
        color: var(--ink);
        line-height: 1.5;
      }

      a {
        color: inherit;
      }

      main {
        width: min(72rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 2rem 0 3rem;
      }

      .shell {
        display: grid;
        gap: 1.25rem;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1.5rem;
        align-items: end;
        padding: 2rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        box-shadow: var(--shadow);
      }

      .eyebrow {
        margin: 0 0 0.5rem;
        color: var(--blue);
        font-size: 0.8125rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      h1 {
        font-size: 2.375rem;
        line-height: 1.1;
        font-weight: 720;
      }

      h2 {
        font-size: 1.125rem;
        line-height: 1.25;
      }

      h3 {
        font-size: 0.9375rem;
      }

      .lede {
        max-width: 48rem;
        margin-top: 0.75rem;
        color: var(--muted);
      }

      .live-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 2.25rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid #b7dbc8;
        border-radius: 999px;
        background: var(--green-soft);
        color: #145f42;
        font-size: 0.8125rem;
        font-weight: 700;
        white-space: nowrap;
      }

      .live-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: var(--green);
      }

      .metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
      }

      .metric {
        min-height: 6rem;
        padding: 1rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
      }

      .metric strong {
        display: block;
        font-size: 1.5rem;
        line-height: 1.1;
      }

      .metric span {
        display: block;
        margin-top: 0.35rem;
        color: var(--muted);
        font-size: 0.8125rem;
      }

      .grid {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.75fr);
        gap: 1.25rem;
        align-items: start;
      }

      .section {
        padding: 1.25rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
      }

      .section-head {
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }

      .section-note {
        color: var(--muted);
        font-size: 0.875rem;
      }

      .checklist {
        display: grid;
        gap: 0.625rem;
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .task {
        display: grid;
        grid-template-columns: 1.5rem minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: start;
        padding: 0.875rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fcfdfc;
      }

      .task[data-status='done'] {
        background: #f6fbf8;
        border-color: #cbe6d8;
      }

      .checkbox {
        position: relative;
        width: 1.125rem;
        height: 1.125rem;
        margin-top: 0.125rem;
        border: 1.5px solid #9aaba3;
        border-radius: 4px;
        background: var(--surface);
      }

      .task[data-status='done'] .checkbox {
        border-color: var(--green);
        background: var(--green);
      }

      .task[data-status='done'] .checkbox::after {
        position: absolute;
        left: 0.33rem;
        top: 0.12rem;
        width: 0.28rem;
        height: 0.58rem;
        border: solid white;
        border-width: 0 0.125rem 0.125rem 0;
        content: '';
        transform: rotate(45deg);
      }

      .task-title {
        display: block;
        font-weight: 650;
      }

      .task-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.45rem;
      }

      .tag {
        display: inline-flex;
        align-items: center;
        min-height: 1.5rem;
        padding: 0.1875rem 0.5rem;
        border-radius: 999px;
        background: var(--surface-muted);
        color: var(--muted);
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
      }

      .tag.done {
        background: var(--green-soft);
        color: #145f42;
      }

      .tag.todo {
        background: var(--amber-soft);
        color: var(--amber);
      }

      .owner {
        align-self: start;
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-size: 0.75rem;
      }

      .playbook {
        display: grid;
        gap: 0.75rem;
      }

      .flow {
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fcfdfc;
      }

      .flow ol,
      .notes {
        padding-left: 1.15rem;
        margin: 0.75rem 0 0;
      }

      .flow li,
      .notes li {
        margin-top: 0.35rem;
        color: var(--muted);
      }

      .links {
        display: grid;
        gap: 0.5rem;
      }

      .link-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 2.75rem;
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fcfdfc;
        font-weight: 650;
        text-decoration: none;
      }

      .link-row span {
        color: var(--muted);
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-size: 0.75rem;
        font-weight: 500;
      }

      .command-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }

      .commands {
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fcfdfc;
      }

      .commands ul {
        display: grid;
        gap: 0.5rem;
        padding: 0;
        margin: 0.75rem 0 0;
        list-style: none;
      }

      code {
        display: inline-block;
        max-width: 100%;
        padding: 0.125rem 0.35rem;
        overflow-wrap: anywhere;
        border-radius: 4px;
        background: #eef3f0;
        color: #25362f;
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-size: 0.8125rem;
      }

      .notice {
        border-color: #ead3aa;
        background: #fffaf0;
      }

      .notice h2 {
        color: #6f471c;
      }

      footer {
        color: var(--muted);
        font-size: 0.8125rem;
      }

      @media (max-width: 56rem) {
        main {
          width: min(100% - 1rem, 72rem);
          padding-top: 0.5rem;
        }

        .hero,
        .grid,
        .metrics,
        .command-grid {
          grid-template-columns: 1fr;
        }

        .hero {
          padding: 1.25rem;
        }

        h1 {
          font-size: 1.875rem;
        }

        .task {
          grid-template-columns: 1.5rem minmax(0, 1fr);
        }

        .owner {
          grid-column: 2;
        }

        .link-row {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    </style>
  </head>
  <body>
    <main>
      {
        isProd ? (
          <>
            <h1>Telotia</h1>
            <p class="lede">Coming soon.</p>
          </>
        ) : (
          <div class="shell">
            <header class="hero">
              <div>
                <p class="eyebrow">Limen operations</p>
                <h1>Development dashboard</h1>
                <p class="lede">
                  The Telotia site is live in two tracks: dev is the working
                  dashboard for contributors, and main is the production
                  release path for telotia.com.
                </p>
              </div>
              <span class="live-pill">
                <span class="live-dot"></span>
                dev.telotia.com live
              </span>
            </header>

            <section class="metrics" aria-label="Project status summary">
              <div class="metric">
                <strong>{completedItems.length}/{devStatus.items.length}</strong>
                <span>setup items complete</span>
              </div>
              <div class="metric">
                <strong>{openItems.length}</strong>
                <span>open project tasks</span>
              </div>
              <div class="metric">
                <strong>dev</strong>
                <span>merges deploy the debug dashboard</span>
              </div>
              <div class="metric">
                <strong>main</strong>
                <span>releases deploy telotia.com</span>
              </div>
            </section>

            <div class="grid">
              <section class="section">
                <div class="section-head">
                  <div>
                    <h2>Setup checklist</h2>
                    <p class="section-note">
                      Cloudflare, GitHub, and project launch readiness.
                    </p>
                  </div>
                  <span class="tag done">{completedItems.length} done</span>
                </div>

                <ul class="checklist">
                  {devStatus.items.map((item) => (
                    <li class="task" data-status={item.status}>
                      <span
                        class="checkbox"
                        aria-label={item.status === 'done' ? 'Done' : 'Todo'}
                      ></span>
                      <span>
                        <span class="task-title">{item.text}</span>
                        <span class="task-meta">
                          <span
                            class:list={[
                              'tag',
                              item.status === 'done' ? 'done' : 'todo',
                            ]}
                          >
                            {item.status === 'done' ? 'Done' : 'Todo'}
                          </span>
                        </span>
                      </span>
                      <span class="owner">{item.owner ?? 'unassigned'}</span>
                    </li>
                  ))}
                </ul>
              </section>

              <aside class="section">
                <div class="section-head">
                  <div>
                    <h2>Live surfaces</h2>
                    <p class="section-note">Primary URLs for smoke tests.</p>
                  </div>
                </div>
                <div class="links">
                  {links.map((link) => (
                    <a class="link-row" href={link.href}>
                      {link.label}
                      <span>{link.href.replace('https://', '')}</span>
                    </a>
                  ))}
                </div>
              </aside>
            </div>

            <section class="section">
              <div class="section-head">
                <div>
                  <h2>Branch and deploy playbook</h2>
                  <p class="section-note">
                    Use this flow for everyday work, production releases, and
                    urgent fixes.
                  </p>
                </div>
              </div>

              <div class="playbook">
                {flowSteps.map((flow) => (
                  <article class="flow">
                    <h3>{flow.title}</h3>
                    <ol>
                      {flow.steps.map((step) => (
                        <li>{step}</li>
                      ))}
                    </ol>
                  </article>
                ))}
              </div>
            </section>

            <section class="section">
              <div class="section-head">
                <div>
                  <h2>Common commands</h2>
                  <p class="section-note">
                    Prefer Bun for JavaScript work and Wrangler for Cloudflare.
                  </p>
                </div>
              </div>
              <div class="command-grid">
                {commandGroups.map((group) => (
                  <div class="commands">
                    <h3>{group.title}</h3>
                    <ul>
                      {group.commands.map((command) => (
                        <li>
                          <code>{command}</code>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </section>

            <section class="section notice">
              <h2>Temporary Cloudflare custody</h2>
              <ul class="notes">
                <li>
                  Telotia domains and Workers temporarily live in the Pdec
                  Cloudflare account until the registrar transfer lock clears.
                </li>
                <li>
                  Keep <code>pdec.prog@gmail.com</code> as a break-glass admin
                  on the future Telotia account to avoid a Google Workspace
                  lockout loop.
                </li>
                <li>
                  GitHub Actions should use a Cloudflare token scoped to account
                  <code>f39fc97d0e872ca3c6cad23b1a7561d6</code> and the
                  <code>telotia.com</code> zone during the temporary period.
                </li>
              </ul>
            </section>

            <footer>
              Limen is the repo codename. Telotia is the public brand. Keep PR
              titles conventional: <code>type(scope): subject</code>.
            </footer>
          </div>
        )
      }
    </main>
  </body>
</html>
