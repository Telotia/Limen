        }

        .pull-id {
          display: none;
        }

        .tel-hero-inner {
          padding: 78px 0 68px;
        }

        .hero-copy-block {
          padding-left: 0;
        }

        .hero-title-row {
          align-items: flex-start;
        }

        .decor-animation-chaotic {
          width: clamp(260px, 40vw, 360px);
          height: 200px;
        }

        .install-heading-row {
          grid-template-columns: 1fr;
        }

        .decor-animation-circle {
          justify-self: start;
        }

        .app-preview-shell {
          min-height: 0;
        }

        .app-workspace {
          grid-template-columns: 52px minmax(0, 1fr);
        }

        .app-eventlog {
          grid-column: 1 / -1;
          border-top: 1px solid var(--app-line-soft);
          border-left: 0;
        }

        .event-list {
          max-height: 15rem;
        }

        .hero-title {
          font-size: 54px;
        }

        .hero-thesis {
          font-size: 34px;
          line-height: 1.12;
        }

        .hero-meta,
        .vocab-grid,
        .install-meta,
        .assessment-grid,
        .repo-chain {
          grid-template-columns: 1fr;
        }

        .install-meta .cell {
          border-right: 0;
          border-bottom: 1px solid var(--rule);
        }

        .install-meta .cell:last-child {
          border-bottom: 0;
        }

        .cycle {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .cycle dd {
          margin-bottom: 22px;
        }

        .footer-bottom {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 560px) {
        .tel-nav-inner,
        .tel-container,
        .tel-hero-inner,
        .footer-inner {
          width: calc(100% - 24px);
        }

        .brand-org {
          display: none;
        }

        .tel-hero {
          min-height: calc(100vh - 80px);
        }

        .tel-hero::after {
          opacity: 0.12;
        }

        .tel-hero-inner {
          padding: 62px 0 56px;
        }

        .app-topbar {
          grid-template-columns: 1fr;
          align-items: start;
        }

        .session-chip {
          justify-self: stretch;
          overflow-wrap: anywhere;
        }

        .app-workspace {
          grid-template-columns: 1fr;
        }

        .app-rail {
          flex-direction: row;
          justify-content: flex-start;
          overflow-x: auto;
          border-right: 0;
          border-bottom: 1px solid var(--app-line-soft);
        }

        .app-main {
          padding: 14px;
        }

        .telos-card h2 {
          font-size: 22px;
        }

        .demo-graph-panel {
          min-height: 17rem;
        }

        .demo-graph-panel svg {
          min-height: 17rem;
        }

        .event-row {
          grid-template-columns: 5.4rem minmax(0, 1fr);
        }

        .hero-title-row {
          flex-direction: column;
          gap: 16px;
        }

        .decor-animation-chaotic {
          width: min(100%, 300px);
          height: 160px;
          margin-top: 0;
        }

        .decor-animation-circle {
          width: 160px;
          height: 160px;
        }

        .mockup-demo-head {
          align-items: flex-start;
          flex-direction: column;
        }

        .hero-title {
          font-size: 42px;
        }

        .hero-thesis {
          font-size: 29px;
          width: 100%;
          max-width: calc(100vw - 48px);
        }

        .hero-copy,
        .section-lede {
          font-size: 18px;
        }

        .hero-copy {
          width: 100%;
          max-width: calc(100vw - 48px);
        }

        .section-title {
          font-size: 34px;
        }

        .tel-section {
          padding: 66px 0;
        }

        .graph-panel,
        .install-block {
          padding: 20px 16px;
        }

        .graph-head {
          align-items: flex-start;
          flex-direction: column;
        }

        .term-card {
          min-height: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 1ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 1ms !important;
        }
      }
    </style>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var resolved;
        if (stored === 'night' || stored === 'daylight') {
          resolved = stored;
        } else {
          resolved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'daylight';
        }
        document.documentElement.setAttribute('data-theme', resolved);
        document.documentElement.setAttribute('data-theme-pref', stored || 'system');
      })();
    </script>
  </head>
  <body>
    <div class="tel-page">
      <svg class="constellation-field" data-constellation-field aria-hidden="true"></svg>
      <div class="twinkle-field" data-star-field aria-hidden="true"></div>
      <nav class="tel-nav" aria-label="Primary navigation">
        <div class="tel-nav-inner">
          <a class="brand" href="/" aria-label="Principia home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">TELOTIA</span>
            <span class="brand-org">Principia · v0.1.0</span>
          </a>
          <div class="nav-links" aria-label="Page sections">
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
          <span class="nav-spacer"></span>
          <div class="theme-switcher" aria-label="Theme">
            <button class="theme-btn" data-theme-value="daylight" title="Daylight">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <circle cx="7" cy="7" r="3" stroke="currentColor" stroke-width="1.3"/>
                <line x1="7" y1="0.5" x2="7" y2="2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="7" y1="11.5" x2="7" y2="13.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="0.5" y1="7" x2="2.5" y2="7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="11.5" y1="7" x2="13.5" y2="7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="2.6" y1="2.6" x2="3.9" y2="3.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="10.1" y1="10.1" x2="11.4" y2="11.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="11.4" y1="2.6" x2="10.1" y2="3.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="3.9" y1="10.1" x2="2.6" y2="11.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>
            <button class="theme-btn" data-theme-value="night" title="Night">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M12.5 9.5A6 6 0 1 1 4.5 1.5a4.3 4.3 0 0 0 8 8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
              </svg>
            </button>
            <button class="theme-btn" data-theme-value="system" title="System">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <rect x="1" y="2" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                <line x1="7" y1="10" x2="7" y2="12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="4.5" y1="12.5" x2="9.5" y2="12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <a class="repo-link" href="https://github.com/Telotia/Principia">
            github.com/Telotia/Principia &nearr;
          </a>
        </div>
      </nav>

      <main>
        <section class="tel-hero" aria-labelledby="hero-title">
          <div class="tel-hero-inner">
            <div class="hero-copy-block">
              <div class="hero-status">
                <span class="status-dot"></span>
                principia / v0.1.0 / alpha
              </div>
              <div class="hero-title-row">
                <h1 class="hero-title" id="hero-title">TELOTIA</h1>
                <div class="decor-animation decor-animation-chaotic" aria-hidden="true">
                  <canvas data-decor-animation="chaotic"></canvas>
                </div>
              </div>
              <p class="hero-thesis">
                <span class="hero-line">An <em>epistemic being.</em></span>
                <span class="hero-line">Not a coding agent.</span>
                <span class="hero-line">There is no deliverable.</span>
              </p>
              <p class="hero-copy">
                <span class="hero-line">Principia takes a single seed.</span>
                <span class="hero-line">
                  It lives inside that seed as an investigation.
                </span>
                <span class="hero-line">
                  Each pass records what was honestly earned.
                </span>
                <span class="hero-line">
                  The work ends when no productive framing is left.
                </span>
              </p>
              <div class="hero-meta" aria-label="Kernel facts">
                {
                  heroMeta.map((item) => (
                    <div class="cell">
                      <div class="meta-label">{item.label}</div>
                      <div class="meta-value">{item.value}</div>
                    </div>
                  ))
                }
              </div>
            </div>

          </div>
        </section>

        <section class="tel-section paper-section" id="organism">
          <div class="tel-container">
            <div class="tel-label">The Organism</div>
            <h2 class="section-title">
              One seed. Eight chambers. <em>One death.</em>
            </h2>
            <p class="section-lede">
              Every Chamber except Slice oscillates the same way: a Constructor
              proposes, a Critic presses, a convergence check decides whether to
              iterate, and a Stabilizer crystallizes what the engagement
              honestly earned.
            </p>

            <div class="graph-panel" aria-label="Chamber graph">
              <div class="graph-head">
                <div class="graph-title">Chamber graph / canonical ontology v4</div>
                <div class="legend" aria-label="Graph legend">
                  <span><span class="swatch active"></span>active</span>
                  <span><span class="swatch complete"></span>completed</span>
                  <span><span class="swatch reentry"></span>re-entry</span>
                </div>
              </div>
              <div class="graph-scroll">
                <svg
                  viewBox="0 0 900 240"
                  preserveAspectRatio="xMidYMid meet"
                  width="100%"
                  height="240"
                  role="img"
                  aria-labelledby="graph-title"
                >
                  <title id="graph-title">Principia chamber graph</title>
                  {
                    graphEdges.map((edge) => {
                      const from = graphNodeById[edge.from];
                      const to = graphNodeById[edge.to];
                      const dashed = edge.dashed || edge.terminal;
                      const activeEdge = !dashed && (from.active || to.active);

                      return (
                        <g>
                          <line
                            x1={from.x}
                            y1={from.y}
