      html[data-theme="night"] .tel-hero {
        min-height: calc(100vh - 58px);
      }

      html[data-theme="night"] .tel-hero-inner {
        display: block;
        padding: 78px 0 64px;
      }

      html[data-theme="night"] .hero-copy-block {
        max-width: 1180px;
      }

      html[data-theme="night"] .hero-copy {
        max-width: 660px;
      }

      html[data-theme="night"] .hero-meta {
        max-width: min(980px, 100%);
      }

      .app-preview-shell {
        position: relative;
        z-index: 1;
        min-height: 36rem;
        overflow: hidden;
        background:
          linear-gradient(135deg, rgb(14 26 54 / 0.94), rgb(7 16 37 / 0.96)),
          #071025;
        border: 1px solid var(--app-line-soft);
        border-radius: 12px;
        box-shadow: var(--shadow-night);
      }

      .app-preview-shell::before {
        position: absolute;
        inset: 0;
        background-image:
          radial-gradient(#ffffff16 0.6px, transparent 0.7px),
          radial-gradient(#dea19310 0.5px, transparent 0.6px);
        background-size: 18px 18px, 11px 13px;
        content: '';
        pointer-events: none;
      }

      .app-topbar,
      .app-workspace,
      .app-rail,
      .app-main,
      .app-eventlog {
        position: relative;
      }

      .app-topbar {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 16px;
        align-items: center;
        min-height: 56px;
        padding: 10px 14px;
        background: rgb(244 240 255 / 0.035);
        border-bottom: 1px solid var(--app-line-soft);
      }

      .app-brand {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        color: var(--night-ink);
        font-family: var(--font-display);
        font-size: 18px;
      }

      .session-chip {
        justify-self: end;
        padding: 6px 12px;
        color: var(--night-ink-3);
        background: rgb(244 240 255 / 0.045);
        border: 1px solid var(--app-line-soft);
        border-radius: 6px;
        font-family: var(--font-mono);
        font-size: 12px;
      }

      .chamber-button,
      .app-icon-button {
        border: 1px solid var(--app-line-soft);
        color: var(--night-ink-3);
        background: rgb(244 240 255 / 0.04);
        font: inherit;
        transition:
          color 120ms var(--ease-paper),
          background 120ms var(--ease-paper),
          border-color 120ms var(--ease-paper);
      }

      .chamber-button.is-active {
        color: var(--night-ink);
        background: rgb(222 161 147 / 0.14);
        border-color: rgb(222 161 147 / 0.44);
      }

      .app-workspace {
        display: grid;
        grid-template-columns: 56px minmax(0, 1fr) minmax(18rem, 0.55fr);
        min-height: 31rem;
      }

      .app-rail {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
        padding: 14px 8px;
        background: rgb(6 13 34 / 0.58);
        border-right: 1px solid var(--app-line-soft);
      }

      .chamber-button {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border-radius: 8px;
        cursor: pointer;
      }

      .chamber-glyph {
        width: 16px;
        height: 16px;
        display: block;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 1;
        stroke-linecap: round;
      }

      .app-main {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        gap: 14px;
        padding: 18px;
      }

      .telos-card,
      .slice-drawer {
        background: rgb(244 240 255 / 0.045);
        border: 1px solid var(--app-line-soft);
        border-radius: 8px;
      }

      .telos-card {
        padding: 18px;
      }

      .telos-card-header {
        display: flex;
        gap: 14px;
        justify-content: space-between;
        color: var(--night-ink-3);
        font-size: 11px;
        text-transform: uppercase;
      }

      .telos-card h2 {
        max-width: 42rem;
        margin-top: 12px;
        color: var(--night-ink);
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 400;
        line-height: 1.18;
      }

      .telos-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 14px;
        color: var(--app-muted);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .demo-graph-panel {
        position: relative;
        min-height: 19rem;
        overflow: hidden;
        background:
          radial-gradient(circle at 76% 26%, rgb(222 161 147 / 0.14), transparent 12rem),
          #050a1f;
        border: 1px solid var(--app-line-soft);
        border-radius: 8px;
      }

      .demo-graph-panel svg {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        min-height: 19rem;
      }

      .animation-panel-label {
        position: absolute;
        top: 14px;
        left: 16px;
        z-index: 1;
        color: var(--night-ink-3);
        font-size: 11px;
        text-transform: uppercase;
      }

      .active-chamber-readout {
        position: absolute;
        right: 16px;
        bottom: 14px;
        z-index: 1;
        color: var(--rose);
        font-family: var(--font-mono);
        font-size: 12px;
      }

      .slice-drawer {
        display: grid;
        gap: 8px;
        padding: 12px;
      }

      /* ── Gradient-bar slice cards ── */
      .slice-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(16, 42, 107, 0.72) 0%, rgba(13, 18, 42, 0.94) 100%);
        border: 1px solid rgba(244, 240, 255, 0.12);
        border-radius: 8px;
        padding: 11px 13px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 5px 10px;
        align-items: start;
        cursor: pointer;
        color: #F4F0FF;
        text-align: left;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 8px 20px rgba(0, 0, 0, 0.28);
        transition: filter 120ms var(--ease-paper);
      }

      .slice-card:hover { filter: brightness(1.07); }
      .slice-card[aria-selected="true"] {
        box-shadow: 0 0 0 1.5px rgba(244, 240, 255, 0.38) inset, 0 8px 20px rgba(0, 0, 0, 0.35);
      }

      /* Gradient bar at bottom — the verdict signal */
      .slice-card::after {
        content: "";
        position: absolute;
        left: 0; right: 0; bottom: 0;
        height: 3px;
        background: var(--slice-gradient);
        opacity: 0.95;
        box-shadow: 0 -6px 16px var(--slice-glow);
      }

      .slice-card--partial {
        --slice-state: #CCA273;
        --slice-soft: rgba(204, 162, 115, 0.16);
        --slice-glow: rgba(204, 162, 115, 0.26);
        --slice-gradient: linear-gradient(90deg, #102A6B 0%, #5990C0 45%, #CCA273 100%);
      }
      .slice-card--proven {
        --slice-state: #5990C0;
        --slice-soft: rgba(89, 144, 192, 0.16);
        --slice-glow: rgba(89, 144, 192, 0.26);
        --slice-gradient: linear-gradient(90deg, #5990C0 0%, #2F6FA8 45%, #102A6B 100%);
      }
      .slice-card--open {
        --slice-state: #7E879D;
        --slice-soft: rgba(126, 135, 157, 0.14);
        --slice-glow: rgba(126, 135, 157, 0.20);
        --slice-gradient: linear-gradient(90deg, #102A6B 0%, #34304F 50%, #7E879D 100%);
      }
      .slice-card--falsified {
        --slice-state: #DEA193;
        --slice-soft: rgba(222, 161, 147, 0.16);
        --slice-glow: rgba(222, 161, 147, 0.24);
        --slice-gradient: linear-gradient(90deg, #102A6B 0%, #6E42C1 48%, #DEA193 100%);
      }

      .slice-card-title {
        display: block;
        color: #F4F0FF;
        font-family: var(--font-display);
        font-size: 14px;
        font-weight: 420;
        line-height: 1.3;
      }

      .slice-card-meta {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
        font-size: 10px;
        color: rgba(244, 240, 255, 0.58);
        margin-top: 3px;
      }

      .slice-card-meta b { color: rgba(244, 240, 255, 0.9); font-weight: 500; }

      .slice-note {
        font-family: var(--font-display);
        font-style: italic;
        color: rgba(244, 240, 255, 0.72);
      }

      .slice-card-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
        padding-top: 1px;
      }

      .slice-verdict-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 8px 2px 6px;
        border-radius: 999px;
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.04em;
        background: var(--slice-soft);
        border: 1px solid color-mix(in srgb, var(--slice-state) 42%, transparent);
        color: #F4F0FF;
        white-space: nowrap;
      }

      .pill-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--slice-state);
        flex-shrink: 0;
      }

      .app-eventlog {
        overflow: hidden;
        background: rgb(5 10 31 / 0.72);
        border-left: 1px solid var(--app-line-soft);
      }

      .eventlog-head {
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        color: var(--night-ink);
        border-bottom: 1px solid var(--app-line-soft);
        font-family: var(--font-display);
        font-size: 18px;
      }

      .eventlog-session {
        color: var(--night-ink-3);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .event-list {
        display: grid;
        gap: 0;
        max-height: 28rem;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 6px 0;
      }

      .event-row {
        display: grid;
        grid-template-columns: 5.6rem minmax(0, 1fr);
        gap: 4px 10px;
        padding: 9px 14px;
        color: var(--night-ink-2);
        border-bottom: 1px solid rgb(216 214 232 / 0.07);
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 1.45;
      }

      .event-row.is-highlighted {
        background: rgb(222 161 147 / 0.1);
      }

      .event-time {
        grid-row: 1 / span 2;
        color: var(--app-faint);
      }

      .event-chamber {
        grid-column: 2;
        color: var(--night-ink);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .event-detail {
        grid-column: 2;
        color: var(--app-muted);
        overflow-wrap: break-word;
      }

      /* ── Slice detail slide-over panel (in-app, not page-level) ── */
      .slice-detail-overlay {
        position: absolute;
        top: 56px; /* sits below the app topbar */
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(7, 16, 37, 0.55);
        z-index: 200;
        display: flex;
        justify-content: flex-end;
      }

      .slice-detail-overlay[aria-hidden="true"] {
        display: none;
      }

      .slice-detail-panel {
        width: min(600px, 78%);
        height: 100%;
        background: linear-gradient(180deg, rgba(13, 18, 42, 0.97) 0%, rgba(5, 8, 22, 0.99) 100%);
        border-left: 1px solid rgba(244, 240, 255, 0.12);
        box-shadow: -18px 0 42px rgba(0, 0, 0, 0.32);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: slid-in 280ms cubic-bezier(0.2, 0.6, 0.2, 1);
      }

      @keyframes slid-in {
        from { transform: translateX(20px); opacity: 0; }
        to   { transform: none; opacity: 1; }
      }

      .slice-detail-head {
        padding: 14px 20px;
        border-bottom: 1px solid var(--app-line-soft);
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
      }

      .slice-detail-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px 3px 8px;
        border-radius: 999px;
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.04em;
        border: 1px solid transparent;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .slice-detail-pill--partial  { background:#ECDFC020; color:#CCA273; border-color:#CCA27344; }
      .slice-detail-pill--proven   { background:#5990C020; color:#5990C0; border-color:#5990C044; }
      .slice-detail-pill--open     { background:#7E879D20; color:#9EA8CA; border-color:#7E879D44; }
      .slice-detail-pill--falsified{ background:#DEA19320; color:#DEA193; border-color:#DEA19344; }
      .slice-detail-pill .pill-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

      .slice-detail-id {
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--night-ink);
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .slice-detail-close {
        background: transparent;
        border: 1px solid transparent;
        color: var(--night-ink-3);
        font-family: var(--font-sans);
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 4px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
      }

      .slice-detail-close:hover {
        color: var(--night-ink);
        background: rgba(244, 240, 255, 0.06);
      }

      .slice-detail-body {
        flex: 1;
        overflow-y: auto;
        padding: 18px 22px 60px;
      }

      .slice-detail-label {
        font-family: var(--font-sans);
        font-size: 10px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--night-ink-3);
        margin: 18px 0 7px;
      }

      .slice-detail-label:first-child { margin-top: 0; }

      .slice-detail-quote {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 16px;
        line-height: 1.5;
        color: var(--night-ink);
        padding-left: 13px;
        border-left: 1px solid var(--night-ink-3);
        margin: 0 0 10px;
      }

      .slice-detail-body p {
        color: var(--night-ink-2);
        font-size: 13px;
        line-height: 1.6;
        margin: 0 0 8px;
      }

      .slice-detail-kv {
        display: grid;
        grid-template-columns: 116px 1fr;
        gap: 5px 14px;
        font-size: 12px;
      }

      .slice-detail-kv dt { color: var(--night-ink-3); }
      .slice-detail-kv dd {
        color: var(--night-ink);
        margin: 0;
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .slice-detail-kv dd.sd-note {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 12px;
      }

      .slice-detail-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 4px;
      }

      .slice-action-btn {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 500;
        padding: 5px 11px;
        border-radius: 4px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border: 1px solid transparent;
        transition: background 120ms var(--ease-paper), border-color 120ms;
      }

      .slice-action-primary {
        background: var(--rose);
        color: #10182f;
        border-color: var(--rose-soft);
      }

      .slice-action-secondary {
        background: transparent;
        color: var(--night-ink);
        border-color: var(--night-ink-3);
      }

      .slice-action-secondary:hover { border-color: var(--night-ink); background: rgba(244, 240, 255, 0.06); }

      .slice-action-quiet {
        background: transparent;
        color: var(--night-ink-2);
      }

      .slice-action-quiet:hover { color: var(--night-ink); background: rgba(244, 240, 255, 0.06); }

      .vivarium-section {
        padding-top: 72px;
      }

      .vivarium-frame {
        margin-top: 34px;
      }

      .install-heading-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: clamp(28px, 7vw, 90px);
        align-items: center;
      }

      .install-heading-copy {
        min-width: 0;
      }

      .app-demo-block {
        margin-top: 42px;
      }

      .mockup-demo-head {
        display: flex;
        gap: 18px;
        align-items: end;
        justify-content: space-between;
        margin-bottom: 16px;
      }

      .mockup-demo-note {
        max-width: 38rem;
        margin: 0;
        color: var(--ink-3);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      /* Continuous site fields: sections sit on the same atmosphere. */
      .tel-page {
        position: relative;
        overflow: hidden;
        isolation: isolate;
      }

      .tel-page::before {
        position: absolute;
        inset: 0;
        z-index: 0;
        content: '';
        pointer-events: none;
      }

      .tel-page::after {
        position: absolute;
        inset: 0;
        z-index: 0;
        content: '';
        pointer-events: none;
      }

      .constellation-field,
      .twinkle-field {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .constellation-field {
        width: 100%;
        color: rgb(216 214 232 / 0.78);
      }

      :global(.constellation-thread) {
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.05;
        opacity: var(--constellation-opacity, 0.46);
      }

      :global(.constellation-node) {
        fill: currentColor;
        opacity: var(--constellation-node-opacity, 0.72);
      }

      :global(.constellation-node.is-anchor) {
        fill: rgb(236 169 147 / 0.92);
      }

      :global(.paper-watermark) {
        fill: none;
        stroke: rgb(112 132 166 / 0.16);
        stroke-width: 5;
        stroke-linecap: round;
        stroke-linejoin: round;
        opacity: var(--watermark-opacity, 0.08);
        filter: blur(6px);
      }

      :global(.moon-orbit) {
        fill: none;
        stroke: rgb(103 130 178 / 0.26);
        stroke-width: 0.7;
        stroke-linecap: round;
        stroke-dasharray: 2 22;
        opacity: var(--orbit-opacity, 0.12);
      }

      :global(.prism-streak) {
        stroke-linecap: round;
        stroke-width: 1.1;
        opacity: var(--prism-opacity, 0.18);
        filter: blur(0.15px);
      }

      :global(.prism-streak.is-cyan) {
        stroke: rgb(132 206 231 / 0.46);
      }

      :global(.prism-streak.is-violet) {
        stroke: rgb(177 162 235 / 0.42);
      }

      :global(.prism-streak.is-rose) {
        stroke: rgb(244 184 204 / 0.38);
      }

      :global(.moon-dust) {
        position: absolute;
        top: var(--dust-top);
        left: var(--dust-left);
        width: var(--dust-size);
        height: var(--dust-size);
        border-radius: 999px;
        opacity: var(--dust-opacity);
        background: rgb(111 133 170 / 0.55);
        transform: scale(0.86);
        transition: opacity 900ms ease, transform 900ms ease;
      }

      :global(.twinkle-star) {
        position: absolute;
        top: var(--star-top);
        left: var(--star-left);
        width: var(--star-size);
        height: var(--star-size);
        border-radius: 999px;
        opacity: var(--star-low);
        background: rgb(244 240 255 / 0.96);
        box-shadow: 0 0 var(--star-glow) rgb(244 240 255 / 0.46);
        transform: scale(0.82);
        filter: brightness(0.98);
        transition:
          opacity var(--star-rise) ease,
          transform var(--star-rise) ease,
          filter var(--star-rise) ease;
      }

      :global(.twinkle-star.is-bright) {
        background: rgb(255 250 228 / 0.98);
        box-shadow:
          0 0 calc(var(--star-glow) * 1.45) rgb(255 225 166 / 0.58),
          0 0 calc(var(--star-glow) * 3.2) rgb(120 174 230 / 0.24);
      }

      :global(.twinkle-star.is-blue) {
        background: rgb(179 220 255 / 0.94);
        box-shadow: 0 0 calc(var(--star-glow) * 1.95) rgb(120 174 230 / 0.46);
      }

      :global(.twinkle-star.is-cross) {
        background: transparent;
        box-shadow: none;
        border-radius: 0;
      }

      :global(.twinkle-star.is-cross)::before,
      :global(.twinkle-star.is-cross)::after {
        position: absolute;
        top: 50%;
        left: 50%;
        content: '';
        background: rgb(255 250 228 / 0.92);
        border-radius: 999px;
        box-shadow: 0 0 var(--star-glow) rgb(255 225 166 / 0.42);
      }

      :global(.twinkle-star.is-cross)::before {
        width: calc(var(--star-size) * 4.2);
        height: 1px;
        transform: translate(-50%, -50%);
      }

      :global(.twinkle-star.is-cross)::after {
        width: 1px;
        height: calc(var(--star-size) * 4.2);
        transform: translate(-50%, -50%);
      }

      :global(.twinkle-star.is-glowing) {
        opacity: var(--star-high);
        transform: scale(var(--star-scale));
        filter: brightness(1.68);
      }

      main,
      .tel-nav,
      .tel-footer {
        position: relative;
        z-index: 1;
      }

      main {
        z-index: 1;
      }

      .tel-hero {
        background: transparent;
      }

      .tel-hero::before,
      .tel-hero::after {
        display: none;
      }

      .paper-section,
      .paper-section.alt {
        background: transparent;
        border: 0;
      }

      html[data-theme="daylight"] .paper-section,
      html[data-theme="daylight"] .paper-section.alt,
      html[data-theme="night"] .paper-section,
      html[data-theme="night"] .paper-section.alt {
        background: transparent;
        border: 0;
      }

      html[data-theme="daylight"] body {
        background: #fcfdff;
        color: var(--ink);
      }

      html[data-theme="daylight"] .tel-page {
        background:
          radial-gradient(ellipse at 82% 8%, rgba(47, 111, 168, 0.22), transparent 31rem),
          radial-gradient(ellipse at 14% 18%, rgba(16, 42, 107, 0.10), transparent 27rem),
          radial-gradient(ellipse at 68% 36%, rgba(89, 144, 192, 0.16), transparent 36rem),
          linear-gradient(
            180deg,
            #fbfdff 0%,
            #f8fcff 20%,
            #f2f8ff 40%,
            #f8fbff 60%,
            #fbfbff 78%,
            #fffdfd 100%
          );
      }

      html[data-theme="daylight"] .tel-page::before {
        opacity: 0.42;
        background:
          radial-gradient(circle, rgba(16, 42, 107, 0.14) 0.34px, transparent 0.82px),
          radial-gradient(circle, rgba(47, 111, 168, 0.10) 0.48px, transparent 0.94px),
          radial-gradient(circle, rgba(104, 132, 174, 0.08) 0.42px, transparent 0.9px);
        background-size: 118px 108px, 219px 197px, 349px 311px;
        background-position: 0 0, 61px 37px, 171px 93px;
        mix-blend-mode: multiply;
