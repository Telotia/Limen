---
// dev.telotia.com renders the finished "Blue Light" marketing design (light medtech).
// prod (telotia.com) stays "Coming soon" until launch.
import designRaw from '../../Telotia Site - Blue Light.dc.html?raw';

const limenEnv = process.env.LIMEN_ENV ?? 'dev';
const isProd = limenEnv === 'prod';

const bodyMatch = designRaw.match(/<body[^>]*>([\s\S]*?)<\/body>/);
const designHtml = bodyMatch ? bodyMatch[1] : '';
---

<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Telotia — claim-to-evidence validation</title>
  </head>
  <body>
    {
      isProd ? (
        <main style="min-height:100dvh;display:grid;place-items:center;text-align:center;font-family:'IBM Plex Sans',system-ui,sans-serif">
          <div>
            <h1 style="font-size:48px;letter-spacing:-.02em;color:#10182F;margin:0">Telotia</h1>
            <p style="color:#5C6680;margin-top:8px">Coming soon.</p>
          </div>
        </main>
      ) : (
        <Fragment set:html={designHtml} />
      )
    }
    {!isProd && (
      <script is:inline>
        {`(function(){var c=document.getElementById('tlHeroCanvas');if(!c)return;var ctx=c.getContext('2d'),w,h,pts;
        function rs(){var r=c.getBoundingClientRect();w=c.width=r.width;h=c.height=r.height;var n=Math.min(110,Math.floor(w*h/13000));pts=[];for(var i=0;i<n;i++)pts.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.32,vy:(Math.random()-.5)*.32});}
        function dr(){ctx.clearRect(0,0,w,h);for(var i=0;i<pts.length;i++){var p=pts[i];p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;}
        for(var i=0;i<pts.length;i++)for(var j=i+1;j<pts.length;j++){var a=pts[i],b=pts[j],dx=a.x-b.x,dy=a.y-b.y,d=Math.sqrt(dx*dx+dy*dy);if(d<130){ctx.strokeStyle='rgba(47,111,176,'+(0.16*(1-d/130))+')';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();}}
        for(var i=0;i<pts.length;i++){var p=pts[i];ctx.fillStyle='rgba(47,111,176,.55)';ctx.beginPath();ctx.arc(p.x,p.y,1.6,0,7);ctx.fill();}
        requestAnimationFrame(dr);}
        rs();dr();window.addEventListener('resize',rs);})();`}
      </script>
    )}
  </body>
</html>
