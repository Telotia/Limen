          radial-gradient(circle at 12% 0%, rgba(255, 255, 255, 0.58), transparent 26rem),
          radial-gradient(circle at 88% 74%, rgba(120, 174, 230, 0.20), transparent 24rem),
          linear-gradient(135deg, rgba(229, 244, 255, 0.76), rgba(190, 220, 249, 0.62));
        border-color: rgba(47, 111, 168, 0.22);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.62),
