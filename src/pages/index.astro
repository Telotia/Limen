---
// dev.telotia.com renders the finished "Ink (white)" marketing design (light medtech).
// prod (telotia.com) stays "Coming soon" until launch.
import designRaw from '../../Telotia White/index.html?raw';

const limenEnv = process.env.LIMEN_ENV ?? 'dev';
const isProd = limenEnv === 'prod';

const bodyMatch = designRaw.match(/<body[^>]*>([\s\S]*?)<\/body>/);
const designHtml = bodyMatch ? bodyMatch[1] : '';
---

<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Telotia — claim-to-evidence validation</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    {
      isProd ? (
        <main style="min-height:100dvh;display:grid;place-items:center;text-align:center;font-family:'IBM Plex Sans',system-ui,sans-serif">
          <div>
            <h1 style="font-size:48px;letter-spacing:-.02em;color:#10182F;margin:0">Telotia</h1>
            <p style="color:#5C6680;margin-top:8px">Coming soon.</p>
          </div>
        </main>
      ) : (
        <Fragment set:html={designHtml} />
      )
    }
    {!isProd && <script is:inline src="/telotia-particles.js"></script>}
    {!isProd && <script is:inline src="/footer-assets.js"></script>}
    {!isProd && <script is:inline src="/ink-init.js"></script>}
  </body>
</html>
