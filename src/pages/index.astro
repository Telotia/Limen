      }

      .mockup-demo-note {
        max-width: 38rem;
        margin: 0;
        color: var(--ink-3);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      /* Continuous site fields: sections sit on the same atmosphere. */
      .tel-page {
        position: relative;
        overflow: hidden;
        isolation: isolate;
      }

      .tel-page::before {
        position: absolute;
        inset: 0;
        z-index: 0;
        content: '';
        pointer-events: none;
      }

      .tel-page::after {
        position: absolute;
        inset: 0;
        z-index: 0;
        content: '';
        pointer-events: none;
      }

      .constellation-field,
      .twinkle-field {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        pointer-events: none;
      }

      .constellation-field {
        width: 100%;
        color: rgb(216 214 232 / 0.78);
      }

      :global(.constellation-thread) {
        fill: none;
        stroke: currentColor;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-width: 1.05;
        opacity: var(--constellation-opacity, 0.46);
      }

      :global(.constellation-node) {
        fill: currentColor;
        opacity: var(--constellation-node-opacity, 0.72);
      }

      :global(.constellation-node.is-anchor) {
        fill: rgb(236 169 147 / 0.92);
      }

      :global(.paper-watermark) {
        fill: none;
        stroke: rgb(112 132 166 / 0.34);
        stroke-width: 0.75;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 1 18;
        opacity: var(--watermark-opacity, 0.24);
      }

      :global(.moon-orbit) {
        fill: none;
        stroke: rgb(103 130 178 / 0.34);
        stroke-width: 0.7;
        stroke-linecap: round;
        stroke-dasharray: 2 22;
        opacity: var(--orbit-opacity, 0.18);
      }

      :global(.prism-streak) {
        stroke-linecap: round;
        stroke-width: 1.1;
        opacity: var(--prism-opacity, 0.18);
        filter: blur(0.15px);
      }

      :global(.prism-streak.is-cyan) {
        stroke: rgb(132 206 231 / 0.46);
      }

      :global(.prism-streak.is-violet) {
        stroke: rgb(177 162 235 / 0.42);
      }

      :global(.prism-streak.is-rose) {
        stroke: rgb(244 184 204 / 0.38);
      }

      :global(.moon-dust) {
        position: absolute;
        top: var(--dust-top);
        left: var(--dust-left);
        width: var(--dust-size);
        height: var(--dust-size);
        border-radius: 999px;
        opacity: var(--dust-opacity);
        background: rgb(111 133 170 / 0.55);
        transform: scale(0.86);
        transition: opacity 900ms ease, transform 900ms ease;
      }

      :global(.twinkle-star) {
        position: absolute;
        top: var(--star-top);
        left: var(--star-left);
        width: var(--star-size);
        height: var(--star-size);
        border-radius: 999px;
        opacity: var(--star-low);
        background: rgb(244 240 255 / 0.96);
        box-shadow: 0 0 var(--star-glow) rgb(244 240 255 / 0.46);
        transform: scale(0.82);
        filter: brightness(0.98);
        transition:
          opacity var(--star-rise) ease,
          transform var(--star-rise) ease,
          filter var(--star-rise) ease;
      }

      :global(.twinkle-star.is-bright) {
        background: rgb(255 250 228 / 0.98);
        box-shadow:
          0 0 calc(var(--star-glow) * 1.45) rgb(255 225 166 / 0.58),
          0 0 calc(var(--star-glow) * 3.2) rgb(120 174 230 / 0.24);
      }

      :global(.twinkle-star.is-blue) {
        background: rgb(179 220 255 / 0.94);
        box-shadow: 0 0 calc(var(--star-glow) * 1.95) rgb(120 174 230 / 0.46);
      }

      :global(.twinkle-star.is-cross) {
        background: transparent;
        box-shadow: none;
        border-radius: 0;
      }

      :global(.twinkle-star.is-cross)::before,
      :global(.twinkle-star.is-cross)::after {
        position: absolute;
        top: 50%;
        left: 50%;
        content: '';
        background: rgb(255 250 228 / 0.92);
        border-radius: 999px;
        box-shadow: 0 0 var(--star-glow) rgb(255 225 166 / 0.42);
      }

      :global(.twinkle-star.is-cross)::before {
        width: calc(var(--star-size) * 4.2);
        height: 1px;
        transform: translate(-50%, -50%);
      }

      :global(.twinkle-star.is-cross)::after {
        width: 1px;
        height: calc(var(--star-size) * 4.2);
        transform: translate(-50%, -50%);
      }

      :global(.twinkle-star.is-glowing) {
        opacity: var(--star-high);
        transform: scale(var(--star-scale));
        filter: brightness(1.68);
      }

