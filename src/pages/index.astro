        color: #f4f0ff;
      }

      html[data-theme="daylight"] .hero-cta-primary:hover { background: #1e2f52; }

      html[data-theme="daylight"] .hero-cta-secondary {
        background: transparent;
        color: var(--ink-2);
        border: 1px solid var(--rule);
      }

      html[data-theme="daylight"] .hero-cta-secondary:hover { background: var(--paper-3); }

      .showcase-caveat {
        margin-top: 28px;
        padding: 16px 20px;
        border-left: 2px solid rgb(216 214 232 / 0.22);
        color: var(--night-ink-3);
        font-size: 13px;
        line-height: 1.6;
        max-width: 640px;
      }

      html[data-theme="daylight"] .showcase-caveat {
        border-left-color: var(--rule);
