  },
  {
    id: 'ctx_slice_4d12e0',
    title: 'Hidden structure can be legible without being deterministic.',
    verdict: 'Proven',
    chamber: 'Debate ▸ Experiment ▸ Slice',
    reentries: 1,
    last: '12 min ago',
    note: 'settled under Critic pressure; encoder choice is explicit',
    theory: `Under a declared encoder E and threshold τ, the claim is falsifiable per encoder given a fixed apparatus criterion — surviving the Critic’s challenge that legibility is observer-relative because the observer is named.`,
    evidence: 'The Experiment Constructor ran zlib-9 over three reference streams and recorded the ratios verbatim. The Critic pressed on encoder choice; the Theory absorbed the pressure by making E explicit.',
  },
  {
    id: 'ctx_slice_9bc717',
    title: 'Exhaustion is not the same as refutation.',
    verdict: 'Open',
    chamber: 'Synthesis released',
    reentries: 0,
    last: 'just now',
    note: 'Synthesis released; awaiting Debate',
    theory: '(awaiting Debate Constructor)',
    evidence: '(no Experiment yet)',
  },
];

const graphNodes = [
  { id: 'origin', x: 60, y: 110, label: 'Origin' },
  { id: 'inspection', x: 170, y: 60, label: 'Inspection' },
  { id: 'telos', x: 170, y: 160, label: 'Telos' },
  { id: 'synthesis', x: 340, y: 110, label: 'Synthesis', active: true },
  { id: 'debate', x: 510, y: 60, label: 'Debate' },
  { id: 'experiment', x: 510, y: 160, label: 'Experiment' },
  { id: 'slice', x: 660, y: 110, label: 'Slice' },
  { id: 'mortality', x: 820, y: 110, label: 'Mortality', terminal: true },
];

const graphNodeById = Object.fromEntries(graphNodes.map((node) => [node.id, node]));

const graphEdges = [
  { from: 'origin', to: 'telos' },
  { from: 'origin', to: 'inspection' },
  { from: 'inspection', to: 'synthesis' },
  { from: 'telos', to: 'synthesis' },
  { from: 'synthesis', to: 'debate' },
  { from: 'debate', to: 'experiment' },
  { from: 'experiment', to: 'slice' },
  { from: 'slice', to: 'synthesis', dashed: true, label: 're-entry' },
  { from: 'synthesis', to: 'mortality', terminal: true },
];

const cycleSteps = [
  {
    step: 'Step 1',
    title: 'Telos',
    body:
      'The Origin proposes a seed. The Critic presses it against the observed environment. The Stabilizer crystallizes the seed into a Telos Context, or rejects it. The session opens.',
  },
  {
    step: 'Step 2 -> 6',
    title: 'Slice cycle',
    body:
      'Synthesis releases a Slice. Debate stabilizes a Theory in its favor. Experiment engages the Theory in the workspace sandbox. Slice judges Proven, Falsified, or Partial. Partial re-enters Debate.',
  },
  {
    step: 'Step 7',
    title: 'Mortality',
    body:
      'When the completed Slices together exhaust the Telos productive framings, the Synthesis Stabilizer emits TELOS_CLOSED. The organism dies. Refuting one reading of the Telos does not exhaust it.',
  },
];

const terms = [
  {
    term: 'Telos',
    pos: 'noun',
    def:
      "The seed crystallized by the Telos Chamber. The organism's anchor. Not a deliverable; an epistemic commitment the rest of the organism is measured against.",
  },
  {
    term: 'Slice',
    pos: 'noun',
    def:
      'A defensible, independently investigable position about the Telos. Carries a Status: Proven, Falsified, or Partial.',
  },
  {
    term: 'Crystallize',
    pos: 'verb',
    def:
      'The act of writing an immutable Crystallized Context. Stabilizers crystallize; nothing else does.',
  },
  {
    term: 'Constructor',
    pos: 'role',
    def:
      "Proposes the chamber's output in its own voice. A worker in Inspection and Experiment; a thinker elsewhere.",
  },
  {
    term: 'Critic',
    pos: 'role',
    def:
      'Presses for load-bearing weaknesses. On the same team as the Constructor: both share one job, to land a sound output.',
  },
  {
    term: 'Stabilizer',
    pos: 'role',
    def:
      'Judges. Not advocating for any verdict. Reads the full oscillation history and commits to what the engagement honestly earned.',
  },
  {
    term: 'Symbiosis',
    pos: 'noun',
    def:
      "Outbound: commission another organism. Inbound: re-house another organism's closed Telos as a Perception Context.",
  },
  {
    term: 'Mortality',
    pos: 'terminal',
    def:
      'TELOS_CLOSED. The single declared end-state, emitted only when productive framings are exhausted. The only natural death.',
  },
  {
    term: 'Apparatus',
    pos: 'noun',
    def:
      'One form of evidence, not the only one. A worker may run tools inside the sandbox; reasoning-only Slices are also valid Evidence.',
  },
];

const demonstrates = [
  'Eight chambers on the v4 ontology, every chamber except Slice oscillating Constructor -> Critic -> Stabilizer.',
  'LLM Critic and Stabilizer wired into the Telos chamber; no hardcoded TTY Critic.',
  'Worker-Constructor in Inspection, probing the environment under a read-only landlock.',
  'Symbiosis gated on an AssistantOrganism Context; no empty-Symbiosis firings.',
  'Mortality is single-source: only the Synthesis Stabilizer emits TELOS_CLOSED.',
];

const limits = [
  'Any Proven slice in any organism run to date.',
  'A robust separation between meta-debate-about-Principia and engagement-with-the-Telos.',
  'Recovery from a stalled Synthesis; the guard catches them but the scheduler keeps re-firing.',
  'Worker token I/O ratio is heavy; no canonical prompt prefix for KV-cache reuse yet.',
  'Falsified-vs-Partial criteria still over-commit to Falsified in observed petri-dish runs.',
];

const repos = [
  {
    step: 'Step 1 / Unit',
    name: 'Assay',
    desc:
      'The prompt-sweep harness. Every chamber prompt is exercised here before it ever touches the kernel.',
    href: 'https://github.com/Telotia/Assay',
  },
  {
    step: 'Step 2 / Integration',
    name: 'Vivarium',
    desc:
      'The control plane. Pins kernel versions per experiment, spawns kernel processes, and streams the runtime event log to a UI.',
    href: 'https://github.com/Telotia/Vivarium',
  },
  {
    step: 'Step 3 / Production',
    name: 'Principia',
    desc:
      'The epistemic-being runtime. Tag-driven releases verified by both Assay and Vivarium before they ship.',
    href: 'https://github.com/Telotia/Principia',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>TELOTIA / Principia</title>
    <meta
      name="description"
      content="Principia is Telotia's epistemic-being runtime: one seed, eight chambers, and a record of what the engagement honestly earned."
    />
    {!isProd && <meta name="robots" content="noindex,nofollow" />}
    <style>
      @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:wght@400;450;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&display=swap');

      :root {
        color-scheme: light;
        --paper: #F7F9FD;
        --paper-2: #F1F5FB;
        --paper-3: #E8EEF8;
        --paper-edge: #CBD6E8;
        --ink: #14203A;
        --ink-2: #31405F;
        --ink-3: #6A7691;
        --ink-4: #8f98bb;
        --rule: #CBD6E8;
        --rule-soft: #DDE5F0;
        --night: #0a1430;
        --night-2: #162244;
        --night-3: #1f3160;
        --night-rule: #2a3656;
        --night-ink: #f4f0ff;
        --night-ink-2: #d8d6e8;
        --night-ink-3: #b9b2d6;
        --rose: #dea193;
        --rose-soft: #b07a6a;
        --blue: #5990c0;
        --violet: #6d4bc3;
        --ocean: radial-gradient(
          ellipse 130% 90% at 50% 0%,
          #213d6f 0%,
          #0f1f44 45%,
          #060d22 100%
        );
        --font-display: 'Newsreader', 'Iowan Old Style', Georgia, serif;
        --font-sans: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont,
          'Segoe UI', system-ui, sans-serif;
        --font-mono: 'IBM Plex Mono', 'JetBrains Mono', ui-monospace,
          SFMono-Regular, Consolas, monospace;
        --ease-paper: cubic-bezier(0.2, 0.6, 0.2, 1);
        --shadow-paper: 0 1px 0 var(--paper-edge), 0 2px 8px -4px #10182f12;
        --shadow-night: 0 18px 48px rgb(0 0 0 / 0.28);
        --moon: #f9fbff;
        --moon-2: #eef5ff;
        --moon-3: #dfeafd;
        --moon-blue: #d7e8ff;
        --blue-deep: #102a6b;
        --blue-mid: #2f6fa8;
        --blue-soft: #78aee6;
        /* App shell — always dark regardless of site theme */
        --app-shell: #071025;
        --app-rail: #0b1732;
        --app-panel: #0f1c3a;
        --app-panel-2: #132449;
        --app-line: #2a3a61;
        --app-line-soft: rgb(216 214 232 / 0.14);
        --app-muted: #9ea8ca;
        --app-faint: #707b9f;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 15px;
        line-height: 1.6;
        font-feature-settings: 'ss01', 'cv11';
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
      }

      p,
      h1,
      h2,
      h3,
      dl,
      dd {
        margin: 0;
      }

      img,
      svg {
        display: block;
      }

      .tel-page {
        min-height: 100vh;
        background:
          radial-gradient(circle at 8% 32rem, rgb(89 144 192 / 0.12), transparent 22rem),
          linear-gradient(180deg, #f6f7fb 0%, #eef1f7 100%);
      }

      .tel-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        color: var(--night-ink);
        background: rgb(6 11 26 / 0.84);
        border-bottom: 1px solid rgb(216 214 232 / 0.18);
        backdrop-filter: blur(10px);
        transition:
          color 320ms var(--ease-paper),
          background 320ms var(--ease-paper),
          border-color 320ms var(--ease-paper);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .tel-nav {
        color: var(--ink);
        background: rgb(247 249 253 / 0.90);
        border-bottom: 1px solid var(--rule-soft);
      }

      .tel-nav-inner {
        width: calc(100% - 32px);
        max-width: 1180px;
        min-height: 58px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 28px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
        text-decoration: none;
      }

      .brand-mark {
        width: 22px;
        height: 22px;
        flex: 0 0 22px;
        color: var(--rose);
        background: currentColor;
        -webkit-mask: url('/assets/principia/principia-mark.svg') center /
          contain no-repeat;
        mask: url('/assets/principia/principia-mark.svg') center / contain no-repeat;
      }

      .brand-name {
        font-family: var(--font-sans);
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.22em;
        line-height: 1;
        text-transform: uppercase;
      }

      .brand-org {
        padding-left: 10px;
        border-left: 1px solid rgb(216 214 232 / 0.2);
        color: var(--night-ink-3);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        transition:
          color 320ms var(--ease-paper),
          border-color 320ms var(--ease-paper);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .brand-org {
        border-left-color: var(--rule);
        color: var(--ink-3);
      }

      .nav-links {
        display: flex;
        gap: 22px;
        align-items: center;
        margin-left: 6px;
      }

      .nav-links a,
      .repo-link {
        color: var(--night-ink-3);
        font-size: 13px;
        text-decoration: none;
        transition:
          color 140ms var(--ease-paper),
          border-color 140ms var(--ease-paper);
      }

      .nav-links a:hover,
      .repo-link:hover {
        color: var(--night-ink);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .nav-links a,
      html[data-theme="daylight"]:not([data-nav-at-hero]) .repo-link {
        color: var(--ink-3);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .nav-links a:hover,
      html[data-theme="daylight"]:not([data-nav-at-hero]) .repo-link:hover {
        color: var(--ink);
      }

      .nav-spacer {
        flex: 1;
      }

      .repo-link {
        font-family: var(--font-mono);
        font-size: 12px;
        white-space: nowrap;
      }

      .theme-switcher {
        display: flex;
        gap: 2px;
        align-items: center;
        padding: 3px;
        background: rgb(255 255 255 / 0.07);
        border-radius: 8px;
      }

      .theme-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border: 0;
        border-radius: 5px;
        background: transparent;
        color: var(--night-ink-3);
        cursor: pointer;
        transition:
          color 140ms var(--ease-paper),
          background 140ms var(--ease-paper),
          box-shadow 140ms var(--ease-paper);
      }

      .theme-btn:hover {
        color: var(--night-ink);
        background: rgb(255 255 255 / 0.07);
      }

      .theme-btn.is-active {
        color: var(--night-ink);
        background: rgb(255 255 255 / 0.11);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .theme-switcher {
        background: rgb(0 0 0 / 0.06);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .theme-btn {
        color: var(--ink-3);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .theme-btn:hover {
        color: var(--ink);
        background: rgb(0 0 0 / 0.05);
      }

      html[data-theme="daylight"]:not([data-nav-at-hero]) .theme-btn.is-active {
        color: var(--ink);
        background: var(--paper);
        box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
      }

      .tel-hero {
        position: relative;
        min-height: calc(100vh - 96px);
        overflow: hidden;
        color: var(--night-ink);
        background:
          /* primary violet bloom — upper right, most visible */
          radial-gradient(circle at 72% 22%, rgba(75, 46, 131, 0.28) 0%, transparent 34%),
          /* secondary cosmic indigo — lower center */
          radial-gradient(circle at 38% 64%, rgba(110, 66, 193, 0.16) 0%, transparent 30%),
          /* cool blue-violet whisper — upper left */
          radial-gradient(circle at 18% 18%, rgba(89, 144, 192, 0.12) 0%, transparent 28%),
          /* rose-gold atmospheric warmth — far right edge */
          radial-gradient(circle at 95% 55%, rgba(222, 161, 147, 0.07) 0%, transparent 22%),
          /* deep indigo field — center mass */
          radial-gradient(ellipse 110% 70% at 50% 45%, rgba(43, 47, 128, 0.18) 0%, transparent 60%),
          linear-gradient(180deg, #070A18 0%, #0B1028 55%, #060d22 100%);
      }

      .tel-hero::before,
      .tel-hero::after {
        position: absolute;
        inset: 0;
        content: '';
        pointer-events: none;
      }

      .tel-hero::before {
        /*
         * Two faint repeating layers for the dim star mass — incommensurate
         * sizes prevent obvious grid rhythm. Individual bright/cross stars
         * come from an SVG at cover size (no tiling), giving true irregular
         * placement for all visually distinct points.
         */
        background:
          /* dim base — majority of star count, spacing creates subtle variation */
          radial-gradient(circle, #ffffff06 0.22px, transparent 0.42px),
          radial-gradient(circle, #ffffff09 0.26px, transparent 0.48px),
          radial-gradient(circle, #ffffff0c 0.30px, transparent 0.54px),
          /* individual bright + cross-stars at organic positions, no tiling */
          url('/assets/principia/stars.svg');
        background-size:
          71px 67px,
          113px 97px,
          179px 163px,
          cover;
        background-repeat:
          repeat,
          repeat,
          repeat,
          no-repeat;
        background-position:
          0 0,
          41px 13px,
          83px 47px,
          center;
      }

      .tel-hero::after {
        opacity: 0.22;
        background: var(--night-ink);
        -webkit-mask: url('/assets/principia/constellation-bg.svg') right 6% top
          10% / min(820px, 78vw) auto no-repeat;
        mask: url('/assets/principia/constellation-bg.svg') right 6% top 10% /
          min(820px, 78vw) auto no-repeat;
      }

      .pull-id {
        position: absolute;
        top: 28px;
        right: max(24px, calc((100% - 1180px) / 2));
        z-index: 2;
        color: var(--night-ink-3);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .tel-hero-inner {
        position: relative;
        z-index: 1;
        width: calc(100% - 32px);
        max-width: 1180px;
        margin: 0 auto;
        padding: 102px 0 82px;
      }

      .hero-status,
      .tel-label {
        color: var(--rose);
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .hero-status {
        display: flex;
        gap: 12px;
        align-items: center;
      }

      .hero-title-row {
        display: flex;
        justify-content: space-between;
        gap: clamp(22px, 4vw, 56px);
        align-items: center;
        margin-top: 18px;
      }

      .hero-copy-block {
        padding-left: clamp(24px, 4.6vw, 78px);
      }

      .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--rose);
        box-shadow: 0 0 0 4px rgb(222 161 147 / 0.12);
      }

      .hero-title {
        max-width: 960px;
        margin: 0;
        color: var(--night-ink);
        font-family: var(--font-sans);
        font-size: 72px;
        font-weight: 500;
        line-height: 1.02;
        letter-spacing: 0.22em;
      }

      .decor-animation {
        position: relative;
        flex: 0 0 auto;
        overflow: visible;         /* no container clipping — animation breathes freely */
        background: transparent;
        mix-blend-mode: screen;
        pointer-events: none;
      }

      /* canvas is larger than its layout anchor and extends in all directions */
      .decor-animation canvas {
        position: absolute;
        display: block;
      }

      .decor-animation-chaotic {
        width: clamp(360px, 42vw, 560px);
        height: clamp(220px, 25vw, 340px);
        opacity: 0.92;
        margin-top: -22px;
      }

      .decor-animation-chaotic canvas {
        top: -40%;
        left: -8%;
        width: 146%;
        height: 182%;
      }

      .decor-animation-circle {
        width: clamp(180px, 20vw, 240px);
        height: clamp(180px, 20vw, 240px);
      }

      .decor-animation-circle canvas {
        top: -55%;
        left: -55%;
        width: 210%;
        height: 210%;
      }

      .hero-thesis {
        max-width: min(1040px, 100%);
        margin-top: 34px;
        color: var(--night-ink-2);
        font-family: var(--font-display);
        font-size: clamp(46px, 4.4vw, 78px);
        font-weight: 340;
        line-height: 1.06;
        overflow-wrap: break-word;
        white-space: normal;
      }

      .hero-line {
        display: block;
      }

      .hero-thesis em,
      .section-title em,
      .cycle dd em,
      .assessment-note em {
        color: var(--rose);
        font-family: var(--font-display);
        font-style: italic;
      }

      .hero-copy {
        max-width: 880px;
        margin-top: 42px;
        color: var(--night-ink-2);
        font-family: var(--font-display);
        font-size: clamp(23px, 1.6vw, 29px);
        font-weight: 340;
        line-height: 1.48;
        overflow-wrap: break-word;
        white-space: normal;
      }

      .hero-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(180px, 1fr));
        gap: 48px;
        max-width: min(980px, 100%);
        margin-top: 40px;
      }

      .hero-meta .cell {
        padding-top: 12px;
        border-top: 1px solid rgb(216 214 232 / 0.2);
      }

      .meta-label,
      .term-pos,
      .card h3,
      .repo-step {
        color: var(--ink-3);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .hero-meta .meta-label {
        color: var(--night-ink-3);
      }

      .meta-value {
        margin-top: 5px;
        color: var(--night-ink);
        font-family: var(--font-display);
        font-size: 18px;
      }

      .tel-section {
        position: relative;
        padding: 88px 0;
      }

      .tel-container {
        position: relative;
        width: calc(100% - 32px);
        max-width: 1180px;
        margin: 0 auto;
      }

      .paper-section {
        background:
          radial-gradient(circle at 18% 16%, rgba(137, 176, 230, 0.10), transparent 28%),
          radial-gradient(circle at 82% 72%, rgba(120, 135, 210, 0.08), transparent 30%),
          radial-gradient(circle at 50% 42%, rgba(255, 255, 255, 0.55), transparent 24%),
          linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
      }

      .paper-section.alt {
        background:
          radial-gradient(circle at 72% 22%, rgba(120, 135, 210, 0.09), transparent 30%),
          radial-gradient(circle at 15% 68%, rgba(137, 176, 230, 0.08), transparent 28%),
          radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.45), transparent 25%),
          linear-gradient(180deg, var(--paper-2) 0%, var(--paper) 100%);
      }

      .tel-section .tel-label {
        margin-bottom: 12px;
        color: var(--ink-3);
      }

      .section-title {
        max-width: 850px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 46px;
        font-weight: 400;
        line-height: 1.12;
      }

      .section-lede {
        max-width: 720px;
        margin-top: 15px;
        color: var(--ink-2);
        font-family: var(--font-display);
        font-size: 20px;
        font-weight: 340;
        line-height: 1.55;
      }

      .graph-panel,
      .install-block {
        color: var(--night-ink);
        background:
          radial-gradient(circle at 8% 0%, rgb(91 124 250 / 0.12), transparent 34%),
          var(--ocean);
        border: 1px solid rgb(216 214 232 / 0.2);
        box-shadow: var(--shadow-night);
      }

      .graph-panel {
        position: relative;
        margin-top: 38px;
        padding: 30px;
        overflow: hidden;
        border-radius: 12px;
      }

      .graph-panel::before {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(#ffffff1f 0.7px, transparent 0.8px),
          radial-gradient(#dea19314 0.5px, transparent 0.6px);
        background-size: 23px 23px, 13px 9px;
        content: '';
        pointer-events: none;
      }

      .graph-head,
      .graph-scroll {
        position: relative;
      }

      .graph-head {
        display: flex;
        gap: 20px;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
      }

      .graph-title {
        font-family: var(--font-display);
        font-size: 17px;
      }

      .legend {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .legend span {
        display: inline-flex;
        gap: 6px;
        align-items: center;
        color: var(--night-ink-3);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .swatch {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
      }

      .swatch.active {
        background: var(--rose);
      }

      .swatch.complete {
        background: #3a4664;
      }

      .swatch.reentry {
        background: transparent;
        border: 1px dashed var(--night-ink-3);
      }

      .graph-scroll {
        overflow-x: auto;
        padding-bottom: 2px;
      }

      .graph-scroll svg {
        min-width: 760px;
      }

      .cycle {
        display: grid;
        grid-template-columns: 210px minmax(0, 1fr);
        gap: 34px 28px;
        max-width: 920px;
        margin-top: 54px;
      }

      .cycle dt {
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 23px;
        font-weight: 420;
      }

      .cycle dt small {
        display: block;
        margin-bottom: 5px;
        color: var(--ink-3);
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
      }

      .cycle dd {
        max-width: 660px;
        color: var(--ink-2);
      }

      .vocab-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        margin-top: 38px;
        overflow: hidden;
        background: var(--rule);
        border: 1px solid var(--rule);
        border-radius: 8px;
        box-shadow: var(--shadow-paper);
      }

      .term-card {
        min-height: 190px;
        padding: 24px 26px;
        background: var(--paper);
        transition: background 120ms var(--ease-paper);
      }

      .term-card:hover {
        background: var(--paper-2);
      }

      .term-name {
        margin-top: 7px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 380;
      }

      .term-def {
        margin-top: 8px;
        color: var(--ink-2);
        font-size: 14px;
        line-height: 1.56;
      }

      .tel-narrow {
        max-width: 720px;
      }

      .install-block {
        margin-top: 32px;
        padding: 24px 26px 22px;
        border-radius: 8px;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1.75;
      }

      .install-block .prompt {
        margin-right: 8px;
        color: var(--night-ink-3);
        user-select: none;
      }

      .install-block .cmd {
        color: var(--night-ink);
      }

      .install-block .arg {
        color: var(--rose);
      }

      .install-block .cmt {
        color: var(--night-ink-3);
      }

      .install-gap {
        height: 12px;
      }

      .install-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: 36px;
        border-top: 1px solid var(--rule);
      }

      .install-meta .cell {
        padding: 18px 24px 18px 0;
        border-right: 1px solid var(--rule);
      }

      .install-meta .cell:last-child {
        border-right: 0;
      }

      .install-meta .value {
        margin-top: 5px;
        color: var(--ink);
        font-family: var(--font-display);
        font-size: 18px;
      }

      .install-meta .mono {
        color: var(--ink-2);
        font-family: var(--font-mono);
        font-size: 13px;
      }

      .assessment-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        margin-top: 34px;
      }

      .card {
        padding: 23px 24px 24px;
        background: var(--paper);
        border: 1px solid var(--rule);
        border-radius: 8px;
        box-shadow: var(--shadow-paper);
      }

      .card.weak {
        background: var(--paper);
      }

      .card h3 {
        margin: 0 0 11px;
      }

      .card ul {
        display: grid;
        gap: 0;
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .card li {
        display: grid;
        grid-template-columns: 18px minmax(0, 1fr);
        gap: 10px;
        padding: 9px 0;
        color: var(--ink-2);
        border-top: 1px solid var(--rule-soft);
        font-size: 14px;
        line-height: 1.55;
      }

      .card li:first-child {
        padding-top: 0;
        border-top: 0;
      }

      .card .mark {
        color: var(--blue);
        font-family: var(--font-display);
        font-style: italic;
      }

      .card.weak .mark {
        color: var(--rose-soft);
      }

      .assessment-note {
        max-width: 720px;
        margin-top: 34px;
        color: var(--ink-2);
        font-family: var(--font-display);
        font-size: 18px;
        font-style: italic;
      }

      .tel-footer {
        position: relative;
        overflow: hidden;
        padding: 64px 0 36px;
        color: var(--night-ink-3);
        background:
          radial-gradient(ellipse 110% 90% at 50% 100%, #0f1738 0%, #060b1a 80%),
          #060b1a;
      }

      .tel-footer::before {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(#ffffff14 0.5px, transparent 0.7px);
        background-size: 17px 17px;
        content: '';
        pointer-events: none;
      }

      .footer-inner {
        position: relative;
        width: calc(100% - 32px);
        max-width: 1180px;
        margin: 0 auto;
      }

      .footer-inner .tel-label {
        margin-bottom: 24px;
        color: var(--night-ink-3);
      }

      .repo-chain {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 36px;
      }

      .repo-card {
        display: flex;
        flex-direction: column;
        gap: 7px;
      }

      .repo-name {
        color: var(--night-ink);
        font-family: var(--font-display);
        font-size: 24px;
      }

      .repo-desc {
        max-width: 290px;
        color: var(--night-ink-3);
        font-size: 13px;
        line-height: 1.5;
      }

      .repo-card a {
        width: fit-content;
        margin-top: 5px;
        color: var(--night-ink-3);
        font-family: var(--font-mono);
        font-size: 11px;
        text-decoration: none;
        border-bottom: 1px solid rgb(216 214 232 / 0.2);
      }

      .repo-card a:hover {
        color: var(--night-ink);
        border-color: var(--night-ink-3);
      }

      .footer-bottom {
        display: flex;
        gap: 18px;
        align-items: center;
        margin-top: 48px;
        padding-top: 22px;
        border-top: 1px solid rgb(216 214 232 / 0.18);
      }

      .footer-bottom .brand-mark {
        width: 18px;
        height: 18px;
        flex-basis: 18px;
      }

      .footer-copy {
        color: var(--night-ink-3);
        font-family: var(--font-display);
        font-size: 13px;
        font-style: italic;
      }

      .footer-spacer {
        flex: 1;
      }

      .footer-bottom a {
        color: var(--night-ink-3);
        font-size: 12px;
        text-decoration: none;
        border-bottom: 1px solid rgb(216 214 232 / 0.2);
      }

      .footer-bottom a:hover {
        color: var(--night-ink);
      }

      /* ── Night theme vars ── */
      html[data-theme="night"] {
        color-scheme: dark;
        --paper: #0a1430;
        --paper-2: #0f1c3a;
        --paper-3: #132449;
        --paper-edge: #2a3a61;
        --ink: #f4f0ff;
        --ink-2: #d8d6e8;
        --ink-3: #b9b2d6;
        --ink-4: #8f98bb;
        --rule: #2a3a61;
        --rule-soft: rgb(216 214 232 / 0.14);
      }

      html[data-theme="night"] body {
        background: #060d22;
        color: var(--night-ink);
      }

      html[data-theme="night"] .tel-page {
        background: #060d22;
      }

      html[data-theme="night"] .paper-section {
        background:
          url('/assets/principia/stars.svg') center / cover no-repeat,
          radial-gradient(circle at 72% 18%, rgba(75, 46, 131, 0.20), transparent 36%),
          radial-gradient(circle at 28% 62%, rgba(110, 66, 193, 0.10), transparent 34%),
          radial-gradient(circle at 14% 22%, rgba(89, 144, 192, 0.08), transparent 30%),
          linear-gradient(180deg, #070A18 0%, #0B1028 100%);
        border-bottom: none;
      }

      html[data-theme="night"] .paper-section.alt {
        background:
          url('/assets/principia/stars.svg') center / cover no-repeat,
          radial-gradient(circle at 20% 20%, rgba(110, 66, 193, 0.18), transparent 34%),
          radial-gradient(circle at 76% 68%, rgba(75, 46, 131, 0.12), transparent 36%),
          radial-gradient(circle at 88% 14%, rgba(89, 144, 192, 0.07), transparent 28%),
          linear-gradient(180deg, #0B1028 0%, #070A18 100%);
        border-bottom: none;
      }

      html[data-theme="night"] .section-title,
      html[data-theme="night"] .cycle dt,
      html[data-theme="night"] .term-name,
      html[data-theme="night"] .install-meta .value,
      html[data-theme="night"] .repo-name {
        color: var(--night-ink);
      }

      html[data-theme="night"] .section-lede,
      html[data-theme="night"] .cycle dd,
      html[data-theme="night"] .term-def,
      html[data-theme="night"] .install-meta .mono,
      html[data-theme="night"] .card li,
      html[data-theme="night"] .assessment-note {
        color: var(--night-ink-2);
      }

      html[data-theme="night"] .tel-section .tel-label,
      html[data-theme="night"] .meta-label,
      html[data-theme="night"] .term-pos,
      html[data-theme="night"] .card h3,
      html[data-theme="night"] .repo-step {
        color: var(--night-ink-3);
      }

      html[data-theme="night"] .vocab-grid,
      html[data-theme="night"] .assessment-grid {
        background: transparent;
        border: 0;
        box-shadow: none;
      }

      html[data-theme="night"] .term-card,
      html[data-theme="night"] .card,
      html[data-theme="night"] .card.weak {
        background:
          radial-gradient(circle at 82% 18%, rgba(110, 66, 193, 0.10), transparent 34%),
          radial-gradient(circle at 16% 80%, rgba(89, 144, 192, 0.07), transparent 30%),
          linear-gradient(135deg, rgba(16, 42, 107, 0.48) 0%, rgba(13, 18, 42, 0.88) 100%);
        border: 1px solid rgba(244, 240, 255, 0.09);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.05),
          0 14px 32px rgba(0, 0, 0, 0.20);
      }

      html[data-theme="night"] .term-card:hover {
        background:
          radial-gradient(circle at 82% 18%, rgba(110, 66, 193, 0.14), transparent 34%),
          radial-gradient(circle at 16% 80%, rgba(89, 144, 192, 0.10), transparent 30%),
          linear-gradient(135deg, rgba(16, 42, 107, 0.56) 0%, rgba(13, 18, 42, 0.92) 100%);
      }

      html[data-theme="night"] .card li {
        border-color: var(--app-line-soft);
      }

      html[data-theme="night"] .install-meta {
        border-color: var(--app-line);
      }

      html[data-theme="night"] .install-meta .cell {
        border-color: var(--app-line);
      }

      html[data-theme="night"] .tel-hero {
        min-height: calc(100vh - 58px);
      }

      html[data-theme="night"] .tel-hero::after {
        display: none;
      }

      html[data-theme="night"] .tel-hero-inner {
        display: block;
        padding: 78px 0 64px;
      }

      html[data-theme="night"] .hero-copy-block {
        max-width: 1180px;
      }

      html[data-theme="night"] .hero-copy {
        max-width: 660px;
      }

      html[data-theme="night"] .hero-meta {
        max-width: min(980px, 100%);
      }

      .app-preview-shell {
        position: relative;
        z-index: 1;
        min-height: 36rem;
        overflow: hidden;
        background:
          linear-gradient(135deg, rgb(14 26 54 / 0.94), rgb(7 16 37 / 0.96)),
          #071025;
        border: 1px solid var(--app-line-soft);
        border-radius: 12px;
        box-shadow: var(--shadow-night);
      }

      .app-preview-shell::before {
        position: absolute;
        inset: 0;
        background-image:
          radial-gradient(#ffffff16 0.6px, transparent 0.7px),
          radial-gradient(#dea19310 0.5px, transparent 0.6px);
        background-size: 18px 18px, 11px 13px;
        content: '';
        pointer-events: none;
      }

      .app-topbar,
      .app-workspace,
      .app-rail,
      .app-main,
      .app-eventlog {
        position: relative;
      }

      .app-topbar {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 16px;
        align-items: center;
        min-height: 56px;
        padding: 10px 14px;
        background: rgb(244 240 255 / 0.035);
        border-bottom: 1px solid var(--app-line-soft);
      }

      .app-brand {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        color: var(--night-ink);
        font-family: var(--font-display);
        font-size: 18px;
      }

      .session-chip {
        justify-self: end;
        padding: 6px 12px;
        color: var(--night-ink-3);
        background: rgb(244 240 255 / 0.045);
        border: 1px solid var(--app-line-soft);
        border-radius: 6px;
        font-family: var(--font-mono);
        font-size: 12px;
      }

      .chamber-button,
      .app-icon-button {
        border: 1px solid var(--app-line-soft);
        color: var(--night-ink-3);
        background: rgb(244 240 255 / 0.04);
        font: inherit;
        transition:
          color 120ms var(--ease-paper),
          background 120ms var(--ease-paper),
          border-color 120ms var(--ease-paper);
      }

      .chamber-button.is-active {
        color: var(--night-ink);
        background: rgb(222 161 147 / 0.14);
        border-color: rgb(222 161 147 / 0.44);
      }

      .app-workspace {
        display: grid;
        grid-template-columns: 56px minmax(0, 1fr) minmax(18rem, 0.55fr);
        min-height: 31rem;
      }

      .app-rail {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
        padding: 14px 8px;
        background: rgb(6 13 34 / 0.58);
        border-right: 1px solid var(--app-line-soft);
      }

      .chamber-button {
        display: grid;
        place-items: center;
        width: 34px;
        height: 34px;
        padding: 0;
        border-radius: 8px;
        cursor: pointer;
      }

      .chamber-glyph {
        width: 16px;
        height: 16px;
        display: block;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 1;
        stroke-linecap: round;
      }

      .app-main {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        gap: 14px;
        padding: 18px;
      }

      .telos-card,
      .slice-drawer {
        background: rgb(244 240 255 / 0.045);
        border: 1px solid var(--app-line-soft);
        border-radius: 8px;
      }

      .telos-card {
        padding: 18px;
      }

      .telos-card-header {
        display: flex;
        gap: 14px;
        justify-content: space-between;
        color: var(--night-ink-3);
        font-size: 11px;
        text-transform: uppercase;
      }

      .telos-card h2 {
        max-width: 42rem;
        margin-top: 12px;
        color: var(--night-ink);
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 400;
        line-height: 1.18;
      }

      .telos-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 14px;
        color: var(--app-muted);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .demo-graph-panel {
        position: relative;
        min-height: 19rem;
        overflow: hidden;
        background:
          radial-gradient(circle at 76% 26%, rgb(222 161 147 / 0.14), transparent 12rem),
          #050a1f;
        border: 1px solid var(--app-line-soft);
        border-radius: 8px;
      }

      .demo-graph-panel svg {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        min-height: 19rem;
      }

      .animation-panel-label {
        position: absolute;
        top: 14px;
        left: 16px;
        z-index: 1;
        color: var(--night-ink-3);
        font-size: 11px;
        text-transform: uppercase;
      }

      .active-chamber-readout {
        position: absolute;
        right: 16px;
        bottom: 14px;
        z-index: 1;
        color: var(--rose);
        font-family: var(--font-mono);
        font-size: 12px;
      }

      .slice-drawer {
        display: grid;
        gap: 8px;
        padding: 12px;
      }

      /* ── Gradient-bar slice cards ── */
      .slice-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(16, 42, 107, 0.72) 0%, rgba(13, 18, 42, 0.94) 100%);
        border: 1px solid rgba(244, 240, 255, 0.12);
        border-radius: 8px;
        padding: 11px 13px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 5px 10px;
        align-items: start;
        cursor: pointer;
        color: #F4F0FF;
        text-align: left;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 8px 20px rgba(0, 0, 0, 0.28);
        transition: filter 120ms var(--ease-paper);
      }

      .slice-card:hover { filter: brightness(1.07); }
      .slice-card[aria-selected="true"] {
        box-shadow: 0 0 0 1.5px rgba(244, 240, 255, 0.38) inset, 0 8px 20px rgba(0, 0, 0, 0.35);
      }

      /* Gradient bar at bottom — the verdict signal */
      .slice-card::after {
        content: "";
        position: absolute;
        left: 0; right: 0; bottom: 0;
        height: 3px;
        background: var(--slice-gradient);
        opacity: 0.95;
        box-shadow: 0 -6px 16px var(--slice-glow);
      }

      .slice-card--partial {
        --slice-state: #CCA273;
        --slice-soft: rgba(204, 162, 115, 0.16);
        --slice-glow: rgba(204, 162, 115, 0.26);
        --slice-gradient: linear-gradient(90deg, #102A6B 0%, #5990C0 45%, #CCA273 100%);
      }
      .slice-card--proven {
        --slice-state: #5990C0;
        --slice-soft: rgba(89, 144, 192, 0.16);
        --slice-glow: rgba(89, 144, 192, 0.26);
        --slice-gradient: linear-gradient(90deg, #5990C0 0%, #2F6FA8 45%, #102A6B 100%);
      }
      .slice-card--open {
        --slice-state: #7E879D;
        --slice-soft: rgba(126, 135, 157, 0.14);
        --slice-glow: rgba(126, 135, 157, 0.20);
        --slice-gradient: linear-gradient(90deg, #102A6B 0%, #34304F 50%, #7E879D 100%);
      }
      .slice-card--falsified {
        --slice-state: #DEA193;
        --slice-soft: rgba(222, 161, 147, 0.16);
        --slice-glow: rgba(222, 161, 147, 0.24);
        --slice-gradient: linear-gradient(90deg, #102A6B 0%, #6E42C1 48%, #DEA193 100%);
      }

      .slice-card-title {
        display: block;
        color: #F4F0FF;
        font-family: var(--font-display);
        font-size: 14px;
        font-weight: 420;
