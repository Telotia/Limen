---
const navItems = [
  { label: 'Process', href: '#process' },
  { label: 'Evidence', href: '#evidence' },
  { label: 'Workspace', href: '#workspace' },
  { label: 'Download', href: '#download' },
  { label: 'Contact', href: '#contact' },
];

const metrics = [
  { label: 'Atomic claims processed', value: '12,480', source: 'example review corpus' },
  { label: 'Citations issued', value: '7,326', source: 'example review corpus' },
  { label: 'Open-web sources used', value: '0', source: 'workspace rule' },
];

const steps = [
  {
    number: '01',
    title: 'Decompose',
    figure: 'decompose',
    copy:
      'We break the document into atomic claims, down to the level where each one can be checked on its own. Not paragraphs - individual propositions, each independently verifiable.',
  },
  {
    number: '02',
    title: 'Search the evidence',
    figure: 'corpus',
    copy:
      'Each claim is matched against your evidence base - the corpus you supplied, not the open web. The search is scoped to what you trust and can cite.',
  },
  {
    number: '03',
    title: 'Grade and cite',
    figure: 'verdict',
    copy:
      'Every claim gets a graded verdict - Supported, Partial, or Unsupported - each linked to the exact source in your corpus. No aggregate scores, no summaries.',
  },
];

const verdicts = [
  {
    key: 'supported',
    label: 'Supported',
    type: 'verdict',
    copy:
      'Evidence in the corpus backs the claim. The supporting passage is retrieved and cited exactly.',
  },
  {
    key: 'partial',
    label: 'Partial',
    type: 'verdict',
    copy:
      'Some of the claim is backed; part is not, or only holds under specific conditions. Graded, non-binary - not collapsed to true or false.',
  },
  {
    key: 'unsupported',
    label: 'Unsupported',
    type: 'verdict',
    copy:
      'This corpus is silent on the claim - not that the claim is wrong. Results are a starting point for a human reviewer, not a final verdict on the work.',
  },
];

const reviewStages = [
  { label: 'Document review', icon: 'document' },
  { label: 'Evidence search', icon: 'search' },
  { label: 'Verdict queue', icon: 'verdict' },
  { label: 'Proof package', icon: 'package' },
];

const glossary = [
  {
    key: 'atomic-claim',
    label: 'Atomic claim',
    type: 'noun',
    copy:
      'A single proposition that can be checked independently. Telotia decomposes documents to this level before searching.',
  },
  {
    key: 'evidence-base',
    label: 'Evidence base',
    type: 'noun',
    copy:
      'The corpus you supply and trust. Telotia checks claims against this - not the open web. You choose what counts as evidence.',
  },
  {
    key: 'decomposition',
    label: 'Decomposition',
    type: 'noun',
    copy:
      'Breaking a document into its individual atomic claims, each independently checkable. The first step before any search or grading.',
  },
];

const verdictNodes = [
  ...verdicts.map((item) => ({ ...item, id: item.key, vector: item.key })),
  ...glossary.map((item) => ({ ...item, id: item.key, vector: item.key })),
];

const spikeKeywords = [
  'supported',
  'partial',
  'unsupported',
  'atomic claim',
  'evidence base',
  'decomposition',
  'trusted corpus',
  'source passage',
  'citation',
  'human review',
  'graded verdict',
  'silent corpus',
  'independent proposition',
  'search scope',
  'proof package',
  'review trail',
  'claim unit',
  'cited exactly',
  'specific condition',
  'not a score',
];

const spikeKeywordItems = spikeKeywords.map((word, index) => {
  const wave = Math.sin(index * 12.91) * 0.5 + 0.5;
  const drift = Math.sin(index * 8.37 + 2.3) * 0.5 + 0.5;
  return {
    word,
    x: 13 + ((index * 31) % 74) + wave * 5,
    y: 14 + ((index * 23) % 70) + drift * 4,
    rotation: -34 + ((index * 29) % 68),
    delay: -(index % 9) * 0.7,
  };
});

const claimRows = [
  {
    id: 'claim-018',
    claim:
      'The device packaging identifies the imported model and manufacturer lot.',
    verdict: 'Supported',
    evidence:
      'Importer file IFU-22, page 4 lists model QX-180 and lot range A17-A19 with matching manufacturer references.',
    source: 'IFU-22 / page 4',
    status: 'green',
  },
  {
    id: 'claim-027',
    claim:
      'Cleaning instructions cover high-touch surfaces after each patient use.',
    verdict: 'Partial',
    evidence:
      'The manual specifies approved cleaning agents but does not define the interval for accessories in shared clinical settings.',
    source: 'Maintenance manual / section 7.2',
    status: 'yellow',
  },
  {
    id: 'claim-041',
    claim:
      'The supplied corpus demonstrates bilingual labelling for all external warnings.',
    verdict: 'Unsupported',
    evidence:
      'No supplied label image or packaging proof contains the French warning text for the outer carton.',
    source: 'No cited passage',
    status: 'neutral',
  },
];

const auditEvents = [
  { time: '09:42:11', label: 'document', detail: '18 atomic claims extracted', tone: 'green' },
  { time: '09:42:38', label: 'corpus', detail: '47 supplied files indexed', tone: 'green' },
  { time: '09:43:02', label: 'review', detail: 'claim-027 requires reviewer note', tone: 'yellow' },
  { time: '09:44:19', label: 'source', detail: 'page citation attached', tone: 'green' },
  { time: '09:45:06', label: 'package', detail: 'proof bundle draft ready', tone: 'neutral' },
];

const contactCards = [
  {
    label: 'Request access',
    title: 'Prepare a Canadian evidence package',
    copy:
      'Share a sample document set and the corpus you want treated as trusted evidence.',
    link: 'mailto:hello@telotia.com',
  },
  {
    label: 'Review team',
    title: 'Discuss importer documentation',
    copy:
      'Use the workspace to separate claims, cite source passages, and support human review.',
    link: 'mailto:hello@telotia.com',
  },
  {
    label: 'Benchmark',
    title: 'Inspect the verdict method',
    copy:
      'See how Supported, Partial, and Unsupported claims are represented before sign-off.',
    link: '#workspace',
  },
];
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Telotia turns health-equipment documentation into citation-linked evidence review for Canadian audit preparation." />
    <title>Telotia — Evidence-grade audit for Canadian health-equipment imports</title>
    <meta property="og:title" content="Telotia — Evidence-grade audit for Canadian health-equipment imports" />
    <meta property="og:description" content="We turn documentation into citation-linked evidence review for teams preparing Canadian proof packages." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://telotia.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg: #f4f0d9;
        --bg-2: #eee7c6;
        --bg-3: #ded49d;
        --bg-deep: #030f13;
        --bg-deep-2: #07171c;
        --green-deep: #0b3d3c;
        --ink: #0a0a0a;
        --ink-2: #2a2a2a;
        --ink-3: #5a5a5a;
        --ink-4: #8a8a8a;
        --paper: #ffffff;
        --paper-2: #d8d29b;
        --paper-3: #bdb58a;
        --rule: #1a1a1a;
        --rule-soft: #d8d8d2;
        --rule-deep: #1f2a30;
        --green: #31988a;
        --green-2: #1e6f66;
        --green-soft: #dbe8e5;
        --yellow: #d8d29b;
        --yellow-2: #897649;
        --yellow-soft: #f2efd8;
        --page-gutter-total: clamp(208px, 26vw, 336px);
        --section-max: 1180px;
        --radius-soft: 14px;
        --radius-panel: 22px;
        --font-sans: Inter, "Helvetica Neue", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --font-mono: "JetBrains Mono", "IBM Plex Mono", ui-monospace, SFMono-Regular, Consolas, monospace;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 66px;
        background: var(--green-deep);
        color: var(--ink);
        font-family: var(--font-sans);
        text-rendering: geometricPrecision;
      }

      body {
        margin: 0;
        background:
          radial-gradient(ellipse at 5% 14%, rgba(137, 118, 73, 0.42), transparent 34rem),
          radial-gradient(ellipse at 95% 42%, rgba(11, 61, 60, 0.52), transparent 38rem),
          radial-gradient(ellipse at 9% 72%, rgba(216, 210, 155, 0.30), transparent 34rem),
          radial-gradient(ellipse at 92% 88%, rgba(49, 152, 138, 0.35), transparent 38rem),
          linear-gradient(
            180deg,
            #061817 0%,
            #0b3d3c 12%,
            #897649 22%,
            #d8d29b 34%,
            #0b3d3c 46%,
            #041514 58%,
            #897649 70%,
            #d8d29b 81%,
            #0b3d3c 91%,
            #030f13 100%
          );
        background-attachment: fixed;
      }

      @supports (-webkit-touch-callout: none) {
        body {
          background-attachment: scroll;
        }
      }

      .skip-link {
        position: fixed;
        left: 16px;
        top: 12px;
        z-index: 40;
        transform: translateY(-140%);
        padding: 10px 12px;
        color: var(--paper);
        background: var(--bg-deep);
        border: 1px solid var(--rule-deep);
        border-radius: 10px;
        font-size: 13px;
        text-decoration: none;
        transition: transform 160ms var(--ease);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      body::before {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        content: "";
        opacity: 0.22;
        background:
          linear-gradient(rgba(216, 210, 155, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(49, 152, 138, 0.03) 1px, transparent 1px);
        background-size: 48px 48px;
      }

      a {
        color: inherit;
      }

      button,
      a {
        -webkit-tap-highlight-color: transparent;
      }

      .particle-field {
        position: fixed;
        inset: 0;
        z-index: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        opacity: 0.84;
      }

      .site-shell {
        position: relative;
        z-index: 1;
        overflow-x: hidden;
        padding-top: 66px;
      }

      .site-shell::before {
        position: absolute;
        top: 66px;
        bottom: 0;
        right: clamp(18px, 3.6vw, 64px);
        left: clamp(18px, 3.6vw, 64px);
        z-index: 0;
        content: "";
        pointer-events: none;
        background:
          radial-gradient(ellipse at 82% 8%, rgba(216, 210, 155, 0.18), transparent 34rem),
          radial-gradient(ellipse at 18% 21%, rgba(49, 152, 138, 0.18), transparent 34rem),
          radial-gradient(ellipse at 50% 36%, rgba(3, 15, 19, 0.34), transparent 52rem),
          radial-gradient(ellipse at 78% 45%, rgba(49, 152, 138, 0.18), transparent 38rem),
          radial-gradient(ellipse at 16% 70%, rgba(49, 152, 138, 0.20), transparent 34rem),
          linear-gradient(
            180deg,
            rgba(3, 15, 19, 0.99) 0%,
            rgba(11, 61, 60, 0.98) 12%,
            rgba(137, 118, 73, 0.96) 17%,
            rgba(216, 210, 155, 0.94) 24%,
            rgba(11, 61, 60, 0.98) 30%,
            rgba(3, 15, 19, 0.99) 46%,
            rgba(11, 61, 60, 0.98) 56%,
            rgba(137, 118, 73, 0.96) 68%,
            rgba(216, 210, 155, 0.94) 78%,
            rgba(11, 61, 60, 0.98) 89%,
            rgba(3, 15, 19, 0.99) 100%
          );
        border-radius: clamp(36px, 6vw, 104px);
        box-shadow:
          inset 0 0 0 1px rgba(216, 210, 155, 0.16),
          0 28px 120px rgba(3, 15, 19, 0.34);
      }

      main,
      .site-footer {
        position: relative;
        z-index: 1;
      }

      .site-header {
        position: fixed;
        top: 0;
        right: 0;
        left: 0;
        z-index: 20;
        background:
          linear-gradient(90deg, rgba(216, 210, 155, 0.92), rgba(238, 231, 198, 0.9) 46%, rgba(49, 152, 138, 0.22));
        backdrop-filter: blur(16px);
      }

      .nav-inner {
        width: min(1180px, calc(100% - 32px));
        min-height: 66px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: var(--ink);
        font-size: 16px;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-decoration: none;
      }

      .wordmark-mark {
        width: 56px;
        height: 35px;
        position: relative;
        flex: 0 0 auto;
        background: none;
      }

      .wordmark-mark::before,
      .wordmark-mark::after {
        position: absolute;
        inset: 0;
        content: "";
        background:
          linear-gradient(135deg, #8e8b6a 0%, #31988a 46%, #030f13 112%);
        -webkit-mask: url("/assets/chaotic-nobg.png") center / contain no-repeat;
        mask: url("/assets/chaotic-nobg.png") center / contain no-repeat;
      }

      .wordmark-mark::before {
        filter:
          drop-shadow(0 0 0.8px rgba(3, 15, 19, 0.82))
          drop-shadow(0.7px 0 0 rgba(3, 15, 19, 0.46))
          drop-shadow(-0.7px 0 0 rgba(49, 152, 138, 0.42))
          drop-shadow(0 0 2.2px rgba(49, 152, 138, 0.28));
      }

      .wordmark-mark::after {
        opacity: 0.92;
        transform: translate(0.9px, 0.55px);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 22px;
        color: var(--ink-3);
        font-size: 13px;
      }

      .nav-links a {
        text-decoration: none;
        transition: color 160ms var(--ease);
      }

      .nav-links a:hover,
      .nav-links a:focus-visible {
        color: var(--ink);
      }

      .nav-burger {
        display: none;
      }

      .mobile-nav {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 19;
        pointer-events: none;
      }

      .mobile-nav-backdrop {
        position: absolute;
        inset: 0;
        backdrop-filter: blur(14px) saturate(1.3);
        -webkit-backdrop-filter: blur(14px) saturate(1.3);
        background: rgba(3, 15, 19, 0.30);
        opacity: 0;
        transition: opacity 240ms var(--ease);
      }

      .mobile-nav-dropdown {
        position: absolute;
        top: 60px;
        right: 12px;
        width: 210px;
        background: rgba(244, 240, 217, 0.92);
        border: 1px solid rgba(244, 240, 217, 0.6);
        border-radius: 18px;
        padding: 8px 0;
        box-shadow:
          0 12px 40px rgba(3, 15, 19, 0.32),
          0 2px 8px rgba(3, 15, 19, 0.18);
        opacity: 0;
        transform: translateY(-10px) scale(0.95);
        transform-origin: top right;
        transition:
          opacity 200ms var(--ease),
          transform 200ms var(--ease);
      }

      .mobile-nav-dropdown a {
        display: flex;
        align-items: center;
        padding: 13px 20px;
        color: rgba(3, 15, 19, 0.82);
        font-size: 15px;
        font-weight: 500;
        text-decoration: none;
        transition: background 140ms, color 140ms;
      }

      .mobile-nav-dropdown a:hover,
      .mobile-nav-dropdown a:focus-visible {
        background: rgba(49, 152, 138, 0.14);
        color: var(--ink);
        outline: none;
      }

      .mobile-nav-dropdown .mobile-nav-divider {
        height: 1px;
        background: rgba(3, 15, 19, 0.10);
        margin: 6px 0;
      }

      .mobile-nav-dropdown .mobile-nav-cta {
        margin: 6px 12px 8px;
        padding: 11px 16px;
        border-radius: 10px;
        background: var(--green);
        color: var(--paper);
        font-size: 14px;
        justify-content: center;
      }

      .mobile-nav-dropdown .mobile-nav-cta:hover {
        background: #27877a;
      }

      .mobile-nav[aria-hidden="false"] {
        pointer-events: auto;
      }

      .mobile-nav[aria-hidden="false"] .mobile-nav-backdrop {
        opacity: 1;
      }

      .mobile-nav[aria-hidden="false"] .mobile-nav-dropdown {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      @media (max-width: 720px) {
        .mobile-nav {
          display: block;
        }
      }

      .nav-action {
        display: inline-flex;
        min-height: 36px;
        align-items: center;
        justify-content: center;
        padding: 0 14px;
        color: var(--paper);
        background: var(--bg-deep);
        border: 1px solid var(--bg-deep);
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition:
          background-color 160ms var(--ease),
          color 160ms var(--ease),
          border-color 160ms var(--ease);
      }

      .nav-action:hover,
      .nav-action:focus-visible {
        color: var(--ink);
        background: var(--yellow);
        border-color: var(--yellow);
      }

      .hero {
        position: relative;
        min-height: calc(100dvh - 66px);
        display: grid;
        align-items: center;
        overflow: hidden;
        color: var(--paper);
        background: transparent;
      }

      .hero::before {
        position: absolute;
        inset: 0;
        z-index: 0;
        content: "";
        pointer-events: none;
        background:
          radial-gradient(circle at 74% 44%, rgba(49, 152, 138, 0.28), transparent 24rem),
          radial-gradient(circle at 26% 72%, rgba(216, 210, 155, 0.08), transparent 24rem);
      }

      .section-inner,
      .hero-inner,
      .footer-inner {
        width: min(var(--section-max), calc(100% - var(--page-gutter-total)));
        margin: 0 auto;
      }

      .hero-inner {
        position: relative;
        z-index: 2;
        display: block;
        padding: 90px 0 72px;
      }

      .hero-brand-title {
        position: absolute;
        top: clamp(12px, 2.4vw, 36px);
        left: calc((100% - min(1180px, calc(100% - var(--page-gutter-total)))) / 2);
        z-index: 1;
        font-size: clamp(52px, 8vw, 108px);
        font-weight: 700;
        letter-spacing: 0.1em;
        line-height: 1;
        background: linear-gradient(135deg, #d8d29b 0%, #31988a 48%, #030f13 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        pointer-events: none;
        user-select: none;
        opacity: 0.82;
      }

      .hero-copy {
        position: relative;
        z-index: 2;
        max-width: 680px;
      }

      .hero-title {
        max-width: 720px;
        margin: 0;
        color: var(--paper);
        font-size: clamp(40px, 4.45vw, 56px);
        font-weight: 500;
        line-height: 1.04;
        letter-spacing: 0;
      }

      .hero-lede {
        max-width: 640px;
        margin: 40px 0 0;
        color: var(--paper-2);
        font-size: 18px;
        line-height: 1.55;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 48px;
      }

      .button-primary,
      .button-secondary {
        display: inline-flex;
        min-height: 44px;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition:
          background-color 160ms var(--ease),
          border-color 160ms var(--ease),
          color 160ms var(--ease);
      }

      .button-primary {
        color: var(--ink);
        background: var(--green);
        border: 1px solid var(--green);
      }

      .button-primary:hover,
      .button-primary:focus-visible {
        background: var(--yellow);
        border-color: var(--yellow);
      }

      .button-secondary {
        color: var(--paper);
        background: transparent;
        border: 1px solid var(--rule-deep);
      }

      .button-secondary:hover,
      .button-secondary:focus-visible {
        border-color: var(--yellow);
        color: var(--yellow);
      }

      .data-strip {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 64px;
      }

      .data-strip .metric {
        padding: 17px 18px;
        border-radius: var(--radius-soft);
        background: rgba(3, 15, 19, 0.28);
        box-shadow: inset 0 0 0 1px rgba(216, 210, 155, 0.08);
      }

      .metric-value {
        color: var(--paper);
        font-family: var(--font-mono);
        font-size: clamp(26px, 4vw, 42px);
        line-height: 1;
        font-variant-numeric: tabular-nums;
      }

      .metric-label {
        margin-top: 8px;
        color: var(--paper-2);
        font-size: 12px;
        line-height: 1.45;
      }

      .metric-source {
        display: block;
        margin-top: 5px;
        color: var(--paper-3);
        font-family: var(--font-mono);
        font-size: 10px;
      }

      .hero-visual {
        position: absolute;
        inset: -110px -16vw -96px 28%;
        z-index: 1;
        min-height: 0;
        pointer-events: none;
      }

      .hero-figure {
        position: absolute;
        inset: 0;
        width: auto;
        height: auto;
        margin: 0;
        isolation: auto;
      }

      .hero-model::before,
      .hero-model::after {
        display: none;
        content: none;
      }

      .hero-model::before {
        inset: 0;
        border-radius: 43% 57% 51% 49% / 48% 43% 57% 52%;
        background:
          radial-gradient(ellipse at 58% 45%, rgba(49, 152, 138, 0.16), transparent 46%),
          radial-gradient(ellipse at 36% 64%, rgba(216, 210, 155, 0.045), transparent 54%);
        filter: blur(34px);
        opacity: 0.78;
        animation: heroFluidDrift 13s ease-in-out infinite alternate;
      }

      .hero-model::after {
        inset: 12%;
        border-radius: 56% 44% 46% 54% / 52% 60% 40% 48%;
        background:
          radial-gradient(ellipse at 50% 48%, rgba(49, 152, 138, 0.16), transparent 42%),
          radial-gradient(ellipse at 38% 58%, rgba(216, 210, 155, 0.07), transparent 48%);
        filter: blur(24px);
        opacity: 0.72;
        animation: heroFluidDrift 16s ease-in-out infinite alternate-reverse;
      }

      .hero-model-canvas {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        filter: drop-shadow(0 0 18px rgba(49, 152, 138, 0.14));
      }

      @keyframes heroFluidDrift {
        0% {
          transform: translate3d(-1.5%, 1%, 0) scale(0.98, 1.02);
          border-radius: 43% 57% 51% 49% / 48% 43% 57% 52%;
        }

        55% {
          transform: translate3d(1.5%, -1%, 0) scale(1.02, 0.98);
          border-radius: 58% 42% 44% 56% / 42% 55% 45% 58%;
        }

        100% {
          transform: translate3d(1%, 1.5%, 0) scale(0.99, 1.01);
          border-radius: 49% 51% 59% 41% / 56% 43% 57% 44%;
        }
      }

      .section {
        position: relative;
        scroll-margin-top: 66px;
        padding: 108px 0;
        background: transparent;
      }

      .section[data-edge-title]::before {
        position: absolute;
        top: 82px;
        left: clamp(30px, 4.6vw, 88px);
        z-index: 2;
        content: attr(data-edge-title);
        color: rgba(5, 35, 34, 0.78);
        font-size: clamp(46px, 4.4vw, 58px);
        font-weight: 700;
        line-height: 0.92;
        letter-spacing: 0;
        opacity: 0.82;
        pointer-events: none;
        text-shadow: 0 1px 22px rgba(244, 240, 217, 0.22);
        text-transform: none;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
      }

      .section[data-edge-side="right"]::before {
        right: clamp(30px, 4.6vw, 88px);
        left: auto;
        transform: none;
      }

      .section[data-edge-tone="deep"]::before {
        color: rgba(244, 240, 217, 0.62);
        text-shadow:
          0 1px 18px rgba(3, 15, 19, 0.3),
          0 0 28px rgba(216, 210, 155, 0.12);
      }

      .section[data-edge-title] .section-inner {
        position: relative;
        z-index: 3;
      }

      .section.alt {
        background: transparent;
      }

      #evidence {
        overflow: hidden;
        background: transparent;
        color: var(--paper);
      }

      #evidence .section-inner {
        width: min(var(--section-max), calc(100% - var(--page-gutter-total)));
      }

      #evidence .section-heading {
        grid-template-columns: minmax(0, 0.78fr) minmax(0, 0.64fr);
        gap: clamp(28px, 4vw, 56px);
      }

      #evidence .section-title {
        max-width: 620px;
      }

      #evidence .section-lede {
        max-width: 520px;
        justify-self: end;
      }

      #evidence .label {
        color: var(--paper-3);
      }

      #evidence .section-title,
      #evidence .verdict-detail h3 {
        color: var(--paper);
      }

      #evidence .section-lede,
      #evidence .verdict-detail p {
        color: rgba(255, 255, 255, 0.76);
      }

      #evidence .verdict-detail {
        border-top-color: rgba(216, 210, 155, 0.36);
        border-bottom-color: rgba(216, 210, 155, 0.26);
      }

      .section.dark {
        color: var(--paper);
        background: transparent;
      }

      .section-heading {
        display: grid;
        grid-template-columns: minmax(0, 0.75fr) minmax(280px, 0.65fr);
        gap: clamp(28px, 6vw, 88px);
        align-items: end;
        margin-bottom: 46px;
      }

      #process .section-heading {
        align-items: start;
      }

      .label {
        display: none;
        margin-bottom: 12px;
        color: var(--ink-3);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .section.dark .label {
        color: var(--paper-3);
      }

      .section-title {
        max-width: 760px;
        margin: 0;
        color: var(--ink);
        font-size: clamp(32px, 4vw, 46px);
        font-weight: 500;
        line-height: 1.1;
        letter-spacing: 0;
      }

      .section.dark .section-title {
        color: var(--paper);
      }

      .section-lede {
        max-width: 620px;
        margin: 0;
        color: var(--ink-2);
        font-size: 18px;
        line-height: 1.55;
      }

      .section.dark .section-lede {
        color: var(--paper-2);
      }

      .section:not(.dark) .label {
        color: rgba(244, 240, 217, 0.76);
        text-shadow: 0 1px 16px rgba(3, 15, 19, 0.28);
      }

      .section:not(.dark) .section-title {
        color: var(--paper);
        text-shadow: 0 2px 20px rgba(3, 15, 19, 0.26);
      }

      .section:not(.dark) .section-lede {
        color: rgba(244, 240, 217, 0.82);
        text-shadow: 0 1px 16px rgba(3, 15, 19, 0.22);
      }

      #process::before,
      #glossary::before {
        color: rgba(244, 240, 217, 0.58);
      }

      .process-flow {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        background: transparent;
      }

      .process-step {
        display: grid;
        grid-template-rows: auto auto 1fr;
        min-height: 520px;
        overflow: hidden;
        background:
          radial-gradient(ellipse at 80% 0%, rgba(49, 152, 138, 0.10), transparent 20rem),
          linear-gradient(180deg, rgba(244, 240, 217, 0.94), rgba(238, 231, 198, 0.92));
        border-radius: var(--radius-panel);
        box-shadow:
          0 18px 48px rgba(3, 15, 19, 0.08),
          inset 0 0 0 1px rgba(137, 118, 73, 0.12);
      }

      .process-figure {
        min-height: 218px;
        display: grid;
        place-items: center;
        background:
          radial-gradient(circle at 50% 50%, rgba(49, 152, 138, 0.10), transparent 44%),
          rgba(222, 212, 157, 0.38);
      }

      .process-svg {
        width: min(260px, 82%);
        height: auto;
        overflow: visible;
      }

      .process-step:nth-child(1) .process-svg line[stroke="#31988a"] {
        stroke-dasharray: 54 18;
        animation: process-dash 2.4s linear infinite;
      }

      .process-step:nth-child(1) .process-svg circle,
      .process-step:nth-child(2) .process-svg circle,
      .process-step:nth-child(3) .process-svg circle {
        transform-box: fill-box;
        transform-origin: center;
        animation: process-node-pulse 2.2s ease-in-out infinite;
      }

      .process-step:nth-child(2) .process-svg line {
        stroke-dasharray: 2 9;
        animation: process-dash 3.0s linear infinite;
      }

      .process-step:nth-child(2) .process-svg circle:first-child {
        animation: process-orbit-breathe 3.2s ease-in-out infinite;
      }

      .process-step:nth-child(3) .process-svg line {
        animation: process-dash 3.4s linear infinite;
      }

      .process-step:nth-child(3) .process-svg circle:nth-of-type(2n) {
        animation-delay: 400ms;
      }

      @keyframes process-dash {
        from {
          stroke-dashoffset: 0;
        }
        to {
          stroke-dashoffset: -144;
        }
      }

      @keyframes process-node-pulse {
        0%,
        100% {
          opacity: 0.55;
          transform: scale(0.6);
        }
        50% {
          opacity: 1;
          transform: scale(1.55);
        }
      }

      @keyframes process-orbit-breathe {
        0%,
        100% {
          opacity: 0.5;
          transform: scale(0.62) translateY(0px);
        }
        50% {
          opacity: 1;
          transform: scale(1.48) translateY(-4px);
        }
      }

      .process-copy {
        padding: 26px;
      }

      .step-number {
        display: block;
        color: var(--green-2);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.14em;
      }

      .process-step h3 {
        margin: 0 0 16px;
        color: var(--ink);
        font-size: 24px;
        font-weight: 500;
        line-height: 1.18;
      }

      .process-step p {
        margin: 0;
        color: var(--ink-2);
        font-size: 15px;
        line-height: 1.6;
      }

      .verdict-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.58fr);
        gap: clamp(28px, 4vw, 56px);
        align-items: center;
      }

      .spike-panel {
        position: relative;
        width: min(100%, 780px);
        min-height: clamp(640px, 52vw, 820px);
        justify-self: center;
        overflow: visible;
        isolation: isolate;
        touch-action: none;
        cursor: grab;
        background: transparent;
        border: 0;
      }

      .spike-panel::before {
        display: none;
        content: none;
      }

      .spike-panel.is-dragging {
        cursor: grabbing;
      }

      .spike-canvas-wrap {
        position: absolute;
        inset: 0 -4% 0;
        z-index: 1;
      }

      .spike-canvas {
        width: 100%;
        height: 100%;
        display: block;
      }

      .spike-label-layer {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
      }

      .spike-keyword-layer {
        position: absolute;
        inset: 0;
        z-index: 4;
        overflow: visible;
        pointer-events: none;
      }

      .spike-keyword {
        position: absolute;
        left: var(--x);
        top: var(--y);
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        opacity: 0.78;
        pointer-events: auto;
        transform: translate(-50%, -50%);
        animation: keywordDrift 12s var(--ease) var(--d) infinite alternate;
      }

      .spike-keyword:nth-child(3n + 1) {
        opacity: 0.7;
      }

      .spike-keyword:nth-child(4n) {
        opacity: 0.58;
      }

      .spike-keyword-dot {
        position: relative;
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: rgba(216, 210, 155, 0.88);
        box-shadow:
          0 0 10px rgba(216, 210, 155, 0.58),
          0 0 22px rgba(216, 210, 155, 0.26);
        transition:
          box-shadow 160ms var(--ease),
          transform 160ms var(--ease),
          background 160ms var(--ease);
      }

      .spike-keyword-dot::after {
        position: absolute;
        inset: -5px;
        border: 1px solid rgba(216, 210, 155, 0.28);
        border-radius: inherit;
        content: "";
        opacity: 0.58;
      }

      .spike-keyword:nth-child(3n + 1) .spike-keyword-dot {
        background: rgba(49, 152, 138, 0.92);
        box-shadow:
          0 0 10px rgba(49, 152, 138, 0.62),
          0 0 24px rgba(49, 152, 138, 0.3);
      }

      .spike-keyword:nth-child(3n + 1) .spike-keyword-dot::after {
        border-color: rgba(49, 152, 138, 0.3);
      }

      .spike-keyword-text {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 8px);
        min-width: max-content;
        max-width: 240px;
        padding: 7px 9px;
        border: 1px solid rgba(216, 210, 155, 0.52);
        border-radius: 999px;
        background: rgba(3, 15, 19, 0.94);
        color: var(--paper-2);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        line-height: 1.15;
        text-transform: uppercase;
        opacity: 0;
        pointer-events: none;
        transform: translateX(-50%) translateY(4px);
        transition:
          opacity 160ms var(--ease),
          transform 160ms var(--ease);
      }

      .spike-keyword:hover {
        opacity: 1;
      }

      .spike-keyword:hover .spike-keyword-dot {
        transform: scale(1.7);
        box-shadow:
          0 0 14px rgba(216, 210, 155, 0.82),
          0 0 30px rgba(49, 152, 138, 0.34);
      }

      .spike-keyword:hover .spike-keyword-text {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      @keyframes keywordDrift {
        from {
          transform: translate(-50%, -50%) translate(-5px, 2px);
        }

        to {
          transform: translate(-50%, -50%) translate(5px, -2px);
        }
      }

      .spike-node {
        --x: 50%;
        --y: 50%;
        position: absolute;
        top: 0;
        left: 0;
        width: 22px;
        height: 22px;
        display: grid;
        place-items: center;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--paper);
        cursor: pointer;
        pointer-events: auto;
        transform: translate(calc(var(--x) - 50%), calc(var(--y) - 50%));
      }

      .spike-dot {
        width: 4px;
        height: 4px;
        border-radius: 999px;
        background: var(--green);
        box-shadow: 0 0 14px rgba(49, 152, 138, 0.72), 0 0 30px rgba(49, 152, 138, 0.36);
        transition:
          box-shadow 180ms var(--ease),
          transform 180ms var(--ease),
          background 180ms var(--ease),
          border-color 180ms var(--ease);
      }

      .spike-node[data-verdict-key="partial"] .spike-dot {
        background: var(--yellow);
        box-shadow: 0 0 14px rgba(216, 210, 155, 0.72), 0 0 30px rgba(216, 210, 155, 0.36);
      }

      .spike-node[data-verdict-key="unsupported"] .spike-dot {
        background: var(--bg-deep);
        border: 1px solid var(--yellow-2);
        box-shadow: 0 0 12px rgba(216, 210, 155, 0.34);
      }

      .spike-node[data-verdict-key="atomic-claim"] .spike-dot,
      .spike-node[data-verdict-key="decomposition"] .spike-dot {
        background: var(--green);
        border: 1px solid rgba(216, 210, 155, 0.32);
        box-shadow: 0 0 12px rgba(49, 152, 138, 0.62), 0 0 26px rgba(216, 210, 155, 0.18);
      }

      .spike-node[data-verdict-key="evidence-base"] .spike-dot {
        background: var(--yellow);
        box-shadow: 0 0 14px rgba(216, 210, 155, 0.62), 0 0 26px rgba(49, 152, 138, 0.24);
      }

      .spike-label-text {
        position: absolute;
        left: 50%;
        top: 50%;
        min-width: max-content;
        padding: 6px 9px;
        border: 1px solid rgba(216, 210, 155, 0.36);
        border-radius: 999px;
        background: rgba(3, 15, 19, 0.88);
        color: var(--paper);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.02em;
        line-height: 1;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, -148%) scale(0.96);
        transition:
          opacity 160ms var(--ease),
          transform 160ms var(--ease);
      }

      .spike-node:hover .spike-label-text,
      .spike-node:focus-visible .spike-label-text {
        opacity: 1;
        transform: translate(-50%, -162%) scale(1);
      }

      .spike-node:hover .spike-dot,
      .spike-node:focus-visible .spike-dot,
      .spike-node[aria-pressed="true"] .spike-dot {
        transform: scale(1.34);
        box-shadow: 0 0 18px rgba(216, 210, 155, 0.82), 0 0 36px rgba(49, 152, 138, 0.42);
      }

      .spike-node:focus-visible {
        outline: 1px solid var(--yellow);
        outline-offset: 3px;
      }

      .definition-list {
        display: grid;
        align-items: center;
        min-width: 0;
      }

      .verdict-detail {
        min-height: 250px;
        display: grid;
        align-content: center;
        padding: 34px;
        border-radius: var(--radius-panel);
        background: rgba(244, 240, 217, 0.08);
        transition:
          opacity 200ms var(--ease),
          transform 200ms var(--ease);
      }

      .verdict-detail.is-out {
        opacity: 0;
        transform: translateY(6px);
      }

      .verdict-detail.is-in {
        opacity: 1;
        transform: translateY(0);
      }

      .verdict-detail .type,
      .definition-card .type {
        display: none;
      }

      .verdict-detail h3,
      .definition-card h3 {
        margin: 0 0 10px;
        color: var(--ink);
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 500;
      }

      .verdict-detail p,
      .definition-card p {
        margin: 0;
        color: var(--ink-2);
        font-size: clamp(17px, 1.8vw, 21px);
        line-height: 1.58;
      }

      .glossary-grid {
        display: grid;
        gap: 16px;
        background: transparent;
      }

      .glossary-row {
        display: grid;
        grid-template-columns: 260px minmax(0, 1fr);
        min-height: 142px;
        background:
          radial-gradient(ellipse at 86% 50%, rgba(49, 152, 138, 0.08), transparent 24rem),
          rgba(244, 240, 217, 0.94);
        border-radius: var(--radius-panel);
        box-shadow: inset 0 0 0 1px rgba(137, 118, 73, 0.12);
      }

      .glossary-term {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 26px;
      }

      .glyph {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
      }

      .glossary-term span {
        display: block;
        color: var(--ink-3);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .glossary-term strong {
        display: block;
        margin-top: 0;
        color: var(--ink);
        font-size: 20px;
        font-weight: 500;
      }

      .glossary-copy {
        display: grid;
        align-items: center;
        padding: 26px 30px;
      }

      .glossary-copy p {
        max-width: 760px;
        margin: 0;
        color: var(--ink-2);
        font-size: 16px;
        line-height: 1.62;
      }

      .workspace-shell {
        background: var(--bg-deep);
        border: 1px solid rgba(216, 210, 155, 0.12);
        border-radius: var(--radius-panel);
        color: var(--paper);
        overflow: hidden;
        box-shadow: 0 26px 80px rgba(3, 15, 19, 0.34);
      }

      .workspace-topbar {
        min-height: 64px;
        display: grid;
        grid-template-columns: 220px minmax(0, 1fr) auto;
        gap: 20px;
        align-items: center;
        padding: 0 22px;
        background: rgba(4, 18, 22, 0.96);
      }

      .workspace-brand {
        color: var(--paper);
        font-weight: 500;
        letter-spacing: 0.12em;
      }

      .workspace-run {
        color: var(--paper-3);
        font-family: var(--font-mono);
        font-size: 12px;
      }

      .review-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--yellow);
        font-family: var(--font-mono);
        font-size: 11px;
        text-transform: uppercase;
      }

      .status-light {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--yellow);
      }

      .workspace-grid {
        display: grid;
        grid-template-columns: 58px minmax(0, 1fr) 330px;
        gap: 12px;
        padding: 12px;
        min-height: 680px;
      }

      .workspace-rail {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: center;
        padding: 12px;
        border-radius: var(--radius-soft);
        background: #041216;
      }

      .rail-step {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        color: var(--paper-3);
        background: transparent;
        border: 1px solid var(--rule-deep);
        border-radius: 10px;
        cursor: pointer;
        transition:
          background-color 160ms var(--ease),
          border-color 160ms var(--ease),
          color 160ms var(--ease);
      }

      .rail-step svg {
        width: 17px;
        height: 17px;
        stroke: currentColor;
        fill: none;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .rail-step.is-active {
        color: var(--ink);
        background: var(--green);
        border-color: var(--green);
      }

      .rail-step:hover,
      .rail-step:focus-visible {
        color: var(--yellow);
        border-color: var(--yellow);
        outline: none;
      }

      .workspace-main {
        padding: 0;
      }

      .claim-card {
        padding: 24px;
        background: var(--bg-deep-2);
        border-radius: var(--radius-soft);
        box-shadow: inset 0 0 0 1px rgba(216, 210, 155, 0.1);
      }

      .claim-card-header,
      .graph-label,
      .queue-label,
      .audit-head {
        display: none;
        color: var(--paper-3);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .claim-card h3 {
        max-width: 760px;
        margin: 0;
        color: var(--paper);
        font-size: 25px;
        font-weight: 500;
        line-height: 1.28;
      }

      .graph-panel {
        position: relative;
        min-height: 250px;
        margin-top: 18px;
        padding: 22px;
        background:
          radial-gradient(circle at 58% 44%, rgba(49, 152, 138, 0.14), transparent 13rem),
          #041316;
        border-radius: var(--radius-soft);
        box-shadow: inset 0 0 0 1px rgba(216, 210, 155, 0.09);
      }

      .claim-graph {
        width: 100%;
        height: 210px;
      }

      .queue {
        margin-top: 18px;
        padding: 18px;
        background: var(--bg-deep-2);
        border-radius: var(--radius-soft);
        box-shadow: inset 0 0 0 1px rgba(216, 210, 155, 0.1);
      }

      .claim-list {
        display: grid;
        gap: 10px;
        margin-top: 14px;
      }

      .claim-row {
        position: relative;
        width: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: start;
        padding: 14px 14px 14px 16px;
        color: var(--paper);
        background: #05181d;
        border: 0;
        border-radius: 12px;
        box-shadow:
          inset 2px 0 0 var(--paper-3),
          inset 0 0 0 1px rgba(216, 210, 155, 0.08);
        text-align: left;
        cursor: pointer;
        transition:
          border-color 160ms var(--ease),
          background-color 160ms var(--ease),
          box-shadow 160ms var(--ease),
          transform 160ms var(--ease);
      }

      .claim-row[data-status="green"] {
        box-shadow:
          inset 2px 0 0 var(--green),
          inset 0 0 0 1px rgba(216, 210, 155, 0.08);
      }

      .claim-row[data-status="yellow"] {
        box-shadow:
          inset 2px 0 0 var(--yellow-2),
          inset 0 0 0 1px rgba(216, 210, 155, 0.08);
      }

      .claim-row[aria-selected="true"],
      .claim-row.is-active,
      .claim-row:hover,
      .claim-row:focus-visible {
        background: #092129;
        box-shadow:
          inset 3px 0 0 currentColor,
          inset 0 0 0 1px rgba(216, 210, 155, 0.16),
          0 0 0 1px rgba(49, 152, 138, 0.08);
        outline: 0;
      }

      .claim-row[data-status="green"][aria-selected="true"],
      .claim-row[data-status="green"].is-active {
        color: var(--green);
      }

      .claim-row[data-status="yellow"][aria-selected="true"],
      .claim-row[data-status="yellow"].is-active {
        color: var(--yellow);
      }

      .claim-row[aria-selected="true"],
      .claim-row.is-active {
        transform: translateX(3px);
      }

      .claim-row[aria-selected="true"]::after,
      .claim-row.is-active::after {
        content: "";
        position: absolute;
        top: 50%;
        right: -19px;
        width: 9px;
        height: 9px;
        border-top: 1px solid var(--yellow);
        border-right: 1px solid var(--yellow);
        opacity: 0.9;
        transform: translateY(-50%) rotate(45deg);
      }

      .claim-row strong {
        display: block;
        color: var(--paper);
        font-size: 14px;
        font-weight: 500;
        line-height: 1.42;
      }

      .claim-row small {
        display: block;
        margin-top: 8px;
        color: var(--paper-3);
        font-family: var(--font-mono);
        font-size: 10px;
      }

      .verdict-pill {
        min-width: 86px;
        padding: 5px 8px;
        border: 1px solid currentColor;
        border-radius: 999px;
        color: var(--paper-3);
        font-family: var(--font-mono);
        font-size: 10px;
        text-align: center;
        text-transform: uppercase;
      }

      .claim-row[data-status="green"] .verdict-pill {
        color: var(--green);
      }

      .claim-row[data-status="yellow"] .verdict-pill {
        color: var(--yellow);
      }

      .audit-panel {
        position: relative;
        border-radius: var(--radius-soft);
        background: #041216;
        overflow: hidden;
        transition:
          background-color 180ms var(--ease),
          box-shadow 180ms var(--ease);
      }

      .audit-panel::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 2px;
        background: var(--green);
        opacity: 0;
        transition:
          opacity 180ms var(--ease),
          background-color 180ms var(--ease);
      }

      .workspace-shell.has-selection .audit-panel::before {
        opacity: 1;
      }

      .audit-panel.is-active {
        box-shadow:
          inset 0 0 0 1px rgba(216, 210, 155, 0.16),
          0 0 0 1px rgba(49, 152, 138, 0.12);
      }

      .audit-panel[data-status="yellow"]::before {
        background: var(--yellow);
      }

      .audit-panel[data-status="neutral"]::before {
        background: var(--paper-3);
      }

      .audit-head {
        padding: 20px;
      }

      .evidence-detail {
        padding: 20px;
        margin: 0 12px 12px;
        border-radius: 12px;
        background: rgba(216, 210, 155, 0.05);
        transition:
          opacity 140ms var(--ease),
          transform 140ms var(--ease);
      }

      .evidence-detail.is-updating {
        opacity: 0.48;
        transform: translateY(4px);
      }

      .evidence-detail h3 {
        margin: 0 0 14px;
        color: var(--paper);
        font-size: 20px;
        font-weight: 500;
      }

      .audit-panel[data-status="green"] .evidence-detail h3 {
        color: var(--green);
      }

      .audit-panel[data-status="yellow"] .evidence-detail h3 {
        color: var(--yellow);
      }

      .audit-panel[data-status="neutral"] .evidence-detail h3 {
        color: var(--paper);
      }

      .evidence-detail p {
        margin: 0;
        color: var(--paper-2);
        font-size: 14px;
        line-height: 1.62;
      }

      .source-line {
        display: block;
        margin-top: 14px;
        color: var(--green);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .audit-panel[data-status="yellow"] .source-line {
        color: var(--yellow);
      }

      .audit-panel[data-status="neutral"] .source-line {
        color: var(--paper-3);
      }

      .claim-graph .graph-verdict-node,
      .claim-graph .graph-source-node,
      .claim-graph .graph-active-edge,
      .claim-graph .graph-source-edge {
        transition:
          fill 180ms var(--ease),
          stroke 180ms var(--ease),
          opacity 180ms var(--ease);
      }

      .workspace-shell[data-active-status="green"] .graph-verdict-node {
        fill: var(--green);
        stroke: var(--green);
      }

      .workspace-shell[data-active-status="yellow"] .graph-verdict-node {
        fill: var(--yellow-2);
        stroke: var(--yellow);
      }

      .workspace-shell[data-active-status="neutral"] .graph-verdict-node {
        fill: #07171c;
        stroke: var(--paper-3);
      }

      .workspace-shell[data-active-status="green"] .graph-active-edge,
      .workspace-shell[data-active-status="green"] .graph-source-edge {
        stroke: var(--green);
        opacity: 1;
      }

      .workspace-shell[data-active-status="yellow"] .graph-active-edge,
      .workspace-shell[data-active-status="yellow"] .graph-source-edge {
        stroke: var(--yellow);
        opacity: 0.9;
      }

      .workspace-shell[data-active-status="neutral"] .graph-active-edge,
      .workspace-shell[data-active-status="neutral"] .graph-source-edge {
        stroke: var(--paper-3);
        opacity: 0.58;
      }

      .event-list {
        display: grid;
        gap: 8px;
        padding: 0 12px 12px;
      }

      .event-row {
        display: grid;
        grid-template-columns: 72px minmax(0, 1fr);
        gap: 12px;
        padding: 14px 12px;
        border-radius: 12px;
        background: rgba(216, 210, 155, 0.035);
        font-family: var(--font-mono);
        font-size: 11px;
      }

      .event-time {
        color: var(--paper-3);
      }

      .event-detail {
        color: var(--paper-2);
        line-height: 1.5;
      }

      .event-detail strong {
        display: block;
        margin-bottom: 3px;
        color: var(--paper);
        font-weight: 500;
        text-transform: uppercase;
      }

      .download-block {
        position: relative;
        min-height: 480px;
        overflow: hidden;
        isolation: isolate;
        display: grid;
        align-items: center;
        padding: clamp(36px, 6vw, 72px);
        background:
          radial-gradient(circle at 72% 44%, rgba(216, 210, 155, 0.16), transparent 22rem),
          linear-gradient(110deg, #d8d29b 0%, #31988a 48%, #030f13 100%);
        border-radius: var(--radius-panel);
        color: var(--paper);
        box-shadow:
          0 28px 90px rgba(3, 15, 19, 0.28),
          inset 0 0 0 1px rgba(216, 210, 155, 0.14);
      }

      .download-block::before {
        position: absolute;
        inset: 0;
        z-index: 0;
        content: "";
        pointer-events: none;
        background: linear-gradient(90deg, rgba(3, 15, 19, 0.88), rgba(3, 15, 19, 0.36) 54%, rgba(3, 15, 19, 0.72));
      }

      .download-canvas {
        position: absolute;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      .download-content {
        position: relative;
        z-index: 2;
        max-width: 520px;
      }

      .download-title {
        margin: 0;
        color: var(--paper);
        font-size: clamp(38px, 5vw, 64px);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: 0;
      }

      .download-copy {
        margin: 22px 0 0;
        color: var(--paper-2);
        font-size: 17px;
        line-height: 1.58;
      }

      .download-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 30px;
      }

      .download-button {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        padding: 0 22px;
        color: var(--ink);
        background: var(--paper);
        border: 1px solid var(--paper);
        border-radius: 12px;
        font-weight: 500;
        text-decoration: none;
      }

      .download-button[aria-disabled="true"] {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .download-button.secondary {
        color: var(--paper);
        background: transparent;
        border-color: rgba(255, 255, 255, 0.36);
      }

      .download-note {
        margin-top: 20px;
        color: rgba(255, 255, 255, 0.58);
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 1.55;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        background: transparent;
      }

      .contact-card {
        min-height: 240px;
        padding: 26px;
        background:
          radial-gradient(ellipse at 100% 20%, rgba(49, 152, 138, 0.09), transparent 18rem),
          rgba(244, 240, 217, 0.92);
        border-radius: var(--radius-panel);
        box-shadow: inset 0 0 0 1px rgba(137, 118, 73, 0.12);
        text-decoration: none;
        transition:
          box-shadow 160ms var(--ease),
          transform 160ms var(--ease);
      }

      .contact-card:hover,
      .contact-card:focus-visible {
        transform: translateY(-3px);
        box-shadow:
          inset 0 0 0 1px rgba(49, 152, 138, 0.28),
          0 10px 32px rgba(3, 15, 19, 0.13);
        outline: none;
      }

      .contact-card span {
        display: block;
        color: var(--green-2);
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .contact-card h3 {
        margin: 0 0 12px;
        color: var(--ink);
        font-size: 24px;
        font-weight: 500;
        line-height: 1.16;
      }

      .contact-card p {
        margin: 0;
        color: var(--ink-2);
        font-size: 15px;
        line-height: 1.6;
      }

      #contact .label {
        color: rgba(216, 210, 155, 0.72);
      }

      #contact .section-title {
        color: var(--paper);
      }

      #contact .section-lede {
        color: rgba(255, 255, 255, 0.72);
      }

      .site-footer {
        position: relative;
        z-index: 1;
        color: var(--paper-2);
        background: transparent;
      }

      .footer-inner {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 34px;
        align-items: end;
        padding: 34px 0;
      }

      .footer-brand {
        color: var(--paper);
        font-weight: 500;
        letter-spacing: 0.18em;
      }

      .footer-small,
      .footer-links {
        color: var(--paper-3);
        font-family: var(--font-mono);
        font-size: 11px;
        line-height: 1.6;
      }

      .footer-links {
        display: flex;
        gap: 18px;
      }

      .footer-links a {
        text-decoration: none;
      }

      .footer-links a:hover {
        color: var(--paper);
      }

      @media (max-width: 980px) {
        .site-shell::before {
          right: 14px;
          left: 14px;
          border-radius: 44px;
        }

        .section-heading,
        .verdict-layout,
        .workspace-grid {
          grid-template-columns: 1fr;
        }

        #evidence .section-inner {
          width: min(100% - 112px, 1180px);
        }

        #evidence .section-lede,
        #evidence .verdict-detail {
          justify-self: start;
        }

        .hero-visual {
          inset: -80px -28vw -90px 18%;
          opacity: 0.58;
        }

        .hero-figure {
          margin: 0;
        }

        .process-flow,
        .contact-grid {
          grid-template-columns: 1fr;
        }

        .process-step {
          min-height: 0;
        }

        .spike-panel {
          min-height: 440px;
        }

        #evidence .spike-panel {
          width: min(100%, 860px);
          min-height: clamp(560px, 72vw, 760px);
        }

        .section[data-edge-title]::before {
          top: 34px;
          left: 22px;
          font-size: 48px;
          opacity: 0.64;
        }

        .section[data-edge-side="right"]::before {
          right: 22px;
        }

        .workspace-grid {
          min-height: 0;
        }

        .workspace-rail {
          flex-direction: row;
          justify-content: flex-start;
          overflow-x: auto;
          padding: 12px 18px;
        }

        .audit-panel {
          border-left: 0;
        }

        .audit-panel::before {
          inset: 0 0 auto 0;
          width: auto;
          height: 2px;
        }
      }

      @media (max-width: 720px) {
        .nav-action {
          display: none;
        }

        .site-shell::before {
          right: 8px;
          left: 8px;
          border-radius: 30px;
        }

        .nav-inner,
        .section-inner,
        .hero-inner,
        .footer-inner {
          width: min(100% - 56px, 1180px);
        }

        #evidence .section-inner {
          width: min(100% - 64px, 1180px);
        }

        .site-header {
          position: fixed;
        }

        .nav-links {
          display: none;
        }

        .nav-burger {
          display: flex;
          flex-direction: column;
          justify-content: center;
          gap: 5px;
          width: 40px;
          height: 40px;
          padding: 8px;
          background: transparent;
          border: 1px solid rgba(10, 10, 10, 0.18);
          border-radius: 10px;
          cursor: pointer;
          flex-shrink: 0;
        }

        .nav-burger span {
          display: block;
          height: 1.5px;
          background: var(--ink);
          border-radius: 2px;
          transition: transform 200ms var(--ease), opacity 200ms var(--ease);
        }

        .nav-burger[aria-expanded="true"] span:nth-child(1) {
          transform: translateY(6.5px) rotate(45deg);
        }

        .nav-burger[aria-expanded="true"] span:nth-child(2) {
          opacity: 0;
        }

        .nav-burger[aria-expanded="true"] span:nth-child(3) {
          transform: translateY(-6.5px) rotate(-45deg);
        }


        .hero {
          min-height: auto;
        }

        .hero-inner {
          min-height: calc(100dvh - 66px);
          padding: 80px 0 64px;
          display: flex;
          align-items: flex-start;
        }

        .hero-copy {
          width: 100%;
        }

        .hero-title {
          font-size: clamp(34px, 10.4vw, 40px);
        }

        .hero-lede,
        .section-lede {
          font-size: 16px;
        }

        .data-strip {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          margin-top: 32px;
        }

        .data-strip .metric {
          min-width: 0;
          padding: 14px 10px;
        }

        .metric-value {
          font-size: clamp(21px, 6.4vw, 27px);
        }

        .metric-label {
          font-size: 10px;
        }

        .metric-source {
          display: block;
          font-size: 9px;
        }

        .hero-visual {
          position: absolute;
          inset: -18% -50% 12% -18%;
          width: auto;
          opacity: 0.38;
          pointer-events: none;
        }

        .hero-figure {
          width: 100%;
          height: 100%;
        }

        .section {
          padding: 52px 0;
        }

        .section[data-edge-title]::before {
          top: 20px;
          left: clamp(18px, 4vw, 32px);
          font-size: 22px;
          letter-spacing: 0.10em;
          opacity: 0.62;
          writing-mode: horizontal-tb;
          transform: none;
        }

        .section[data-edge-side="right"]::before {
          right: clamp(18px, 4vw, 32px);
          left: auto;
        }

        .hero-brand-title {
          font-size: clamp(32px, 9vw, 52px);
          top: 10px;
        }

        .section-heading {
          margin-bottom: 32px;
        }

        .section-title {
          font-size: 32px;
        }

        .spike-panel {
          min-height: 360px;
        }

        #evidence .spike-panel {
          width: min(100%, 620px);
          min-height: min(104vw, 540px);
        }

        .spike-canvas-wrap {
          inset: 7% 6% 8%;
        }

        .glossary-row {
          grid-template-columns: 1fr;
        }

        .glossary-term {
          border-right: 0;
        }

        .workspace-topbar {
          grid-template-columns: 1fr;
          padding: 18px;
        }

        .workspace-main {
          padding: 0;
        }

        .claim-row {
          grid-template-columns: 1fr;
        }

        .claim-row[aria-selected="true"],
        .claim-row.is-active {
          transform: none;
        }

        .claim-row[aria-selected="true"]::after,
        .claim-row.is-active::after {
          display: none;
        }

        .verdict-pill {
          width: fit-content;
        }

        .download-block {
          padding: 32px 24px;
        }

        .download-actions {
          flex-direction: column;
        }

        .download-button {
          width: 100%;
        }

        .footer-inner {
          grid-template-columns: 1fr;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        .particle-field,
        .download-canvas {
          display: none;
        }

        *,
        *::before,
        *::after {
          animation-duration: 1ms !important;
          transition-duration: 1ms !important;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <canvas class="particle-field" data-bio-particles aria-hidden="true"></canvas>
    <div class="site-shell">
      <header class="site-header">
        <div class="nav-inner">
          <a class="wordmark" href="#top" aria-label="Telotia home">
            <span class="wordmark-mark" aria-hidden="true"></span>
            TELOTIA
          </a>
          <nav class="nav-links" aria-label="Primary navigation">
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <a class="nav-action" href="mailto:hello@telotia.com">Request audit</a>
          <button class="nav-burger" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav-overlay">
            <span></span><span></span><span></span>
          </button>
        </div>
      </header>
      <div class="mobile-nav" id="mobile-nav-overlay" aria-hidden="true">
        <div class="mobile-nav-backdrop"></div>
        <div class="mobile-nav-dropdown">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          <div class="mobile-nav-divider"></div>
          <a href="mailto:hello@telotia.com" class="mobile-nav-cta">Request audit</a>
        </div>
      </div>

      <main id="content">
        <span id="top" aria-hidden="true"></span>
        <section class="hero" aria-labelledby="hero-title">
          <span class="hero-brand-title" aria-hidden="true">TELOTIA</span>
          <div class="hero-inner">
            <div class="hero-copy">
              <h1 class="hero-title" id="hero-title">
                Evidence-grade audit for Canadian health-equipment imports.
              </h1>
              <p class="hero-lede">
                We turn documentation into citation-linked evidence review for teams preparing Canadian proof packages. We check the claim, not the conclusion.
              </p>
              <div class="hero-actions">
                <a class="button-primary" href="mailto:hello@telotia.com">Request an audit</a>
                <a class="button-secondary" href="#process">See the review flow</a>
              </div>
              <div class="data-strip" aria-label="Example review data">
                {metrics.map((item) => (
                  <div class="metric">
                    <div class="metric-value" data-count-to={item.value.replace(/,/g, '')}>{item.value}</div>
                    <div class="metric-label">{item.label}</div>
                    <small class="metric-source">source: {item.source}</small>
                  </div>
                ))}
              </div>
            </div>
            <div class="hero-visual" aria-hidden="true">
              <div class="hero-figure hero-model">
                <canvas class="hero-model-canvas" data-hero-models></canvas>
              </div>
            </div>
          </div>
        </section>

        <section class="section" id="process" data-edge-title="Process" data-edge-side="left">
          <div class="section-inner">
            <div class="section-heading">
              <div>
                <span class="label">How it works</span>
                <h2 class="section-title">Decompose. Search. Grade.</h2>
              </div>
              <p class="section-lede">
                From product documentation to reviewable proof, every claim is separated, searched, graded, and linked back to source evidence.
              </p>
            </div>

            <div class="process-flow">
              {steps.map((step) => (
                <article class="process-step">
                  <div class="process-figure" aria-hidden="true">
                    {step.figure === 'decompose' && (
                      <svg class="process-svg" viewBox="0 0 300 220">
                        <rect x="40" y="32" width="94" height="126" fill="#ffffff" stroke="#1a1a1a" stroke-width="1" />
                        <line x1="58" y1="60" x2="116" y2="60" stroke="#1a1a1a" stroke-width="1" />
                        <line x1="58" y1="82" x2="116" y2="82" stroke="#1a1a1a" stroke-width="1" />
                        <line x1="58" y1="104" x2="116" y2="104" stroke="#1a1a1a" stroke-width="1" />
                        <line x1="58" y1="126" x2="116" y2="126" stroke="#1a1a1a" stroke-width="1" />
                        {[0, 1, 2, 3, 4, 5].map((i) => (
                          <g>
                            <line x1="154" y1={54 + i * 22} x2={206 + (i % 2) * 22} y2={42 + i * 24} stroke="#31988a" stroke-width="1" opacity="0.6" />
                            <circle cx={218 + (i % 2) * 22} cy={38 + i * 24} r="4" fill={i % 2 ? '#d8d29b' : '#31988a'} />
                          </g>
                        ))}
                      </svg>
                    )}
                    {step.figure === 'corpus' && (
                      <svg class="process-svg" viewBox="0 0 300 220">
                        <circle cx="150" cy="110" r="62" fill="none" stroke="#31988a" stroke-width="1" />
                        <circle cx="150" cy="110" r="36" fill="rgba(49,152,138,0.16)" stroke="#1e6f66" stroke-width="1" />
                        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => {
                          const angle = (i / 8) * Math.PI * 2;
                          const x = 150 + Math.cos(angle) * 84;
                          const y = 110 + Math.sin(angle) * 64;
                          return (
                            <g>
                              <line x1="150" y1="110" x2={x} y2={y} stroke="#d8d29b" stroke-width="0.8" opacity="0.55" />
                              <circle cx={x} cy={y} r="3.5" fill={i % 3 === 0 ? '#d8d29b' : '#31988a'} />
                            </g>
                          );
                        })}
                      </svg>
                    )}
                    {step.figure === 'verdict' && (
                      <svg class="process-svg" viewBox="0 0 300 220">
                        <circle cx="150" cy="110" r="76" fill="none" stroke="#d8d8d2" stroke-width="1" />
                        <circle cx="150" cy="110" r="18" fill="#ffffff" stroke="#1a1a1a" stroke-width="1" />
                        {[0, 1, 2, 3, 4, 5].map((i) => {
                          const angle = -Math.PI / 2 + (i / 6) * Math.PI * 2;
                          const x = 150 + Math.cos(angle) * 76;
                          const y = 110 + Math.sin(angle) * 76;
                          const isSupported = i < 3;
                          const isPartial = i === 3 || i === 4;
                          return (
                            <g>
                              <line
                                x1="150"
                                y1="110"
                                x2={x}
                                y2={y}
                                stroke={isSupported ? '#31988a' : isPartial ? '#8e8b6a' : '#8a8a8a'}
                                stroke-width="1"
                                stroke-dasharray={isPartial ? '4 4' : i === 5 ? '2 4' : ''}
                                opacity={i === 5 ? '0.5' : '0.85'}
                              />
                              <circle
                                cx={x}
                                cy={y}
                                r="7"
                                fill={isSupported ? '#31988a' : isPartial ? 'none' : '#ffffff'}
                                stroke={isPartial ? '#d8d29b' : '#1a1a1a'}
                                stroke-width="1"
                              />
                            </g>
                          );
                        })}
                      </svg>
                    )}
                  </div>
