    <script>
      import * as THREE from 'three';

      const initVerdictSpikeBall = (widget: HTMLElement) => {
        const panel = widget.querySelector('.spike-panel');
        const canvasWrap = widget.querySelector('.spike-canvas-wrap');
        const canvas = widget.querySelector('[data-spike-canvas]');
        const labelNodes = Array.from(widget.querySelectorAll('[data-verdict-node]')).filter(
          (node): node is HTMLElement => node instanceof HTMLElement,
        );
        const keywordNodes = Array.from(widget.querySelectorAll('.spike-keyword')).filter(
          (node): node is HTMLElement => node instanceof HTMLElement,
        );

        if (
          !(panel instanceof HTMLElement) ||
          !(canvasWrap instanceof HTMLElement) ||
          !(canvas instanceof HTMLCanvasElement) ||
          labelNodes.length === 0
        ) {
          return;
        }

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
        camera.position.set(0, 0, 6.9);

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.setClearColor(0x000000, 0);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

        const group = new THREE.Group();
        group.rotation.set(-0.16, 0.24, 0.02);
        group.scale.setScalar(1.12);
        scene.add(group);

        scene.add(new THREE.HemisphereLight(0xf7f7f4, 0x030f13, 1.35));
        const keyLight = new THREE.PointLight(0xd8d29b, 2.15, 12);
        keyLight.position.set(-2.6, 2.2, 4.7);
        scene.add(keyLight);
        const greenLight = new THREE.PointLight(0x31988a, 2.35, 10);
        greenLight.position.set(2.4, -2, 4.2);
        scene.add(greenLight);

        const seeded = (index: number) => {
          const value = Math.sin(index * 127.1 + 17.17) * 43758.5453123;
          return value - Math.floor(value);
        };

        const core = new THREE.Mesh(
          new THREE.SphereGeometry(0.045, 24, 16),
          new THREE.MeshStandardMaterial({
            color: 0xd8d29b,
            emissive: 0xd8d29b,
            emissiveIntensity: 0.5,
            roughness: 0.42,
            metalness: 0.16,
          }),
        );
        group.add(core);

        const rayCount = 260;
        const rayPositions = new Float32Array(rayCount * 6);
        const rayColors = new Float32Array(rayCount * 6);
        const rayDirections: THREE.Vector3[] = [];
        const rayStarts: number[] = [];
        const rayLengths: number[] = [];

        const green = new THREE.Color(0x31988a);
        const paleGreen = new THREE.Color(0x83d1c6);
        const yellow = new THREE.Color(0xd8d29b);

        for (let index = 0; index < rayCount; index += 1) {
          const u = (index * 0.61803398875) % 1;
          const v = (index * 0.75487766624) % 1;
          const theta = Math.PI * 2 * u;
          const phi = Math.acos(2 * v - 1);
          const direction = new THREE.Vector3(
            Math.sin(phi) * Math.cos(theta),
            Math.sin(phi) * Math.sin(theta),
            Math.cos(phi),
          ).normalize();
          rayDirections.push(direction);
          rayStarts.push(0.07 + seeded(index + 9) * 0.22);
          rayLengths.push(0.58 + seeded(index + 29) * 0.82);

          const color = index % 17 === 0 ? yellow : index % 5 === 0 ? paleGreen : green;
          const colorOffset = index * 6;
          rayColors[colorOffset] = color.r * 0.74;
          rayColors[colorOffset + 1] = color.g * 0.74;
          rayColors[colorOffset + 2] = color.b * 0.74;
          rayColors[colorOffset + 3] = color.r;
          rayColors[colorOffset + 4] = color.g;
          rayColors[colorOffset + 5] = color.b;
        }

        const writeRays = (time: number) => {
          for (let index = 0; index < rayCount; index += 1) {
            const direction = rayDirections[index];
            const shimmer = reduceMotion ? 0 : Math.sin(time * 0.00085 + index * 0.41) * 0.055;
            const sideBend = reduceMotion ? 0 : Math.sin(time * 0.00042 + index * 0.13) * 0.026;
            const tangent = new THREE.Vector3(-direction.y, direction.x, 0);
            if (tangent.lengthSq() < 0.0001) tangent.set(1, 0, 0);
            tangent.normalize();
            const binormal = new THREE.Vector3().crossVectors(direction, tangent).normalize();
            const start = direction
              .clone()
              .multiplyScalar(rayStarts[index])
              .add(tangent.clone().multiplyScalar((seeded(index + 71) - 0.5) * 0.09))
              .add(binormal.clone().multiplyScalar((seeded(index + 91) - 0.5) * 0.07));
            const filamentDirection = direction
              .clone()
              .multiplyScalar(1.04 + seeded(index + 151) * 0.22)
              .add(tangent.clone().multiplyScalar((seeded(index + 131) - 0.5) * 0.22))
              .add(binormal.clone().multiplyScalar((seeded(index + 171) - 0.5) * 0.18))
              .normalize();
            const end = start
              .clone()
              .add(filamentDirection.multiplyScalar(rayLengths[index] + shimmer))
              .add(tangent.clone().multiplyScalar(sideBend));
            const offset = index * 6;
            rayPositions[offset] = start.x;
            rayPositions[offset + 1] = start.y;
            rayPositions[offset + 2] = start.z;
            rayPositions[offset + 3] = end.x;
            rayPositions[offset + 4] = end.y;
            rayPositions[offset + 5] = end.z;
          }
        };

        writeRays(0);
        const rayGeometry = new THREE.BufferGeometry();
        rayGeometry.setAttribute('position', new THREE.BufferAttribute(rayPositions, 3));
        rayGeometry.setAttribute('color', new THREE.BufferAttribute(rayColors, 3));
        const rays = new THREE.LineSegments(
          rayGeometry,
          new THREE.LineBasicMaterial({
            vertexColors: true,
            transparent: true,
            opacity: 0.72,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
          }),
        );
        group.add(rays);

        const semanticVectors: Record<string, THREE.Vector3> = {
          supported: new THREE.Vector3(0.58, 0.76, 0.21),
          partial: new THREE.Vector3(-0.72, 0.28, 0.55),
          unsupported: new THREE.Vector3(-0.26, -0.86, -0.42),
          'atomic-claim': new THREE.Vector3(0.95, -0.18, 0.31),
          'evidence-base': new THREE.Vector3(-0.91, -0.36, 0.2),
          decomposition: new THREE.Vector3(0.12, 0.46, -0.88),
        };

        const colorByKey: Record<string, number> = {
          supported: 0x31988a,
          partial: 0xd8d29b,
          unsupported: 0x8e8b6a,
          'atomic-claim': 0x83d1c6,
          'evidence-base': 0xd8d29b,
          decomposition: 0x31988a,
        };

        const endpoints: Array<{ node: HTMLElement; mesh: THREE.Mesh; pulse: number }> = [];

        labelNodes.forEach((node, index) => {
          const vector = node.dataset.vector || 'supported';
          const key = node.dataset.verdictKey || 'supported';
          const color = colorByKey[key] || 0x31988a;
          const direction = (semanticVectors[vector] || semanticVectors.supported).clone().normalize();
          const endpointPosition = direction.clone().multiplyScalar(1.38 + (index % 3) * 0.035);
          const bend = new THREE.Vector3(-direction.y, direction.x, direction.z * 0.22);
          if (bend.lengthSq() < 0.0001) bend.set(0.18, 0.08, 0.12);
          bend.normalize().multiplyScalar((index % 2 === 0 ? 1 : -1) * (0.18 + seeded(index + 211) * 0.16));

          const lineCurve = new THREE.CatmullRomCurve3([
            direction.clone().multiplyScalar(0.06),
            direction.clone().multiplyScalar(0.62).add(bend.clone().multiplyScalar(0.45)),
            direction.clone().multiplyScalar(1.18).add(bend),
            endpointPosition,
          ]);
          const ray = new THREE.Mesh(
            new THREE.TubeGeometry(lineCurve, 30, key === 'unsupported' ? 0.0042 : 0.0056, 8, false),
            new THREE.MeshStandardMaterial({
              color,
              emissive: color,
              emissiveIntensity: key === 'supported' ? 0.44 : 0.32,
              roughness: 0.5,
              transparent: true,
              opacity: key === 'unsupported' ? 0.60 : 0.80,
            }),
          );
          group.add(ray);

          const endpoint = new THREE.Mesh(
            new THREE.SphereGeometry(key === 'supported' ? 0.042 : 0.038, 28, 18),
            new THREE.MeshStandardMaterial({
              color,
              emissive: color,
              emissiveIntensity: key === 'supported' ? 0.62 : 0.42,
              roughness: 0.28,
              metalness: 0.08,
            }),
          );
          endpoint.position.copy(endpointPosition);
          group.add(endpoint);
          endpoints.push({ node, mesh: endpoint, pulse: index * 0.9 });
        });

        const tempVector = new THREE.Vector3();
        const keywordAnchors = keywordNodes.map((node, index) => {
          const direction = rayDirections[(index * 13) % rayDirections.length].clone().normalize();
          const tangent = new THREE.Vector3(-direction.y, direction.x, 0);
          if (tangent.lengthSq() < 0.0001) tangent.set(1, 0, 0);
          tangent.normalize();
          const binormal = new THREE.Vector3().crossVectors(direction, tangent).normalize();
          const anchor = direction
            .clone()
            .multiplyScalar(0.28 + seeded(index + 503) * 0.84)
            .add(tangent.clone().multiplyScalar((seeded(index + 521) - 0.5) * 0.42))
            .add(binormal.clone().multiplyScalar((seeded(index + 547) - 0.5) * 0.34));

          return { node, anchor, phase: seeded(index + 601) * Math.PI * 2 };
        });

        const resize = () => {
          const rect = canvasWrap.getBoundingClientRect();
          const width = Math.max(1, Math.floor(rect.width));
          const height = Math.max(1, Math.floor(rect.height));
          camera.position.z = width < 560 ? 8.8 : 6.8;
          camera.aspect = width / height;
          camera.updateProjectionMatrix();
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          renderer.setSize(width, height, true);
        };

        const projectLabels = () => {
          const panelRect = panel.getBoundingClientRect();
          const canvasRect = canvas.getBoundingClientRect();
          group.updateMatrixWorld();

          endpoints.forEach(({ node, mesh }) => {
            mesh.getWorldPosition(tempVector);
            tempVector.project(camera);
            const x = (tempVector.x * 0.5 + 0.5) * canvasRect.width + canvasRect.left - panelRect.left;
            const y = (-tempVector.y * 0.5 + 0.5) * canvasRect.height + canvasRect.top - panelRect.top;
            node.style.setProperty('--x', `${x}px`);
            node.style.setProperty('--y', `${y}px`);
            node.style.opacity = tempVector.z > 1 ? '0' : '1';
          });

          keywordAnchors.forEach(({ node, anchor, phase }) => {
            const breathe = reduceMotion ? 0 : Math.sin(performance.now() * 0.00045 + phase) * 0.025;
            tempVector.copy(anchor).multiplyScalar(1 + breathe).applyMatrix4(group.matrixWorld);
            tempVector.project(camera);
            const x = (tempVector.x * 0.5 + 0.5) * canvasRect.width + canvasRect.left - panelRect.left;
            const y = (-tempVector.y * 0.5 + 0.5) * canvasRect.height + canvasRect.top - panelRect.top;
            node.style.setProperty('--x', `${x}px`);
            node.style.setProperty('--y', `${y}px`);
            node.style.opacity = tempVector.z > 1 ? '0' : '';
          });
        };

        const observer = new ResizeObserver(resize);
        observer.observe(panel);
        resize();

        const clampRotation = (value: number) => Math.max(-1.18, Math.min(1.18, value));
        let targetRotationX = group.rotation.x;
        let targetRotationY = group.rotation.y;
        let lastPointerX = 0;
        let lastPointerY = 0;
        let isDragging = false;

        const stopDrag = (event: PointerEvent) => {
          if (!isDragging) return;
          isDragging = false;
          panel.classList.remove('is-dragging');
          if ('releasePointerCapture' in panel) {
            panel.releasePointerCapture(event.pointerId);
          }
        };

        panel.addEventListener('pointerdown', (event) => {
          if ((event.target as HTMLElement | null)?.closest('[data-verdict-node]')) return;
          isDragging = true;
          panel.classList.add('is-dragging');
          lastPointerX = event.clientX;
          lastPointerY = event.clientY;
          if ('setPointerCapture' in panel) {
            panel.setPointerCapture(event.pointerId);
          }
        });

        panel.addEventListener('pointermove', (event) => {
          if (!isDragging) return;
          const dx = event.clientX - lastPointerX;
          const dy = event.clientY - lastPointerY;
          lastPointerX = event.clientX;
          lastPointerY = event.clientY;
          targetRotationY += dx * 0.006;
          targetRotationX = clampRotation(targetRotationX + dy * 0.006);
        });

        panel.addEventListener('pointerup', stopDrag);
        panel.addEventListener('pointercancel', stopDrag);
        panel.addEventListener('pointerleave', stopDrag);

        let previousTime = 0;
        const animate = (time: number) => {
          const delta = previousTime === 0 ? 16 : Math.min(40, time - previousTime);
          previousTime = time;

          if (!reduceMotion && !isDragging) targetRotationY += delta * 0.000006;

          group.rotation.x += (targetRotationX - group.rotation.x) * 0.08;
          group.rotation.y += (targetRotationY - group.rotation.y) * 0.08;

          if (!reduceMotion) {
            writeRays(time);
            rayGeometry.attributes.position.needsUpdate = true;
          }

          endpoints.forEach(({ mesh, pulse, node }) => {
            const active = node.getAttribute('aria-pressed') === 'true';
            const shimmer = reduceMotion ? 0.02 : Math.sin(time * 0.0012 + pulse) * 0.032 + 0.03;
            const scale = 1 + shimmer + (active ? 0.12 : 0);
            mesh.scale.setScalar(scale);
          });

          renderer.render(scene, camera);
          projectLabels();
          window.requestAnimationFrame(animate);
        };

        window.requestAnimationFrame(animate);
      };

      const onReady = (callback: () => void) => {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', callback, { once: true });
          return;
        }

        callback();
      };

      onReady(() => {
        const verdictWidget = document.querySelector('[data-verdict-widget]');

        if (verdictWidget instanceof HTMLElement) {
          const nodes = Array.from(verdictWidget.querySelectorAll('[data-verdict-node]')).filter(
            (node): node is HTMLElement => node instanceof HTMLElement,
          );
          const detail = verdictWidget.querySelector('[data-verdict-detail]');
          const type = detail?.querySelector('[data-verdict-type]');
          const title = detail?.querySelector('[data-verdict-title]');
          const copy = detail?.querySelector('[data-verdict-copy]');

          let crossfadeTimer: ReturnType<typeof setTimeout> | null = null;

          const activateNode = (node: HTMLElement) => {
            if (!(detail instanceof HTMLElement)) return;
            nodes.forEach((other) => other.setAttribute('aria-pressed', other === node ? 'true' : 'false'));

            if (crossfadeTimer !== null) clearTimeout(crossfadeTimer);

            detail.classList.add('is-out');
            detail.classList.remove('is-in');

            crossfadeTimer = window.setTimeout(() => {
              if (type) type.textContent = node.getAttribute('data-verdict-type') || 'verdict';
              if (title) title.textContent = node.getAttribute('data-verdict-node-title') || '';
              if (copy) copy.textContent = node.getAttribute('data-verdict-node-copy') || '';

              detail.classList.remove('is-out');
              detail.classList.add('is-in');
              crossfadeTimer = null;
            }, 200);
          };

          nodes.forEach((node) => {
            node.addEventListener('mouseenter', () => activateNode(node));
            node.addEventListener('focus', () => activateNode(node));
            node.addEventListener('click', () => activateNode(node));
            node.addEventListener('keydown', (event) => {
              if (!(event instanceof KeyboardEvent)) return;
              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                activateNode(node);
              }
            });
          });

          initVerdictSpikeBall(verdictWidget);
        }

        const metricValues = Array.from(document.querySelectorAll('[data-count-to]'));

        if (metricValues.length > 0) {
          const duration = 5000;
          const formatNumber = (value: number) => Math.round(value).toLocaleString('en-US');
          const targets = metricValues.map((element) => Number(element.getAttribute('data-count-to') || '0'));
          let hasRun = false;

          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            metricValues.forEach((element) => {
              element.textContent = '0';
            });
          }

          const runCounters = () => {
            if (hasRun) return;
            hasRun = true;
            const start = performance.now();

            const tick = (now: number) => {
              const progress = Math.min(1, (now - start) / duration);
              const eased = 1 - Math.pow(1 - progress, 3);

              metricValues.forEach((element, index) => {
                const value = targets[index] * eased;
                element.textContent = formatNumber(value);
              });

              if (progress < 1) {
                window.requestAnimationFrame(tick);
              } else {
                metricValues.forEach((element, index) => {
                  element.textContent = formatNumber(targets[index]);
                });
              }
            };

            window.requestAnimationFrame(tick);
          };

          const firstMetric = metricValues[0];
          if ('IntersectionObserver' in window && firstMetric instanceof Element) {
            const observer = new IntersectionObserver(
              (entries) => {
                if (entries.some((entry) => entry.isIntersecting)) {
                  observer.disconnect();
                  runCounters();
                }
              },
              { threshold: 0.35 },
            );
            observer.observe(firstMetric);
          } else {
            runCounters();
          }
        }
      });
    </script>

    <script>
      const reviewApp = document.querySelector('[data-review-app]');

      if (reviewApp instanceof HTMLElement) {
        const rows = Array.from(reviewApp.querySelectorAll('[data-claim-row]')).filter(
          (row): row is HTMLElement => row instanceof HTMLElement,
        );
        const railSteps = Array.from(reviewApp.querySelectorAll('[data-rail-step]'));
        const title = reviewApp.querySelector('[data-review-title]');
        const verdict = reviewApp.querySelector('[data-review-verdict]');
        const evidence = reviewApp.querySelector('[data-review-evidence]');
        const source = reviewApp.querySelector('[data-review-source]');
        const sidebar = reviewApp.querySelector('[data-review-sidebar]');
        const detail = reviewApp.querySelector('[data-review-detail]');
        const narrowReview = window.matchMedia('(max-width: 980px)');

        railSteps.forEach((step) => {
          step.addEventListener('click', () => {
            railSteps.forEach((other) => {
              other.classList.toggle('is-active', other === step);
              if (other === step) {
                other.setAttribute('aria-current', 'step');
              } else {
                other.removeAttribute('aria-current');
              }
            });
          });
        });

        const selectReviewRow = (row: HTMLElement) => {
          const status = row.getAttribute('data-status') || 'neutral';

          rows.forEach((other) => {
            const isActive = other === row;
            other.setAttribute('aria-selected', isActive ? 'true' : 'false');
            other.classList.toggle('is-active', isActive);
          });

          reviewApp.classList.add('has-selection');
          reviewApp.setAttribute('data-active-status', status);

          if (sidebar instanceof HTMLElement) {
            sidebar.setAttribute('data-status', status);
            sidebar.classList.add('is-active');
          }

          if (detail instanceof HTMLElement) {
            detail.classList.add('is-updating');
          }

          window.setTimeout(() => {
            if (title) title.textContent = row.getAttribute('data-claim') || '';
            if (verdict) verdict.textContent = row.getAttribute('data-verdict') || '';
            if (evidence) evidence.textContent = row.getAttribute('data-evidence') || '';
            if (source) source.textContent = row.getAttribute('data-source') || '';

            if (detail instanceof HTMLElement) {
              detail.classList.remove('is-updating');
            }

            if (sidebar instanceof HTMLElement && narrowReview.matches) {
              sidebar.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              sidebar.focus({ preventScroll: true });
            }
          }, 90);
        };

        rows.forEach((row) => {
          row.addEventListener('click', () => {
            selectReviewRow(row);
          });

          row.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              selectReviewRow(row);
            }
          });
        });

        const selectedRow = rows.find((row) => row.getAttribute('aria-selected') === 'true') ?? rows[0];
        if (selectedRow) {
          selectReviewRow(selectedRow);
        }
      }
    </script>

    <script>
      const heroModelCanvas = document.querySelector('[data-hero-models]');

      if (heroModelCanvas instanceof HTMLCanvasElement) {
        const canvas = heroModelCanvas;
        const context = canvas.getContext('2d');
        const frame = canvas.closest('.hero-figure');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const particleCount = 2600;
        const biologicalFamilies = [
          'dna-double-helix',
          'mitochondrion-with-cristae',
          'nucleated-cell',
          'phospholipid-vesicle',
          'microtubule-cylinder',
          'viral-capsid',
        ];
        const variantCount = 120;
        const holdMs = 3200;
        const scatterMs = 1200;
        const assembleMs = 1900;
        const cycleMs = holdMs + scatterMs + assembleMs;
        const startTime = performance.now();
        let width = 0;
        let height = 0;
        let animationFrame = 0;

        type Point = {
          x: number;
          y: number;
        };

        type Variant = {
          id: number;
          family: number;
          rotation: number;
          scaleX: number;
          scaleY: number;
          loops: number;
          lobes: number;
          phase: number;
        };

        type HeroParticle = {
          id: number;
          seed: number;
          x: number;
          y: number;
          size: number;
          tone: number;
        };

        const particles: HeroParticle[] = Array.from({ length: particleCount }, (_, id) => ({
          id,
          seed: id * 12.9898 + 78.233,
          x: 0,
          y: 0,
          size: 1.12 + (id % 7) * 0.16,
          tone: id % 17 === 0 ? 2 : id % 6 === 0 ? 1 : 0,
        }));

        const variants: Variant[] = Array.from({ length: variantCount }, (_, id) => ({
          id,
          family: id % biologicalFamilies.length,
          rotation: (unit(id * 17.7 + 4) - 0.5) * Math.PI * 0.45,
          scaleX: 0.98 + unit(id * 3.3 + 8) * 0.34,
          scaleY: 0.88 + unit(id * 5.9 + 2) * 0.32,
          loops: 2.4 + unit(id * 9.1 + 1) * 4.6,
          lobes: 3 + Math.floor(unit(id * 11.9 + 9) * 5),
          phase: unit(id * 29.3 + 7) * Math.PI * 2,
        }));

        const modelSequence = (() => {
          const sequence: number[] = [];
          const recentIds: number[] = [];
          const recentFamilies: number[] = [];
          const recentLimit = Math.min(5, Math.max(1, biologicalFamilies.length - 1));
          const sequenceLength = variantCount * 2;

          for (let step = 0; step < sequenceLength; step += 1) {
            const ordered = variants
              .map((variant) => variant.id)
              .sort((a, b) => unit(a * 97.31 + step * 19.13) - unit(b * 97.31 + step * 19.13));
            const candidate =
              ordered.find((id) => !recentIds.includes(id) && !recentFamilies.includes(variants[id].family)) ??
              ordered.find((id) => !recentIds.includes(id)) ??
              ordered[0];

            if (typeof candidate === 'number') {
              sequence.push(candidate);
              recentIds.push(candidate);
              recentFamilies.push(variants[candidate].family);
              if (recentIds.length > 5) recentIds.shift();
              if (recentFamilies.length > recentLimit) recentFamilies.shift();
            }
          }

          return sequence;
        })();

        function random(seed: number) {
          return Math.sin(seed) * 43758.5453123 % 1;
        }

        function unit(seed: number) {
          return Math.abs(random(seed));
        }

        function easeInOut(value: number) {
          return value < 0.5
            ? 4 * value * value * value
            : 1 - Math.pow(-2 * value + 2, 3) / 2;
        }

        function mix(a: number, b: number, t: number) {
          return a + (b - a) * t;
        }

        function clamp(value: number, min: number, max: number) {
          return Math.max(min, Math.min(max, value));
        }

        function rotate(x: number, y: number, angle: number) {
          const cos = Math.cos(angle);
          const sin = Math.sin(angle);
          return {
            x: x * cos - y * sin,
            y: x * sin + y * cos,
          };
        }

        function resizeHeroModel() {
          if (!(frame instanceof HTMLElement) || !context) return;
          const rect = frame.getBoundingClientRect();
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          width = Math.max(320, rect.width);
          height = Math.max(320, rect.height);
          canvas.width = Math.floor(width * ratio);
          canvas.height = Math.floor(height * ratio);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
        }

        function variantForCycle(cycle: number) {
          if (modelSequence.length === 0) return variants[0];
          const sequenceIndex = ((cycle % modelSequence.length) + modelSequence.length) % modelSequence.length;
          return variants[modelSequence[sequenceIndex] ?? 0] ?? variants[0];
        }

        function cloudCenter(cycle: number, time: number) {
          return {
            x: width * (0.51 + Math.sin(cycle * 1.73 + time * 0.00017) * 0.018),
            y: height * (0.50 + Math.cos(cycle * 1.31 + time * 0.00015) * 0.016),
          };
        }

        function organicScatterTarget(particle: HeroParticle, cycle: number, time: number): Point {
          const minSide = Math.min(width, height);
          const center = cloudCenter(cycle, time);
          const seed = particle.seed + cycle * 47.13;
          const angle = unit(seed + 1) * Math.PI * 2;
          const radial = Math.pow(unit(seed + 5), 0.58);
          const lobe =
            1 +
            Math.sin(angle * 3 + cycle * 0.7) * 0.18 +
            Math.sin(angle * 7 + seed * 0.03) * 0.11 +
            Math.cos(angle * 11 + cycle) * 0.06;
          const tendril = particle.id % 19 === 0 ? 0.15 + unit(seed + 9) * 0.18 : 0;
          const radius = minSide * (0.06 + radial * (0.32 + tendril)) * lobe;
          const local = rotate(
            Math.cos(angle) * radius * (1.08 + unit(cycle + 3) * 0.18),
            Math.sin(angle) * radius * (0.70 + unit(cycle + 12) * 0.16),
            (unit(cycle * 13.7 + 5) - 0.5) * Math.PI * 0.42,
          );
          const swirl = Math.sin(radial * 11 + time * 0.001 + seed) * minSide * 0.012;
          return {
            x: center.x + local.x + Math.cos(angle + Math.PI / 2) * swirl,
            y: center.y + local.y + Math.sin(angle + Math.PI / 2) * swirl,
          };
        }

        function legacyModelTarget(particle: HeroParticle, variant: Variant, time: number, boil: number): Point {
          const minSide = Math.min(width, height);
          const side = minSide * 1.16;
          const cx = width * 0.52;
          const cy = height * 0.5;
          const id = particle.id;
          const seed = particle.seed;
          const angle = unit(seed) * Math.PI * 2;
          const jitter =
            (Math.sin(time * 0.0031 + seed) + Math.cos(time * 0.0023 + seed * 0.41)) *
            minSide *
            0.006 *
            boil;
          const family = variant.family;
          const localAngle = angle + variant.phase;

          if (family === 0) {
            const band = id % 12;
            const membrane = band < 5;
            const nucleus = band === 5 || band === 6;
            const baseRadius = nucleus
              ? side * (0.045 + unit(seed + variant.id) * 0.07)
              : membrane
                ? side * (0.245 + unit(seed + 7) * 0.05)
                : side * (0.095 + unit(seed + 3) * 0.17);
            const edge =
              membrane
                ? 1 + Math.sin(localAngle * variant.lobes + variant.phase) * 0.08
                : 1;
            const local = rotate(
              Math.cos(localAngle) * baseRadius * variant.scaleX * edge,
              Math.sin(localAngle) * baseRadius * variant.scaleY * edge,
              variant.rotation,
            );
            return { x: cx + local.x + jitter, y: cy + local.y + jitter * 0.4 };
          }

          if (family === 1) {
            const strandType = id % 9;
            const helixT = ((id * 37) % particleCount) / particleCount;
            const turn = helixT * Math.PI * (7.2 + variant.loops * 0.7) + variant.phase;
            const amplitude = side * (0.12 + unit(variant.id + 9) * 0.045);
            const baseX = -width * 0.38 + helixT * width * 0.86;
            let baseY = 0;
            if (strandType < 6) {
              const strand = strandType % 2;
              const thickness = (Math.floor(strandType / 2) - 1) * side * 0.012;
              baseY = Math.sin(turn + strand * Math.PI) * amplitude + thickness;
            } else {
              const bridge = unit(seed + 24);
              const yA = Math.sin(turn) * amplitude;
              const yB = Math.sin(turn + Math.PI) * amplitude;
              baseY = mix(yA, yB, bridge) + (unit(seed + 31) - 0.5) * side * 0.012;
            }
            const rotated = rotate(baseX, baseY, variant.rotation * 0.45);
            return { x: cx + rotated.x + jitter, y: cy + rotated.y - jitter * 0.3 };
          }

          if (family === 2) {
            const nodeCount = 5 + Math.floor(unit(variant.id * 6.7) * 5);
            const node = id % nodeCount;
            const pathT = node / Math.max(1, nodeCount - 1);
            const pathAngle = -0.8 + pathT * Math.PI * 1.65 + variant.phase * 0.2;
            const pathRadius = side * (0.13 + Math.sin(pathT * Math.PI) * 0.18);
            const nodeX = (pathT - 0.5) * width * 0.82;
            const nodeY = Math.sin(pathAngle) * pathRadius * 0.55;
            const radius = side * (0.04 + unit(variant.id + node * 19) * 0.08) * Math.sqrt(unit(seed + 3));
            const local = rotate(
              nodeX + Math.cos(localAngle) * radius,
              nodeY + Math.sin(localAngle) * radius * 0.82,
              variant.rotation,
            );
            return { x: cx + local.x + jitter, y: cy + local.y };
          }

          if (family === 3) {
            const shell = id % 5 !== 0;
            const bilayer = id % 5;
            const radius = shell
              ? side * (0.22 + (bilayer % 2) * 0.027 + unit(seed + 11) * 0.045)
              : side * (0.06 + unit(seed + 12) * 0.12);
            const ripple = 1 + Math.sin(localAngle * variant.lobes + time * 0.001 + variant.phase) * 0.075;
            const local = rotate(
              Math.cos(localAngle) * radius * variant.scaleX * ripple,
              Math.sin(localAngle) * radius * variant.scaleY * ripple,
              variant.rotation,
            );
            return { x: cx + local.x + jitter, y: cy + local.y + jitter * 0.2 };
          }

          if (family === 4) {
            const branch = id % 7;
            const branchT = unit(seed + 15);
            const thickness = (unit(seed + 32) - 0.5) * side * 0.038;
            const domain = branch >= 5;
            const leftTip = { x: -side * 0.27, y: -side * 0.23 };
            const rightTip = { x: side * 0.27, y: -side * 0.23 };
            const hinge = { x: 0, y: -side * 0.02 };
            const stem = { x: 0, y: side * 0.26 };
            let x = 0;
            let y = 0;
            if (domain) {
              const tip = branch === 5 ? leftTip : rightTip;
              const r = side * (0.045 + unit(seed + 18) * 0.055);
              x = tip.x + Math.cos(localAngle) * r;
              y = tip.y + Math.sin(localAngle) * r * 0.8;
            } else if (branch < 2) {
              x = mix(stem.x, hinge.x, branchT) + thickness * 0.35;
              y = mix(stem.y, hinge.y, branchT);
            } else if (branch < 4) {
              const tip = branch === 2 ? leftTip : rightTip;
              x = mix(hinge.x, tip.x, branchT) + thickness;
              y = mix(hinge.y, tip.y, branchT) - thickness * 0.2;
            } else {
              x = mix(leftTip.x, rightTip.x, branchT) * 0.35;
              y = hinge.y + Math.sin(branchT * Math.PI) * side * 0.045;
            }
            const local = rotate(x, y, variant.rotation * 0.35);
            return { x: cx + local.x + jitter, y: cy + local.y };
          }

          if (family === 5) {
            const strand = id % 3;
            const band = Math.floor(id / 3) % 5;
            const helixT = ((Math.floor(id / 15) * 17 + band * 3) % Math.floor(particleCount / 15)) / Math.floor(particleCount / 15);
            const a = helixT * Math.PI * (6.2 + variant.loops * 0.45) + variant.phase + strand * ((Math.PI * 2) / 3);
            const thickness = (band - 2) * side * 0.0075;
            const local = rotate(
              -width * 0.36 + helixT * width * 0.82,
              Math.sin(a) * side * 0.105 + thickness,
              variant.rotation * 0.35 + 0.08,
            );
            return { x: cx + local.x + jitter, y: cy + local.y };
          }

          if (family === 6) {
            const protofilament = id % 13;
            const t = (Math.floor(id / 13) % Math.floor(particleCount / 13)) / Math.floor(particleCount / 13);
            const tubeAngle = (protofilament / 13) * Math.PI * 2 + t * Math.PI * 2.4 + variant.phase;
            const baseX = -width * 0.38 + t * width * 0.84;
            const y = Math.sin(tubeAngle) * side * 0.155;
            const depth = Math.cos(tubeAngle) * side * 0.025;
            const local = rotate(baseX, y + depth, variant.rotation * 0.3);
            return { x: cx + local.x + jitter, y: cy + local.y };
          }

          if (family === 7) {
            const layer = id % 7;
            if (layer < 3) {
              const r = side * (0.19 + unit(seed + 6) * 0.035);
              const bean = 1 + Math.sin(localAngle * 2 + variant.phase) * 0.18;
              const local = rotate(
                Math.cos(localAngle) * r * 1.42 * bean,
                Math.sin(localAngle) * r * 0.72,
                variant.rotation * 0.25,
              );
              return { x: cx + local.x + jitter, y: cy + local.y };
            }
            const foldT = ((Math.floor(id / 7) * 19) % Math.floor(particleCount / 7)) / Math.floor(particleCount / 7);
            const lane = layer - 3;
            const x = -side * 0.31 + foldT * side * 0.62;
            const y = Math.sin(foldT * Math.PI * (5 + lane * 0.9) + variant.phase) * side * 0.075 + (lane - 1.5) * side * 0.035;
            const local = rotate(x, y, variant.rotation * 0.25);
            return { x: cx + local.x + jitter, y: cy + local.y };
          }

          if (family === 8) {
            const ring = id % 9;
            const latitude = -0.78 + (ring / 8) * 1.56;
            const localA = angle + ring * 0.23 + variant.phase;
            const shellR = side * (0.18 + unit(seed + 6) * 0.055);
            const facet = 1 + Math.sin(localA * 5) * 0.035 + Math.sin(localA * 10) * 0.025;
            const x = Math.cos(localA) * Math.cos(latitude) * shellR * 1.08 * facet;
            const y = Math.sin(latitude) * shellR * 0.98 + Math.sin(localA) * shellR * 0.15;
            const local = rotate(x, y, variant.rotation);
            return { x: cx + local.x + jitter, y: cy + local.y };
          }

          if (family === 9) {
            const loopT = ((id * 23) % particleCount) / particleCount;
            const a = loopT * Math.PI * (3.2 + variant.loops * 0.35) + variant.phase;
            const r = side * (0.08 + Math.sin(loopT * Math.PI) * 0.20);
            const bead = (unit(seed + 3) - 0.5) * side * 0.025;
            const local = rotate(
              Math.cos(a) * r * 1.18 + bead,
              Math.sin(a * 0.74) * r * 0.92,
              variant.rotation * 0.7,
            );
            return { x: cx + local.x + jitter, y: cy + local.y };
          }

          if (family === 10) {
            const subunit = id % 2;
            const r = side * (0.115 + unit(seed + 4) * 0.085);
            const offsetX = subunit === 0 ? -side * 0.115 : side * 0.12;
            const offsetY = subunit === 0 ? -side * 0.04 : side * 0.055;
            const local = rotate(
              offsetX + Math.cos(localAngle) * r * (subunit === 0 ? 1.18 : 0.92),
              offsetY + Math.sin(localAngle) * r * (subunit === 0 ? 0.78 : 1.05),
              variant.rotation * 0.45,
            );
            return { x: cx + local.x + jitter, y: cy + local.y };
          }

          const vesicleCount = 6 + Math.floor(unit(variant.id + 19) * 4);
          const vesicle = id % vesicleCount;
          const clusterA = (vesicle / vesicleCount) * Math.PI * 2 + variant.phase;
          const clusterR = side * (0.10 + unit(variant.id + vesicle * 7) * 0.20);
          const centerX = Math.cos(clusterA) * clusterR * 1.25;
          const centerY = Math.sin(clusterA) * clusterR * 0.74;
          const localR = side * (0.028 + unit(variant.id + vesicle * 13) * 0.04);
          const local = rotate(
            centerX + Math.cos(localAngle) * localR,
            centerY + Math.sin(localAngle) * localR,
            variant.rotation * 0.5,
          );
          return { x: cx + local.x + jitter, y: cy + local.y };
        }

        function modelTarget(particle: HeroParticle, variant: Variant, time: number, boil: number): Point {
          const minSide = Math.min(width, height);
          const side = minSide * 1.26;
          const cx = width * 0.52;
          const cy = height * 0.5;
          const id = particle.id;
          const seed = particle.seed + variant.id * 31.17;
          const angle = unit(seed) * Math.PI * 2 + variant.phase;
          const boilJitter =
            (Math.sin(time * 0.0021 + seed) + Math.cos(time * 0.0017 + seed * 0.31)) *
            minSide *
            0.0045 *
            boil;
          const place = (x: number, y: number, rotation = variant.rotation * 0.28) => {
            const local = rotate(x, y, rotation);
            return {
              x: cx + local.x + boilJitter,
              y: cy + local.y + boilJitter * 0.45,
            };
          };

          if (variant.family === 0) {
            const band = id % 12;
            const stepCount = Math.floor(particleCount / 12);
            const step = Math.floor(id / 12);
            const t = ((step * 7 + band * 11) % stepCount) / stepCount;
            const turn = t * Math.PI * (8.4 + variant.loops * 0.22) + variant.phase;
            const amplitude = side * (0.14 + unit(variant.id + 9) * 0.035);
            const x = (t - 0.5) * side * 0.92;
            let y = 0;

            if (band < 8) {
              const strand = band % 2;
              const thickness = (Math.floor(band / 2) - 1.5) * side * 0.0105;
              y = Math.sin(turn + strand * Math.PI) * amplitude + thickness;
            } else {
              const rungT = unit(seed + 22);
              y =
                mix(Math.sin(turn) * amplitude, Math.sin(turn + Math.PI) * amplitude, rungT) +
                (unit(seed + 28) - 0.5) * side * 0.014;
            }

            return place(x, y, variant.rotation * 0.18);
          }

          if (variant.family === 1) {
            const layer = id % 10;

            if (layer < 4) {
              const a = angle;
              const r = side * (0.255 + unit(seed + 6) * 0.038);
              const bean = 1 + Math.sin(a * 2.1 + variant.phase) * 0.12 + Math.cos(a * 3.2) * 0.055;
              return place(
                Math.cos(a) * r * 1.42 * bean,
                Math.sin(a) * r * 0.66,
                variant.rotation * 0.2,
              );
            }

            const lane = layer - 4;
            const steps = Math.floor(particleCount / 10);
            const t = ((Math.floor(id / 10) * 11 + lane * 5) % steps) / steps;
            const x = (t - 0.5) * side * 0.70;
            const y =
              Math.sin(t * Math.PI * (5.5 + lane * 0.55) + variant.phase) * side * 0.082 +
              (lane - 2.5) * side * 0.023;
            return place(x, y, variant.rotation * 0.2);
          }

          if (variant.family === 2) {
            const layer = id % 13;

            if (layer < 4) {
              const r = side * (0.255 + unit(seed + 14) * 0.052);
              const edge = 1 + Math.sin(angle * 5 + variant.phase) * 0.055 + Math.cos(angle * 3) * 0.045;
              return place(
                Math.cos(angle) * r * 1.05 * edge,
                Math.sin(angle) * r * 0.96 * edge,
                variant.rotation * 0.22,
              );
            }

            if (layer < 8) {
              const r = side * (0.082 + unit(seed + 18) * 0.052);
              return place(
                side * 0.075 + Math.cos(angle) * r,
                -side * 0.025 + Math.sin(angle) * r * 0.86,
                variant.rotation * 0.22,
              );
            }

            const organelle = layer - 8;
            const organelleAngle = (organelle / 5) * Math.PI * 2 + variant.phase * 0.18;
            const organelleCenterR = side * (0.10 + unit(variant.id + organelle * 17) * 0.11);
            const localR = side * (0.018 + unit(seed + organelle) * 0.025);
            return place(
              Math.cos(organelleAngle) * organelleCenterR + Math.cos(angle) * localR,
              Math.sin(organelleAngle) * organelleCenterR * 0.82 + Math.sin(angle) * localR,
              variant.rotation * 0.22,
            );
          }

          if (variant.family === 3) {
            const band = id % 8;
            const membrane = band < 6;
            const r = membrane
              ? side * (0.205 + (band % 3) * 0.016 + unit(seed + 11) * 0.034)
              : side * (0.06 + unit(seed + 13) * 0.11);
            const ripple = membrane
              ? 1 + Math.sin(angle * (4 + variant.lobes * 0.25) + time * 0.0007) * 0.045
              : 1;
            return place(
              Math.cos(angle) * r * 1.22 * ripple,
              Math.sin(angle) * r * 0.88 * ripple,
              variant.rotation * 0.26,
            );
          }

          if (variant.family === 4) {
            const protofilament = id % 13;
            const lane = Math.floor((id % 39) / 13);
            const steps = Math.floor(particleCount / 39);
            const t = ((Math.floor(id / 39) * 17 + protofilament * 3) % steps) / steps;
            const tubeAngle = (protofilament / 13) * Math.PI * 2 + t * Math.PI * 2.8 + variant.phase;
            const taper = Math.sin(t * Math.PI);
            const curve = Math.sin(t * Math.PI * 1.55 + variant.phase * 0.26) * side * 0.095;
            const x =
              (t - 0.5) * side * 0.92 +
              Math.cos(tubeAngle) * side * 0.032 * taper +
              Math.sin(t * Math.PI * 4.2 + variant.phase) * side * 0.012;
            const y =
              curve +
              Math.sin(tubeAngle) * side * 0.075 * taper +
              Math.cos(tubeAngle) * side * 0.018 +
              (lane - 1) * side * 0.010;
            return place(x, y, variant.rotation * 0.18);
          }

          const ring = id % 12;

          if (ring < 10) {
            const latitude = -0.92 + (ring / 9) * 1.84;
            const localA = angle + ring * 0.31;
            const shellR = side * (0.23 + unit(seed + 6) * 0.038);
            const facet = 1 + Math.sin(localA * 5) * 0.035 + Math.sin(localA * 10) * 0.022;
            return place(
              Math.cos(localA) * Math.cos(latitude) * shellR * 1.08 * facet,
              Math.sin(latitude) * shellR * 0.94 + Math.sin(localA) * shellR * 0.12,
              variant.rotation * 0.32,
            );
          }

          const vertex = id % 12;
          const vertexAngle = (vertex / 12) * Math.PI * 2 + variant.phase;
          const vertexR = side * 0.20;
          const clusterR = side * (0.015 + unit(seed + 42) * 0.018);
          return place(
            Math.cos(vertexAngle) * vertexR + Math.cos(angle) * clusterR,
            Math.sin(vertexAngle) * vertexR * 0.82 + Math.sin(angle) * clusterR,
            variant.rotation * 0.32,
          );
        }

        function drawFluid(now: number, phase: number) {
          if (!context) return;
          void now;
          void phase;
        }

        function renderHeroModel(now: number) {
          if (!context || width === 0 || height === 0) return;
          const elapsed = now - startTime;
          const cycle = Math.floor(elapsed / cycleMs);
          const phaseMs = elapsed % cycleMs;
          const phase = phaseMs / cycleMs;
          const currentVariant = variantForCycle(cycle);
          const nextVariant = variantForCycle(cycle + 1);

          context.clearRect(0, 0, width, height);
          drawFluid(now, phase);

          context.save();
          context.globalCompositeOperation = 'lighter';
          particles.forEach((particle) => {
            const from = modelTarget(particle, currentVariant, now, phaseMs < holdMs ? 1 : 0.18);
            const scatter = organicScatterTarget(particle, cycle, now);
            const to = modelTarget(particle, nextVariant, now, 0.18);
            let x = from.x;
            let y = from.y;
            let scatterAmount = 0;

            if (phaseMs >= holdMs && phaseMs < holdMs + scatterMs) {
              const t = easeInOut((phaseMs - holdMs) / scatterMs);
              x = mix(from.x, scatter.x, t);
              y = mix(from.y, scatter.y, t);
              scatterAmount = t;
            } else if (phaseMs >= holdMs + scatterMs) {
              const t = easeInOut((phaseMs - holdMs - scatterMs) / assembleMs);
              x = mix(scatter.x, to.x, t);
              y = mix(scatter.y, to.y, t);
              scatterAmount = 1 - t;
            }

            particle.x += (x - particle.x) * (reduceMotion.matches ? 1 : 0.13);
            particle.y += (y - particle.y) * (reduceMotion.matches ? 1 : 0.13);

            const pulse = Math.sin(now * 0.0014 + particle.seed) * 0.08;
            const alpha = clamp(0.38 + pulse - scatterAmount * 0.05, 0.20, 0.78);
            const radius = particle.size + (particle.tone === 2 ? 0.24 : 0) + pulse * 0.65;
            context.fillStyle =
              particle.tone === 2
                ? `rgba(216, 210, 155, ${alpha})`
                : particle.tone === 1
                  ? `rgba(255, 255, 255, ${alpha * 0.9})`
                  : `rgba(49, 152, 138, ${alpha})`;
            context.beginPath();
            context.arc(particle.x, particle.y, Math.max(0.6, radius), 0, Math.PI * 2);
            context.fill();
          });
          context.restore();

          if (!reduceMotion.matches) {
            animationFrame = window.requestAnimationFrame(renderHeroModel);
          }
        }

        resizeHeroModel();
        particles.forEach((particle) => {
          const target = modelTarget(particle, variantForCycle(0), startTime, 1);
          particle.x = target.x;
          particle.y = target.y;
        });
        renderHeroModel(startTime);
        window.addEventListener('resize', () => {
          resizeHeroModel();
          particles.forEach((particle) => {
            const target = modelTarget(particle, variantForCycle(0), performance.now(), 1);
            particle.x = target.x;
            particle.y = target.y;
          });
        });
        window.addEventListener('pagehide', () => window.cancelAnimationFrame(animationFrame));
      }
    </script>

    <script>
      const bioCanvas = document.querySelector('[data-bio-particles]');

      if (bioCanvas instanceof HTMLCanvasElement) {
        const canvas = bioCanvas;
        const context = canvas.getContext('2d');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const particleCount = 1400;
        const particles = Array.from({ length: particleCount }, (_, index) => ({
          seed: index * 97.131,
          x: 0,
          y: 0,
          size: 0.7 + (index % 7) * 0.08,
          tone: index % 13 === 0 ? 'yellow' : index % 5 === 0 ? 'white' : 'green',
        }));

        function resizeCanvas() {
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.floor(window.innerWidth * ratio);
          canvas.height = Math.floor(window.innerHeight * ratio);
          canvas.style.width = `${window.innerWidth}px`;
          canvas.style.height = `${window.innerHeight}px`;
          if (context) context.setTransform(ratio, 0, 0, ratio, 0, 0);
        }

        function easeInOutCubic(value: number) {
          return value < 0.5
            ? 4 * value * value * value
            : 1 - Math.pow(-2 * value + 2, 3) / 2;
        }

        function clamp(value: number, min: number, max: number) {
          return Math.max(min, Math.min(max, value));
        }

        function targetFor(
          particle: { seed: number; x: number; y: number; size: number; tone: string },
          mode: number,
        ) {
          const width = window.innerWidth;
          const height = window.innerHeight;
          const centerX = width * 0.66;
          const centerY = height * 0.48;
          const index = particle.seed;
          const t = (index % particleCount) / particleCount;
          const angle = t * Math.PI * 2 * 7;
          const wave = Math.sin(t * Math.PI * 2 * 3 + index);

          if (mode === 0) {
            const radius = Math.min(width, height) * (0.16 + 0.08 * Math.sin(t * Math.PI * 18));
            return {
              x: centerX + Math.cos(angle) * radius,
              y: centerY + Math.sin(angle * 0.54) * radius * 0.72 + wave * 14,
            };
          }

          if (mode === 1) {
            const col = index % 36;
            const row = Math.floor(index / 36) % 38;
            return {
              x: width * 0.18 + col * (width * 0.0048) + wave * 6,
              y: height * 0.22 + row * (height * 0.006) + Math.sin(index) * 4,
            };
          }

          if (mode === 2) {
            const radius = Math.min(width, height) * (0.12 + (index % 280) / 280 * 0.22);
            const a = t * Math.PI * 2 * 2.4;
            return {
              x: width * 0.5 + Math.cos(a) * radius * 1.22,
              y: height * 0.5 + Math.sin(a) * radius * 0.82,
            };
          }

          if (mode === 3) {
            const ringIndex = index % 6;
            const a = -Math.PI / 2 + (ringIndex / 6) * Math.PI * 2;
            const baseX = width * 0.5 + Math.cos(a) * Math.min(width, height) * 0.22;
            const baseY = height * 0.48 + Math.sin(a) * Math.min(width, height) * 0.22;
            const spread = 10 + (index % 70) * 0.12;
            return {
              x: baseX + Math.cos(index) * spread,
              y: baseY + Math.sin(index * 1.7) * spread,
            };
          }

          return {
            x: width * 0.5 + Math.cos(angle) * Math.min(width, height) * 0.08,
            y: height * 0.5 + Math.sin(angle) * Math.min(width, height) * 0.08,
          };
        }

        function activeMode() {
          const sections = ['#top', '#process', '#evidence', '#workspace', '#download'];
          let nearest = 0;
          let distance = Number.POSITIVE_INFINITY;

          sections.forEach((selector, index) => {
            const element = selector === '#top' ? document.querySelector('.hero') : document.querySelector(selector);
            if (!element) return;
            const rect = element.getBoundingClientRect();
            const nextDistance = Math.abs(rect.top - window.innerHeight * 0.18);
            if (nextDistance < distance) {
              distance = nextDistance;
              nearest = index;
            }
          });

          return nearest;
        }

        function render() {
          if (!context || reduceMotion.matches) return;
          const width = window.innerWidth;
          const height = window.innerHeight;
          const mode = activeMode();

          context.clearRect(0, 0, width, height);
          context.globalCompositeOperation = 'source-over';

          particles.forEach((particle) => {
            const target = targetFor(particle, mode);
            particle.x += (target.x - particle.x) * 0.045;
            particle.y += (target.y - particle.y) * 0.045;
            const progress = easeInOutCubic(clamp(Math.abs(window.scrollY % 800) / 800, 0, 1));
            const alphaBase = particle.tone === 'yellow' ? 0.32 : particle.tone === 'white' ? 0.28 : 0.38;
            const alpha = alphaBase + Math.sin(progress * Math.PI + particle.seed) * 0.06;
            context.fillStyle =
              particle.tone === 'yellow'
                ? `rgba(216, 210, 155, ${alpha})`
                : particle.tone === 'white'
                  ? `rgba(255, 255, 255, ${alpha})`
                  : `rgba(49, 152, 138, ${alpha})`;
            context.beginPath();
            context.arc(particle.x, particle.y, particle.size, 0, Math.PI * 2);
            context.fill();
          });

          window.requestAnimationFrame(render);
        }

        resizeCanvas();
        particles.forEach((particle) => {
          const start = targetFor(particle, 0);
          particle.x = start.x;
          particle.y = start.y;
        });
        render();
        window.addEventListener('resize', resizeCanvas);
      }
    </script>

    <script>
      const downloadCanvas = document.querySelector('[data-download-particles]');

      if (downloadCanvas instanceof HTMLCanvasElement) {
        const canvas = downloadCanvas;
        const context = canvas.getContext('2d');
        const block = canvas.closest('[data-download-block]');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const specks = Array.from({ length: 920 }, (_, index) => ({
          t: ((index * 0.61803398875) % 1) * Math.PI * 2,
          lane: index % 9,
          phase: index * 0.019,
          seed: index * 12.9898 + 78.233,
          size: 0.72 + (index % 5) * 0.18,
          spin: index % 2 === 0 ? 1 : -1,
          tone: index % 13,
          offset: (Math.abs(Math.sin(index * 12.9898 + 78.233) * 43758.5453123 % 1) - 0.5) * 8,
        }));
        let width = 0;
        let height = 0;
        let frame = 0;
        let pointerX = 0;
        let pointerY = 0;
        let pointerPull = 0;
        let pointerInside = false;
        let burst = 0;

        function resize() {
          if (!(block instanceof HTMLElement) || !context) return;
          const ratio = Math.min(window.devicePixelRatio || 1, 2);
          const rect = block.getBoundingClientRect();
          width = rect.width;
          height = rect.height;
          canvas.width = Math.floor(width * ratio);
          canvas.height = Math.floor(height * ratio);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          context.setTransform(ratio, 0, 0, ratio, 0, 0);
        }

        function updatePointer(event: PointerEvent) {
          if (!(block instanceof HTMLElement)) return;
          const rect = block.getBoundingClientRect();
          pointerX = event.clientX - rect.left;
          pointerY = event.clientY - rect.top;
          pointerInside = true;
        }

        function draw() {
          if (!context) return;
          frame += reduceMotion.matches ? 0.0010 : 0.0058;
          pointerPull += ((pointerInside ? 0.6 : 0) - pointerPull) * 0.048;
          burst *= 0.91;
          context.clearRect(0, 0, width, height);
          const centerX = width * 0.63;
          const centerY = height * 0.54;
          const scaleX = Math.min(width * 0.28, height * 0.70);
          const scaleY = Math.min(height * 0.36, width * 0.19);

          specks.forEach((speck) => {
            const track = speck.lane % 3;
            const layer = track === 0 ? 1.08 : track === 1 ? 0.76 : 0.48;
            const band = Math.floor(speck.lane / 3) - 1;
            const slow = frame + speck.phase;
            const t = speck.t + Math.sin(slow * 0.52) * 0.022 + frame * 0.016 * speck.spin;
            const sinT = Math.sin(t);
            const cosT = Math.cos(t);
            const rawX = sinT * scaleX * layer;
            const rawY = sinT * cosT * scaleY * layer;
            const side = sinT < 0 ? -1 : 1;
            const skew = side * 0.36;
            const tangentAngle = Math.atan2(Math.cos(2 * t) * scaleY * layer, cosT * scaleX * layer) + skew * 0.18;
            const normalAngle = tangentAngle + Math.PI / 2;
            const lineWidth = (band * 8 + speck.offset + Math.sin(slow * 0.38) * 2.2) * (1.0 + track * 0.18);
            const floatX = Math.cos(slow * 0.31) * (2.2 + track * 0.55);
            const floatY = Math.sin(slow * 0.27) * (1.8 + track * 0.52);
            let x = centerX + rawX + rawY * skew + Math.cos(normalAngle) * lineWidth + floatX;
            let y = centerY + rawY - Math.abs(rawX) * 0.08 + Math.sin(normalAngle) * lineWidth + floatY;

            if (pointerPull > 0.02 || burst > 0.02) {
              const dx = x - pointerX;
              const dy = y - pointerY;
              const distance = Math.max(22, Math.hypot(dx, dy));
              const influence = Math.min(1, 200 / distance) * (pointerPull + burst * 1.3);
              const tangent = speck.spin * influence * 28;
              x += (dx / distance) * influence * 32 + (-dy / distance) * tangent;
              y += (dy / distance) * influence * 22 + (dx / distance) * tangent;
            }

            const tone = speck.tone;
            const color =
              tone === 0 || tone === 7
                ? '216, 210, 155'
                : tone < 6
                  ? '49, 152, 138'
                  : '255, 255, 255';
            const baseAlpha = (tone === 0 || tone === 7 ? 0.68 : 0.44) + pointerPull * 0.14 + burst * 0.18;
            context.fillStyle = `rgba(${color}, ${Math.min(0.88, baseAlpha)})`;
            context.beginPath();
            context.ellipse(x, y, speck.size * 3.4, speck.size * 1.1, tangentAngle, 0, Math.PI * 2);
            context.fill();
          });

          window.requestAnimationFrame(draw);
        }

        resize();
        draw();
        window.addEventListener('resize', resize);
        if (block instanceof HTMLElement) {
          block.addEventListener('pointerenter', updatePointer);
          block.addEventListener('pointermove', updatePointer);
          block.addEventListener('pointerleave', () => {
            pointerInside = false;
          });
          block.addEventListener('pointerdown', (event) => {
            updatePointer(event);
            burst = 1;
          });
        }
      }
    </script>

    <script>
      const burger = document.querySelector('.nav-burger');
      const mobileNav = document.getElementById('mobile-nav-overlay');

      if (burger && mobileNav) {
        const closeNav = () => {
          burger.setAttribute('aria-expanded', 'false');
          mobileNav.setAttribute('aria-hidden', 'true');
        };

        burger.addEventListener('click', () => {
          const open = burger.getAttribute('aria-expanded') === 'true';
          burger.setAttribute('aria-expanded', String(!open));
          mobileNav.setAttribute('aria-hidden', String(open));
        });

        mobileNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeNav);
        });

        const backdrop = mobileNav.querySelector('.mobile-nav-backdrop');
        if (backdrop) backdrop.addEventListener('click', closeNav);

        document.addEventListener('click', (e) => {
          if (
            burger.getAttribute('aria-expanded') === 'true' &&
            !mobileNav.contains(e.target as Node) &&
            !burger.contains(e.target as Node)
          ) closeNav();
        });
      }
    </script>
  </body>
</html>
