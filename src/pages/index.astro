              <line x1="150" y1="90" x2="95" y2="122" stroke="var(--sand)" stroke-width="1" stroke-dasharray="4 4" style="animation:dashFlow 2s linear infinite"/><line x1="150" y1="90" x2="95" y2="58" stroke="var(--sand)" stroke-width="1" stroke-dasharray="4 4" style="animation:dashFlow 2s linear infinite;animation-delay:-.6s"/>
              <line x1="150" y1="90" x2="150" y2="154" stroke="var(--t4)" stroke-width="1" stroke-dasharray="2 5" opacity=".6"/>
              <circle cx="150" cy="26" r="6" fill="var(--teal)" style="animation:pulseO 2.6s ease-in-out infinite"/><circle cx="205" cy="58" r="6" fill="var(--teal)" style="animation:pulseO 2.6s ease-in-out infinite;animation-delay:-.5s"/><circle cx="205" cy="122" r="6" fill="var(--teal)" style="animation:pulseO 2.6s ease-in-out infinite;animation-delay:-1s"/>
