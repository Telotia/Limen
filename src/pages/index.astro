---
// The homepage, two builds (main merged into dev, 23 Oct 2026):
// - prod (telotia.com) renders <TelosHome />, as on main: the scroll story, "coming soon" and how to reach us,
//   French by default;
// - dev (dev.telotia.com) renders dev's own homepage in MarketingShell, as before the merge.
import TelosHome from '../components/TelosHome.astro';
import Hero from '../components/home/Hero.astro';
import HomePath from '../components/home/HomePath.astro';
import PageInk from '../components/home/PageInk.astro';
import MarketingShell from '../layouts/MarketingShell.astro';

const isProd = (process.env.LIMEN_ENV ?? 'dev') === 'prod';
---

{
  isProd ? (
    <html lang="fr-CA" data-lang="fr">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Telotia</title>
        <meta name="title-fr" content="Telotia" />
        <meta name="title-en" content="Telotia" />
        <meta name="description" content="Telotia, recherche et développement en santé publique. Pour que chaque heure de soins compte." />
        <link rel="preload" href="/fonts/Outfit.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/Inter-cv11.ttf" as="font" type="font/ttf" crossorigin />
        {/* Before first paint: the saved language, and whether the animated story will run. */}
        <script is:inline>
          (function () {
            var root = document.documentElement, lang = null;
            try { lang = localStorage.getItem('telotia-lang'); } catch (e) {}
            var forced = new URLSearchParams(location.search).get('lang');
            if (forced === 'en' || forced === 'fr') lang = forced;
            if (lang === 'en') { root.dataset.lang = 'en'; root.lang = 'en-CA'; }
            if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
              root.classList.add('story-on');
              if (matchMedia('(max-width: 759px)').matches) root.classList.add('story-tall');
            }
          })();
        </script>
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
      </head>
      <body class="telos">
        <TelosHome />
      </body>
    </html>
  ) : (
    <MarketingShell
      isProd={false}
      title="Telotia | Claim-to-evidence validation"
      description="Evidence-grade claim review for Canadian health-equipment imports."
    >
      <PageInk />
      <Hero />
      <HomePath />
    </MarketingShell>
  )
}
