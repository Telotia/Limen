                    </g>
                    <g class="norma-cursor-star">
                      <circle cx="117.14" cy="208.31" r="6.4" fill="#0B4CFF" opacity="0.58" />
                      <circle cx="117.14" cy="208.31" r="3.8" fill="#1466FF" />
