        border-color: rgba(127, 147, 216, 0.52);
      }

      html[data-theme-pref="system"] .active-chamber-readout,
      html[data-theme-pref="system"] .slice-verdict-pill {
        color: #9fb5ff;
      }

      @media (max-width: 900px) {
        .tel-nav-inner {
          gap: 16px;
        }

        .nav-links {
          display: none;
        }

        .repo-link {
          display: none;
        }

        .pull-id {
          display: none;
        }

        .tel-hero-inner {
          padding: 78px 0 68px;
        }

        .hero-copy-block {
          padding-left: 0;
        }

        .hero-title-row {
          align-items: flex-start;
        }

        .decor-animation-chaotic {
          width: clamp(260px, 40vw, 360px);
          height: 200px;
        }

        .install-heading-row {
          grid-template-columns: 1fr;
        }

        .decor-animation-circle {
          justify-self: start;
        }

        .app-preview-shell {
          min-height: 0;
        }

        .norma-download-block {
          min-height: 520px;
          border-radius: 20px;
        }

        .norma-download-content {
          min-height: 520px;
          width: 100%;
          justify-content: flex-end;
          padding: 34px 26px;
        }

        .norma-download-title {
          font-size: clamp(38px, 13vw, 52px);
        }

        .app-workspace {
          grid-template-columns: 52px minmax(0, 1fr);
        }

        .app-eventlog {
          grid-column: 1 / -1;
          border-top: 1px solid var(--app-line-soft);
          border-left: 0;
        }

        .event-list {
          max-height: 15rem;
        }

        .hero-thesis {
          font-size: 34px;
          line-height: 1.12;
        }

        .hero-meta,
        .vocab-grid,
        .install-meta,
        .assessment-grid,
        .repo-chain {
          grid-template-columns: 1fr;
        }

        .install-meta .cell {
          border-right: 0;
          border-bottom: 1px solid var(--rule);
        }

        .install-meta .cell:last-child {
          border-bottom: 0;
        }

        .cycle {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .cycle dd {
          margin-bottom: 22px;
        }

        .footer-bottom {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 560px) {
        .tel-nav-inner,
        .tel-container,
        .tel-hero-inner,
        .footer-inner {
          width: calc(100% - 24px);
        }

        .brand-org {
          display: none;
        }

        .tel-hero {
          min-height: calc(100vh - 80px);
        }

        .tel-hero::after {
          opacity: 0.12;
        }

        .tel-hero-inner {
          padding: 62px 0 56px;
        }

        .app-topbar {
          grid-template-columns: 1fr;
          align-items: start;
        }

        .session-chip {
          justify-self: stretch;
          overflow-wrap: anywhere;
        }

        .app-workspace {
          grid-template-columns: 1fr;
        }

        .app-rail {
          flex-direction: row;
          justify-content: flex-start;
          overflow-x: auto;
          border-right: 0;
          border-bottom: 1px solid var(--app-line-soft);
        }

        .app-main {
          padding: 14px;
        }

        .telos-card h2 {
          font-size: 22px;
        }

        .demo-graph-panel {
          min-height: 17rem;
        }

        .demo-graph-panel svg {
          min-height: 17rem;
        }

        .event-row {
          grid-template-columns: 5.4rem minmax(0, 1fr);
        }

        .hero-title-row {
          flex-direction: column;
          gap: 16px;
        }

        .decor-animation-chaotic {
          width: min(100%, 300px);
          height: 160px;
          margin-top: 0;
        }

        .decor-animation-circle {
          width: 160px;
          height: 160px;
        }

        .norma-download-block {
          cursor: auto;
        }

        .norma-cursor {
          display: none;
        }

        .norma-download-actions {
          align-items: stretch;
          flex-direction: column;
        }

        .norma-download-button {
          width: 100%;
        }

        .mockup-demo-head {
          align-items: flex-start;
          flex-direction: column;
        }

        .hero-title {
          font-size: 42px;
        }

        .hero-thesis {
          font-size: 29px;
          width: 100%;
          max-width: calc(100vw - 48px);
        }

        .hero-copy,
        .section-lede {
          font-size: 18px;
        }

        .hero-copy {
          width: 100%;
          max-width: calc(100vw - 48px);
        }

        .section-title {
          font-size: 34px;
        }

        .tel-section {
          padding: 66px 0;
        }

        .graph-panel,
        .install-block {
          padding: 20px 16px;
        }

        .graph-head {
          align-items: flex-start;
          flex-direction: column;
        }

        .term-card {
          min-height: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          animation-duration: 1ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 1ms !important;
        }
      }
    </style>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var resolved;
        if (stored === 'night' || stored === 'daylight') {
          resolved = stored;
        } else {
          resolved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'daylight';
        }
        document.documentElement.setAttribute('data-theme', resolved);
        document.documentElement.setAttribute('data-theme-pref', stored || 'system');
      })();
    </script>
  </head>
  <body>
    <div class="tel-page">
      <svg class="constellation-field" data-constellation-field aria-hidden="true"></svg>
      <div class="twinkle-field" data-star-field aria-hidden="true"></div>
      <nav class="tel-nav" aria-label="Primary navigation">
        <div class="tel-nav-inner">
          <a class="brand" href="/" aria-label="Telotia home">
            <span class="brand-mark" aria-hidden="true"></span>
            <span class="brand-name">TELOTIA</span>
            <span class="brand-org">private beta</span>
          </a>
          <div class="nav-links" aria-label="Page sections">
            {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          </div>
          <span class="nav-spacer"></span>
          <div class="theme-switcher" aria-label="Theme">
            <button class="theme-btn" data-theme-value="daylight" title="Daylight">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <circle cx="7" cy="7" r="3" stroke="currentColor" stroke-width="1.3"/>
                <line x1="7" y1="0.5" x2="7" y2="2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="7" y1="11.5" x2="7" y2="13.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="0.5" y1="7" x2="2.5" y2="7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="11.5" y1="7" x2="13.5" y2="7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="2.6" y1="2.6" x2="3.9" y2="3.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="10.1" y1="10.1" x2="11.4" y2="11.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="11.4" y1="2.6" x2="10.1" y2="3.9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="3.9" y1="10.1" x2="2.6" y2="11.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>
            <button class="theme-btn" data-theme-value="night" title="Night">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M12.5 9.5A6 6 0 1 1 4.5 1.5a4.3 4.3 0 0 0 8 8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
              </svg>
            </button>
            <button class="theme-btn" data-theme-value="system" title="System">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <rect x="1" y="2" width="12" height="8" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
                <line x1="7" y1="10" x2="7" y2="12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="4.5" y1="12.5" x2="9.5" y2="12.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <a class="repo-link" href="mailto:hello@telotia.com">
            Get in touch &nearr;
          </a>
        </div>
      </nav>

      <main>
        <section class="tel-hero" aria-labelledby="hero-title">
          <div class="tel-hero-inner">
            <div class="hero-copy-block">
              <div class="hero-status">
                <span class="status-dot"></span>
                in development · private beta
              </div>
              <div class="hero-title-row">
                <h1 class="hero-title" id="hero-title">
                  <img
                    src="/assets/principia/telotia-wordmark.svg"
                    alt="TELOTIA"
                    class="hero-wordmark"
                    width="1624"
                    height="338"
                  />
                </h1>
                <div class="decor-animation decor-animation-chaotic" aria-hidden="true">
                  <canvas data-decor-animation="chaotic"></canvas>
                </div>
              </div>
              <p class="hero-thesis">
                <span class="hero-line">Every important artifact makes claims.</span>
                <span class="hero-line">We validate which claims <em>survive evidence.</em></span>
              </p>
              <p class="hero-copy">
                <span class="hero-line">Give Telotia a document and a body of evidence you trust.</span>
                <span class="hero-line">
                  It breaks the document into its individual claims
                </span>
                <span class="hero-line">
                  and shows you, claim by claim, what the evidence supports —
                </span>
                <span class="hero-line">
                  and what it doesn't.
                </span>
              </p>
              <div class="hero-cta-row">
                <a class="hero-cta-primary" href="#showcase">See it run</a>
                <a class="hero-cta-secondary" href="mailto:hello@telotia.com">Get in touch</a>
              </div>
              <div class="hero-meta" aria-label="Kernel facts">
                {
                  heroMeta.map((item) => (
                    <div class="cell">
                      <div class="meta-label">{item.label}</div>
                      <div class="meta-value">{item.value}</div>
                    </div>
                  ))
                }
              </div>
            </div>

          </div>
        </section>

        <section class="tel-section paper-section" id="how-it-works">
          <div class="tel-container">
            <div class="tel-label">How it works</div>
            <h2 class="section-title">
              Break it down. Search the evidence. <em>Grade every claim.</em>
            </h2>
            <p class="section-lede">
              Three steps. No aggregate scores, no summaries. Each claim is
              checked and cited on its own — against the evidence base you
              supply, not the open web.
            </p>

            <dl class="cycle">
              {
                cycleSteps.map((item) => (
                  <>
                    <dt>
                      <small>{item.step}</small>
                      {item.title}
                    </dt>
                    <dd>{item.body}</dd>
                  </>
                ))
              }
            </dl>
          </div>
        </section>

        <section class="tel-section paper-section alt" id="vocabulary">
          <div class="tel-container">
            <div class="tel-label">Verdict vocabulary</div>
            <h2 class="section-title">
              Three verdicts. <em>No collapse to true or false.</em>
            </h2>
            <p class="section-lede">
              Absence of evidence is not falsehood. When the product finds no
              support for a claim, it says "no support found in this corpus" —
              not "false." This is both more honest and more useful.
            </p>
            <div class="vocab-grid">
              {
                terms.map((term) => (
                  <article class="term-card">
                    <div class="term-pos">{term.pos}</div>
                    <h3 class="term-name">{term.term}</h3>
                    <p class="term-def">{term.def}</p>
                  </article>
                ))
              }
            </div>
          </div>
        </section>

        <section class="tel-section paper-section" id="showcase">
          <div class="tel-container">
            <div class="install-heading-row">
              <div class="install-heading-copy">
                <div class="tel-label">Live showcase</div>
                <h2 class="section-title">
                  See it on real research. <em>Real claims. Real evidence.</em>
                </h2>
                <p class="section-lede tel-narrow">
                  We indexed the published papers of the Concordia Design Lab —
                  a fixed, trusted body of research. Then we dropped in an
                  outside paper and asked: which of its claims does the lab's
                  research actually support? Watch Telotia decompose the paper
                  and answer, claim by claim, with citations.
                </p>
              </div>
              <div class="decor-animation decor-animation-circle" aria-hidden="true">
                <canvas data-decor-animation="circle"></canvas>
              </div>
            </div>

            <div class="install-meta" aria-label="Showcase details">
              <div class="cell">
                <div class="meta-label">Evidence base</div>
                <div class="value">
                  <span class="mono">Concordia Design Lab / 47 papers / 2006–2024</span>
                </div>
              </div>
              <div class="cell">
                <div class="meta-label">Input document</div>
                <div class="value">External research paper, outside the lab corpus</div>
              </div>
              <div class="cell">
                <div class="meta-label">Corpus note</div>
                <div class="value">Demonstrates any document, any trusted corpus</div>
              </div>
            </div>

            <div class="app-demo-block" id="app-demo">
              <div class="mockup-demo-head">
                <div class="tel-label">interactive mockup</div>
                <p class="mockup-demo-note">
                  Select a claim to see the graded verdict and the exact corpus passage cited as evidence.
                </p>
              </div>

              <aside class="app-preview-shell" data-vivarium-app aria-label="Interactive Telotia showcase mockup">
                <div class="app-topbar">
                  <div class="app-brand">
                    <span class="brand-mark" aria-hidden="true"></span>
                    Telotia
                  </div>
                  <div class="session-chip">run_2026_05_20_showcase / concordia-design-lab</div>
                </div>

                <div class="app-workspace">
                  <nav class="app-rail" aria-label="Chambers">
                    {
                      appChambers.map((chamber) => (
                        <button
                          class:list={['chamber-button', chamber.id === 'synthesis' && 'is-active']}
                          type="button"
                          data-chamber={chamber.id}
                          aria-label={`${chamber.label}: ${chamber.state}`}
                          title={`${chamber.label}: ${chamber.state}`}
                        >
                          <svg class="chamber-glyph" aria-hidden="true">
                            <use href={`/assets/principia/icons.svg#ch-${chamber.id}`}></use>
                          </svg>
                        </button>
                      ))
                    }
                  </nav>

                  <div class="app-main">
                    <article class="telos-card">
                      <div class="telos-card-header">
                        <span>Document / doc_paper_8f0a1b34</span>
                        <span data-chamber-state>active / decompose</span>
                      </div>
                      <h2 data-app-title>
                        Which claims in this external paper are supported by the Concordia Design Lab corpus?
                      </h2>
                      <div class="telos-meta">
                        <span>18 atomic claims extracted</span>
                        <span>corpus: 47 papers / 2006–2024</span>
                        <span data-slice-readout>claim_a3f2b9c1 / Supported</span>
                      </div>
                    </article>

                    <section class="demo-graph-panel" aria-label="Claim validation pipeline">
                      <div class="animation-panel-label">claim pipeline / decompose active</div>
                      <svg
                        viewBox="0 0 900 240"
                        preserveAspectRatio="xMidYMid meet"
                        role="img"
                        aria-labelledby="demo-graph-title"
                      >
                        <title id="demo-graph-title">Claim validation pipeline</title>
                        {
                          graphEdges.map((edge) => {
                            const from = graphNodeById[edge.from];
                            const to = graphNodeById[edge.to];
                            const dashed = edge.dashed || edge.terminal;
                            const activeEdge = !dashed && (from.active || to.active);

                            return (
                              <g>
                                <line
                                  x1={from.x}
                                  y1={from.y}
                                  x2={to.x}
                                  y2={to.y}
                                  stroke={activeEdge ? '#DEA193' : '#3A4664'}
                                  stroke-width={activeEdge ? '1.5' : '0.9'}
                                  stroke-dasharray={dashed ? '3 5' : ''}
                                  opacity={dashed ? '0.55' : '1'}
                                />
                              </g>
                            );
                          })
                        }
                        {
                          graphNodes.map((node) => (
                            <g>
                              <circle
                                cx={node.x}
                                cy={node.y}
                                r={node.active ? '14' : '10'}
                                fill={node.active ? '#DEA193' : node.terminal ? '#0A1430' : '#162244'}
                                stroke={node.active ? '#DEA193' : '#B0A89A'}
                                stroke-width="1.2"
                                stroke-dasharray={node.terminal ? '2 3' : ''}
                              />
                              <text
                                x={node.x}
                                y={node.y < 110 ? node.y - 22 : node.y + 30}
                                text-anchor="middle"
                                font-family="IBM Plex Sans, system-ui, sans-serif"
                                font-size="11"
                                fill={node.active ? '#DEA193' : '#B0A89A'}
                              >
                                {node.label}
                              </text>
                            </g>
                          ))
                        }
                      </svg>
                      <div class="active-chamber-readout" data-chamber-readout>DECOMPOSE / ACTIVE</div>
                    </section>

                    <div class="slice-drawer" aria-label="Slices">
                      {
                        appSlices.map((slice, index) => (
                          <div
                            class:list={['slice-card', `slice-card--${slice.verdict.toLowerCase()}`]}
                            role="button"
                            tabindex="0"
                            aria-selected={index === 0 ? 'true' : 'false'}
                            data-slice={slice.id}
                            data-verdict={slice.verdict}
                            data-title={slice.title}
                            data-slice-theory={slice.theory}
                            data-slice-evidence={slice.evidence}
                            data-slice-chamber={slice.chamber}
                            data-slice-reentries={String(slice.reentries)}
                            data-slice-last={slice.last}
                            data-slice-note={slice.note}
                          >
                            <div class="slice-card-main">
                              <strong class="slice-card-title">{slice.title}</strong>
                              <div class="slice-card-meta">
                                <span>{slice.chamber}</span>
                                <span>·</span>
                                <span><b>{slice.reentries}</b> re-entries</span>
                                <span>·</span>
                                <span>last engaged <b>{slice.last}</b></span>
                                {slice.note && (
                                  <>
                                    <span>·</span>
                                    <span class="slice-note">{slice.note}</span>
                                  </>
                                )}
                              </div>
                            </div>
                            <div class="slice-card-right">
                              <span class="slice-verdict-pill">
                                <span class="pill-dot"></span>
                                {slice.verdict}
                              </span>
                            </div>
                          </div>
                        ))
                      }
                    </div>
                  </div>

                  <aside class="app-eventlog" aria-label="Runtime event log">
                    <div class="eventlog-head">
                      <span>processing log</span>
                      <span class="eventlog-session">run_2026_05_20_showcase</span>
                    </div>
                    <div class="event-list">
                      {
                        appEvents.map((event, index) => (
                          <div class:list={['event-row', index === 1 && 'is-highlighted']} data-event-chamber={event.chamber}>
                            <span class="event-time">{event.time}</span>
                            <span class="event-chamber">{event.chamber}</span>
                            <span class="event-detail">
                              {event.event} / {event.detail}
                            </span>
                          </div>
                        ))
                      }
                    </div>
                  </aside>
                </div>
                <!-- Slice detail panel — constrained inside the Vivarium app frame -->
                <div class="slice-detail-overlay" id="sliceDetailOverlay" aria-hidden="true">
                  <aside class="slice-detail-panel" aria-label="Slice detail">
                    <div class="slice-detail-head">
                      <span class="slice-detail-pill" id="sliceDetailVerdict"></span>
                      <span class="slice-detail-id" id="sliceDetailId"></span>
                      <button class="slice-detail-close" id="sliceDetailClose">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                          <line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/>
                        </svg>
                        Close
                      </button>
                    </div>
                    <div class="slice-detail-body">
                      <div class="slice-detail-label">Claim</div>
                      <blockquote class="slice-detail-quote" id="sliceDetailTitle"></blockquote>

                      <div class="slice-detail-label">How we read it</div>
                      <p id="sliceDetailTheory"></p>

                      <div class="slice-detail-label">What the corpus says</div>
                      <p id="sliceDetailEvidence"></p>

                      <div class="slice-detail-label">State</div>
                      <dl class="slice-detail-kv" id="sliceDetailState"></dl>

                      <div class="slice-detail-label" style="margin-top:22px">Actions</div>
                      <div class="slice-detail-actions">
                        <button class="slice-action-btn slice-action-primary">&#8859; View source passage</button>
                        <button class="slice-action-btn slice-action-secondary">See related claims</button>
                        <button class="slice-action-btn slice-action-quiet" id="sliceCopyId">Copy id</button>
                      </div>
                    </div>
                  </aside>
                </div>
              </aside>
            </div>

            <section
              class="norma-download-block"
              data-norma-download
              data-particle-src="/assets/principia/chaotic-p.svg"
              aria-label="Download Norma for Windows"
            >
              <canvas class="norma-ripple-canvas" data-norma-ripple></canvas>
              <div class="norma-download-content">
                <h2 class="norma-download-title">Download Norma for Windows</h2>
                <p class="norma-download-copy">
                  Norma packages the local constellation runtime for operators
                  who need Vivarium sessions, chamber traces, and release checks
                  in one desktop surface.
                </p>
                <div class="norma-download-actions">
                  <a class="norma-download-button norma-download-button--primary" href="https://github.com/Telotia/Principia/releases">
                    Download for x64
                  </a>
                  <a class="norma-download-button norma-download-button--secondary" href="https://github.com/Telotia/Principia/releases">
                    Download for ARM64
                  </a>
                </div>
                <p class="norma-platform-note">Windows 11 / Windows 10 - macOS and Linux builds staged through Vivarium</p>
              </div>
              <div class="norma-cursor" data-norma-cursor aria-hidden="true">
                <svg viewBox="60 50 150 178" fill="none" aria-hidden="true">
                  <path class="norma-cursor-line" d="M174.38 76.12 L84.75 145.87 L117.14 208.31 L129.95 206.32 L189.11 183.08 Z" />
                  <path class="norma-cursor-line-glint" d="M174.38 76.12 L84.75 145.87 L117.14 208.31 L129.95 206.32 L189.11 183.08 Z" />
                  <g class="norma-cursor-stars" filter="url(#normaCursorGlow)">
                    <g class="norma-cursor-star">
                      <circle cx="174.38" cy="76.12" r="10.2" fill="#0B4CFF" opacity="0.64" />
