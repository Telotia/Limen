---
// Sibling of index.astro -- same multi-page ink-wash site/ bundle pattern.
// In production (telotia.com) this page only exists to send old links home.
import designRaw from '../../site/consult.html?raw';

const limenEnv = process.env.LIMEN_ENV ?? 'dev';
const isProd = limenEnv === 'prod';

const bodyMatch = designRaw.match(/<body[^>]*>([\s\S]*?)<\/body>/);
const designHtml = bodyMatch ? bodyMatch[1] : '';
---

<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Telotia · Consult</title>
    {isProd && <meta http-equiv="refresh" content="0; url=/" />}
    {isProd && <meta name="robots" content="noindex" />}
    {isProd && <link rel="canonical" href="https://telotia.com/" />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>
  <body>
    {
      isProd ? (
        <p><a href="/">Telotia</a></p>
      ) : (
        <Fragment set:html={designHtml} />
      )
    }
  </body>
</html>
