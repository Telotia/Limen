{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-enum": [
      2,
      "always",
      [
        "pages",
        "layouts",
        "components",
        "styles",
        "content",
        "assets",
        "config",
        "ci",
        "deps",
        "docs",
        "infra"
      ]
    ],
    "scope-empty": [2, "never"],
    "subject-case": [
      2,
      "never",
      ["sentence-case", "start-case", "pascal-case", "upper-case"]
    ]
  }
}
